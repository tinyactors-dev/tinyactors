#!/usr/bin/env ruby
#MISE description="Convert the vendored W3C SCXML IRP tests into jq and ECMAScript scenarios"

require 'pathname'
require_relative '../../ruby/scxml_irp/importer'

root = Pathname.new(__dir__).join('../..').expand_path
importer = SCXML::IRP::Importer.new(suite: root.join('vendor/scxml-irp'),
                                  scenarios_dir: root.join('ruby/scenarios/scxml_irp'),
                                  root: root)
imports = importer.write_all
imported = imports.count(&:imported?)
puts "imported #{imported} of #{imports.size} W3C SCXML IRP tests; " \
     "see ruby/scenarios/scxml_irp/INDEX.md for the #{imports.size - imported} skipped"
