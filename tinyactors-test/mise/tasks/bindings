#!/usr/bin/env ruby
#MISE description="Generate RPC bindings (build/gen/ta_rpc.{c,h}) from tinyactors-core's published tinyactors.api.json"
#MISE sources=["bindings.rb", "mise/tasks/bindings", "mise/lib/**/*", "../tinyactors-core/dist/include/tinyactors.api.json"]
#MISE outputs={auto=true}

# Reads tinyactors-core/dist/include/tinyactors.api.json (published by
# tinyactors-core's `dist` task, not the copy under its own include/) and
# bindings.rb, and writes JSON codecs for every bound type plus one RPC
# handler per bound function. See README.md ("Generated bindings") and
# docs/protocol.md. `mise run build` runs `mise run dist` in tinyactors-core
# before this task, so the description is current whenever this runs as part
# of a normal build; running `mise run bindings` on its own trusts whatever
# tinyactors-core last published.

require 'json'
require 'pathname'

ROOT = Pathname.new(__dir__).join('../..').expand_path
DESCRIPTION = ROOT.parent.join('tinyactors-core/dist/include/tinyactors.api.json')
OUT_DIR = ROOT.join('build/gen')
require ROOT.join('bindings').to_s
require ROOT.join('mise/lib/rpc').to_s

begin
  output = Rpc.generate(DESCRIPTION, TinyactorsBindings)
rescue Rpc::Error => e
  abort "bindings: #{e.message}"
end

OUT_DIR.mkpath
# Rewrite only on change so an unchanged generation keeps its mtime and does
# not make downstream compile steps look stale.
def write_if_changed(path, contents)
  path.write(contents) unless path.file? && path.read == contents
end

write_if_changed(OUT_DIR.join('ta_rpc.h'), output.header)
write_if_changed(OUT_DIR.join('ta_rpc.c'), output.source)
write_if_changed(OUT_DIR.join('coverage.json'), "#{JSON.pretty_generate(output.coverage)}\n")
counts = output.coverage.reject { |_, value| value.is_a?(Hash) }
puts "generated build/gen/ta_rpc.{c,h}: #{counts.map { |key, value| "#{key}=#{value}" }.join(' ')}"
