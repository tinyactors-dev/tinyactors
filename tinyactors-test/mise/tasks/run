#!/usr/bin/env ruby
#MISE description="Run the suites against an implementation: run -- <command…> [--milestone M1|M2|…] [--suite protocol|scenarios|w3c]… [--datamodel quickjs|native|<name>] [--realm auto|isolated] [--kind binding|reference] [--skip <file>]… [--timeout <s>]"
# vim:ft=ruby

# The command is every argument that is not one of the options below, or
# everything after a second `--`. It runs in the directory mise was called
# from, and speaks docs/driver.md on its standard input and output. The
# suites are protocol (suites/protocol), scenarios (suites/scenarios) and
# w3c (the W3C IRP suite in suites/w3c/irp); without --suite, all three.
# --milestone runs the set of one milestone of the bindings' plan
# (suites/milestones.txt: its vector files, scenarios and suites, and those
# of the milestones before it); --suite then narrows it, and naming a suite
# the milestone does not run is an error. Without --milestone, every case
# runs.
# The scenarios and the W3C suite are converted for the language of the
# datamodel host.create reports (docs/driver.md, "Datamodels"). --kind says
# which methods the command must offer (docs/driver.md, "Kinds"): binding
# (the default) or reference (ta-conform). --skip names a file of W3C test
# ids with reasons, in the format of suites/w3c/skip.txt, skipped besides
# that list and the language's (suites/w3c/skip-<language>.txt). Exit
# status 1 when a case fails, when a suite passes no case, or when a method
# the kind must offer is not offered.

require_relative '../../lib/runner'

OPTIONS = %w[--milestone --suite --datamodel --realm --kind --skip --timeout].freeze

def usage(message)
  abort "run: #{message}\nusage: mise run //tinyactors-test:run -- <command…> [--milestone M1|M2|…] " \
        '[--suite protocol|scenarios|w3c]… ' \
        '[--datamodel quickjs|native|<name>] [--realm auto|isolated] [--kind binding|reference] [--skip <file>]… [--timeout <s>]'
end

arguments = ARGV.dup
command = []
options = Hash.new { |hash, key| hash[key] = [] }
until arguments.empty?
  argument = arguments.shift
  if argument == '--' && !command.empty?
    command.concat(arguments)
    break
  elsif OPTIONS.include?(argument)
    usage("#{argument} needs a value") if arguments.empty?
    options[argument] << arguments.shift
  elsif argument != '--'
    command << argument
  end
end
usage('no command') if command.empty?
suites = options['--suite'].empty? ? Runner::SUITES : options['--suite']
unknown = suites - Runner::SUITES
usage("no suite #{unknown.join(', ')}") unless unknown.empty?

only = nil
if (milestone = options['--milestone'].last)
  begin
    only = Milestones.select(milestone)
  rescue Milestones::Error => e
    usage(e.message)
  end
  outside = suites - only.suites
  usage("#{milestone} does not run #{outside.join(', ')}") unless options['--suite'].empty? || outside.empty?
  suites = options['--suite'].empty? ? only.suites : suites
  puts "run: milestone #{only}"
end

kind = options['--kind'].last || 'binding'
usage("no kind #{kind}") unless Runner::REQUIRED.key?(kind)

cwd = ENV.fetch('MISE_ORIGINAL_CWD', Dir.pwd)
runner = Runner.new(command,
                    datamodel: options['--datamodel'].last || 'quickjs',
                    realm: options['--realm'].last,
                    kind: kind,
                    timeout: Integer(options['--timeout'].last || 60),
                    skip: options['--skip'].map { |path| File.expand_path(path, cwd) },
                    chdir: cwd,
                    only: only)
exit(runner.run(suites) ? 0 : 1)
