#!/usr/bin/env ruby
#MISE description="Run the suites against an implementation: run -- <command…> [--suite protocol|scenarios|w3c]… [--datamodel quickjs|native|<name>] [--realm auto|isolated] [--language ecmascript] [--skip <file>]… [--timeout <s>]"
# vim:ft=ruby

# The command is every argument that is not one of the options below, or
# everything after a second `--`. It runs in the directory mise was called
# from, and speaks docs/driver.md on its standard input and output. The
# suites are protocol (suites/protocol), scenarios (suites/scenarios) and
# w3c (the W3C IRP suite, fetched and converted on first use); without
# --suite, all three. --skip names a file of W3C test ids with reasons, in
# the format of suites/w3c/skip.txt, skipped besides that list. Exit
# status 1 when a case fails.

require_relative '../../lib/runner'

OPTIONS = %w[--suite --datamodel --realm --language --skip --timeout].freeze

def usage(message)
  abort "run: #{message}\nusage: mise run //tinyactors-test:run -- <command…> [--suite protocol|scenarios|w3c]… " \
        '[--datamodel quickjs|native|<name>] [--realm auto|isolated] [--language ecmascript] [--skip <file>]… [--timeout <s>]'
end

arguments = ARGV.dup
command = []
options = Hash.new { |hash, key| hash[key] = [] }
until arguments.empty?
  argument = arguments.shift
  if argument == '--' && !command.empty?
    command.concat(arguments)
    break
  elsif OPTIONS.include?(argument)
    usage("#{argument} needs a value") if arguments.empty?
    options[argument] << arguments.shift
  elsif argument != '--'
    command << argument
  end
end
usage('no command') if command.empty?
suites = options['--suite'].empty? ? Runner::SUITES : options['--suite']
unknown = suites - Runner::SUITES
usage("no suite #{unknown.join(', ')}") unless unknown.empty?

cwd = ENV.fetch('MISE_ORIGINAL_CWD', Dir.pwd)
skip = options['--skip'].empty? ? nil : W3C.skipped(*options['--skip'].map { |path| File.expand_path(path, cwd) })
runner = Runner.new(command,
                    datamodel: options['--datamodel'].last || 'quickjs',
                    realm: options['--realm'].last,
                    language: options['--language'].last || 'ecmascript',
                    timeout: Integer(options['--timeout'].last || 60),
                    skip: skip,
                    chdir: cwd)
exit(runner.run(suites) ? 0 : 1)
