#!/usr/bin/env ruby
#MISE description="Run the debug adapter: the Debug Adapter Protocol on stdin and stdout (args: [--host PATH])"

# Builds nothing, like the workbench task: a DAP client starts this, and a
# build writing to stdout would corrupt the protocol.
require 'pathname'

ROOT = Pathname.new(__dir__).join('../..').expand_path

host = ROOT.join('build/tinyactors-test')
abort "dap: no host at #{host}; run `mise run build` first" unless host.executable?

exec(ROOT.join('bin/dap').to_s, *ARGV)
