#!/usr/bin/env ruby
#MISE description="Build, then run the jq and ECMAScript data model, population scale, smoke, bindings, bindings generator, DSL, runner, instruments, and workbench self-tests, the SCXML IRP import check, the export round-trip check, and scenario suites (the exhaustive scenarios, and the largest populations, only with --full)"
#MISE sources=["bin/**/*", "bindings.rb", "ruby/**/*", "src/**/*", "tests/**/*", "vendor/**/*", "workbench/**/*", "mise/**/*", "mise.toml", "../tinyactors-core/include/**/*", "../tinyactors-core/src/**/*", "../tinyactors-host/include/**/*", "../tinyactors-host/src/**/*", "../tinyactors-otlp/include/**/*", "../tinyactors-otlp/src/**/*", "../tinyxml/include/**/*", "../tinyxml/src/**/*", "../tinyactors-scxml/include/**/*", "../tinyactors-scxml/src/**/*", "../mise/lib/**/*", "../mise.toml"]
#MISE outputs={auto=true}
#USAGE flag "--full" help="Also run the exhaustive scenarios and the scale test's largest populations"

require 'etc'
require 'pathname'
require 'tempfile'

require 'task_stamp'

root = Pathname.new(__dir__).join('../../..').expand_path
full = ENV['usage_full'] == 'true' || ARGV.include?('--full')

def run(*command, chdir:)
  pid = Process.spawn(*command, chdir: chdir.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

# Runs independent checks at once, one per CPU, and prints each one's output
# in the order given once it has finished; fails when any of them failed.
def run_all(commands, chdir:)
  queue = Queue.new
  commands.each_with_index { |command, index| queue << [command, index] }
  queue.close
  outputs = Array.new(commands.size)
  workers = Array.new([Etc.nprocessors, commands.size].min) do
    Thread.new do
      while (item = queue.pop)
        command = item[0]
        Tempfile.create('check') do |log|
          pid = Process.spawn(*command, chdir: chdir.to_s, out: log, err: log)
          _pid, status = Process.wait2(pid)
          outputs[item[1]] = [command.join(' '), status.success?, File.read(log.path)]
        end
      end
    end
  end
  workers.each(&:join)
  outputs.each { |_, _, text| print text }
  failed = outputs.reject { |_, ok, _| ok }.map(&:first)
  abort "failed: #{failed.join(', ')}" unless failed.empty?
end

run('mise', 'run', *TaskStamp.force(root, 'build'), 'build', chdir: root)
# The scale test checks invariant 17 (per-actor cost does not grow with the
# population) at 50,000 and 200,000 actors; --full measures up to the
# four-million-actor target as well, which takes about a minute and GBs.
# It compares timings, so it runs alone, before the checks that run at once.
scale = full ? {} : { 'TAT_SCALE_MAX_POPULATION' => '200000' }
pid = Process.spawn(scale, 'build/scale_test', chdir: root.to_s)
_pid, status = Process.wait2(pid)
exit(status.exitstatus || 1) unless status.success?
run_all([
  ['build/json_datamodel_test'],
  ['build/ecmascript_datamodel_test'],
  %w[ruby ruby/smoke.rb],
  %w[ruby ruby/bindings_test.rb],
  %w[ruby ruby/bindings_generator_test.rb],
  %w[ruby ruby/selftest.rb],
  %w[ruby ruby/runner_selftest.rb],
  %w[ruby ruby/instruments_selftest.rb],
  %w[ruby ruby/workbench_selftest.rb],
  %w[ruby ruby/scxml_irp_check.rb],
  %w[ruby ruby/export_roundtrip_check.rb]
], chdir: root)
# The scenarios use every CPU themselves, so they run after the checks.
run('ruby', 'ruby/run_scenarios.rb', *(full ? [] : ['--fast']), chdir: root)
