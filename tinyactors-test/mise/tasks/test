#!/usr/bin/env ruby
#MISE description="Build, then run the data model, smoke, bindings, DSL and runner self-tests, the SCXML IRP import check, the export round-trip check, and scenario suites"

require 'pathname'

root = Pathname.new(__dir__).join('../..').expand_path

def run(*command, chdir:)
  pid = Process.spawn(*command, chdir: chdir.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

run('mise', 'run', 'build', chdir: root)
run('build/json_datamodel_test', chdir: root)
run('ruby', 'ruby/smoke.rb', chdir: root)
run('ruby', 'ruby/bindings_test.rb', chdir: root)
run('ruby', 'ruby/selftest.rb', chdir: root)
run('ruby', 'ruby/runner_selftest.rb', chdir: root)
run('ruby', 'ruby/scxml_irp_check.rb', chdir: root)
run('ruby', 'ruby/export_roundtrip_check.rb', chdir: root)
run('ruby', 'ruby/run_scenarios.rb', chdir: root)
