#!/usr/bin/env ruby
#MISE description="Build the tinyactors-test JSON-RPC host"
# vim:ft=ruby
#
# No `#MISE sources`/`outputs`: this task always runs and skips by content
# instead (mise/lib/cache.rb), the same way tinyxml/mise/tasks/build/{_default,
# library,tests} do. That is deliberate, not an oversight. tinyactors-core is
# consumed only through its published dist/ (../tinyactors-core/mise/tasks/
# dist), never by compiling its src/ or include/ directly, and the only thing
# that refreshes that dist/ is the `mise run dist` call below. A `#MISE
# sources` list keyed on `../tinyactors-core/dist/**` would therefore be
# circular: mise checks sources' mtimes *before* running this task's body, so
# it would see core's dist/ as untouched (nothing has published it yet),
# print "sources up-to-date, skipping", and never reach the `mise run dist`
# call that would have refreshed it -- silently linking against a stale
# archive forever after a real core change. Always entering the body avoids
# that trap: `mise run dist` in core is content-gated (a handful of hashes,
# not a rebuild, when core did not really change), and `link` below keys on
# the bytes of whatever it produces, so an unchanged archive still relinks
# nothing while a changed one propagates immediately.
# Changing CC/CFLAGS already changes `link`'s cache key (the command is part
# of it), so it relinks on its own; there is no mtime gate to force past.
# `TA_FORCE=1 mise run build` (or `rm -rf build`) ignores every stamp for a
# from-scratch run instead.

require 'fileutils'
require 'pathname'
require 'shellwords'
require 'cache'

ROOT = Pathname.new(__dir__).join('../..').expand_path
WORKSPACE = ROOT.parent
CORE = WORKSPACE.join('tinyactors-core')
CORE_DIST_INCLUDE = CORE.join('dist/include')
CORE_DIST_HEADER = CORE_DIST_INCLUDE.join('tinyactors.h')
# The "release" profile specifically: core's dist task publishes one archive
# per profile (mise/tasks/dist in core), each built with its own hard-coded
# flags rather than this shell's $CFLAGS. This host always links the release
# profile (-O2), which is also what a plain `mise run dist` in core publishes
# by default.
CORE_DIST_LIBRARY = CORE.join('dist/lib/release/libtinyactors.a')
# The SCXML codec (ADR 0053) is compiled from its sources into the host, and
# links txml's published archive. See ../tinyactors-scxml/README.md.
SCXML = WORKSPACE.join('tinyactors-scxml')
XML = WORKSPACE.join('tinyxml')
XML_DIST_INCLUDE = XML.join('dist/include')
XML_DIST_LIBRARY = XML.join('dist/lib/release/libtxml.a')
JQ_SOURCE = ROOT.join('vendor/jq')
QUICKJS_SOURCE = ROOT.join('vendor/quickjs-ng')
BUILD = ROOT.join('build')
JQ_BUILD = BUILD.join('jq')
QUICKJS_BUILD = BUILD.join('quickjs-ng')
PREFIX = BUILD.join('prefix')

def run(*command, chdir: ROOT)
  puts command.shelljoin
  pid = Process.spawn(*command, chdir: chdir.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

unless JQ_SOURCE.join('.tinyactors-vendor-version').file?
  run('mise', 'run', 'vendor-jq', chdir: WORKSPACE)
end

libjq = PREFIX.join('lib/libjq.a')
libonig = PREFIX.join('lib/libonig.a')
unless libjq.file? && libonig.file?
  FileUtils.mkdir_p(JQ_BUILD)
  unless JQ_BUILD.join('Makefile').file?
    run(
      JQ_SOURCE.join('configure').to_s,
      '--disable-shared',
      '--enable-static',
      '--disable-docs',
      '--with-oniguruma=builtin',
      "--prefix=#{PREFIX}",
      chdir: JQ_BUILD
    )
  end
  run('make', '-j2', 'install', chdir: JQ_BUILD)
end

unless QUICKJS_SOURCE.join('.tinyactors-vendor-version').file?
  run('mise', 'run', 'vendor-quickjs', chdir: WORKSPACE)
end

# quickjs-ng is compiled straight from its library sources (the same set as
# its CMake `qjs` target without quickjs-libc) with its own flags; it does not
# build under the host's -Werror -pedantic. Like jq, this only runs when the
# archive or its installed header is missing.
libqjs = PREFIX.join('lib/libqjs.a')
quickjs_header = PREFIX.join('include/quickjs.h')
unless libqjs.file? && quickjs_header.file?
  FileUtils.rm_rf(QUICKJS_BUILD)
  FileUtils.mkdir_p(QUICKJS_BUILD)
  FileUtils.mkdir_p(libqjs.dirname)
  FileUtils.mkdir_p(quickjs_header.dirname)
  quickjs_compiler = Shellwords.split(ENV.fetch('CC', 'cc'))
  quickjs_flags = %w[
    -std=gnu11 -O2 -funsigned-char -D_GNU_SOURCE -DQUICKJS_NG_BUILD
    -Wno-implicit-fallthrough -Wno-sign-compare -Wno-unused-parameter
  ]
  objects = %w[dtoa libregexp libunicode quickjs].map do |name|
    object = QUICKJS_BUILD.join("#{name}.o")
    run(*quickjs_compiler, *quickjs_flags, "-I#{QUICKJS_SOURCE}", '-c',
        QUICKJS_SOURCE.join("#{name}.c").to_s, '-o', object.to_s)
    object
  end
  FileUtils.rm_f(libqjs)
  run('ar', 'rcs', libqjs.to_s, *objects.map(&:to_s))
  FileUtils.cp(QUICKJS_SOURCE.join('quickjs.h'), quickjs_header)
end

# Publishes tinyactors-core's dist/ (dist/include/{tinyactors.h,tinyactors.c,
# tinyactors.api.json}, dist/lib/<profile>/libtinyactors.a). Content-gated in core, so
# this is a handful of hash comparisons, not a rebuild, whenever core has not
# really changed; it is what keeps CORE_DIST_HEADER/CORE_DIST_LIBRARY current
# before anything below compiles or links against them.
run('mise', 'run', 'dist', chdir: CORE)
run('mise', 'run', 'dist', chdir: XML)

# The generated bindings are cached by mise's own stamp, which survives
# `rm -rf build`; force the task when what it generates is gone. `bindings`
# computes its own outputs, so TaskStamp cannot check them.
generated = %w[ta_rpc.c ta_rpc.h].map { |name| BUILD.join('gen', name) }
run('mise', 'run', *(generated.all?(&:file?) ? [] : ['--force']), 'bindings', chdir: ROOT)

compiler = Shellwords.split(ENV.fetch('CC', 'cc'))
flags = Shellwords.split(ENV.fetch('CFLAGS', '-std=c11 -Wall -Wextra -Werror -pedantic -O2'))
compiler_id = Cache.tool_id(compiler.first(1))

# Relinks `binary` from `command` unless the last successful link had the same
# command and the same input bytes (its own sources, headers it reads, and
# every library it links, core's archive included) and the binary is still
# there. So an upstream tinyactors-core rebuild that leaves the archive's
# bytes identical (a comment-only src/*.c edit — see
# tinyactors-core/mise/tasks/dist's write-only-if-different guard) relinks
# nothing here, while a real change to the archive's bytes does. Modeled on
# tinyxml/mise/tasks/build/_default's `link`.
#
# Note the deliberate decoupling this migration introduces: this host
# compiles its own translation units with $CFLAGS (default -O2, see `flags`
# below), but libtinyactors.a is a prebuilt archive published by
# tinyactors-core's own `dist` task under a *named profile* (see
# tinyactors-core/mise/tasks/dist), whose flags are hard-coded there, not read
# from this shell's environment. Since this consumer no longer compiles
# tinyactors-core's sources itself, CFLAGS here never reaches core's code at
# all -- only this module's own .c files. Linking dist/lib/release/... (see
# CORE_DIST_LIBRARY above) is what restores -O2 for core's code specifically:
# the "release" profile is defined as -O2, independent of whatever $CFLAGS
# this host itself happens to be invoked with.
def link(name, binary, command, inputs, tool_id)
  root = ROOT
  key = Cache.digest(command.map { |part| part.start_with?(root.to_s) ? part.delete_prefix("#{root}/") : part }.join(' '),
                     tool_id, inputs)
  cache_name = "link-#{name}"
  if binary.file? && Cache.stamped?(cache_name, key)
    puts "#{name}: cached (link inputs unchanged)"
    return
  end
  Cache.unstamp(cache_name)
  run(*command)
  Cache.stamp(cache_name, key)
end

host_sources = [
  ROOT.join('src/main.c'),
  ROOT.join('src/rpc.c'),
  ROOT.join('src/server.c'),
  ROOT.join('src/json_datamodel.c'),
  ROOT.join('src/ecmascript_datamodel.c'),
  ROOT.join('src/value_codec.c'),
  ROOT.join('src/allocator.c'),
  ROOT.join('src/binding.c'),
  ROOT.join('src/adapters.c'),
  ROOT.join('src/instruments.c'),
  SCXML.join('src/ta_scxml.c'),
  BUILD.join('gen/ta_rpc.c')
]
host_binary = BUILD.join('tinyactors-test')
host_command = [
  *compiler,
  *flags,
  "-I#{ROOT.join('src')}",
  "-I#{BUILD.join('gen')}",
  "-I#{PREFIX.join('include')}",
  "-I#{JQ_BUILD.join('src')}",
  "-I#{CORE_DIST_INCLUDE}",
  "-I#{SCXML.join('include')}",
  "-I#{XML_DIST_INCLUDE}",
  *host_sources.map(&:to_s),
  CORE_DIST_LIBRARY.to_s,
  XML_DIST_LIBRARY.to_s,
  libjq.to_s,
  libonig.to_s,
  libqjs.to_s,
  '-lm',
  '-lpthread',
  '-o',
  host_binary.to_s
]
link('tinyactors-test', host_binary, host_command,
     [*host_sources, CORE_DIST_HEADER, CORE_DIST_LIBRARY, SCXML.join('include/ta_scxml.h'),
      XML_DIST_INCLUDE.join('txml.h'), XML_DIST_LIBRARY, libjq, libonig, libqjs], compiler_id)

json_binary = BUILD.join('json_datamodel_test')
json_sources = [
  ROOT.join('tests/json_datamodel_test.c'),
  ROOT.join('src/json_datamodel.c'),
  ROOT.join('src/allocator.c')
]
json_command = [
  *compiler,
  *flags,
  "-I#{ROOT.join('src')}",
  "-I#{PREFIX.join('include')}",
  "-I#{JQ_BUILD.join('src')}",
  "-I#{CORE_DIST_INCLUDE}",
  *json_sources.map(&:to_s),
  CORE_DIST_LIBRARY.to_s,
  libjq.to_s,
  libonig.to_s,
  '-lm',
  '-o',
  json_binary.to_s
]
link('json_datamodel_test', json_binary, json_command,
     [*json_sources, CORE_DIST_HEADER, CORE_DIST_LIBRARY, libjq, libonig], compiler_id)

ecma_binary = BUILD.join('ecmascript_datamodel_test')
ecma_sources = [
  ROOT.join('tests/ecmascript_datamodel_test.c'),
  ROOT.join('src/ecmascript_datamodel.c'),
  ROOT.join('src/allocator.c')
]
ecma_command = [
  *compiler,
  *flags,
  "-I#{ROOT.join('src')}",
  "-I#{PREFIX.join('include')}",
  "-I#{CORE_DIST_INCLUDE}",
  *ecma_sources.map(&:to_s),
  CORE_DIST_LIBRARY.to_s,
  libqjs.to_s,
  '-lm',
  '-lpthread',
  '-o',
  ecma_binary.to_s
]
link('ecmascript_datamodel_test', ecma_binary, ecma_command,
     [*ecma_sources, CORE_DIST_HEADER, CORE_DIST_LIBRARY, libqjs], compiler_id)

# The population benchmark (tests/scale_test.c): core, with core's null data
# model, and nothing else, so what it measures is core's own per-actor cost.
scale_binary = BUILD.join('scale_test')
scale_sources = [
  ROOT.join('tests/scale_test.c'),
  ROOT.join('src/allocator.c')
]
scale_command = [
  *compiler,
  *flags,
  "-I#{ROOT.join('src')}",
  "-I#{CORE_DIST_INCLUDE}",
  *scale_sources.map(&:to_s),
  CORE_DIST_LIBRARY.to_s,
  '-o',
  scale_binary.to_s
]
link('scale_test', scale_binary, scale_command,
     [*scale_sources, CORE_DIST_HEADER, CORE_DIST_LIBRARY], compiler_id)
