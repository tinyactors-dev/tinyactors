#!/usr/bin/env ruby
#MISE description="Build the tinyactors-test JSON-RPC host"
# mise skips this task when both binaries are newer than every source below.
# The sources include core's src/ and api/ so edits there re-run the
# amalgamate/api --check steps. Use `mise run --force build` after changing CC/CFLAGS.
#MISE sources=["mise/tasks/build", "mise/tasks/bindings", "mise/lib/**/*", "bindings.rb", "src/**/*.c", "src/**/*.h", "tests/**/*.c", "build/prefix/lib/*.a", "../tinyactors-core/include/**/*", "../tinyactors-core/src/**/*", "../tinyactors-core/mise/lib/**/*", "../tinyactors-core/mise/tasks/amalgamate", "../tinyactors-core/mise/tasks/api"]
#MISE outputs=["build/tinyactors-test", "build/json_datamodel_test", "build/ecmascript_datamodel_test"]

require 'fileutils'
require 'pathname'
require 'shellwords'

ROOT = Pathname.new(__dir__).join('../..').expand_path
WORKSPACE = ROOT.parent
JQ_SOURCE = ROOT.join('vendor/jq')
QUICKJS_SOURCE = ROOT.join('vendor/quickjs-ng')
BUILD = ROOT.join('build')
JQ_BUILD = BUILD.join('jq')
QUICKJS_BUILD = BUILD.join('quickjs-ng')
PREFIX = BUILD.join('prefix')

def run(*command, chdir: ROOT)
  puts command.shelljoin
  pid = Process.spawn(*command, chdir: chdir.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

unless JQ_SOURCE.join('.tinyactors-vendor-version').file?
  run('mise', 'run', 'vendor-jq', chdir: WORKSPACE)
end

libjq = PREFIX.join('lib/libjq.a')
libonig = PREFIX.join('lib/libonig.a')
unless libjq.file? && libonig.file?
  FileUtils.mkdir_p(JQ_BUILD)
  unless JQ_BUILD.join('Makefile').file?
    run(
      JQ_SOURCE.join('configure').to_s,
      '--disable-shared',
      '--enable-static',
      '--disable-docs',
      '--with-oniguruma=builtin',
      "--prefix=#{PREFIX}",
      chdir: JQ_BUILD
    )
  end
  run('make', '-j2', 'install', chdir: JQ_BUILD)
end

unless QUICKJS_SOURCE.join('.tinyactors-vendor-version').file?
  run('mise', 'run', 'vendor-quickjs', chdir: WORKSPACE)
end

# quickjs-ng is compiled straight from its library sources (the same set as
# its CMake `qjs` target without quickjs-libc) with its own flags; it does not
# build under the host's -Werror -pedantic. Like jq, this only runs when the
# archive or its installed header is missing.
libqjs = PREFIX.join('lib/libqjs.a')
quickjs_header = PREFIX.join('include/quickjs.h')
unless libqjs.file? && quickjs_header.file?
  FileUtils.rm_rf(QUICKJS_BUILD)
  FileUtils.mkdir_p(QUICKJS_BUILD)
  FileUtils.mkdir_p(libqjs.dirname)
  FileUtils.mkdir_p(quickjs_header.dirname)
  quickjs_compiler = Shellwords.split(ENV.fetch('CC', 'cc'))
  quickjs_flags = %w[
    -std=gnu11 -O2 -funsigned-char -D_GNU_SOURCE -DQUICKJS_NG_BUILD
    -Wno-implicit-fallthrough -Wno-sign-compare -Wno-unused-parameter
  ]
  objects = %w[dtoa libregexp libunicode quickjs].map do |name|
    object = QUICKJS_BUILD.join("#{name}.o")
    run(*quickjs_compiler, *quickjs_flags, "-I#{QUICKJS_SOURCE}", '-c',
        QUICKJS_SOURCE.join("#{name}.c").to_s, '-o', object.to_s)
    object
  end
  FileUtils.rm_f(libqjs)
  run('ar', 'rcs', libqjs.to_s, *objects.map(&:to_s))
  FileUtils.cp(QUICKJS_SOURCE.join('quickjs.h'), quickjs_header)
end

run('mise', 'run', 'amalgamate', '--check', chdir: WORKSPACE.join('tinyactors-core'))
run('mise', 'run', 'api', '--check', chdir: WORKSPACE.join('tinyactors-core'))
# bindings is cached by mise's own stamp, which survives `rm -rf build`; force it
# when its outputs are gone.
generated = %w[ta_rpc.c ta_rpc.h].map { |name| BUILD.join('gen', name) }
run('mise', 'run', *(generated.all?(&:file?) ? [] : ['--force']), 'bindings', chdir: ROOT)

compiler = Shellwords.split(ENV.fetch('CC', 'cc'))
flags = Shellwords.split(ENV.fetch('CFLAGS', '-std=c11 -Wall -Wextra -Werror -pedantic -O2'))
sources = [
  ROOT.join('src/main.c'),
  ROOT.join('src/rpc.c'),
  ROOT.join('src/server.c'),
  ROOT.join('src/json_datamodel.c'),
  ROOT.join('src/ecmascript_datamodel.c'),
  ROOT.join('src/scxml_target.c'),
  ROOT.join('src/value_codec.c'),
  ROOT.join('src/allocator.c'),
  ROOT.join('src/binding.c'),
  ROOT.join('src/adapters.c'),
  ROOT.join('src/instruments.c'),
  BUILD.join('gen/ta_rpc.c'),
  WORKSPACE.join('tinyactors-core/include/tinyactors.c')
]
libraries = [libjq, libonig]

run(
  *compiler,
  *flags,
  "-I#{ROOT.join('src')}",
  "-I#{BUILD.join('gen')}",
  "-I#{PREFIX.join('include')}",
  "-I#{JQ_BUILD.join('src')}",
  "-I#{WORKSPACE.join('tinyactors-core/include')}",
  *sources.map(&:to_s),
  *libraries.map(&:to_s),
  libqjs.to_s,
  '-lm',
  '-lpthread',
  '-o',
  BUILD.join('tinyactors-test').to_s
)

run(
  *compiler,
  *flags,
  "-I#{ROOT.join('src')}",
  "-I#{PREFIX.join('include')}",
  "-I#{JQ_BUILD.join('src')}",
  "-I#{WORKSPACE.join('tinyactors-core/include')}",
  ROOT.join('tests/json_datamodel_test.c').to_s,
  ROOT.join('src/json_datamodel.c').to_s,
  ROOT.join('src/allocator.c').to_s,
  WORKSPACE.join('tinyactors-core/include/tinyactors.c').to_s,
  *libraries.map(&:to_s),
  '-lm',
  '-o',
  BUILD.join('json_datamodel_test').to_s
)

run(
  *compiler,
  *flags,
  "-I#{ROOT.join('src')}",
  "-I#{PREFIX.join('include')}",
  "-I#{WORKSPACE.join('tinyactors-core/include')}",
  ROOT.join('tests/ecmascript_datamodel_test.c').to_s,
  ROOT.join('src/ecmascript_datamodel.c').to_s,
  ROOT.join('src/scxml_target.c').to_s,
  ROOT.join('src/allocator.c').to_s,
  WORKSPACE.join('tinyactors-core/include/tinyactors.c').to_s,
  libqjs.to_s,
  '-lm',
  '-lpthread',
  '-o',
  BUILD.join('ecmascript_datamodel_test').to_s
)
