#!/usr/bin/env ruby
#MISE description="Run tinyactors-test Ruby scenarios (args: [-n PATTERN] [SCENARIO_FILE...])"
#MISE depends=["build"]
# The build is content-gated, so this costs a few hashes when nothing
# changed, and a kernel or core edit reaches the scenarios without a
# separate `mise run build`.

require 'pathname'

root = Pathname.new(__dir__).join('../..').expand_path
exec('ruby', root.join('ruby/run_scenarios.rb').to_s, *ARGV)
