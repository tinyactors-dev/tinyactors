{
  "description": "A console send waits in the mailbox while the system is stopped; entry and exit breakpoints stop before the block's first unit, at the microstep's start (core ADR 0087); stepIn by statement goes into a <foreach> without stopping twice at its position (ADR 0083, open point 1), and a <log> writes `label: value`; stepOut leaves the block and, as it was the macrostep's last, ends the macrostep, whose summary is one output; next finishes a microstep's only block",
  "chart": "counter",
  "only": "test",
  "why": "it stops and steps; napi's adapter never stops a live actor (napi ADR 0027)",
  "steps": [
    { "start": true },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" } } ] } }
    },
    {
      "request": "setFunctionBreakpoints", "arguments": { "breakpoints": [ { "name": "busy" }, { "name": "exit:busy" } ] },
      "response": { "body": { "breakpoints": [
        { "id": { "$capture": "entry" }, "verified": true },
        { "id": { "$capture": "exit" }, "verified": true }
      ] } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "send bump {\"n\": 1}", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": { "$text": "sent bump to {title}; it waits in the mailbox (1 message): continue or step to deliver it" } } }
    },
    { "request": "continue", "arguments": { "threadId": { "$var": "thread" } } },
    {
      "event": "stopped",
      "body": { "reason": "function breakpoint", "threadId": { "$var": "thread" }, "description": "entered busy", "hitBreakpointIds": [ { "$var": "entry" } ] }
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": { "$prefix": [
        { "name": "log 1", "id": { "$capture": "frame" } },
        { "name": "onentry of busy" },
        { "name": { "$prefix": "microstep 2.1" } },
        { "name": "macrostep 2 on bump" }
      ] } } }
    },
    {
      "request": "scopes", "arguments": { "frameId": { "$var": "frame" } },
      "response": { "body": { "scopes": { "$prefix": [ { "name": "Data model" }, { "name": "Event", "variablesReference": { "$capture": "event" } } ] } } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "event" } },
      "response": { "body": { "variables": { "$some": { "name": "name", "value": "\"bump\"" } } } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "event" } },
      "response": { "body": { "variables": { "$some": { "name": "data", "value": "{\"n\":1}" } } } }
    },
    {
      "request": "evaluate", "arguments": { "expression": { "$expr": { "jq": "[.count, .last]", "js": "[count, last]" } }, "context": "watch", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "[1,{\"n\":1}]" } }
    },
    { "request": "stepIn", "arguments": { "threadId": { "$var": "thread" } } },
    {
      "events": [
        { "event": "stopped", "body": { "reason": "step", "threadId": { "$var": "thread" } } },
        { "event": "output", "body": { "category": "stdout", "output": "busy: 1\n" } }
      ]
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": { "$prefix": [ { "name": "foreach 2 iteration 1" }, { "name": "onentry of busy" } ] } } }
    },
    { "request": "stepIn", "arguments": { "threadId": { "$var": "thread" } } },
    { "event": "stopped", "body": { "reason": "step" } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": { "$prefix": [ { "name": "assign 1" }, { "name": "foreach 2 iteration 1" }, { "name": "onentry of busy" } ] } } }
    },
    { "request": "stepIn", "arguments": { "threadId": { "$var": "thread" } } },
    { "event": "stopped", "body": { "reason": "step" } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": { "$prefix": [ { "name": "foreach 2 iteration 2", "id": { "$capture": "frame" } }, { "name": "onentry of busy" } ] } } }
    },
    {
      "request": "evaluate", "arguments": { "expression": ".count", "context": "watch", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "2" } }
    },
    { "request": "stepOut", "arguments": { "threadId": { "$var": "thread" } } },
    { "event": "stopped", "body": { "reason": "step" } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "totalFrames": 1, "stackFrames": [ { "name": "idle in busy (held; 0 messages waiting)", "id": { "$capture": "frame" } } ] } }
    },
    {
      "request": "evaluate", "arguments": { "expression": ".count", "context": "watch", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "4" } }
    },
    {
      "request": "threads",
      "response": { "body": { "threads": { "$some": { "id": { "$var": "thread" }, "name": { "$text": "{title} · busy" } } } } }
    },
    { "request": "evaluate", "arguments": { "expression": "send done", "context": "repl", "frameId": { "$var": "frame" } } },
    { "request": "continue", "arguments": { "threadId": { "$var": "thread" } } },
    {
      "event": "stopped",
      "body": { "reason": "function breakpoint", "description": "exited busy", "hitBreakpointIds": [ { "$var": "exit" } ] }
    },
    {
      "event": "output",
      "body": { "category": "console", "output": { "$expr": {
        "jq": { "$text": "{title} macrostep 2: bump {\"n\":1}\n  idle → busy on bump\n    assign .count = 1\n    assign .last = {\"n\":1}\n    assign .count = 2\n    assign .count = 4\n  now in busy\n" },
        "js": { "$text": "{title} macrostep 2: bump {\"n\":1}\n  idle → busy on bump\n    assign count = 1\n    assign last = {\"n\":1}\n    assign count = 2\n    assign count = 4\n  now in busy\n" }
      } } }
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": { "$prefix": [
        { "name": "log 1" },
        { "name": "onexit of busy" },
        { "name": { "$prefix": "microstep 3.1" } },
        { "name": "macrostep 3 on done" }
      ] } } }
    },
    { "request": "next", "arguments": { "threadId": { "$var": "thread" } } },
    {
      "events": [
        { "event": "stopped", "body": { "reason": "step" } },
        { "event": "output", "body": { "category": "stdout", "output": "leaving: 4\n" } }
      ]
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "totalFrames": 1, "stackFrames": [ { "name": "idle in idle (held; 0 messages waiting)" } ] } }
    }
  ]
}
