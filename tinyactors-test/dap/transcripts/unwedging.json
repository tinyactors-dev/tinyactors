{
  "description": "A macrostep that never ends: a transition breakpoint with a hit condition stops it at a microstep's start; stepIn runs that microstep's only unit and stops at the next one's start (core ADR 0087); a goto and an event sent meanwhile wait in the mailbox; abandon ends the macrostep (core ADR 0082) and the system stops again; on continue the actor takes the jump, then the event; goto of a resting actor with nothing waiting, from the console and from gotoTargets, runs an operator transition now and stops with reason goto",
  "chart": "spinner",
  "only": "test",
  "why": "it stops at a breakpoint inside a runaway macrostep and steps; napi's adapter never stops a live actor (napi ADR 0027)",
  "steps": [
    { "start": true },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" } } ] } }
    },
    {
      "request": "setFunctionBreakpoints", "arguments": { "breakpoints": [ { "name": "spinning → spinning", "hitCondition": "3" } ] },
      "response": { "body": { "breakpoints": [ { "id": { "$capture": "spin" }, "verified": true } ] } }
    },
    { "request": "evaluate", "arguments": { "expression": "send spin", "context": "repl", "frameId": { "$var": "frame" } } },
    { "request": "continue", "arguments": { "threadId": { "$var": "thread" } } },
    {
      "event": "stopped",
      "body": { "reason": "function breakpoint", "description": "spinning → spinning", "hitBreakpointIds": [ { "$var": "spin" } ] }
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": { "$prefix": [
        { "name": "assign 1", "id": { "$capture": "frame" } },
        { "name": "transition spinning → spinning" },
        { "name": { "$prefix": "microstep 2.4" } },
        { "name": "macrostep 2 on spin" }
      ] } } }
    },
    {
      "request": "evaluate", "arguments": { "expression": ".n", "context": "watch", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "2" } }
    },
    { "request": "setFunctionBreakpoints", "arguments": { "breakpoints": [] } },
    { "request": "stepIn", "arguments": { "threadId": { "$var": "thread" } } },
    { "event": "stopped", "body": { "reason": "step" } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": { "$prefix": [
        { "name": "assign 1", "id": { "$capture": "frame" } },
        { "name": "transition spinning → spinning" },
        { "name": { "$prefix": "microstep 2.5" } },
        { "name": "macrostep 2 on spin" }
      ] } } }
    },
    {
      "request": "evaluate", "arguments": { "expression": ".n", "context": "watch", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "3" } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "goto resting", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": { "$text": "{title}: goto resting queued; it waits in the mailbox (1 message): continue or step to deliver it" } } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "send poke", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": { "$text": "sent poke to {title}; it waits in the mailbox (2 messages): continue or step to deliver it" } } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "abandon", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": { "$text": "{title}: abandoned macrostep 2; it keeps the configuration after its last completed microstep" } } }
    },
    {
      "event": "stopped",
      "body": { "reason": "pause", "threadId": { "$var": "thread" }, "description": "its macrostep was abandoned" }
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "totalFrames": 1, "stackFrames": [ { "id": { "$capture": "frame" }, "name": "idle in spinning (held; 2 messages waiting)" } ] } }
    },
    {
      "request": "evaluate", "arguments": { "expression": ".n", "context": "watch", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "4" } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "abandon", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "success": false, "message": { "$text": "{title} has no macrostep to abandon" } }
    },
    { "request": "setFunctionBreakpoints", "arguments": { "breakpoints": [ { "name": "on:poke" } ] } },
    { "request": "continue", "arguments": { "threadId": { "$var": "thread" } } },
    {
      "event": "stopped",
      "body": { "reason": "function breakpoint", "threadId": { "$var": "thread" }, "description": "about to take poke" }
    },
    {
      "request": "threads",
      "response": { "body": { "threads": { "$some": { "id": { "$var": "thread" }, "name": { "$text": "{title} · resting" } } } } }
    },
    { "request": "setFunctionBreakpoints", "arguments": { "breakpoints": [] } },
    { "request": "stepIn", "arguments": { "threadId": { "$var": "thread" } } },
    { "event": "stopped", "body": { "reason": "step", "threadId": { "$var": "thread" } } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" }, "name": "idle in resting (held; 0 messages waiting)" } ] } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "goto nowhere", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "success": false, "message": "nowhere is not a state of the chart" }
    },
    {
      "request": "evaluate", "arguments": { "expression": "goto resting", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": { "$text": "{title}: goto resting" } } }
    },
    { "event": "stopped", "body": { "reason": "goto", "threadId": { "$var": "thread" }, "description": "the jump's macrostep ended" } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "name": "idle in resting (held; 0 messages waiting)" } ] } }
    },
    {
      "request": "gotoTargets", "arguments": { "source": {} },
      "response": { "body": { "targets": [ { "label": "resting", "id": { "$capture": "resting" } }, { "label": "spinning" } ] } }
    },
    { "request": "goto", "arguments": { "threadId": { "$var": "thread" }, "targetId": { "$var": "resting" } } },
    {
      "events": [
        { "event": "stopped", "body": { "reason": "goto", "threadId": { "$var": "thread" }, "description": "the jump's macrostep ended" } },
        { "event": "output", "body": { "category": "console", "output": { "$text": "{title}: goto resting\n" } } }
      ]
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "name": "idle in resting (held; 0 messages waiting)" } ] } }
    }
  ]
}
