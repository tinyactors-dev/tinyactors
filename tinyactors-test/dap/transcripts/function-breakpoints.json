{
  "description": "Function breakpoints by name: a condition in the data model that does not hold does not stop; a transition named source → target with a hit condition stops at its second hit, before the transition's content, at the microstep's start (core ADR 0086)",
  "chart": "counter",
  "only": "test",
  "why": "function breakpoints stop; napi's adapter never stops a live actor, where they are tracepoints (napi ADR 0026)",
  "steps": [
    { "start": true },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" } } ] } }
    },
    {
      "request": "setFunctionBreakpoints",
      "arguments": { "breakpoints": [
        { "name": "busy", "condition": { "$expr": { "jq": ".count > 100", "js": "count > 100" } } },
        { "name": "idle -> busy", "hitCondition": "2" },
        { "name": "on:done" }
      ] },
      "response": { "body": { "breakpoints": [
        { "verified": true },
        { "id": { "$capture": "transition" }, "verified": true },
        { "id": { "$capture": "done" }, "verified": true }
      ] } }
    },
    { "request": "evaluate", "arguments": { "expression": "send bump", "context": "repl", "frameId": { "$var": "frame" } } },
    { "request": "evaluate", "arguments": { "expression": "send done", "context": "repl", "frameId": { "$var": "frame" } } },
    { "request": "continue", "arguments": { "threadId": { "$var": "thread" } } },
    {
      "event": "stopped",
      "body": { "reason": "function breakpoint", "description": "about to take done", "hitBreakpointIds": [ { "$var": "done" } ] }
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" } } ] } }
    },
    {
      "request": "evaluate", "arguments": { "expression": ".count", "context": "watch", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "4" } }
    },
    { "request": "evaluate", "arguments": { "expression": "send bump", "context": "repl", "frameId": { "$var": "frame" } } },
    { "request": "continue", "arguments": { "threadId": { "$var": "thread" } } },
    {
      "event": "stopped",
      "body": { "reason": "function breakpoint", "description": "idle → busy", "hitBreakpointIds": [ { "$var": "transition" } ] }
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": { "$prefix": [
        { "name": "assign 1" },
        { "name": "transition idle → busy on bump" },
        { "name": { "$prefix": "microstep 4.1" } },
        { "name": "macrostep 4 on bump" }
      ] } } }
    }
  ]
}
