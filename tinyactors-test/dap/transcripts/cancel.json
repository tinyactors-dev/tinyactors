{
  "description": "The Timers scope lists a pending delayed send by the ID its chart gave it; cancel withdraws it by that ID (core ADR 0084), and a second cancel finds nothing",
  "chart": "counter",
  "steps": [
    { "start": true },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" } } ] } }
    },
    { "request": "setFunctionBreakpoints", "arguments": { "breakpoints": [ { "name": "on:remind" } ] } },
    { "request": "evaluate", "arguments": { "expression": "send remind", "context": "repl", "frameId": { "$var": "frame" } } },
    { "request": "continue", "arguments": { "threadId": { "$var": "thread" } } },
    { "event": "stopped", "body": { "reason": "function breakpoint", "description": "about to take remind" } },
    { "request": "stepIn", "arguments": { "threadId": { "$var": "thread" } } },
    { "event": "stopped", "body": { "reason": "step" } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": { "$prefix": [ { "name": "send 1" }, { "name": "transition idle on remind" } ] } } }
    },
    { "request": "stepIn", "arguments": { "threadId": { "$var": "thread" } } },
    { "event": "stopped", "body": { "reason": "step" } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" }, "name": { "$prefix": "idle in idle" } } ] } }
    },
    {
      "request": "scopes", "arguments": { "frameId": { "$var": "frame" } },
      "response": { "body": { "scopes": { "$some": { "name": "Timers", "variablesReference": { "$capture": "timers" } } } } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "timers" } },
      "response": { "body": { "variables": [ { "name": "nudge", "variablesReference": { "$capture": "timer" } } ] } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "timer" } },
      "response": { "body": { "variables": { "$prefix": [ { "name": "event", "value": "\"tick\"" } ] } } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "timer" } },
      "response": { "body": { "variables": { "$some": { "name": "due", "value": "60000" } } } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "cancel nudge", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": { "$contains": "withdrew send nudge" } } }
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" } } ] } }
    },
    {
      "request": "scopes", "arguments": { "frameId": { "$var": "frame" } },
      "response": { "body": { "scopes": { "$some": { "name": "Timers", "variablesReference": { "$capture": "timers" } } } } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "timers" } },
      "response": { "body": { "variables": [] } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "cancel nudge", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "success": false, "message": { "$contains": "no pending send nudge" } }
    }
  ]
}
