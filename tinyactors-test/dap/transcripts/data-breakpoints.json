{
  "description": "A data-model location can be watched for writes, named from the Variables pane or by an expression; an <assign> to it stops with reason data breakpoint; reads cannot be watched, and other scopes have no locations",
  "chart": "counter",
  "steps": [
    { "start": true },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" } } ] } }
    },
    {
      "request": "scopes", "arguments": { "frameId": { "$var": "frame" } },
      "response": { "body": { "scopes": { "$prefix": [
        { "name": "Data model", "variablesReference": { "$capture": "data" } },
        { "name": "Event", "variablesReference": { "$capture": "event" } }
      ] } } }
    },
    {
      "request": "dataBreakpointInfo", "arguments": { "variablesReference": { "$var": "data" }, "name": "count" },
      "response": { "body": { "dataId": { "$capture": "count" }, "accessTypes": [ "write" ] } }
    },
    {
      "request": "dataBreakpointInfo", "arguments": { "name": ".items[1]", "frameId": { "$var": "frame" } },
      "response": { "body": { "dataId": { "$text": "{title} [\"items\",1]" }, "description": { "$text": "{title} .items[1]" } } }
    },
    {
      "request": "dataBreakpointInfo", "arguments": { "variablesReference": { "$var": "event" }, "name": "name" },
      "response": { "body": { "dataId": null } }
    },
    {
      "request": "setDataBreakpoints", "arguments": { "breakpoints": [ { "dataId": { "$var": "count" }, "accessType": "read" } ] },
      "response": { "body": { "breakpoints": [ { "verified": false } ] } }
    },
    {
      "request": "setDataBreakpoints", "arguments": { "breakpoints": [ { "dataId": { "$var": "count" } } ] },
      "response": { "body": { "breakpoints": [ { "id": { "$capture": "watch" }, "verified": true } ] } }
    },
    { "request": "evaluate", "arguments": { "expression": "send bump", "context": "repl", "frameId": { "$var": "frame" } } },
    { "request": "continue", "arguments": { "threadId": { "$var": "thread" } } },
    {
      "event": "stopped",
      "body": { "reason": "data breakpoint", "threadId": { "$var": "thread" }, "description": { "$prefix": "count = 1" }, "hitBreakpointIds": [ { "$var": "watch" } ] }
    }
  ]
}
