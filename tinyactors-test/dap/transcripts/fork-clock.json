{
  "description": "fork copies the actor into a system of its own (core ADR 0085) with its own clock: the copy keeps the pending delayed send, clock moves the fork's time, and what falls due runs in the fork. napi attaches live here, since fork is a console command of a live session",
  "chart": "counter",
  "only": "test",
  "why": "napi's adapter has no forks (napi ADR 0027)",
  "steps": [
    { "start": true },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" } } ] } }
    },
    { "request": "setFunctionBreakpoints", "arguments": { "breakpoints": [ { "name": "on:ping" } ] } },
    { "request": "evaluate", "arguments": { "expression": "send remind", "context": "repl", "frameId": { "$var": "frame" } } },
    { "request": "evaluate", "arguments": { "expression": "send ping", "context": "repl", "frameId": { "$var": "frame" } } },
    { "request": "continue", "arguments": { "threadId": { "$var": "thread" } } },
    { "event": "stopped", "body": { "reason": "function breakpoint", "description": "about to take ping" } },
    { "request": "setFunctionBreakpoints", "arguments": { "breakpoints": [ { "name": "on:tick" } ] } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" } } ] } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "fork", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": { "$contains": "fork" } } }
    },
    {
      "request": "threads",
      "response": { "body": { "threads": { "$some": { "id": { "$capture": "fork" }, "name": { "$contains": "fork" } } } } }
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "fork" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" } } ] } }
    },
    {
      "request": "scopes", "arguments": { "frameId": { "$var": "frame" } },
      "response": { "body": { "scopes": { "$some": { "name": "Timers", "variablesReference": { "$capture": "timers" } } } } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "timers" } },
      "response": { "body": { "variables": [ { "name": "nudge" } ] } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "clock 60s", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "success": false }
    },
    {
      "request": "evaluate", "arguments": { "expression": "clock +60s", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": { "$prefix": "t=60000ms" } } }
    },
    { "request": "continue", "arguments": { "threadId": { "$var": "fork" } } },
    {
      "event": "stopped",
      "body": { "reason": "function breakpoint", "threadId": { "$var": "fork" }, "description": "about to take tick" }
    },
    { "request": "stepIn", "arguments": { "threadId": { "$var": "fork" } } },
    { "event": "stopped", "body": { "reason": "step", "threadId": { "$var": "fork" } } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "fork" } },
      "response": { "body": { "stackFrames": { "$prefix": [ { "name": "assign 1" }, { "name": "transition idle on tick (internal)" } ] } } }
    },
    { "request": "stepIn", "arguments": { "threadId": { "$var": "fork" } } },
    { "event": "stopped", "body": { "reason": "step", "threadId": { "$var": "fork" } } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "fork" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" }, "name": "idle in idle (held; 0 messages waiting)" } ] } }
    },
    {
      "request": "evaluate", "arguments": { "expression": ".ticks", "context": "watch", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "1" } }
    },
    {
      "request": "scopes", "arguments": { "frameId": { "$var": "frame" } },
      "response": { "body": { "scopes": { "$some": { "name": "System", "variablesReference": { "$capture": "system" } } } } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "system" } },
      "response": { "body": { "variables": { "$some": { "name": "now", "value": "60000" } } } }
    }
  ]
}
