{
  "description": "An actor at rest: one frame, the seven scopes, the data model with a container that expands, the configuration and the system variables; evaluate in the watch, hover and clipboard contexts",
  "chart": "counter",
  "steps": [
    { "start": true },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "totalFrames": 1, "stackFrames": [ { "id": { "$capture": "frame" }, "name": { "$prefix": "idle in idle" } } ] } }
    },
    {
      "request": "scopes", "arguments": { "frameId": { "$var": "frame" } },
      "response": { "body": { "scopes": [
        { "name": "Data model", "presentationHint": "locals", "variablesReference": { "$capture": "data" } },
        { "name": "Event" },
        { "name": "Configuration", "variablesReference": { "$capture": "configuration" } },
        { "name": "Queues" },
        { "name": "Timers" },
        { "name": "Invocations" },
        { "name": "System", "variablesReference": { "$capture": "system" } }
      ] } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "data" } },
      "response": { "body": { "variables": [
        { "name": "count", "value": "0", "type": "number", "variablesReference": 0, "evaluateName": ".count" },
        { "name": "it", "value": "null", "type": "null", "variablesReference": 0, "evaluateName": ".it" },
        { "name": "items", "value": "[1,2]", "type": "array", "evaluateName": ".items", "indexedVariables": 2,
          "variablesReference": { "$capture": "items" } },
        { "name": "last", "value": "null", "type": "null", "variablesReference": 0, "evaluateName": ".last" },
        { "name": "ticks", "value": "0", "type": "number", "variablesReference": 0, "evaluateName": ".ticks" }
      ] } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "items" } },
      "response": { "body": { "variables": [
        { "name": "[0]", "value": "1", "evaluateName": ".items[0]" },
        { "name": "[1]", "value": "2", "evaluateName": ".items[1]" }
      ] } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "items" }, "start": 1, "count": 1 },
      "response": { "body": { "variables": [ { "name": "[1]", "value": "2" } ] } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "configuration" } },
      "response": { "body": { "variables": [ { "name": "active", "value": "{\"idle\":{}}" } ] } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "system" } },
      "response": { "body": { "variables": { "$prefix": [
        { "name": "_sessionid", "type": "string" },
        { "name": "_name", "value": "\"counter\"" }
      ] } } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "system" } },
      "response": { "body": { "variables": { "$some": { "name": "now", "value": "0" } } } }
    },
    {
      "request": "evaluate",
      "arguments": { "expression": { "$expr": { "jq": ".count + 1", "js": "count + 1" } }, "context": "watch", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "1", "type": "number", "variablesReference": 0 } }
    },
    {
      "request": "evaluate",
      "arguments": { "expression": ".items", "context": "hover", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "[1,2]", "indexedVariables": 2, "variablesReference": { "$capture": "hovered" } } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "hovered" } },
      "response": { "body": { "variables": [ { "value": "1" }, { "value": "2" } ] } }
    },
    {
      "request": "evaluate",
      "arguments": { "expression": ".items", "context": "clipboard", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "[\n  1,\n  2\n]" } }
    },
    {
      "request": "evaluate",
      "arguments": { "expression": { "$expr": { "jq": "In(\"idle\")", "js": "inState(\"idle\")" } }, "context": "watch", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": "true" } }
    },
    {
      "request": "evaluate",
      "arguments": { "expression": { "$expr": { "jq": ".count +", "js": "count +" } }, "context": "watch", "frameId": { "$var": "frame" } },
      "response": { "success": false }
    },
    {
      "request": "variables", "arguments": { "variablesReference": 9999 },
      "response": { "success": false }
    }
  ]
}
