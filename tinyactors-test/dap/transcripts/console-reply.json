{
  "description": "The console sends an event with the debug origin: it waits in the actor's mailbox while the system is stopped, and the Queues scope shows it; an on: breakpoint stops before the macrostep that takes it; a step lands at the microstep's start, before its <send>; the chart's reply to the event's origin comes back to the console",
  "chart": "counter",
  "steps": [
    { "start": true },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" } } ] } }
    },
    {
      "request": "setFunctionBreakpoints", "arguments": { "breakpoints": [ { "name": "on:ping" } ] },
      "response": { "body": { "breakpoints": [ { "id": { "$capture": "on" }, "verified": true } ] } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "send ping", "context": "repl", "frameId": { "$var": "frame" } },
      "response": { "body": { "result": { "$text": "sent ping to {title}; it waits in the mailbox (1 message): continue or step to deliver it" } } }
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "id": { "$capture": "frame" }, "name": "idle in idle (held; 1 message waiting)" } ] } }
    },
    {
      "request": "scopes", "arguments": { "frameId": { "$var": "frame" } },
      "response": { "body": { "scopes": { "$some": { "name": "Queues", "variablesReference": { "$capture": "queues" } } } } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "queues" } },
      "response": { "body": { "variables": [
        { "name": "internal", "value": "[]" },
        { "name": "current", "value": "null" },
        { "name": "mailbox", "indexedVariables": 1, "variablesReference": { "$capture": "mailbox" } }
      ] } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "mailbox" } },
      "response": { "body": { "variables": [ { "name": "[0]", "variablesReference": { "$capture": "message" } } ] } }
    },
    {
      "request": "variables", "arguments": { "variablesReference": { "$var": "message" } },
      "response": { "body": { "variables": [
        { "name": "event", "value": "\"ping\"" },
        { "name": "from", "value": "\"this console\"" }
      ] } }
    },
    { "request": "continue", "arguments": { "threadId": { "$var": "thread" } } },
    {
      "event": "stopped",
      "body": { "reason": "function breakpoint", "threadId": { "$var": "thread" }, "description": "about to take ping", "hitBreakpointIds": [ { "$var": "on" } ] }
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "name": "about to take ping (before transition selection)" } ] } }
    },
    {
      "request": "exceptionInfo", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "success": false, "message": { "$text": "{title} did not stop for an exception" } }
    },
    { "request": "stepIn", "arguments": { "threadId": { "$var": "thread" } } },
    { "event": "stopped", "body": { "reason": "step" } },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": { "$prefix": [
        { "name": "send 1" },
        { "name": "transition idle on ping (internal)" },
        { "name": { "$prefix": "microstep 2.1" } },
        { "name": "macrostep 2 on ping" }
      ] } } }
    },
    { "request": "stepIn", "arguments": { "threadId": { "$var": "thread" } } },
    {
      "events": [
        { "event": "stopped", "body": { "reason": "step" } },
        { "event": "output", "body": { "category": "console", "output": { "$text": "{title} replied pong 0\n" } } }
      ]
    },
    {
      "request": "stackTrace", "arguments": { "threadId": { "$var": "thread" } },
      "response": { "body": { "stackFrames": [ { "name": "idle in idle (held; 0 messages waiting)" } ] } }
    },
    {
      "request": "evaluate", "arguments": { "expression": "send", "context": "repl" },
      "response": { "success": false }
    }
  ]
}
