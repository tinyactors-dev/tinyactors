#!/usr/bin/env ruby
# frozen_string_literal: true

# The interactive test workbench: a live tinyactors system whose charts are
# read from a directory on disk and hot-reloaded when they change.
#
#   cd somewhere/with/charts && /path/to/tinyactors-test/bin/workbench
#
# See ruby/workbench/README.md.
require_relative '../ruby/workbench'

Workbench::App.main(ARGV)
