#!/usr/bin/env ruby
#MISE description="Package the extension as build/tinyactors-vscode.vsix, to install with `code --install-extension`"
#MISE alias="package"
#MISE sources=["package.json", "README.md", "lib/**/*.js", "mise/tasks/build"]
#MISE outputs=["build/tinyactors-vscode.vsix"]
# vim:ft=ruby

# A .vsix is a zip archive: the extension's files under extension/, a
# manifest that repeats what package.json says in the Visual Studio
# gallery's XML, and the content types of the files. This writes the same
# archive `vsce package` does for an extension with no dependencies and
# nothing to compile, without fetching vsce, and with the same bytes each
# time (every entry is dated 1980-01-01).

require 'json'
require 'pathname'
require 'zlib'

ROOT = Pathname.new(__dir__).join('../..').expand_path
OUTPUT = ROOT.join('build/tinyactors-vscode.vsix')

manifest = JSON.parse(ROOT.join('package.json').read)
abort 'tinyactors-vscode: package.json has dependencies; this packager copies no node_modules' if manifest['dependencies']

def xml(text)
  text.to_s.gsub('&', '&amp;').gsub('<', '&lt;').gsub('>', '&gt;').gsub('"', '&quot;').gsub("'", '&apos;')
end

files = %w[package.json README.md] + Dir.glob('lib/**/*.js', base: ROOT.to_s).sort
entries = files.map { |file| ["extension/#{file}", ROOT.join(file).binread] }

vsix_manifest = <<~XML
  <?xml version="1.0" encoding="utf-8"?>
  <PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
      <Identity Language="en-US" Id="#{xml(manifest.fetch('name'))}" Version="#{xml(manifest.fetch('version'))}" Publisher="#{xml(manifest.fetch('publisher'))}" />
      <DisplayName>#{xml(manifest.fetch('displayName'))}</DisplayName>
      <Description xml:space="preserve">#{xml(manifest.fetch('description'))}</Description>
      <Tags>#{xml(manifest.fetch('categories').map(&:downcase).join(','))}</Tags>
      <Categories>#{xml(manifest.fetch('categories').join(','))}</Categories>
      <GalleryFlags>Public</GalleryFlags>
      <Properties>
        <Property Id="Microsoft.VisualStudio.Code.Engine" Value="#{xml(manifest.dig('engines', 'vscode'))}" />
        <Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value="" />
        <Property Id="Microsoft.VisualStudio.Code.ExtensionPack" Value="" />
        <Property Id="Microsoft.VisualStudio.Code.ExtensionKind" Value="workspace" />
        <Property Id="Microsoft.VisualStudio.Code.LocalizedLanguages" Value="" />
        <Property Id="Microsoft.VisualStudio.Code.ExecutesCode" Value="true" />
        <Property Id="Microsoft.VisualStudio.Services.GitHubFlavoredMarkdown" Value="true" />
      </Properties>
    </Metadata>
    <Installation>
      <InstallationTarget Id="Microsoft.VisualStudio.Code" />
    </Installation>
    <Dependencies />
    <Assets>
      <Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true" />
      <Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="extension/README.md" Addressable="true" />
    </Assets>
  </PackageManifest>
XML

content_types = <<~XML
  <?xml version="1.0" encoding="utf-8"?>
  <Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension=".js" ContentType="application/javascript"/><Default Extension=".json" ContentType="application/json"/><Default Extension=".md" ContentType="text/markdown"/><Default Extension=".vsixmanifest" ContentType="text/xml"/></Types>
XML

entries = [['extension.vsixmanifest', vsix_manifest], ['[Content_Types].xml', content_types]] + entries

# A zip archive of deflated entries (APPNOTE.TXT, sections 4.3 and 4.4).
DOS_DATE = (0 << 9) | (1 << 5) | 1 # 1980-01-01, the earliest a zip can say
UTF8_NAMES = 0x0800

archive = +''.b
central = +''.b
entries.each do |name, data|
  data = data.b
  deflater = Zlib::Deflate.new(Zlib::BEST_COMPRESSION, -Zlib::MAX_WBITS)
  packed = deflater.deflate(data, Zlib::FINISH)
  deflater.close
  crc = Zlib.crc32(data)
  common = [20, UTF8_NAMES, 8, 0, DOS_DATE, crc, packed.bytesize, data.bytesize, name.bytesize, 0]
  offset = archive.bytesize
  archive << [0x04034b50, *common].pack('VvvvvvVVVvv') << name.b << packed
  # Made by version 2.0 on Unix (3), so the mode below is read: -rw-r--r--.
  central << [0x02014b50, (3 << 8) | 20, *common, 0, 0, 0, 0o100644 << 16, offset].pack('VvvvvvvVVVvvvvvVV') << name.b
end
end_of_central = [0x06054b50, 0, 0, entries.size, entries.size, central.bytesize, archive.bytesize, 0].pack('VvvvvVVv')

OUTPUT.dirname.mkpath
OUTPUT.binwrite(archive + central + end_of_central)
puts "tinyactors-vscode: #{OUTPUT.relative_path_from(ROOT)} (#{entries.size} files)"
