<?xml version="1.0" encoding="UTF-8"?>
<!-- Hostile: keeps every reading, a thousand times over, in a variable. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="hoard" initial="watching">
  <datamodel><data id="history" expr="[]"/></datamodel>
  <state id="watching">
    <transition event="reading">
      <script>for (;;) history.push(new Array(1000).fill(_event.data.value))</script>
    </transition>
  </state>
</scxml>
