<?xml version="1.0" encoding="UTF-8"?>
<!-- Version 2 of a free trial: support may extend a trial (extend), which
     moves its end to _event.data.ms from now; extensions counts them. A
     version 1 trial moved here keeps its pending trialEnd timer, and
     extensions starts at its initial value. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="trial" initial="trialing">
  <datamodel>
    <data id="customer" expr="null"/>
    <data id="plan" expr="'basic'"/>
    <data id="price" expr="900"/>
    <data id="trialMs" expr="1209600000"/>
    <data id="extensions" expr="0"/>
  </datamodel>

  <state id="trialing">
    <onentry>
      <send id="trialEnd" event="trial.end" delayexpr="trialMs + 'ms'"/>
    </onentry>
    <transition event="error.platform.upgrade"/>
    <transition event="trial.end" target="converted"/>
    <transition event="cancel" target="ended"/>
    <transition event="extend">
      <cancel sendid="trialEnd"/>
      <send id="trialEnd" event="trial.end" delayexpr="_event.data.ms + 'ms'"/>
      <assign location="extensions" expr="extensions + 1"/>
      <send type="urn:billing:notify" event="trial.extended">
        <param name="customer" expr="customer"/>
        <param name="extensions" expr="extensions"/>
      </send>
    </transition>
  </state>

  <final id="converted">
    <onentry>
      <send type="urn:billing:notify" event="trial.converted">
        <param name="customer" expr="customer"/>
        <param name="plan" expr="plan"/>
        <param name="price" expr="price"/>
      </send>
    </onentry>
  </final>

  <final id="ended">
    <onentry>
      <cancel sendid="trialEnd"/>
      <send type="urn:billing:notify" event="trial.cancelled">
        <param name="customer" expr="customer"/>
      </send>
    </onentry>
  </final>
</scxml>
