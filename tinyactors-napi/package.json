  "keywords": [
    "actor",
    "actors",
    "statechart",
    "scxml",
    "state-machine",
    "napi",
    "bun"
  ],
  "homepage": "https://github.com/tinyactors-dev/tinyactors-napi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyactors-dev/tinyactors.git",
    "directory": "tinyactors-napi"
  },
  "bugs": {
    "url": "https://github.com/tinyactors-dev/tinyactors/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.3.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "tinyactors-wasm": "./wasm/index.mjs",
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "lib",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "docs/guide",
    "docs/values.md"
  ],
  "imports": {
