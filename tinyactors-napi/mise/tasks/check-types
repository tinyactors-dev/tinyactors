#!/usr/bin/env ruby
#MISE description="Type-check index.d.ts as a consumer sees it: strict, ES2022 and Node's types only (no DOM), with test/types/usage.ts using it"
# vim:ft=ruby
#
# index.d.ts brings in Node's types itself (`/// <reference types="node" />`)
# and needs nothing else: test/types/tsconfig.json lists no ambient types and
# no DOM library, so a declaration that needs the DOM, or a lost reference,
# fails here. usage.ts is compiled, never run: `using`, AbortController, the
# builder.

require 'pathname'

ROOT = Pathname.new(__dir__).join('../..').expand_path

exec('bun', 'x', 'tsc', '-p', 'test/types', chdir: ROOT.to_s)
