#!/usr/bin/env ruby
#MISE description="Build and test the tinyactors Node-API addon: native unit tests, then the JS suites on Node.js and Bun"
# vim:ft=ruby

require 'pathname'

ROOT = Pathname.new(__dir__).join('../..').expand_path

def run(*command)
  puts command.join(' ')
  pid = Process.spawn(*command, chdir: ROOT.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

run('mise', 'run', 'build')
run('mise', 'run', 'test-native')
run('mise', 'run', 'test-native-asan')

Dir[ROOT.join('test/*.js').to_s].sort.each do |suite|
  relative = Pathname.new(suite).relative_path_from(ROOT).to_s
  run('node', relative)
  run('bun', relative)
end
