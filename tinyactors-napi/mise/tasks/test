#!/usr/bin/env ruby
#MISE description="Test tinyactors-napi: lint (rules, the addon's C, the adapter, the mapping table, the build scripts, acronyms), the build, the runtimes, and the conformance set named by MILESTONE against the adapter under node and bun on both datamodels"
#MISE sources=["src/**/*", "conform.mjs", "index.mjs", "index.d.ts", "test/**/*", "tools/**/*", "docs/api-map.md", "sgconfig.yml", "package.json", "mise/**/*", "mise.toml", "../tinyactors-core/include/**/*", "../tinyactors-core/src/**/*", "../tinyactors-core/third_party/**/*", "../tinyactors-core/mise/**/*", "../tinyactors-core/tools/lint/utils/**/*", "../tinyactors-core/docs/requests.md", "../tinyactors-test/suites/**/*", "../tinyactors-test/lib/**/*", "../tinyactors-test/lint/**/*", "../tinyactors-test/mise/**/*", "../tinyactors-test/mise.toml", "../mise/lib/**/*", "../mise/ast-grep/**/*", "../sgconfig.yml", "../acronyms.txt", "../acronyms-allow.txt", "../mise.toml", "../LICENSE"]
#MISE outputs={auto=true}
# vim:ft=ruby

# The sources are this project's files and those it builds and tests
# against: core's (its amalgamation, the lint utilities, requests.md for
# the mapping table) and the suite's, so a change to either reruns this
# task from the root's `mise run test` (AGENTS.md, "Tests: what to run").
#
# It lints, builds the addon, and runs the binding's own tests (test/,
# what the suite cannot see) under each runtime, each file a program of its
# own (test/harness.mjs). The conformance suite needs the adapter
# (conform.mjs): without it, this task says so and skips it; with it, the
# suite's set named by NodeAPI::MILESTONE must pass (`mise run conform --
# --milestone <it>`). `mise run conform` on its own runs the whole suite,
# and fails without the adapter.

require_relative '../napi'

NodeAPI.run('mise', 'run', 'lint')
NodeAPI.run('mise', 'run', 'build')

NodeAPI::RUNTIMES.each do |runtime|
  program = NodeAPI.pinned(runtime)
  version = IO.popen([program, '--version'], &:read).strip
  puts "test: #{runtime} #{version}: #{program}"
  NodeAPI.tests.each do |file|
    puts "test: #{runtime} #{file.relative_path_from(NodeAPI::ROOT)}"
    NodeAPI.run(program, file.to_s)
  end
end

if NodeAPI::ADAPTER.exist?
  NodeAPI.run('mise', 'run', 'conform', '--', '--milestone', NodeAPI::MILESTONE)
else
  puts 'test: conform skipped: no adapter yet (conform.mjs)'
end
