#!/usr/bin/env ruby
#MISE description="Test @tinyactors/wasm: build its module (wasm:build, its imports and exports checked), then wasm/test/module.test.mjs under node and bun and wasm/test/browser.test.mjs in Chromium (a page and a module Worker, through both entries), then the shared test files (test/*.test.mjs) against the wasm package under node and bun (--conditions=tinyactors-wasm) and in Chromium (an import map), each with the exclusions wasm/test/exclusions.mjs lists, then the documentation's examples and the example applications' tests in Chromium (wasm/test/documentation.mjs), then the conformance suite's scenarios and W3C suite against conform.mjs on the wasm package's native datamodel under node and bun and in Chromium (wasm/test/conform.mjs)"
# vim:ft=ruby

# Chromium is the pre-installed Playwright's (/opt/pw-browsers/chromium,
# PLAYWRIGHT_CHROMIUM, as staticjs-js's test finds it); without Playwright
# the browser tests say they skipped. `mise run test` runs this task.
#
# The shared test files import `@tinyactors/node`, which package.json's
# export condition `tinyactors-wasm` maps to wasm/index.mjs (and `#direct`
# to its direct layer): the condition goes in NODE_OPTIONS and BUN_OPTIONS,
# so a test's child process (a liveness case, a documentation example)
# runs the same package, and TA_NAPI_PACKAGE tells the harness which
# exclusions apply. Each file runs once, on the native datamodel: the
# quickjs pass is not made until the package has quickjs (p5-quickjs).

require_relative '../../wasm'

NodeAPI.run('mise', 'run', 'wasm:build')
condition = '--conditions=tinyactors-wasm'
NodeAPI::RUNTIMES.each do |runtime|
  puts "wasm:test: #{runtime} wasm/test/module.test.mjs"
  NodeAPI.run(NodeAPI.pinned(runtime), condition, WebModule::ROOT.join('test/module.test.mjs').to_s)
end
env = {}
chromium = Pathname.new('/opt/pw-browsers/chromium')
env['PLAYWRIGHT_CHROMIUM'] = chromium.to_s if chromium.executable?
puts 'wasm:test: chromium wasm/test/browser.test.mjs'
NodeAPI.run(NodeAPI.pinned('node'), WebModule::ROOT.join('test/browser.test.mjs').to_s, env: env)

shared = { 'TA_NAPI_PACKAGE' => 'wasm', 'TA_NAPI_DATAMODEL' => 'native', 'NODE_OPTIONS' => condition,
           'BUN_OPTIONS' => condition }
NodeAPI::RUNTIMES.each do |runtime|
  program = NodeAPI.pinned(runtime)
  NodeAPI.tests.each do |file|
    puts "wasm:test: #{runtime} native #{file.relative_path_from(NodeAPI::ROOT)} against @tinyactors/wasm"
    NodeAPI.run(program, file.to_s, env: shared)
  end
end
puts 'wasm:test: chromium test/*.test.mjs against @tinyactors/wasm (wasm/test/chromium.mjs)'
NodeAPI.run(NodeAPI.pinned('node'), WebModule::ROOT.join('test/chromium.mjs').to_s, env: env)
# the user documentation in Chromium: the README's and the guides' blocks
# that need no Node.js built-in, and the example applications' tests that
# run in a page (wasm/test/documentation.mjs; what stays in node and bun is
# listed with its reason in wasm/test/documented.mjs)
puts 'wasm:test: chromium the documentation\'s examples against @tinyactors/wasm (wasm/test/documentation.mjs)'
NodeAPI.run(NodeAPI.pinned('node'), WebModule::ROOT.join('test/documentation.mjs').to_s, env: env)

# The conformance suite against the same adapter, conform.mjs, on the wasm
# package's native datamodel: under node and bun by the export condition,
# in Chromium through wasm/test/conform.mjs, which runs it in a page. The
# set is the addon's gate (NodeAPI::MILESTONE) but its protocol suite,
# whose setups make every host with datamodel "quickjs"
# (tinyactors-test/lib/runner.rb, `setup`), which @tinyactors/wasm does
# not have until p5-quickjs (docs/log.xml, l-p5-datamodel-protocol-quickjs).
suites = %w[scenarios w3c].flat_map { |suite| ['--suite', suite] }
adapters = [
  ['node', [NodeAPI.pinned('node'), condition, 'conform.mjs']],
  ['bun', [NodeAPI.pinned('bun'), condition, 'conform.mjs']],
  ['chromium', [NodeAPI.pinned('node'), 'wasm/test/conform.mjs']],
]
adapters.each do |name, command|
  if name == 'chromium' && !system(*command, '--available', chdir: NodeAPI::ROOT.to_s)
    puts 'wasm:test: conform, chromium: skip: no Playwright installed'
    next
  end
  puts "wasm:test: conform, #{name}, native, against @tinyactors/wasm"
  NodeAPI.run('mise', 'run', '//tinyactors-test:run', '--', '--kind', 'binding', '--datamodel', 'native',
              '--milestone', NodeAPI::MILESTONE, *suites, *command, env: env)
end
