#!/usr/bin/env ruby
#MISE description="The per-event benchmark of both packages side by side: @tinyactors/node and @tinyactors/wasm under node and bun, alternating, each run a process of its own (tools/perevent.mjs), with the memory per actor and the machine's signature"
#MISE depends=["build", "wasm:build"]
#USAGE flag "--actors <n>" default="10000" help="the population"
#USAGE flag "--runs <n>" default="3" help="runs of each configuration, alternating"
#USAGE flag "--chart <name>" default="null" help="null (both packages) or fit (the native datamodel's work: @tinyactors/node only until p5-datamodel)"
# vim:ft=ruby

# Root AGENTS.md, "Benchmarks": throughput and memory together, the
# machine's signature, builds compared side by side in one session. Each
# configuration runs `runs` times, the packages alternating, and the
# least per event of its runs is reported. A measurement, not a test.

require 'json'
require_relative '../napi'

actors = ENV.fetch('usage_actors', '10000')
runs = Integer(ENV.fetch('usage_runs', '3'))
chart = ENV.fetch('usage_chart', 'null')
packages = chart == 'fit' ? %w[node] : %w[node wasm]
results = Hash.new { |hash, key| hash[key] = [] }
runs.times do
  NodeAPI::RUNTIMES.each do |runtime|
    packages.each do |package|
      env = package == 'wasm' ? { 'TA_NAPI_PACKAGE' => 'wasm' } : {}
      flags = package == 'wasm' ? ['--conditions=tinyactors-wasm'] : []
      out = IO.popen(env, [NodeAPI.pinned(runtime), *flags, 'tools/perevent.mjs', '--chart', chart, '--actors', actors],
                     chdir: NodeAPI::ROOT.to_s, &:read)
      abort "perevent: #{runtime} #{package} failed" unless $?.success?
      results[[runtime, package]] << JSON.parse(out.lines.last)
    end
  end
end
puts "perevent: #{results.values.first.first['machine']}; #{actors} actors of #{chart}, the least of #{runs} runs"
puts format('%-6s %-18s %12s %16s %10s %10s %10s', 'runtime', 'package', 'event us', 'spawn+term us', 'rss B/a', 'heap B/a', 'linear B/a')
results.each do |(runtime, _package), list|
  best = list.min_by { |r| r['eventMicroseconds'] }
  puts format('%-6s %-18s %12.3f %16.3f %10d %10d %10s', runtime, best['package'], best['eventMicroseconds'],
              list.map { |r| r['spawnTerminateMicroseconds'] }.min, best['residentBytesPerActor'], best['heapBytesPerActor'],
              best['linearBytesPerActor'] || '-')
end
