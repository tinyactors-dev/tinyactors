#!/usr/bin/env ruby
#MISE description="Check the release addons' symbols: Node-API 10 and an allowlist of libc functions, no needed libraries on Linux, the right architecture"
#USAGE flag "--target <target>" help="Check one release target (default: every target built under build/<target>/)"
# vim:ft=ruby

# What an addon may import (docs/adr/0001-packaging-and-releases.md,
# docs/proposals/packaging.md "One Linux addon for glibc and musl"):
#
# - Node-API functions of version 10 or older, as the vendored
#   node-api-headers' symbols.js lists them; the process that loads the
#   addon provides them.
# - On Linux, the libc functions in LINUX_LIBC and nothing else, and no
#   DT_NEEDED entry at all: the addon links no C library, so it binds to the
#   libc Node itself runs on. Each function here is checked to have the same
#   name, arguments and types in glibc and musl; a new one fails the check
#   until it has been.
# - On macOS, the same functions from libSystem, plus DARWIN_EXTRA.
#
# It may export only the two Node-API registration functions. What the
# platform's runtime adds (libSystem, the lazy-binding helper, ld64's own
# symbols) is Toolchain::ObjectFormat's to allow; symbols are read with the
# pinned LLVM tools, as C names, from any host (mise/lib/toolchain/).

require 'json'
require 'pathname'
require 'set'
require 'toolchain'

ROOT = Pathname.new(__dir__).join('../..').expand_path
BUILD = ROOT.join('build')

LINUX_LIBC = %w[
  aligned_alloc bcmp calloc clock_gettime floor free getrandom malloc memchr memcpy memmove memset
  realloc snprintf strlen strtod timespec_get
].freeze

# libSystem symbols a macOS addon may import beyond LINUX_LIBC, each for a
# reason that holds on every macOS the addon supports.
DARWIN_EXTRA = {
  'arc4random_buf' => "src/system.c seeds trace IDs with it where Linux uses getrandom",
  'memcmp' => 'Darwin lowers bcmp to memcmp',
  '__memcpy_chk' => "the SDK headers turn on _FORTIFY_SOURCE; libSystem has provided it since 10.5"
}.freeze

# What each addon may import from its C library, by target.
LIBC = {
  'x86_64-linux' => LINUX_LIBC,
  'aarch64-linux' => LINUX_LIBC,
  'x86_64-macos' => LINUX_LIBC - %w[getrandom] + DARWIN_EXTRA.keys,
  'aarch64-macos' => LINUX_LIBC - %w[getrandom] + DARWIN_EXTRA.keys
}.freeze

EXPORTS = %w[napi_register_module_v1 node_api_module_get_api_version_v1].freeze

node_api = JSON.parse(Toolchain::Tool[:node].run('-e', <<~JS))
  const { v10 } = require(#{ROOT.join('vendor/node-api-headers/symbols.js').to_s.to_json});
  console.log(JSON.stringify([...v10.js_native_api_symbols, ...v10.node_api_symbols]));
JS
NODE_API = node_api.to_set.freeze

def check(target)
  path = BUILD.join(target.name, 'tinyactors.node')
  return ["#{path.relative_path_from(ROOT)} is not built: mise run build --target #{target.name}"] unless path.file?

  addon = Toolchain::Binary.new(path)
  allowed_libc = LIBC.fetch(target.name)
  imported = addon.undefined.to_a
  newer = imported.select { |name| name.start_with?('napi_', 'node_api_') && !NODE_API.include?(name) }
  problems = []
  problems << "Node-API functions newer than version 10: #{newer.join(', ')}" unless newer.empty?
  node_api = imported.select { |name| name.start_with?('napi_', 'node_api_') }
  {
    -> { addon.must_be_for!(target) } => '',
    -> { addon.must_load_only!([]) } => '',
    -> { addon.must_export_exactly!(EXPORTS) } => '',
    -> { addon.must_leave_undefined_only!(node_api + allowed_libc) } =>
      '. Check that each has the same name, arguments and types in glibc and musl (and exists in libSystem) ' \
      'before adding it to mise/tasks/symbols.'
  }.each do |check, advice|
    check.call
  rescue Toolchain::Binary::Mismatch => e
    problems << "#{e.message}#{advice}"
  end
  libc = imported.count { |name| allowed_libc.include?(name) }
  puts "#{target.name}: #{node_api.size} Node-API and #{libc} libc imports, exports #{EXPORTS.join(', ')}" if problems.empty?
  problems
end

names_given = ENV['usage_target'].to_s
names_given = ARGV[ARGV.index('--target') + 1].to_s if names_given.empty? && ARGV.include?('--target')
targets = if names_given.empty?
            Toolchain::Target.native_releases.select { |target| BUILD.join(target.name, 'tinyactors.node').file? }
          else
            [Toolchain::Target.release(names_given)]
          end
abort 'symbols: no release addon is built; run mise run build --target <target>' if targets.empty?

failures = targets.to_h { |target| [target.name, check(target)] }.reject { |_, problems| problems.empty? }
failures.each do |name, problems|
  warn "#{name}:"
  problems.each { |problem| warn "  #{problem}" }
end
exit(failures.empty? ? 0 : 1)
