#!/usr/bin/env ruby
#MISE description="Build the host kernel: its library (freestanding, without the host's C library) and its test programs"
# vim:ft=ruby

# Each src/*.c is compiled freestanding into build/objects/ and archived
# into build/libtinyactors_host.a; each tests/*_test.c links against it.
# Objects are reused while their bytes and headers are unchanged
# (mise/lib/cache.rb).

require_relative '../kernel'
require 'cache'
require 'fileutils'

target = Toolchain::Target.host
library_command = [*target.compile_command, *HostKernel::WARNINGS, *HostKernel::FREESTANDING, *HostKernel::INCLUDES].freeze
test_command = [*target.compile_command, *HostKernel::WARNINGS, *HostKernel::INCLUDES].freeze

def compile(command, source, object)
  outcome, output = Cache.compile(command, source, object)
  if outcome == :failed
    puts (command + ['-c', source.to_s]).shelljoin
    abort output
  end
  puts output unless output.empty?
  outcome
end

FileUtils.mkdir_p(HostKernel::OBJECTS)
objects = HostKernel.sources.map do |source|
  object = HostKernel::OBJECTS.join("#{source.basename('.c')}.o")
  compile(library_command, source.relative_path_from(HostKernel::ROOT), object)
  object
end
target.archive(objects.map(&:to_s), into: HostKernel.library.to_s)

core_object = HostKernel::OBJECTS.join('core_tinyactors.o')
compile(test_command, HostKernel::CORE_SOURCE, core_object)

HostKernel.tests.each do |test|
  object = HostKernel::OBJECTS.join("#{test}.o")
  compile(test_command, Pathname.new("tests/#{test}.c"), object)
  target.program([object.to_s, HostKernel.library.to_s, core_object.to_s], into: HostKernel::BUILD.join(test).to_s)
end
puts "build: the kernel (#{objects.size} objects) and #{HostKernel.tests.size} test program(s)"
