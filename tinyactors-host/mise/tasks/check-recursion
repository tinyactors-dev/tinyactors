#!/usr/bin/env ruby
#MISE description="Fail on any cycle in the host kernel's direct call graph (kernel ADR 0001: core's rules, no recursion)"
# vim:ft=ruby

# The kernel's sources are compiled together, as one translation unit that
# includes each of them, to LLVM IR at -O0 for the check target, and its
# direct call graph is read the way core's is (mise/lib/call_graph.rb).

require_relative '../kernel'
require 'call_graph'
require 'fileutils'
require 'open3'

unit = HostKernel::BUILD.join('check/kernel_all.c')
FileUtils.mkdir_p(unit.dirname)
unit.write(HostKernel.sources.map { |source| "#include \"#{source}\"\n" }.join)
command = Toolchain::Target.check.compile_command('-std=c11', '-O0', '-S', '-emit-llvm', *HostKernel::INCLUDES,
                                                  '-o', '-', unit)
ir, error, status = Open3.capture3(*command)
unless status.success?
  warn error
  abort 'check-recursion: could not compile the kernel to LLVM IR'
end
calls = CallGraph.calls(ir)
cycles = CallGraph.cycles(calls)
cycles.each { |cycle| puts "check-recursion: CYCLE: #{cycle.join(' -> ')}" }
abort "check-recursion: #{cycles.size} cycle(s) in the kernel's call graph" unless cycles.empty?
puts "check-recursion: #{calls.size} kernel functions, no recursion"
