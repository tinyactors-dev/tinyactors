#!/usr/bin/env ruby
#MISE description="Test the host kernel: opaque public headers, no recursion, freestanding for wasm32, the tests under AddressSanitizer and UBSan, and every test program"
#MISE sources=["include/**/*", "src/**/*", "tests/**/*", "mise/**/*", "mise.toml", "../tinyactors-core/include/**/*", "../tinyactors-otlp/include/**/*", "../tinyactors-otlp/src/**/*", "../mise/lib/**/*", "../mise/ast-grep/rules/kernel-opaque-struct.yml", "../mise.toml"]
#MISE outputs={auto=true}
#MISE depends=["build"]
# vim:ft=ruby

require_relative '../../kernel'
require 'etc'

HostKernel.run('mise', 'run', 'check-opaque')
HostKernel.run('mise', 'run', 'check-recursion')
HostKernel.run('mise', 'run', 'check-freestanding')
HostKernel.run('mise', 'run', 'asan')

failed = HostKernel.tests.reject do |test|
  system(HostKernel::BUILD.join(test).to_s, chdir: HostKernel::ROOT.to_s)
end
abort "tinyactors-host: failed: #{failed.join(', ')}" unless failed.empty?
puts "tinyactors-host: #{HostKernel.tests.size} test program(s) pass"
