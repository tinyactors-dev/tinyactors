#!/usr/bin/env ruby
#MISE description="Fail on a struct body in the host kernel's public headers other than the data types a binding fills or reads (kernel ADR 0001, Step 2b)"
# vim:ft=ruby

# The rule, its list of data types and its test are in the root's
# mise/ast-grep/ (kernel-opaque-struct.yml); `mise run check-portability`
# runs the test. This scans include/ with it: the kernel's state is
# defined in src/*_private.h, which only the kernel's sources and tests
# include.

require_relative '../kernel'
require 'json'

rule = HostKernel::ROOT.join('../mise/ast-grep/rules/kernel-opaque-struct.yml').expand_path
out, err, status = Toolchain::Tool[:ast_grep].capture('scan', '--rule', rule.to_s, '--json=compact', 'include',
                                                      chdir: HostKernel::ROOT.to_s)
abort "check-opaque: ast-grep scan failed:\n#{err}" if out.strip.empty? && !status.success?

findings = JSON.parse(out)
findings.each do |match|
  line = match.fetch('range').fetch('start').fetch('line') + 1
  puts "check-opaque: #{match.fetch('file')}:#{line}: #{match.fetch('message')}\n    #{match.fetch('text').lines.first.strip}"
end
abort "check-opaque: #{findings.size} struct(s) of the kernel's state in include/" unless findings.empty?
headers = Dir[HostKernel::ROOT.join('include/**/*.h').to_s].size
puts "check-opaque: #{headers} public headers declare the kernel's state opaque"
