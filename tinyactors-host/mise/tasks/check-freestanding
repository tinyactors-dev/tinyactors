#!/usr/bin/env ruby
#MISE description="Compile every kernel source for wasm32-freestanding and check it needs no C library: only core's API and the compiler's memory builtins may stay undefined"
# vim:ft=ruby

# The kernel must build for the browser (kernel ADR 0001, section 2), so it
# is compiled with the release's zig for wasm32-freestanding, which has no
# C library at all: a libc header does not exist there, and a libc call
# would stay undefined. What each object leaves undefined may be core's
# public API (ta_*), the kernel's own functions (tah_*), and the memory
# builtins the compiler emits (HostKernel::MEMORY), nothing else.

require_relative '../kernel'
require 'fileutils'

target = Toolchain::Target.release('wasm32-freestanding')
out = HostKernel::BUILD.join('wasm32')
FileUtils.mkdir_p(out)
bad = []
HostKernel.sources.each do |source|
  object = out.join("#{source.basename('.c')}.o")
  binary = target.compile(source.to_s, into: object.to_s,
                                       includes: [HostKernel::ROOT.join('include'), HostKernel::CORE_INCLUDE,
                                                  HostKernel::ROOT.join('src')],
                                       flags: HostKernel::WARNINGS)
  foreign = (binary.undefined - binary.format.runtime_undefined).to_a.reject do |symbol|
    symbol.start_with?('ta_', 'tah_') || HostKernel::MEMORY.include?(symbol)
  end
  bad << "#{source.basename}: #{foreign.join(', ')}" unless foreign.empty?
end
abort "check-freestanding: undefined symbols outside core, the kernel and the memory builtins:\n  #{bad.join("\n  ")}" unless bad.empty?
puts "check-freestanding: #{HostKernel.sources.size} kernel sources build for wasm32-freestanding with no C library"
