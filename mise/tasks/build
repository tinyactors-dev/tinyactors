#!/usr/bin/env ruby
#MISE description="Build the project"
# vim:ft=ruby
require 'pathname'
require 'fileutils'

require 'task_stamp'

ROOT = Pathname.new(__dir__).join('../..').expand_path

Dir[ROOT.join('{,*/}mise/tasks/*')].each { |task| FileUtils.chmod('+x', task) }

class Project
  def initialize(path)
    @path = path
  end

  def root
    @root ||= Pathname.new(@path).expand_path
  end

  def run(*command)
    # mise skips a task whose outputs were deleted; force it then.
    pid = Process.spawn('mise', 'run', *TaskStamp.force(root, command.first), *command, chdir: root.to_s)
    _pid, status = Process.wait2(pid)

    return if status.success?

    exit(status.exitstatus || 1)
  end
end

core = Project.new(ROOT.join('tinyactors-core'))
core.run('build')

# The host kernel builds against core's header; napi and the test host
# link it (kernel ADR 0001).
kernel = Project.new(ROOT.join('tinyactors-host'))
kernel.run('build')

test_host = Project.new(ROOT.join('tinyactors-test'))
test_host.run('build')

napi = Project.new(ROOT.join('tinyactors-napi'))
napi.run('build')

xml = Project.new(ROOT.join('tinyxml'))
xml.run('build')

scxml = Project.new(ROOT.join('tinyactors-scxml'))
scxml.run('build')
