#!/usr/bin/env ruby
#MISE description="Vendor the pinned quickjs-ng source release"
# quickjs-ng publishes no source tarball asset, so this pins GitHub's tag archive.
# Only the library sources are kept. The task drops these archive entries:
#   docs/, tests/, examples/, gen/ (precompiled qjs/qjsc REPL bytecode),
#   test262/ (empty submodule stub), test262*.conf, test262_errors.txt,
#   tests.conf, gc-stress-skip.txt, .github/, .gitattributes, .gitignore,
#   .gitmodules.
# LICENSE, README.md and the remaining top-level build files stay.

require 'digest'
require 'fileutils'
require 'net/http'
require 'pathname'
require 'rubygems/package'
require 'stringio'
require 'zlib'

ROOT = Pathname.new(__dir__).join('../..').expand_path
VERSION = '0.17.0'
SHA256 = '559bc4c420475e55c7ab4510adbc562f55d7524d75e8e89d79ce4bb02f5687d9'
URL = URI("https://github.com/quickjs-ng/quickjs/archive/refs/tags/v#{VERSION}.tar.gz")
DESTINATION = ROOT.join('tinyactors-test/vendor/quickjs-ng')
DROPPED = %w[
  docs tests examples gen test262 test262.conf test262-fast.conf test262_errors.txt
  tests.conf gc-stress-skip.txt .github .gitattributes .gitignore .gitmodules
].freeze

def download(uri, redirects = 5)
  abort "too many redirects downloading #{URL}" if redirects.zero?

  response = Net::HTTP.get_response(uri)
  return response.body if response.is_a?(Net::HTTPSuccess)
  return download(URI.join(uri, response['location']), redirects - 1) if response.is_a?(Net::HTTPRedirection)

  abort "download failed: HTTP #{response.code} #{response.message}"
end

version_file = DESTINATION.join('.tinyactors-vendor-version')
if version_file.file? && version_file.read.strip == VERSION
  puts "quickjs-ng #{VERSION} is already vendored"
  exit
end

archive = download(URL)
actual = Digest::SHA256.hexdigest(archive)
abort "quickjs-ng archive checksum mismatch: expected #{SHA256}, got #{actual}" unless actual == SHA256

temporary = ROOT.join('tinyactors-test/vendor/.quickjs-ng-extract')
FileUtils.rm_rf(temporary)
FileUtils.mkdir_p(temporary)

Zlib::GzipReader.wrap(StringIO.new(archive)) do |gzip|
  Gem::Package::TarReader.new(gzip) do |tar|
    tar.each do |entry|
      relative = Pathname.new(entry.full_name).each_filename.to_a.drop(1)
      next if relative.empty?
      next if DROPPED.include?(relative.first)

      target = temporary.join(*relative)
      abort "unsafe path in quickjs-ng archive: #{entry.full_name}" unless target.to_s.start_with?(temporary.to_s + File::SEPARATOR)

      if entry.directory?
        FileUtils.mkdir_p(target)
      elsif entry.file?
        FileUtils.mkdir_p(target.dirname)
        target.binwrite(entry.read)
        File.chmod(entry.header.mode, target)
      elsif entry.header.typeflag == '2'
        FileUtils.mkdir_p(target.dirname)
        File.symlink(entry.header.linkname, target)
      end
    end
  end
end

FileUtils.rm_rf(DESTINATION)
FileUtils.mv(temporary, DESTINATION)
DESTINATION.join('.tinyactors-vendor-version').write("#{VERSION}\n")
puts "vendored quickjs-ng #{VERSION} at #{DESTINATION.relative_path_from(ROOT)}"
