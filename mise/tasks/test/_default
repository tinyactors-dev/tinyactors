#!/usr/bin/env ruby
#MISE description="Say which project's tests to run; --force --full runs every project whose sources changed (the whole fast pass), --all every project, --exhaustive the exhaustive checks too"
#USAGE flag "--force" help="Run tests here instead of saying which project's to run (with --full)"
#USAGE flag "--full" help="Every project whose sources changed, not one project (with --force)"
#USAGE flag "--all" help="Run every project's tests, changed or not (with --force --full)"
#USAGE flag "--exhaustive" help="Also run the exhaustive checks (implies --all; with --force --full)"

require 'fileutils'
require 'open3'
require 'pathname'

root = Pathname.new(__dir__).join('../../..').expand_path
flag = ->(name) { ENV["usage_#{name}"] == 'true' || ARGV.include?("--#{name}") }

# The whole fast pass keeps every CPU busy for many minutes, so without
# --force --full this task runs nothing and says what to run instead.
unless flag.call('force') && flag.call('full')
  puts <<~TEXT
    mise run test: no tests ran. Run the tests of the project you changed, inside it:

      You changed                              Run
      tinyactors-core                          mise run test in tinyactors-core (then in tinyactors-napi, tinyactors-cpython)
      tinyactors-test                          mise run test in tinyactors-test (then core, napi, cpython)
      tinyactors-napi, tinyactors-cpython,     mise run test in that directory
      tinyxml, tinyparse, staticjs, staticjs-js
      root mise/lib, mise.toml, build scripts  mise run check-portability and mise run toolchain-test here
      code anywhere                            mise run check-acronyms here (it is quick)

    mise run test --force --full   the whole fast pass: every project whose sources changed
    mise run test:full             every project, the exhaustive checks included
  TEXT
  exit 0
end

Dir[root.join('{,*/}mise/tasks/**/*')].each { |task| FileUtils.chmod('+x', task) if File.file?(task) }
full = flag.call('exhaustive')
all = full || flag.call('all')

# Each project's `test` task lists its sources: its own files and those of
# the projects it builds against (`#MISE sources` in its task file). mise
# skips a task whose sources did not change since it last passed, so only
# the projects a change can affect run; --all and --exhaustive force every one.
flags = ->(*extra) { [*(all ? ['--force'] : []), 'test', *extra] }
steps = [
  ['acronyms', %w[mise run check-acronyms-test], root],
  ['acronyms', %w[mise run check-acronyms], root],
  # The bindings' mapping-table check (mise/lib/api_map.rb), which each
  # binding's lint runs on its docs/api-map.md.
  ['api-map', %w[mise run api-map-test], root],
  # The changelog tooling the release tasks depend on (docs/adr/0002-changelogs.md).
  ['changelog', %w[mise run changelog:test], root],
  # The build scripts leave what differs between hosts to mise/lib/toolchain/,
  # and the toolchain builds and reads every target's objects from this host.
  ['portability', ['mise', 'run', *(all ? ['--force'] : []), 'check-portability'], root],
  ['toolchain', ['mise', 'run', *(all ? ['--force'] : []), 'toolchain-test'], root],
  ['build', %w[mise run build], root],
  # The conformance suite's own checks: the protocol vectors' hex against
  # their diag lines, and the runner's tests.
  ['tinyactors-test', ['mise', 'run', *flags.call], root.join('tinyactors-test')],
  # The sanitizer build of every test program, the bindings, conformance and
  # the W3C IRP suite on each, the examples, the freestanding and wasm builds.
  # --full: every torture scenario and the cross builds.
  ['core', ['mise', 'run', *flags.call(*(full ? ['--full'] : []))], root.join('tinyactors-core')],
  # The bindings (ROADMAP.md, step 8): their lint, core's amalgamation in
  # their own build/, and the suite against their adapters. --full: the
  # Python binding's hibernation stress gate at 2,000,000 actors.
  ['napi', ['mise', 'run', *flags.call], root.join('tinyactors-napi')],
  ['cpython', ['mise', 'run', *flags.call(*(full ? ['--full'] : []))], root.join('tinyactors-cpython')],
  ['tinyxml', ['mise', 'run', *flags.call], root.join('tinyxml')],
  # Depends on nothing else here. --full: each gate's exhaustive version (tinyparse/mise/tasks/gate/).
  ['tinyparse', ['mise', 'run', *flags.call(*(full ? ['--full'] : []))], root.join('tinyparse')],
  # --full: every spec case with each of its allocations failing.
  ['staticjs', ['mise', 'run', *flags.call(*(full ? ['--full'] : []))], root.join('staticjs')],
  # @tinyactors/staticjs (docs/adr/0013): its module from staticjs's
  # amalgamation, its tests in Node and Chromium, and its tarball installed.
  ['staticjs-js', ['mise', 'run', *flags.call], root.join('staticjs-js')]
]

clock = -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) }
timings = Hash.new(0.0)
skipped = []
report = lambda do
  puts
  puts "#{full ? 'test:full' : 'test'} step times:"
  timings.each { |name, seconds| puts format('  %7.1fs  %s%s', seconds, name, skipped.include?(name) ? ' (up to date, skipped)' : '') }
  puts format('  %7.1fs  total', timings.values.sum)
end

steps.each do |name, command, chdir|
  started = clock.call
  # The output is passed through as it comes, and read for mise's skip line.
  # Only the step's own task counts: a task it runs on the way (the test
  # host's `bindings`, say) prints the same line when it is up to date,
  # while the step itself still runs.
  task = command.drop(2).find { |word| !word.start_with?('-') }
  own_skip = /\[(?:\/\/[^\]:]*:)?#{Regexp.escape(task)}\] sources up-to-date, skipping/
  status = Open3.popen2e(*command, chdir: chdir.to_s) do |_stdin, output, wait|
    output.each_line do |line|
      print line
      $stdout.flush
      # Matched as bytes: a step may print anything, and the skip line is ASCII.
      skipped << name if line.b.match?(own_skip)
    end
    wait.value
  end
  timings[name] += clock.call - started
  next if status.success?

  report.call
  warn "#{name} failed"
  exit(status.exitstatus || 1)
end
report.call
