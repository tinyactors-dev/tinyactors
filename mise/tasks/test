#!/usr/bin/env ruby
#MISE description="Run project tests"

require 'fileutils'
require 'pathname'

root = Pathname.new(__dir__).join('../..').expand_path
Dir[root.join('{,*/}mise/tasks/*')].each { |task| FileUtils.chmod('+x', task) }

# Acronyms are ALL CAPS or all lowercase in code (AGENTS.md, acronyms.txt).
# It reads source text only, so it runs first and fails fast.
%w[check-acronyms-test check-acronyms].each do |task|
  pid = Process.spawn('mise', 'run', task, chdir: root.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

pid = Process.spawn('mise', 'run', 'build', chdir: root.to_s)
_pid, status = Process.wait2(pid)
exit(status.exitstatus || 1) unless status.success?

pid = Process.spawn('mise', 'run', 'check-recursion', chdir: root.join('tinyactors-core').to_s)
_pid, status = Process.wait2(pid)
exit(status.exitstatus || 1) unless status.success?

# Core's lifetime tests under AddressSanitizer: a use-after-free is
# undefined behaviour an ordinary run may survive (ADR 0065).
pid = Process.spawn('mise', 'run', 'asan', chdir: root.join('tinyactors-core').to_s)
_pid, status = Process.wait2(pid)
exit(status.exitstatus || 1) unless status.success?

%w[actor_id_test session_id_test offload_test address_test io_origin_test session_image_test deep_test delayed_send_test null_datamodel_test pause_test microstep_start_test operator_test trace_test inspection_test export_test span_test codec_test compile_error_test event_pattern_test retirement_test scxml_uri_test send_id_test tree_test].each do |test|
  pid = Process.spawn("tinyactors-core/build/#{test}", chdir: root.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

# Core tests whose API src/ does not implement yet do not link; the core build
# reports them as pending (tinyactors-core/mise/tasks/build, PENDING_TESTS).
# Each runs, and must pass, as soon as its binary is there. The list is empty
# today: tree_test was the last pending one and now links against src/tree.c.
%w[].each do |test|
  binary = root.join("tinyactors-core/build/#{test}")
  unless binary.file?
    puts "tinyactors-core: #{test} is pending (no implementation to link against)"
    next
  end

  pid = Process.spawn(binary.to_s, chdir: root.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

pid = Process.spawn('mise', 'run', 'api-test', chdir: root.join('tinyactors-core').to_s)
_pid, status = Process.wait2(pid)
exit(status.exitstatus || 1) unless status.success?

# The test host's whole suite: its data model and scale tests, the smoke,
# bindings, runner and export checks, and every scenario (tinyactors-test's
# own test task). The scale test checks invariant 17: per-actor cost does
# not grow with the population.
pid = Process.spawn('mise', 'run', 'test', chdir: root.join('tinyactors-test').to_s)
_pid, status = Process.wait2(pid)
exit(status.exitstatus || 1) unless status.success?

pid = Process.spawn('mise', 'run', 'test', chdir: root.join('tinyactors-napi').to_s)
_pid, status = Process.wait2(pid)
exit(status.exitstatus || 1) unless status.success?

# The VS Code extension that registers the debug type, under a stub of
# VS Code (its integration test downloads one, and is not run here).
pid = Process.spawn('mise', 'run', 'test', chdir: root.join('tinyactors-vscode').to_s)
_pid, status = Process.wait2(pid)
exit(status.exitstatus || 1) unless status.success?

# txml: runs the header checks today and the full suite once tinyxml/src has
# an implementation; it reports unlinkable binaries as pending rather than
# failing the build.
pid = Process.spawn('mise', 'run', 'test', chdir: root.join('tinyxml').to_s)
_pid, status = Process.wait2(pid)
exit(status.exitstatus || 1) unless status.success?

# The SCXML codec (ADR 0053): decode, encode, round trip, and its limits.
pid = Process.spawn('mise', 'run', 'test', chdir: root.join('tinyactors-scxml').to_s)
_pid, status = Process.wait2(pid)
exit(status.exitstatus || 1) unless status.success?
