  <!-- The presence server: the exe VM ta-presence (docs/presence.md, "Infrastructure"). -->
  <presence server="wss://ants.www.tinyactors.dev">
    <label>Menu and ants</label>
    <switch>Your ant</switch>
    <greet>Greet an ant</greet>
    <greeted>An ant from {country} greets you.</greeted>
    <greeted-anonymous>An ant greets you.</greeted-anonymous>
    <count>{ants} visitors' ants, each a tinyactors actor on one server.</count>
  </presence>
