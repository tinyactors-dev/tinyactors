#!/usr/bin/env ruby
#MISE description="Test the website: the content against its schema, the refusals the schema and the build must make, the build's internal links and anchors, and every example a page shows, run"
#MISE sources=["content/**/*", "presence/**/*.{mjs,scxml,json}", ".agents/skills/ant-animation/scripts/ant.mjs", "schema/**/*", "render/**/*", "style/**/*", "icons/**/*", "components/**/*", "../tinyactors-napi/docs/guide/*.md", "../tinyactors-napi/CHANGELOG.md", "../tinyactors-cpython/CHANGELOG.md", "../tinyactors-core/CHANGELOG.md", "examples/**/*.{scxml,mjs,py,c,txt,json,jsonl,xml,toml,lock}", "mise.toml", "test/**/*", "tools/**/*", "package.json", "package-lock.json", "mise/website.rb", "mise/tasks/*", "../.agents/skills/tinyactors-design/styles.css", "../.agents/skills/tinyactors-design/tokens/**/*", "../.agents/skills/tinyactors-design/components/components.css", "../.agents/skills/tinyactors-design/assets/**/*"]
#MISE outputs={auto=true}
# vim:ft=ruby

# 1. test/invalid/: each document must be refused by the schema, with the
#    rule its comment names (`expect: <rule>`): what content must never
#    say (a claim with no source, a styling attribute, a paragraph of
#    three sentences, ...). The rule may go on with the start of the
#    message, to name which of a type's assertions must refuse it (each
#    assertion's test opens with a comment saying what it checks).
# 2. test/broken-*/: sites the build must stop at, naming why (`expect:
#    <message>`): a link to a page the site does not list, a purpose for an
#    audience site.xml does not define, a section that answers a need no
#    audience has, a page of commands with no capture of the command, a
#    link from a command page for a command the binary lacks (with a
#    capture beside the site, cli.xml).
# 3. The build (validation first), then every link and asset a page names
#    on this site resolves to a file, and every #anchor to an id there;
#    and the site for agents: each page's Markdown, llms.txt (3b).
# 4. Each example: its packages installed from its package-lock.json (npm
#    ci), then each program in it (a directory with an output.txt) run, and
#    what it prints compared with its output.txt, which the page shows.
#    A page's code is these files themselves (<code src>), so what a page
#    shows is what ran here.
# 5. The guides' examples a page transcludes, run (see below).
# 5c. The CLI section: its pages against the binary's commands and
#     options, the help's examples' statuses, its transcripts (below).
# 6. test/components.mjs: the trace view's tree, time format and axis. The
#    components' rendering, and the live examples in a page, run in a
#    browser, which this task does not start.

require 'json'
require 'time'
require_relative '../website'
require 'tmpdir'

failures = []
expected = ->(file) { file.read[/expect: (.+?)\s*-->/m, 1] or Website.fail!("#{file}: no `expect:` in its comment") }

# 1. What the schema refuses.
invalid = Website::ROOT.glob('test/invalid/*.xml').sort
invalid.each do |file|
  rule = expected.call(file)
  out, ok = Website.capture('sxml', 'validate', "--schema=#{Website::SCHEMA}", file)
  if ok
    failures << "#{file.basename}: valid, but must be refused (#{rule})"
  elsif !out.include?(" #{rule}")
    failures << "#{file.basename}: refused, but not by #{rule}:\n#{out}"
  end
end
puts "website: the schema refuses #{invalid.size - failures.size} of #{invalid.size} invalid documents, each by its rule"

# 2. What the build refuses.
broken = Website::ROOT.glob('test/broken-*/site.xml').sort
broken.each do |site|
  name = site.dirname.basename
  message = expected.call(site)
  Dir.mktmpdir('website-test') do |dir|
    # a site with a capture of the command beside it (cli.xml) is built with it
    capture = site.dirname.join('cli.xml')
    cli = capture.file? ? ["--param=cli=#{capture}"] : []
    out, ok = Website.capture('sxml', 'transform', "--result-directory=#{dir}", *cli, Website::STYLESHEET, site)
    failures << "#{name}: built, but must stop at #{message.inspect}" if ok
    failures << "#{name}: stopped, but without #{message.inspect}:\n#{out}" if !ok && !out.include?(message)
  end
end
puts "website: the build refuses #{broken.size} sites, each with its message (#{broken.map { |site| site.dirname.basename }.join(', ')})"

# 3. The build, and its internal links.
Website.build!
pages = Website::SITE.glob('**/*.html').to_h { |file| [file, file.read] }
ids = ->(file) { pages.fetch(file, '').scan(/\sid="([^"]+)"/).flatten }
resolve = lambda do |path|
  file = Website::SITE.join(path.delete_prefix('/'))
  # "/x/" is x/index.html; "/x" the file x, x.html ("/ns/site") or x/index.html
  [path.end_with?('/') ? file.join('index.html') : file, Pathname.new("#{file}.html"), file.join('index.html')].find(&:file?)
end
links = 0
pages.each do |file, html|
  # attributes of the page's tags only: a code block's text (an SCXML
  # <invoke src="...">) is escaped, so its "<" opens no tag
  tags = html.scan(/<[a-zA-Z][^>]*>/)
  tags.flat_map { |tag| tag.scan(/\s(?:href|src|srcset|data-src)="([^"]*)"/).flatten }.each do |url|
    next if url.match?(%r{\A[a-z]+:}) # another site's: not checked here

    links += 1
    path, anchor = url.split('#', 2)
    path = path.sub(/\?.*/, '') # a version query names the same file
    target = path.empty? ? file : resolve.call(path)
    if target.nil?
      failures << "#{file.relative_path_from(Website::SITE)}: #{url}: no such file in the build"
    elsif anchor && !ids.call(target).include?(anchor)
      failures << "#{file.relative_path_from(Website::SITE)}: #{url}: no id #{anchor.inspect} there"
    end
  end
end
puts "website: #{links} links and assets in #{pages.size} pages resolve"

# 3b. The site for agents (render/markdown.xsl): every page but the 404 has
#     its Markdown beside its HTML, which names it; llms.txt lists each
#     once; every link of the site's own origin in llms.txt, llms-full.txt
#     and the Markdown resolves to a file of the build, and its #anchor to
#     an id there (a Markdown file's ids are its <a id> anchors); and each
#     page's Markdown holds a fence for every code block of its content.
#     /copywriter/ is the copywriter's own page, not indexed: no Markdown.
origin = Website::ORIGIN
markdown = pages.keys.reject { |file| file.basename.to_s == '404.html' || file.dirname.basename.to_s == 'copywriter' }.to_h { |file| [file, file.sub_ext('.md')] }
llms = Website::SITE.join('llms.txt').read
agent_files = [Website::SITE.join('llms.txt'), Website::SITE.join('llms-full.txt'), *markdown.values.select(&:file?)]
markdown.each do |html, md|
  name = md.relative_path_from(Website::SITE)
  url = "#{origin}/#{name}"
  next failures << "#{name}: no Markdown beside #{html.basename}" unless md.file?

  failures << "#{html.relative_path_from(Website::SITE)}: names no Markdown alternate" unless pages[html].include?(%(type="text/markdown" href="/#{name}"))
  count = llms.scan("](#{url})").size
  failures << "llms.txt: lists #{name} #{count} times, not once" unless count == 1
end
md_ids = ->(file) { file.extname == '.md' ? file.read.scan(/<a id="([^"]+)"><\/a>/).flatten : ids.call(file) }
agent_links = 0
agent_files.each do |file|
  file.read.scan(/\]\((#{Regexp.escape(origin)}[^)\s]*)\)|<(#{Regexp.escape(origin)}[^>\s]*)>/).flatten.compact.each do |url|
    agent_links += 1
    path, anchor = url.delete_prefix(origin).split('#', 2)
    target = Website::SITE.join(path.delete_prefix('/'))
    target = target.join('index.html') if path.end_with?('/')
    if !target.file?
      failures << "#{file.relative_path_from(Website::SITE)}: #{url}: no such file in the build"
    elsif anchor && !md_ids.call(target).include?(anchor)
      failures << "#{file.relative_path_from(Website::SITE)}: #{url}: no id #{anchor.inspect} there"
    end
  end
end
fences = 0
Website.documents.each do |document|
  text = document.read
  path = text[/<page\b[^>]*\spath="([^"]+)"/, 1] or next
  next if path == '/404'

  md = Website::SITE.join("#{path.delete_prefix('/')}#{'index' if path.end_with?('/')}.md")
  next unless md.file?

  want = text.scan(/<code\s[^>]*language="/).size
  got = md.read.scan(/^(`{3,})[a-z]/).size
  fences += got
  failures << "#{md.relative_path_from(Website::SITE)}: #{got} fenced blocks, but #{document.basename} has #{want} code blocks" unless got == want
end
puts "website: #{markdown.size} pages have their Markdown, each listed once in llms.txt; " \
     "#{agent_links} links for agents resolve; #{fences} code blocks fenced"

# 3c. Audiences and page kinds (README.md, "Audiences and page kinds"):
#     each page with a purpose has its <meta name="page-kind"> and one
#     <link rel="audience"> per audience, in its order; no page carries
#     the content's answers (they stay in content/); every audience file the
#     build wrote, and the index, validates against the published
#     audiences/audience.xsd; and every file a page links to is one of them.
#     Each such page links one voice, a file of voices/ for its kind, and
#     every voice file and the index validate against voices/voice.xsd.
PURPOSES_QUERY = <<~XQUERY
  declare namespace s = "https://www.tinyactors.dev/ns/site";
  array { for $page in /s:site/s:pages/s:page ! doc(resolve-uri(@src, base-uri(/s:site)))/s:page[s:purpose]
          return map { 'path': string($page/@path), 'kind': string($page/s:purpose/@kind),
                       'for': array { tokenize($page/s:purpose/@for) },
                       'sections': array { $page/s:section[@answers] ! map { 'id': string(@id), 'answers': normalize-space(@answers) } } } }
XQUERY
out, ok = Website.capture('sxml', 'xquery', "--context-item=#{Website::CONTENT.join('site.xml')}", '--method=json', "--expression=#{PURPOSES_QUERY}")
Website.fail!("reading the pages' purposes failed:\n#{out}") unless ok
purposes = JSON.parse(out)
audience_dir = Website::SITE.join('audiences')
audience_files = audience_dir.glob('*.xml').sort
out, ok = Website.capture('sxml', 'validate', "--schema=#{audience_dir.join('audience.xsd')}", *audience_files)
failures << "audiences/: not valid against audiences/audience.xsd:\n#{out}" unless ok && audience_files.size > 1
voice_dir = Website::SITE.join('voices')
voice_files = voice_dir.glob('*.xml').sort
out, ok = Website.capture('sxml', 'validate', "--schema=#{voice_dir.join('voice.xsd')}", *voice_files)
failures << "voices/: not valid against voices/voice.xsd:\n#{out}" unless ok && voice_files.size > 1
linked = 0
purposes.each do |purpose|
  file = Website::SITE.join("#{purpose['path'].delete_prefix('/')}#{'index' if purpose['path'].end_with?('/')}.html")
  html = file.read
  name = file.relative_path_from(Website::SITE)
  failures << "#{name}: no <meta name=\"page-kind\" content=\"#{purpose['kind']}\">" unless html.include?(%(<meta name="page-kind" content="#{purpose['kind']}">))
  hrefs = html.scan(/<link rel="audience" href="([^"]+)">/).flatten
  want = purpose['for'].map { |id| "/audiences/#{id}.xml" }
  failures << "#{name}: links the audiences #{hrefs.inspect}, not #{want.inspect}" unless hrefs == want
  hrefs.each { |href| failures << "#{name}: #{href}: no such audience file" unless audience_dir.join(File.basename(href)).file? }
  voices = html.scan(/<link rel="voice" href="([^"]+)">/).flatten
  failures << "#{name}: links #{voices.size} voices, not one" unless voices.size == 1
  voices.each do |href|
    file = voice_dir.join(File.basename(href))
    if !file.file? then failures << "#{name}: #{href}: no such voice file"
    elsif !file.read.match?(/kinds="[^"]*\b#{Regexp.escape(purpose['kind'])}\b/) then failures << "#{name}: #{href} is not a voice for #{purpose['kind']} pages"
    end
  end
  linked += hrefs.size
  failures << "#{name}: publishes the content's answers (data-answers, data-kind or page-answers)" if html.match?(/data-answers=|data-kind=|name="page-answers"/)
end
puts "website: #{purposes.size} pages name their kind, their voice and #{linked} audience links; #{audience_files.size} audience files valid against audience.xsd, #{voice_files.size} voice files against voice.xsd"

# 3d. Published URLs keep working (published-urls.txt): every path the
#     sitemap ever held is a page or file of the build, or a redirect of
#     _redirects to one; every path of this build's sitemap is in the file,
#     so a new page is added to it; and each page "/x/" has its "/x"
#     redirect, within Cloudflare's 2,000 static redirects.
redirects = Website::SITE.join('_redirects').readlines(chomp: true).to_h { |line| line.split.first(2) }
sitemap = Website.sitemap_paths
published = Website.published_paths
published.each do |path|
  next if resolve.call(path)

  target = redirects[path]
  if target.nil?
    failures << "published-urls.txt: #{path} is neither a page of the build nor a redirect of _redirects (Website::MOVED)"
  elsif !resolve.call(target.split('#').first)
    failures << "published-urls.txt: #{path} redirects to #{target}, which is no file of the build"
  end
end
(sitemap - published).each { |path| failures << "published-urls.txt: lacks #{path}, which the sitemap lists: append it" }
redirects.each { |from, to| failures << "_redirects: #{from} goes to #{to}, which is no file of the build" unless resolve.call(to.split('#').first) }
sitemap.select { |path| path.end_with?('/') && path != '/' }.each do |path|
  failures << "_redirects: no 301 from #{path.delete_suffix('/')} to #{path}" unless redirects[path.delete_suffix('/')] == path
end
failures << "_redirects: #{redirects.size} redirects, more than Cloudflare's 2,000" if redirects.size > 2000
puts "website: #{published.size} published URLs resolve; the sitemap's #{sitemap.size} paths are among them; #{redirects.size} redirects land on files"

# 3e. Namespaces of the site's origin resolve: every one a document of the
#     build or its sources names has its page; each schema of schema/ is
#     published, and its namespace's page links it; the CLI's JSON Schema
#     is served at the path of its $id.
namespace = %r{#{Regexp.escape(origin)}/ns(?:/[a-z0-9-]+)+}
sources = [*Website::ROOT.glob('{schema,render}/*.{xsd,xsl,xq}'), *Website.documents,
           *Website::SITE.glob('**/*.{xml,xsd,html}').reject { |file| file.to_s.include?('/vendor/') || file.to_s.include?('/copywriter/') }]
names = sources.flat_map { |file| file.read.scan(namespace) }.uniq.sort
names.each do |uri|
  failures << "#{uri}: a namespace with no page (site.xml, <namespaces>)" unless Website::SITE.join("#{uri.delete_prefix(origin).delete_prefix('/')}.html").file?
end
Website::ROOT.glob('schema/*.xsd').each do |schema|
  target = schema.read[/targetNamespace="([^"]+)"/, 1]
  copy = Website::SITE.glob("**/#{schema.basename}").find { |file| file.read == schema.read }
  next failures << "#{schema.basename}: not published" unless copy
  page = Website::SITE.join("#{target.delete_prefix(origin).delete_prefix('/')}.html")
  href = "#{origin}/#{copy.relative_path_from(Website::SITE)}"
  failures << "#{target}: its page does not link its schema, #{href}" unless page.file? && page.read.include?(%(href="#{href}"))
end
Website::SITE.glob('cli/**/run.schema.json').each do |file|
  id = JSON.parse(file.read)['$id']
  served = Website::SITE.join(URI(id).path.delete_prefix('/'))
  failures << "#{file.relative_path_from(Website::SITE)}: not served at its $id's path, #{URI(id).path}" unless served.file? && served.read == file.read
  puts "website: note: run.schema.json's $id names #{URI(id).host}, the site is #{URI(origin).host}" unless URI(id).host == URI(origin).host
end
puts "website: #{names.size} namespaces of #{origin} have their pages; the schemas are published and linked"

# 3f. sitemap.xml's <lastmod>: every page's, the date build/dates.xml gives
#     it, not after today; the changelog's Atom feed: an entry per release
#     of each package, each linking a release on the changelog page, which
#     links the feed in its head.
today = Time.now.utc.strftime('%Y-%m-%d')
dates = Website::DATES.read.scan(/<page path="([^"]+)" date="([^"]+)"/).to_h
lastmods = Website::SITE.join('sitemap.xml').read.scan(%r{<loc>#{Regexp.escape(origin)}([^<]*)</loc>\s*(?:<lastmod>([^<]*)</lastmod>)?}).to_h
lastmods.each do |path, date|
  if date.nil? || !date.match?(/\A\d{4}-\d{2}-\d{2}\z/) then failures << "sitemap.xml: #{path} has no <lastmod> date"
  elsif date > today then failures << "sitemap.xml: #{path}'s <lastmod> #{date} is after today"
  elsif dates[path] && dates[path] != date then failures << "sitemap.xml: #{path}'s <lastmod> is #{date}, build/dates.xml says #{dates[path]}"
  end
end
changelog = pages.find { |_, html| html.include?('class="changelog"') }
feed = Website::SITE.join('changelog/feed.xml')
if changelog.nil? || !feed.file?
  failures << 'changelog: no page holds the changelog, or it has no feed.xml'
else
  failures << "#{changelog[0].relative_path_from(Website::SITE)}: does not link its feed" unless changelog[1].include?('<link rel="alternate" type="application/atom+xml" href="/changelog/feed.xml"')
  out, ok = Website.capture('sxml', 'xquery', "--context-item=#{feed}", '--method=json',
                            '--expression=declare namespace a = "http://www.w3.org/2005/Atom"; array { /a:feed/a:entry/a:link[@rel = "alternate"]/@href ! string() }')
  if !ok then failures << "changelog/feed.xml: not XML:\n#{out}"
  else
    links = JSON.parse(out)
    want = Website::CONTENT.join('site.xml').read.scan(/<package\b[^>]*\schangelog="([^"]+)"/).flatten
                   .sum { |file| Website::CONTENT.join(file).read.scan(/^## \[[^\]]+\] - \d{4}-\d{2}-\d{2}$/).size }
    failures << "changelog/feed.xml: #{links.size} entries, but the packages' changelogs have #{want} releases" unless links.size == want
    links.each do |href|
      failures << "changelog/feed.xml: #{href}: no such release on the changelog page" unless ids.call(changelog[0]).include?(href.split('#', 2)[1])
    end
  end
  failures << '_headers: no Atom type for /changelog/feed.xml' unless Website::SITE.join('_headers').read.include?("/changelog/feed.xml\n  Content-Type: application/atom+xml")
end
puts "website: #{lastmods.size} sitemap entries have their <lastmod>; the changelog's feed lists every release"

# 3g. /.well-known/security.txt (RFC 9116): Contact, an Expires within a
#     year of now and after it, the Canonical URL of the file itself.
security = Website::SITE.join('.well-known/security.txt')
if security.file?
  fields = security.read.lines.to_h { |line| line.chomp.split(': ', 2) }
  expires = Time.iso8601(fields['Expires'].to_s) rescue nil
  failures << 'security.txt: no Contact' unless fields['Contact'].to_s.start_with?('https://')
  failures << "security.txt: Expires #{fields['Expires'].inspect} is not within the coming year" unless expires && expires > Time.now && expires <= Time.now + (366 * 24 * 60 * 60)
  failures << 'security.txt: Canonical is not its own URL' unless fields['Canonical'] == "#{origin}/.well-known/security.txt"
  failures << 'security.txt: no Preferred-Languages' unless fields['Preferred-Languages']
else
  failures << 'build/site/.well-known/security.txt: missing'
end
puts 'website: /.well-known/security.txt has its Contact, Expires and Canonical'

# 4. The examples, run: every directory under examples/ that holds an
#    output.txt is a program, its package.json's "main" or main.mjs; with
#    a browser.mjs, that too, under Node.js with tools/file-fetch.mjs (its
#    fetch of the chart beside it reads the file); with a pyproject.toml it
#    holds main.py too, run with uv against its
#    uv.lock (the PyPI package), and with a main.c that too, built against
#    tinyactors-core's newest release (Website.c_release): each must print
#    the same output.txt.
programs = Website::EXAMPLES.glob('*/**/output.txt').map(&:dirname).sort
Website::EXAMPLES.children.select(&:directory?).each do |root|
  next if !root.join('package.json').file? || root.join('node_modules/.package-lock.json').file?

  Website.run('npm', 'ci', '--no-audit', '--no-fund', chdir: root)
end
programs.each do |dir|
  package = dir.join('package.json')
  main = (package.file? && package.read[/"main":\s*"([^"]+)"/, 1]) || 'main.mjs'
  name = dir.relative_path_from(Website::EXAMPLES)
  Website.fail!("examples/#{name}: no #{main}") unless dir.join(main).file?
  out, ok = Website.capture('node', main, chdir: dir)
  want = dir.join('output.txt').read
  if !ok
    failures << "examples/#{name}: #{main} failed:\n#{out}"
  elsif out != want
    failures << "examples/#{name}: #{main} printed\n#{out}but output.txt says\n#{want}"
  end
  if dir.join('browser.mjs').file?
    out, ok = Website.capture('node', '--import', Website::ROOT.join('tools/file-fetch.mjs'), 'browser.mjs', chdir: dir)
    if !ok
      failures << "examples/#{name}: browser.mjs failed:\n#{out}"
    elsif out != want
      failures << "examples/#{name}: browser.mjs printed\n#{out}but output.txt says\n#{want}"
    end
  end
  next unless dir.join('pyproject.toml').file?

  Website.fail!("examples/#{name}: a pyproject.toml, but no main.py") unless dir.join('main.py').file?
  out, ok = Website.capture('uv', 'run', '--locked', '--quiet', 'python', 'main.py', chdir: dir)
  if !ok
    failures << "examples/#{name}: main.py failed:\n#{out}"
  elsif out != want
    failures << "examples/#{name}: main.py printed\n#{out}but output.txt says\n#{want}"
  end
  next unless dir.join('main.c').file?

  begin
    program = Website.c_program(dir, name.to_s.tr('/', '-'))
    out, ok = Website.capture(program, chdir: dir)
    if !ok
      failures << "examples/#{name}: main.c's program failed:\n#{out}"
    elsif out != want
      failures << "examples/#{name}: main.c printed\n#{out}but output.txt says\n#{want}"
    end
  rescue Toolchain::Error => e
    failures << "examples/#{name}: main.c did not build:\n#{e.message}"
  end
end
also = { 'browsers' => 'browser.mjs', 'Python' => 'pyproject.toml', 'C' => 'main.c' }
            .map { |language, file| "#{programs.count { |dir| dir.join(file).file? }} in #{language}" }
puts "website: #{programs.size} example programs ran and printed their output.txt, and of them #{also.join(', ')} too " \
     "(tinyactors-core #{Website.c_release.parent.basename})"

# 4b. The version the site advertises is published: the newest release in
#     tinyactors-napi's changelog is the @tinyactors/wasm every example
#     installs from npm. A release's changelog section is committed before
#     its packages are approved on npm, so an install command must not show
#     it until the examples run on it.
newest = Website::ROOT.join('../tinyactors-napi/CHANGELOG.md').read[/^## \[([^\]]+)\] - /, 1]
pinned = Website::EXAMPLES.glob('*/package-lock.json').filter_map do |lock|
  version = JSON.parse(lock.read).dig('packages', 'node_modules/@tinyactors/wasm', 'version')
  [lock.dirname.basename.to_s, version] if version
end
pinned.each do |name, version|
  next if version == newest

  failures << "examples/#{name}: installs @tinyactors/wasm #{version}, but the site shows tinyactors-napi's newest release, #{newest}: " \
              "update the examples to it once npm has it (npm install @tinyactors/wasm@#{newest})"
end
puts "website: the examples install @tinyactors/wasm #{newest}, the version the site shows"

# 4c. The live chat runs the tutorial's charts: its charts/step-5 and
#     charts/step-9 are copies of steps 5 and 9, byte for byte, so the page
#     runs what the tutorial built.
names = ->(dir) { dir.glob('*.scxml').map { |file| file.basename.to_s }.sort }
{ 'step-5' => '5-hibernation', 'step-9' => '9-direct-messages' }.each do |copy, step|
  live = Website::EXAMPLES.join('chat-live/charts', copy)
  tutorial = Website::EXAMPLES.join('chat', step, 'charts')
  if names.call(live) != names.call(tutorial)
    failures << "examples/chat-live/charts/#{copy}: holds #{names.call(live).join(', ')}, #{step} holds #{names.call(tutorial).join(', ')}"
  end
  names.call(tutorial).each do |name|
    next if !live.join(name).file? || live.join(name).read == tutorial.join(name).read

    failures << "examples/chat-live/charts/#{copy}/#{name}: differs from examples/chat/#{step}/charts/#{name}: copy it again"
  end
end
puts "website: the live chat's charts are the tutorial's steps 5 and 9"

# 5. The guides' examples a page transcludes: in each <example>, a
#    javascript <code src="...md" section fence> is run in examples/guides
#    against the published package, and must print the output fence the
#    example shows beside it. Sections and fences are read as
#    render/site.xsl reads them.
def markdown_section(file, heading)
  lines = file.read.split(/\r?\n/, -1)
  start = lines.index("## #{heading}") or Website.fail!("#{file}: no section \"## #{heading}\"")
  after = lines[(start + 1)..]
  after.take_while { |line| !line.start_with?('## ') }
end

def markdown_fence(file, heading, n)
  lines = markdown_section(file, heading)
  marks = lines.each_index.select { |i| lines[i].start_with?('```') }
  Website.fail!("#{file}: \"## #{heading}\" has no fence #{n}") if marks.size < 2 * n
  lines[(marks[2 * n - 2] + 1)...marks[2 * n - 1]].join("\n")
end

guides = Website::EXAMPLES.join('guides')
Website.run('npm', 'ci', '--no-audit', '--no-fund', chdir: guides) unless guides.join('node_modules/.package-lock.json').file?
transcluded = 0
Website.documents.each do |document|
  document.read.scan(%r{<example>(.*?)</example>}m).flatten.each do |example|
    codes = example.scan(/<code\s([^>]*?)\/?>/).flatten.map { |attributes| attributes.scan(/([\w-]+)="([^"]*)"/).to_h }
    program = codes.find { |code| code['src']&.end_with?('.md') && code['language'] == 'javascript' }
    output = codes.find { |code| code['src']&.end_with?('.md') && code['role'] == 'output' }
    next unless program && output

    source = ->(code) { document.dirname.join(code['src']).expand_path }
    file = guides.join("#{transcluded}.transcluded.mjs")
    file.write("#{markdown_fence(source.call(program), program['section'], program['fence'].to_i)}\n")
    want = markdown_fence(source.call(output), output['section'], output['fence'].to_i)
    out, ok = Website.capture('node', file.basename, chdir: guides)
    file.delete
    name = "#{document.basename}: \"#{program['section']}\" fence #{program['fence']}"
    failures << "#{name}: failed:\n#{out}" unless ok
    failures << "#{name}: printed\n#{out}but the guide's output is\n#{want}" if ok && out.strip != want.strip
    transcluded += 1
  end
end
puts "website: #{transcluded} transcluded guide examples ran and printed their guide's output"

# 5b. The examples written in the content: in each <example>, a javascript
#     <code> whose text is the program and a <code role="output"> whose text
#     is what it prints. Each runs in examples/guides against the published
#     packages, its indentation removed as render/site.xsl removes it. Code
#     shown outside an <example>, or without its output (a fragment, a
#     program that needs a browser), is not run.
EXAMPLES_QUERY = <<~XQUERY
  array { for $example in //*:example
          let $program := $example/*:code[@language = 'javascript'][not(@src)][normalize-space(.) != '']
          let $output := $example/*:code[@role = 'output'][not(@src)][normalize-space(.) != '']
          where exists($program) and exists($output)
          return map { 'section': string($example/ancestor::*:section/@id),
                       'program': string($program[1]), 'output': string($output[1]) } }
XQUERY
dedent = lambda do |text|
  lines = text.sub(/\A\s*\n/, '').sub(/\n\s*\z/, '').split("\n", -1)
  indent = lines.reject { |line| line.strip.empty? }.map { |line| line[/\A */].size }.min || 0
  lines.map { |line| line[indent..] || '' }.join("\n")
end
written = 0
Website.documents.each do |document|
  out, ok = Website.capture('sxml', 'xquery', "--context-item=#{document}", '--method=json', "--expression=#{EXAMPLES_QUERY}")
  Website.fail!("#{document}: reading its examples failed:\n#{out}") unless ok
  JSON.parse(out).each_with_index do |example, i|
    file = guides.join("#{written}.written.mjs")
    file.write("#{dedent.call(example['program'])}\n")
    out, ok = Website.capture('node', file.basename, chdir: guides)
    file.delete
    name = "#{document.relative_path_from(Website::CONTENT)}: section #{example['section']}, example #{i + 1}"
    want = dedent.call(example['output'])
    failures << "#{name}: failed:\n#{out}" unless ok
    failures << "#{name}: printed\n#{out}but the page's output is\n#{want}" if ok && out.strip != want.strip
    written += 1
  end
end
puts "website: #{written} examples written in the content ran and printed their output"

# 5c. The CLI section (mise/cli.rb), against the binary the build used:
#     the pinned release's, or TINYACTORS_CLI's for development. Every
#     command the binary lists has its page and Markdown, and every page
#     under /cli/ is the content's, or a command's under /cli/commands/; no page names a command
#     or an option the binary lacks (a code span or a shell block that
#     runs `tinyactors COMMAND ...`, or a span that starts with a command's
#     name or an option); every example of its help ran with a status its
#     exit table gives for an answer (0 or 1: 2 is a command line the
#     program refused, 3 a file it could not read); each transcript a page
#     shows is what the binary prints now; and the release the pages
#     describe is the one the site's install command names: the pin, and
#     tinyactors-core's newest release.
cli = Website::CLI
cli_xml = cli::DOCUMENT.read
commands = cli.commands
options = cli.options
known = options.values.flatten.uniq
commands.each do |command|
  %w[index.html index.md].each do |file|
    failures << "cli: the binary lists #{command}, and build/site/cli/commands/#{command}/#{file} is missing" unless Website::SITE.join('cli', 'commands', command, file).file?
  end
end
command_pages = Website::SITE.join('cli', 'commands').children.select { |dir| dir.directory? && dir.join('index.html').file? }.map { |dir| dir.basename.to_s }
(command_pages - commands).each { |name| failures << "cli: build/site/cli/commands/#{name}/ is the page of no command the binary lists" }
content_paths = Website.documents.filter_map { |document| document.read[%r{<page\b[^>]*\spath="(/cli/[a-z/-]*)"}, 1] }
Website::SITE.join('cli').glob('**/index.html').map { |file| "/#{file.dirname.relative_path_from(Website::SITE)}/" }.each do |path|
  next if content_paths.include?(path) || path.start_with?('/cli/commands/')
  failures << "cli: build/site#{path} is neither a page of the content nor a command's"
end
named = 0
unescape = ->(text) { text.gsub('&lt;', '<').gsub('&gt;', '>').gsub('&quot;', '"').gsub('&amp;', '&') }
Website.documents.each do |document|
  text = document.read
  spans = text.scan(%r{<code>([^<]*)</code>}).flatten + text.scan(%r{<code\s[^>]*language="shell"[^>]*>([^<]*)</code>}).flatten
  spans.map(&unescape).each do |span|
    span.split(/\s*\|\s*|\n/).each do |segment|
      words = segment.split
      runs = segment.match?(/(?:\A|\s)tinyactors\s/)
      command = runs ? segment[/(?:\A|\s)tinyactors\s+(?:-\S+\s+)*([^\s<>]+)/, 1] : (words.first if commands.include?(words.first))
      if runs && !commands.include?(command)
        failures << "#{document.relative_path_from(Website::ROOT)}: `#{segment}` names the command #{command.inspect}, which tinyactors does not have"
        next
      end
      next unless command || segment.start_with?('-')

      allowed = command ? options[command] : known
      segment.scan(/(?<![\w\-.\/=])--?[A-Za-z][\w-]*/).each do |token|
        named += 1
        # flags clustered (-Wf) or a value attached (-cNAME)
        next if allowed.include?(token) || allowed.include?(token[0, 2])

        failures << "#{document.relative_path_from(Website::ROOT)}: `#{segment}` names #{token}, which tinyactors #{command} does not have".squeeze(' ')
      end
    end
  end
end
examples = cli_xml.scan(/<example line="([^"]*)" caption="[^"]*" status="(\d+)">/)
examples.each do |line, status|
  failures << "cli: the help's example `#{unescape.call(line)}` exited with #{status}" if status.to_i > 1
end
cli::TRANSCRIPTS.each do |file, line|
  shown = Website.documents.any? { |document| document.read.include?(line.gsub('<', '&lt;')) }
  failures << "cli: no page shows `#{line}`, whose output is examples/cli/#{file}" unless shown
  out, = cli.shell(line)
  want = cli::FIXTURE.join(file).read
  failures << "cli: `#{line}` printed\n#{out}but examples/cli/#{file} says\n#{want}" unless out == want
end
steps = 0
cli::WALKTHROUGHS.each do |name, walkthrough|
  page = Website::CONTENT.join('pages', walkthrough[:page]).read
  cli.walkthrough!(name).each do |step|
    steps += 1
    where = "#{walkthrough[:page]}: `#{step[:line]}`"
    failures << "cli: #{walkthrough[:page]} does not show `#{step[:line]}`" unless page.include?(step[:line].gsub('<', '&lt;').gsub('>', '&gt;'))
    failures << "cli: #{where} exited with #{step[:exited]}, not #{step[:status] || 0}" unless step[:exited] == (step[:status] || 0)
    want = cli::FIXTURE.join(name, step[:output]).read
    failures << "cli: #{where} printed\n#{step[:printed]}but examples/cli/#{name}/#{step[:output]} says\n#{want}" unless step[:printed] == want
  end
end
version = cli_xml[/<cli version="([^"]+)"/, 1]
core = Website::REPO.join('tinyactors-core/CHANGELOG.md').read[/^## \[([^\]]+)\] - /, 1]
if cli.override
  puts "website: cli: #{cli::OVERRIDE} names tinyactors #{version}, not the pinned release #{cli.pin} " \
       "(tinyactors-core's newest is #{core}): run the tests again without it once #{cli.pin} is published"
else
  failures << "cli: the build ran tinyactors #{version}, but mise.toml pins #{cli.pin}" unless version == cli.pin
  failures << "cli: mise.toml pins tinyactors-core #{cli.pin}, but the install command shows its newest release, #{core}" unless cli.pin == core
end
puts "website: cli: tinyactors #{version}: #{commands.size} commands have their pages; #{examples.size} examples of its help ran; " \
     "#{named} options the content names checked against it; #{cli::TRANSCRIPTS.size} transcripts and #{steps} steps of #{cli::WALKTHROUGHS.size} walkthroughs match"

# 6. The components' pure parts (their rendering runs in a browser).
out, ok = Website.capture('node', Website::ROOT.join('test/components.mjs'))
failures << "test/components.mjs failed:\n#{out}" unless ok
puts "website: #{out.strip}" if ok

# 7. The presence server (presence/server.mjs) on a free port against two
#    tabs: origins, tickets, greetings, duplicated tabs, reloads.
presence = Website::ROOT.join('presence')
Website.run('npm', 'ci', '--no-audit', '--no-fund', chdir: presence) unless presence.join('node_modules/.package-lock.json').file?
out, ok = Website.capture('node', 'smoke.mjs', chdir: presence)
failures << "presence/smoke.mjs failed:\n#{out}" unless ok
puts "website: the presence server passes its #{out.lines.count { |line| line.start_with?('ok: ') }} smoke checks" if ok

unless failures.empty?
  warn failures.map { |failure| "website: #{failure}" }.join("\n")
  exit 1
end
puts 'website: ok'
