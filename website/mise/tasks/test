#!/usr/bin/env ruby
#MISE description="Test the website: the content against its schema, the refusals the schema and the build must make, the build's internal links and anchors, and every example a page shows, run"
#MISE sources=["content/**/*", "presence/**/*.{mjs,scxml,json}", ".agents/skills/ant-animation/scripts/ant.mjs", "schema/**/*", "render/**/*", "style/**/*", "icons/**/*", "components/**/*", "../tinyactors-napi/docs/guide/*.md", "../tinyactors-napi/CHANGELOG.md", "../tinyactors-cpython/CHANGELOG.md", "../tinyactors-core/CHANGELOG.md", "examples/**/*.{scxml,mjs,txt,json}", "test/**/*", "tools/**/*", "package.json", "package-lock.json", "mise/website.rb", "mise/tasks/*", "../.agents/skills/tinyactors-design/styles.css", "../.agents/skills/tinyactors-design/tokens/**/*", "../.agents/skills/tinyactors-design/components/components.css", "../.agents/skills/tinyactors-design/assets/**/*"]
#MISE outputs={auto=true}
# vim:ft=ruby

# 1. test/invalid/: each document must be refused by the schema, with the
#    rule its comment names (`expect: <rule>`): what content must never
#    say (a claim with no source, a styling attribute, a paragraph of
#    three sentences, ...). The rule may go on with the start of the
#    message, to name which of a type's assertions must refuse it (each
#    assertion's test opens with a comment saying what it checks).
# 2. test/broken-*/: sites the build must stop at, naming why (`expect:
#    <message>`): a link to a page the site does not list, a purpose for an
#    audience site.xml does not define, a section that answers a need no
#    audience has.
# 3. The build (validation first), then every link and asset a page names
#    on this site resolves to a file, and every #anchor to an id there;
#    and the site for agents: each page's Markdown, llms.txt (3b).
# 4. Each example: its packages installed from its package-lock.json (npm
#    ci), then each program in it (a directory with an output.txt) run, and
#    what it prints compared with its output.txt, which the page shows.
#    A page's code is these files themselves (<code src>), so what a page
#    shows is what ran here.
# 5. The guides' examples a page transcludes, run (see below).
# 6. test/components.mjs: the trace view's tree, time format and axis. The
#    components' rendering, and the live examples in a page, run in a
#    browser, which this task does not start.

require 'json'
require_relative '../website'
require 'tmpdir'

failures = []
expected = ->(file) { file.read[/expect: (.+?)\s*-->/m, 1] or Website.fail!("#{file}: no `expect:` in its comment") }

# 1. What the schema refuses.
invalid = Website::ROOT.glob('test/invalid/*.xml').sort
invalid.each do |file|
  rule = expected.call(file)
  out, ok = Website.capture('sxml', 'validate', "--schema=#{Website::SCHEMA}", file)
  if ok
    failures << "#{file.basename}: valid, but must be refused (#{rule})"
  elsif !out.include?(" #{rule}")
    failures << "#{file.basename}: refused, but not by #{rule}:\n#{out}"
  end
end
puts "website: the schema refuses #{invalid.size - failures.size} of #{invalid.size} invalid documents, each by its rule"

# 2. What the build refuses.
broken = Website::ROOT.glob('test/broken-*/site.xml').sort
broken.each do |site|
  name = site.dirname.basename
  message = expected.call(site)
  Dir.mktmpdir('website-test') do |dir|
    out, ok = Website.capture('sxml', 'transform', "--result-directory=#{dir}", Website::STYLESHEET, site)
    failures << "#{name}: built, but must stop at #{message.inspect}" if ok
    failures << "#{name}: stopped, but without #{message.inspect}:\n#{out}" if !ok && !out.include?(message)
  end
end
puts "website: the build refuses #{broken.size} sites, each with its message (#{broken.map { |site| site.dirname.basename }.join(', ')})"

# 3. The build, and its internal links.
Website.build!
pages = Website::SITE.glob('**/*.html').to_h { |file| [file, file.read] }
ids = ->(file) { pages.fetch(file, '').scan(/\sid="([^"]+)"/).flatten }
resolve = lambda do |path|
  file = Website::SITE.join(path.delete_prefix('/'))
  [path.end_with?('/') ? file.join('index.html') : file, file.join('index.html')].find(&:file?)
end
links = 0
pages.each do |file, html|
  # attributes of the page's tags only: a code block's text (an SCXML
  # <invoke src="...">) is escaped, so its "<" opens no tag
  tags = html.scan(/<[a-zA-Z][^>]*>/)
  tags.flat_map { |tag| tag.scan(/\s(?:href|src|srcset|data-src)="([^"]*)"/).flatten }.each do |url|
    next if url.match?(%r{\A[a-z]+:}) # another site's: not checked here

    links += 1
    path, anchor = url.split('#', 2)
    path = path.sub(/\?.*/, '') # a version query names the same file
    target = path.empty? ? file : resolve.call(path)
    if target.nil?
      failures << "#{file.relative_path_from(Website::SITE)}: #{url}: no such file in the build"
    elsif anchor && !ids.call(target).include?(anchor)
      failures << "#{file.relative_path_from(Website::SITE)}: #{url}: no id #{anchor.inspect} there"
    end
  end
end
puts "website: #{links} links and assets in #{pages.size} pages resolve"

# 3b. The site for agents (render/markdown.xsl): every page but the 404 has
#     its Markdown beside its HTML, which names it; llms.txt lists each
#     once; every link of the site's own origin in llms.txt, llms-full.txt
#     and the Markdown resolves to a file of the build, and its #anchor to
#     an id there (a Markdown file's ids are its <a id> anchors); and each
#     page's Markdown holds a fence for every code block of its content.
#     /copywriter/ is the copywriter's own page, not indexed: no Markdown.
origin = Website::ORIGIN
markdown = pages.keys.reject { |file| file.basename.to_s == '404.html' || file.dirname.basename.to_s == 'copywriter' }.to_h { |file| [file, file.sub_ext('.md')] }
llms = Website::SITE.join('llms.txt').read
agent_files = [Website::SITE.join('llms.txt'), Website::SITE.join('llms-full.txt'), *markdown.values.select(&:file?)]
markdown.each do |html, md|
  name = md.relative_path_from(Website::SITE)
  url = "#{origin}/#{name}"
  next failures << "#{name}: no Markdown beside #{html.basename}" unless md.file?

  failures << "#{html.relative_path_from(Website::SITE)}: names no Markdown alternate" unless pages[html].include?(%(type="text/markdown" href="/#{name}"))
  count = llms.scan("](#{url})").size
  failures << "llms.txt: lists #{name} #{count} times, not once" unless count == 1
end
md_ids = ->(file) { file.extname == '.md' ? file.read.scan(/<a id="([^"]+)"><\/a>/).flatten : ids.call(file) }
agent_links = 0
agent_files.each do |file|
  file.read.scan(/\]\((#{Regexp.escape(origin)}[^)\s]*)\)|<(#{Regexp.escape(origin)}[^>\s]*)>/).flatten.compact.each do |url|
    agent_links += 1
    path, anchor = url.delete_prefix(origin).split('#', 2)
    target = Website::SITE.join(path.delete_prefix('/'))
    target = target.join('index.html') if path.end_with?('/')
    if !target.file?
      failures << "#{file.relative_path_from(Website::SITE)}: #{url}: no such file in the build"
    elsif anchor && !md_ids.call(target).include?(anchor)
      failures << "#{file.relative_path_from(Website::SITE)}: #{url}: no id #{anchor.inspect} there"
    end
  end
end
fences = 0
Website.documents.each do |document|
  text = document.read
  path = text[/<page\b[^>]*\spath="([^"]+)"/, 1] or next
  next if path == '/404'

  md = Website::SITE.join("#{path.delete_prefix('/')}#{'index' if path.end_with?('/')}.md")
  next unless md.file?

  want = text.scan(/<code\s[^>]*language="/).size
  got = md.read.scan(/^(`{3,})[a-z]/).size
  fences += got
  failures << "#{md.relative_path_from(Website::SITE)}: #{got} fenced blocks, but #{document.basename} has #{want} code blocks" unless got == want
end
puts "website: #{markdown.size} pages have their Markdown, each listed once in llms.txt; " \
     "#{agent_links} links for agents resolve; #{fences} code blocks fenced"

# 3c. Audiences and page kinds (README.md, "Audiences and page kinds"):
#     each page with a purpose has its <meta name="page-kind"> and one
#     <link rel="audience"> per audience, in its order; each section that
#     answers needs carries them as data-answers; every audience file the
#     build wrote, and the index, validates against the published
#     audiences/audience.xsd; and every file a page links to is one of them.
PURPOSES_QUERY = <<~XQUERY
  declare namespace s = "https://www.tinyactors.dev/ns/site";
  array { for $page in /s:site/s:pages/s:page ! doc(resolve-uri(@src, base-uri(/s:site)))/s:page[s:purpose]
          return map { 'path': string($page/@path), 'kind': string($page/s:purpose/@kind),
                       'for': array { tokenize($page/s:purpose/@for) },
                       'sections': array { $page/s:section[@answers] ! map { 'id': string(@id), 'answers': normalize-space(@answers) } } } }
XQUERY
out, ok = Website.capture('sxml', 'xquery', "--context-item=#{Website::CONTENT.join('site.xml')}", '--method=json', "--expression=#{PURPOSES_QUERY}")
Website.fail!("reading the pages' purposes failed:\n#{out}") unless ok
purposes = JSON.parse(out)
audience_dir = Website::SITE.join('audiences')
audience_files = audience_dir.glob('*.xml').sort
out, ok = Website.capture('sxml', 'validate', "--schema=#{audience_dir.join('audience.xsd')}", *audience_files)
failures << "audiences/: not valid against audiences/audience.xsd:\n#{out}" unless ok && audience_files.size > 1
linked = 0
purposes.each do |purpose|
  file = Website::SITE.join("#{purpose['path'].delete_prefix('/')}#{'index' if purpose['path'].end_with?('/')}.html")
  html = file.read
  name = file.relative_path_from(Website::SITE)
  failures << "#{name}: no <meta name=\"page-kind\" content=\"#{purpose['kind']}\">" unless html.include?(%(<meta name="page-kind" content="#{purpose['kind']}">))
  hrefs = html.scan(/<link rel="audience" href="([^"]+)">/).flatten
  want = purpose['for'].map { |id| "/audiences/#{id}.xml" }
  failures << "#{name}: links the audiences #{hrefs.inspect}, not #{want.inspect}" unless hrefs == want
  hrefs.each { |href| failures << "#{name}: #{href}: no such audience file" unless audience_dir.join(File.basename(href)).file? }
  linked += hrefs.size
  purpose['sections'].each do |section|
    failures << "#{name}: section #{section['id']} lacks data-answers=\"#{section['answers']}\"" unless html.match?(/<section id="#{Regexp.escape(section['id'])}"[^>]* data-answers="#{Regexp.escape(section['answers'])}"/)
  end
end
puts "website: #{purposes.size} pages name their kind and #{linked} audience links; #{audience_files.size} audience files valid against audience.xsd"

# 4. The examples, run: every directory under examples/ that holds an
#    output.txt is a program, its package.json's "main" or main.mjs.
programs = Website::EXAMPLES.glob('*/**/output.txt').map(&:dirname).sort
Website::EXAMPLES.children.select(&:directory?).each do |root|
  next if root.join('node_modules/.package-lock.json').file?

  Website.run('npm', 'ci', '--no-audit', '--no-fund', chdir: root)
end
programs.each do |dir|
  package = dir.join('package.json')
  main = (package.file? && package.read[/"main":\s*"([^"]+)"/, 1]) || 'main.mjs'
  name = dir.relative_path_from(Website::EXAMPLES)
  Website.fail!("examples/#{name}: no #{main}") unless dir.join(main).file?
  out, ok = Website.capture('node', main, chdir: dir)
  want = dir.join('output.txt').read
  if !ok
    failures << "examples/#{name}: #{main} failed:\n#{out}"
  elsif out != want
    failures << "examples/#{name}: #{main} printed\n#{out}but output.txt says\n#{want}"
  end
end
puts "website: #{programs.size} example programs ran and printed their output.txt"

# 4b. The version the site advertises is published: the newest release in
#     tinyactors-napi's changelog is the @tinyactors/wasm every example
#     installs from npm. A release's changelog section is committed before
#     its packages are approved on npm, so an install command must not show
#     it until the examples run on it.
newest = Website::ROOT.join('../tinyactors-napi/CHANGELOG.md').read[/^## \[([^\]]+)\] - /, 1]
pinned = Website::EXAMPLES.glob('*/package-lock.json').filter_map do |lock|
  version = JSON.parse(lock.read).dig('packages', 'node_modules/@tinyactors/wasm', 'version')
  [lock.dirname.basename.to_s, version] if version
end
pinned.each do |name, version|
  next if version == newest

  failures << "examples/#{name}: installs @tinyactors/wasm #{version}, but the site shows tinyactors-napi's newest release, #{newest}: " \
              "update the examples to it once npm has it (npm install @tinyactors/wasm@#{newest})"
end
puts "website: the examples install @tinyactors/wasm #{newest}, the version the site shows"

# 4c. The live chat runs the tutorial's charts: its charts/step-5 and
#     charts/step-9 are copies of steps 5 and 9, byte for byte, so the page
#     runs what the tutorial built.
names = ->(dir) { dir.glob('*.scxml').map { |file| file.basename.to_s }.sort }
{ 'step-5' => '5-hibernation', 'step-9' => '9-direct-messages' }.each do |copy, step|
  live = Website::EXAMPLES.join('chat-live/charts', copy)
  tutorial = Website::EXAMPLES.join('chat', step, 'charts')
  if names.call(live) != names.call(tutorial)
    failures << "examples/chat-live/charts/#{copy}: holds #{names.call(live).join(', ')}, #{step} holds #{names.call(tutorial).join(', ')}"
  end
  names.call(tutorial).each do |name|
    next if !live.join(name).file? || live.join(name).read == tutorial.join(name).read

    failures << "examples/chat-live/charts/#{copy}/#{name}: differs from examples/chat/#{step}/charts/#{name}: copy it again"
  end
end
puts "website: the live chat's charts are the tutorial's steps 5 and 9"

# 5. The guides' examples a page transcludes: in each <example>, a
#    javascript <code src="...md" section fence> is run in examples/guides
#    against the published package, and must print the output fence the
#    example shows beside it. Sections and fences are read as
#    render/site.xsl reads them.
def markdown_section(file, heading)
  lines = file.read.split(/\r?\n/, -1)
  start = lines.index("## #{heading}") or Website.fail!("#{file}: no section \"## #{heading}\"")
  after = lines[(start + 1)..]
  after.take_while { |line| !line.start_with?('## ') }
end

def markdown_fence(file, heading, n)
  lines = markdown_section(file, heading)
  marks = lines.each_index.select { |i| lines[i].start_with?('```') }
  Website.fail!("#{file}: \"## #{heading}\" has no fence #{n}") if marks.size < 2 * n
  lines[(marks[2 * n - 2] + 1)...marks[2 * n - 1]].join("\n")
end

guides = Website::EXAMPLES.join('guides')
Website.run('npm', 'ci', '--no-audit', '--no-fund', chdir: guides) unless guides.join('node_modules/.package-lock.json').file?
transcluded = 0
Website.documents.each do |document|
  document.read.scan(%r{<example>(.*?)</example>}m).flatten.each do |example|
    codes = example.scan(/<code\s([^>]*?)\/?>/).flatten.map { |attributes| attributes.scan(/([\w-]+)="([^"]*)"/).to_h }
    program = codes.find { |code| code['src']&.end_with?('.md') && code['language'] == 'javascript' }
    output = codes.find { |code| code['src']&.end_with?('.md') && code['role'] == 'output' }
    next unless program && output

    source = ->(code) { document.dirname.join(code['src']).expand_path }
    file = guides.join("#{transcluded}.transcluded.mjs")
    file.write("#{markdown_fence(source.call(program), program['section'], program['fence'].to_i)}\n")
    want = markdown_fence(source.call(output), output['section'], output['fence'].to_i)
    out, ok = Website.capture('node', file.basename, chdir: guides)
    file.delete
    name = "#{document.basename}: \"#{program['section']}\" fence #{program['fence']}"
    failures << "#{name}: failed:\n#{out}" unless ok
    failures << "#{name}: printed\n#{out}but the guide's output is\n#{want}" if ok && out.strip != want.strip
    transcluded += 1
  end
end
puts "website: #{transcluded} transcluded guide examples ran and printed their guide's output"

# 5b. The examples written in the content: in each <example>, a javascript
#     <code> whose text is the program and a <code role="output"> whose text
#     is what it prints. Each runs in examples/guides against the published
#     packages, its indentation removed as render/site.xsl removes it. Code
#     shown outside an <example>, or without its output (a fragment, a
#     program that needs a browser), is not run.
EXAMPLES_QUERY = <<~XQUERY
  array { for $example in //*:example
          let $program := $example/*:code[@language = 'javascript'][not(@src)][normalize-space(.) != '']
          let $output := $example/*:code[@role = 'output'][not(@src)][normalize-space(.) != '']
          where exists($program) and exists($output)
          return map { 'section': string($example/ancestor::*:section/@id),
                       'program': string($program[1]), 'output': string($output[1]) } }
XQUERY
dedent = lambda do |text|
  lines = text.sub(/\A\s*\n/, '').sub(/\n\s*\z/, '').split("\n", -1)
  indent = lines.reject { |line| line.strip.empty? }.map { |line| line[/\A */].size }.min || 0
  lines.map { |line| line[indent..] || '' }.join("\n")
end
written = 0
Website.documents.each do |document|
  out, ok = Website.capture('sxml', 'xquery', "--context-item=#{document}", '--method=json', "--expression=#{EXAMPLES_QUERY}")
  Website.fail!("#{document}: reading its examples failed:\n#{out}") unless ok
  JSON.parse(out).each_with_index do |example, i|
    file = guides.join("#{written}.written.mjs")
    file.write("#{dedent.call(example['program'])}\n")
    out, ok = Website.capture('node', file.basename, chdir: guides)
    file.delete
    name = "#{document.relative_path_from(Website::CONTENT)}: section #{example['section']}, example #{i + 1}"
    want = dedent.call(example['output'])
    failures << "#{name}: failed:\n#{out}" unless ok
    failures << "#{name}: printed\n#{out}but the page's output is\n#{want}" if ok && out.strip != want.strip
    written += 1
  end
end
puts "website: #{written} examples written in the content ran and printed their output"

# 6. The components' pure parts (their rendering runs in a browser).
out, ok = Website.capture('node', Website::ROOT.join('test/components.mjs'))
failures << "test/components.mjs failed:\n#{out}" unless ok
puts "website: #{out.strip}" if ok

# 7. The presence server (presence/server.mjs) on a free port against two
#    tabs: origins, tickets, greetings, duplicated tabs, reloads.
presence = Website::ROOT.join('presence')
Website.run('npm', 'ci', '--no-audit', '--no-fund', chdir: presence) unless presence.join('node_modules/.package-lock.json').file?
out, ok = Website.capture('node', 'smoke.mjs', chdir: presence)
failures << "presence/smoke.mjs failed:\n#{out}" unless ok
puts "website: the presence server passes its #{out.lines.count { |line| line.start_with?('ok: ') }} smoke checks" if ok

unless failures.empty?
  warn failures.map { |failure| "website: #{failure}" }.join("\n")
  exit 1
end
puts 'website: ok'
