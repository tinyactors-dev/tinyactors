<?xml version="1.0" encoding="UTF-8"?>
<!-- A user. It tracks presence and reports each change to the workspace.
     It shows the roster the workspace sends. It joins rooms and posts to them.
     A join or a post counts as activity.
     A join of a room that does not exist fails with error.communication. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="user" initial="offline">
  <datamodel>
    <data id="name"/>
  </datamodel>
  <state id="offline">
    <onentry>
      <send target="tinyactors://chat/@workspace" event="status">
        <param name="user" expr="name"/>
        <param name="status" expr="'offline'"/>
      </send>
    </onentry>
    <transition event="connect" target="online"/>
  </state>
  <state id="online" initial="active">
    <transition event="disconnect" target="offline"/>
    <transition event="join">
      <send id="join" targetexpr="'tinyactors://chat/@room.' + _event.data.room" event="join">
        <param name="user" expr="name"/>
      </send>
      <raise event="activity"/>
    </transition>
    <transition event="joined">
      <send type="chat:client" event="joined">
        <param name="to" expr="name"/>
        <param name="room" expr="_event.data.room"/>
      </send>
    </transition>
    <transition event="error.communication" cond="_event.sendid === 'join'">
      <send type="chat:client" event="error">
        <param name="to" expr="name"/>
        <param name="reason" expr="'no such room'"/>
      </send>
    </transition>
    <transition event="post">
      <send targetexpr="'tinyactors://chat/@room.' + _event.data.room" event="post">
        <param name="user" expr="name"/>
        <param name="text" expr="_event.data.text"/>
      </send>
      <raise event="activity"/>
    </transition>
    <!-- before "roster": that descriptor matches roster.update too -->
    <transition event="roster.update">
      <send type="chat:client" event="roster.update">
        <param name="to" expr="name"/>
        <param name="user" expr="_event.data.user"/>
        <param name="status" expr="_event.data.status"/>
      </send>
    </transition>
    <transition event="roster">
      <send type="chat:client" event="roster">
        <param name="to" expr="name"/>
        <param name="roster" expr="_event.data.roster"/>
      </send>
    </transition>
    <transition event="message">
      <send type="chat:client" event="message">
        <param name="to" expr="name"/>
        <param name="room" expr="_event.data.room"/>
        <param name="from" expr="_event.data.from"/>
        <param name="text" expr="_event.data.text"/>
      </send>
    </transition>
    <state id="active">
      <onentry>
        <send target="tinyactors://chat/@workspace" event="status">
          <param name="user" expr="name"/>
          <param name="status" expr="'active'"/>
        </send>
        <send id="idle" event="idle" delay="300s"/>
      </onentry>
      <onexit><cancel sendid="idle"/></onexit>
      <transition event="activity">            <!-- no target: the state stays, the timer starts again -->
        <cancel sendid="idle"/>
        <send id="idle" event="idle" delay="300s"/>
      </transition>
      <transition event="idle" target="away"/>
    </state>
    <state id="away">
      <onentry>
        <send target="tinyactors://chat/@workspace" event="status">
          <param name="user" expr="name"/>
          <param name="status" expr="'away'"/>
        </send>
      </onentry>
      <transition event="activity" target="active"/>
    </state>
  </state>
</scxml>
