<?xml version="1.0" encoding="UTF-8"?>
<!-- A user. It tracks presence and reports each change to the workspace.
     It shows the roster the workspace sends. It joins rooms and posts to them.
     A join or a post counts as activity.
     A join of a room that does not exist fails with error.communication.
     Typing tells the room once every 3 seconds at most; another member's
     typing shows on the screen until that member posts, 5 seconds pass
     after the last notice, or this user disconnects or loses the connection.
     A lost connection shows the user as away at once, and offline after
     30 seconds. A reconnect before then brings back the status from
     before, the messages that came meanwhile and the roster as it is now.
     Joining a room tells the screen, which reads the room's latest posts
     from the application's store; each message carries the number the
     store gave it, so a screen shows a post once, and the time the store
     recorded, so a screen shows when it was posted, held or not.
     A direct message is a room of two that the workspace makes: the user
     asks for one with another user, and the screen hears of it, and of
     every direct message of theirs when they come online or back. A join of
     someone else's is refused. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="user" initial="offline">
  <datamodel>
    <data id="name"/>
    <data id="quiet" expr="({})"/>    <!-- room -> true while this user's typing was told less than 3 s ago -->
    <data id="typers" expr="({})"/>   <!-- "room user" -> { id, room, user }: an indicator on the screen and its timer -->
    <data id="timer"/>
    <data id="held" expr="[]"/>       <!-- messages that came while reconnecting; the rest is dropped -->
  </datamodel>
  <state id="offline">
    <onentry>
      <send target="tinyactors://chat/@workspace" event="status">
        <param name="user" expr="name"/>
        <param name="status" expr="'offline'"/>
      </send>
      <assign location="held" expr="[]"/>   <!-- what came while reconnecting is lost with the connection -->
    </onentry>
    <transition event="connect" target="online"/>
  </state>
  <state id="online" initial="active">
    <onentry>
      <!-- back from a lost connection: the messages that came meanwhile -->
      <foreach array="held" item="message">
        <send type="chat:client" event="message">
          <param name="to" expr="name"/>
          <param name="seq" expr="message.seq"/>
          <param name="at" expr="message.at"/>
          <param name="room" expr="message.room"/>
          <param name="from" expr="message.from"/>
          <param name="text" expr="message.text"/>
        </send>
      </foreach>
      <assign location="held" expr="[]"/>
    </onentry>
    <onexit>
      <!-- this user's screen stops showing who is typing, and the timers go -->
      <foreach array="Object.values(typers)" item="typer">
        <cancel sendidexpr="typer.id"/>
        <send type="chat:client" event="typing.stopped">
          <param name="to" expr="name"/>
          <param name="room" expr="typer.room"/>
          <param name="user" expr="typer.user"/>
        </send>
      </foreach>
      <assign location="typers" expr="({})"/>
      <assign location="quiet" expr="({})"/>
    </onexit>
    <history id="resume">               <!-- active or away, as before the connection was lost -->
      <transition target="active"/>
    </history>
    <transition event="disconnect" target="offline"/>
    <transition event="connection.lost" target="reconnecting"/>
    <!-- back from a lost connection, once resume has reported the status again:
         the screen missed the roster's changes and the direct messages
         made meanwhile, so the workspace sends both whole -->
    <transition event="reconnected">
      <send target="tinyactors://chat/@workspace" event="roster.get"/>
      <send target="tinyactors://chat/@workspace" event="dms.get">
        <param name="user" expr="name"/>
      </send>
    </transition>

    <!-- this user types: the room hears of it at most once every 3 seconds -->
    <transition event="typing" cond="!quiet[_event.data.room]">
      <send targetexpr="'tinyactors://chat/@room.' + _event.data.room" event="typing">
        <param name="user" expr="name"/>
      </send>
      <assign location="quiet[_event.data.room]" expr="true"/>
      <send event="quiet.over" delay="3s">
        <param name="room" expr="_event.data.room"/>
      </send>
      <raise event="activity"/>
    </transition>
    <transition event="typing">
      <raise event="activity"/>
    </transition>
    <transition event="quiet.over">
      <assign location="quiet[_event.data.room]" expr="false"/>
    </transition>

    <!-- another member types: the screen shows it until 5 seconds after the last notice -->
    <transition event="others.typing">
      <if cond="(_event.data.room + ' ' + _event.data.user) in typers">
        <cancel sendidexpr="typers[_event.data.room + ' ' + _event.data.user].id"/>
      <else/>
        <send type="chat:client" event="typing">
          <param name="to" expr="name"/>
          <param name="room" expr="_event.data.room"/>
          <param name="user" expr="_event.data.user"/>
        </send>
      </if>
      <send event="indicator.expired" delay="5s" idlocation="timer">
        <param name="room" expr="_event.data.room"/>
        <param name="user" expr="_event.data.user"/>
      </send>
      <assign location="typers[_event.data.room + ' ' + _event.data.user]"
              expr="({ id: timer, room: _event.data.room, user: _event.data.user })"/>
    </transition>
    <transition event="indicator.expired">
      <script>delete typers[_event.data.room + ' ' + _event.data.user];</script>
      <send type="chat:client" event="typing.stopped">
        <param name="to" expr="name"/>
        <param name="room" expr="_event.data.room"/>
        <param name="user" expr="_event.data.user"/>
      </send>
    </transition>
    <!-- before "join": that descriptor matches join.refused too -->
    <transition event="join.refused">
      <send type="chat:client" event="error">
        <param name="to" expr="name"/>
        <param name="reason" expr="'not a member'"/>
      </send>
    </transition>
    <transition event="join">
      <send id="join" targetexpr="'tinyactors://chat/@room.' + _event.data.room" event="join">
        <param name="user" expr="name"/>
      </send>
      <raise event="activity"/>
    </transition>
    <transition event="joined">
      <send type="chat:client" event="joined">
        <param name="to" expr="name"/>
        <param name="room" expr="_event.data.room"/>
      </send>
    </transition>
    <transition event="error.communication" cond="_event.sendid === 'join'">
      <send type="chat:client" event="error">
        <param name="to" expr="name"/>
        <param name="reason" expr="'no such room'"/>
      </send>
    </transition>
    <!-- a direct message: the workspace makes it, or finds the one made before -->
    <transition event="dm.open">
      <send target="tinyactors://chat/@workspace" event="dm.open">
        <param name="user" expr="name"/>
        <param name="with" expr="_event.data.with"/>
      </send>
      <raise event="activity"/>
    </transition>
    <transition event="dm.opened">
      <send type="chat:client" event="dm.opened">
        <param name="to" expr="name"/>
        <param name="room" expr="_event.data.room"/>
        <param name="with" expr="_event.data.with"/>
      </send>
    </transition>
    <transition event="dms">
      <send type="chat:client" event="dms">
        <param name="to" expr="name"/>
        <param name="dms" expr="_event.data.dms"/>
      </send>
    </transition>
    <transition event="post">
      <send targetexpr="'tinyactors://chat/@room.' + _event.data.room" event="post">
        <param name="user" expr="name"/>
        <param name="text" expr="_event.data.text"/>
      </send>
      <raise event="activity"/>
    </transition>
    <!-- before "roster": that descriptor matches roster.update too -->
    <transition event="roster.update">
      <send type="chat:client" event="roster.update">
        <param name="to" expr="name"/>
        <param name="user" expr="_event.data.user"/>
        <param name="status" expr="_event.data.status"/>
      </send>
    </transition>
    <transition event="roster">
      <send type="chat:client" event="roster">
        <param name="to" expr="name"/>
        <param name="roster" expr="_event.data.roster"/>
      </send>
    </transition>
    <transition event="message">
      <!-- a post ends its author's indicator -->
      <if cond="(_event.data.room + ' ' + _event.data.from) in typers">
        <cancel sendidexpr="typers[_event.data.room + ' ' + _event.data.from].id"/>
        <script>delete typers[_event.data.room + ' ' + _event.data.from];</script>
        <send type="chat:client" event="typing.stopped">
          <param name="to" expr="name"/>
          <param name="room" expr="_event.data.room"/>
          <param name="user" expr="_event.data.from"/>
        </send>
      </if>
      <send type="chat:client" event="message">
        <param name="to" expr="name"/>
        <param name="seq" expr="_event.data.seq"/>
        <param name="at" expr="_event.data.at"/>
        <param name="room" expr="_event.data.room"/>
        <param name="from" expr="_event.data.from"/>
        <param name="text" expr="_event.data.text"/>
      </send>
    </transition>
    <state id="active">
      <onentry>
        <send target="tinyactors://chat/@workspace" event="status">
          <param name="user" expr="name"/>
          <param name="status" expr="'active'"/>
        </send>
        <send id="idle" event="idle" delay="300s"/>
      </onentry>
      <onexit><cancel sendid="idle"/></onexit>
      <transition event="activity">            <!-- no target: the state stays, the timer starts again -->
        <cancel sendid="idle"/>
        <send id="idle" event="idle" delay="300s"/>
      </transition>
      <transition event="idle" target="away"/>
    </state>
    <state id="away">
      <onentry>
        <send target="tinyactors://chat/@workspace" event="status">
          <param name="user" expr="name"/>
          <param name="status" expr="'away'"/>
        </send>
      </onentry>
      <transition event="activity" target="active"/>
    </state>
  </state>
  <state id="reconnecting">
    <onentry>
      <!-- the others see the user as away at once -->
      <send target="tinyactors://chat/@workspace" event="status">
        <param name="user" expr="name"/>
        <param name="status" expr="'away'"/>
      </send>
      <send id="grace" event="grace.over" delay="30s"/>
    </onentry>
    <onexit><cancel sendid="grace"/></onexit>
    <!-- back: resume enters active or away, whose entry reports the status;
         "reconnected" comes after it -->
    <transition event="connect" target="resume">
      <raise event="reconnected"/>
    </transition>
    <transition event="disconnect" target="offline"/>
    <transition event="grace.over" target="offline"/>
    <transition event="message">
      <assign location="held" expr="held.concat([{ seq: _event.data.seq, at: _event.data.at, room: _event.data.room, from: _event.data.from, text: _event.data.text }])"/>
    </transition>
  </state>
</scxml>
