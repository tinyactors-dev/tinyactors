{"jsonrpc":"2.0","id":1,"method":"run.addImage","params":{"sources":[{"name":"order.scxml","text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" name=\"order\" initial=\"cart\">\n  <datamodel>\n    <data id=\"customer\" expr=\"''\"/>\n    <data id=\"items\" expr=\"[]\"/>\n    <data id=\"total\" expr=\"0\"/>\n    <data id=\"reminders\" expr=\"0\"/>\n  </datamodel>\n  <state id=\"cart\">\n    <transition event=\"item.added\">\n      <assign location=\"items\" expr=\"items.concat([_event.data.sku])\"/>\n      <assign location=\"total\" expr=\"total + _event.data.price\"/>\n    </transition>\n    <transition event=\"checkout\" cond=\"items.length &gt; 0\" target=\"paying\"/>\n  </state>\n  <state id=\"paying\">\n    <onentry>\n      <send id=\"reminder\" event=\"payment.reminder\" delay=\"900s\"/>\n    </onentry>\n    <invoke id=\"payment\" src=\"payment.scxml\">\n      <param name=\"amount\" expr=\"total\"/>\n    </invoke>\n    <transition event=\"payment.reminder\">\n      <assign location=\"reminders\" expr=\"reminders + 1\"/>\n      <log label=\"reminder\" expr=\"customer + ' owes ' + total\"/>\n    </transition>\n    <transition event=\"done.invoke.payment\" target=\"shipped\">\n      <cancel sendid=\"reminder\"/>\n    </transition>\n    <transition event=\"cancel\" target=\"cancelled\">\n      <cancel sendid=\"reminder\"/>\n    </transition>\n  </state>\n  <state id=\"shipped\">\n    <transition event=\"delivered\" target=\"delivered\"/>\n  </state>\n  <final id=\"delivered\"/>\n  <final id=\"cancelled\"/>\n</scxml>\n"},{"name":"payment.scxml","text":"<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" name=\"payment\" initial=\"authorizing\">\n  <datamodel>\n    <data id=\"amount\" expr=\"0\"/>\n    <data id=\"attempts\" expr=\"1\"/>\n  </datamodel>\n  <state id=\"authorizing\">\n    <onentry><send event=\"authorized\" delay=\"2s\"/></onentry>\n    <transition event=\"authorized\" target=\"captured\"/>\n    <transition event=\"declined\"><assign location=\"attempts\" expr=\"attempts + 1\"/></transition>\n  </state>\n  <final id=\"captured\"/>\n</scxml>\n"}]}}
