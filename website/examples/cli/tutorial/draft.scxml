<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="order" datamodel="ecmascript" initial="open">
  <datamodel>
    <data id="total" expr="0"/>
    <data id="attempts" expr="0"/>
    <data id="charge" expr="null"/>
  </datamodel>
  <state id="open">
    <transition event="item.added" cond="_event.data.price &gt; 0">
      <assign location="total" expr="total + _event.data.price"/>
    </transition>
    <transition event="checkout" cond="total &gt; 0" target="paying"/>
    <transition event="cancel" target="cancelled"/>
  </state>
  <state id="paying">
    <onentry>
      <assign location="attempts" expr="attempts + 1"/>
      <send type="payments" target="charges" event="charge" id="pay">
        <param name="amount" expr="total"/>
      </send>
      <send event="payment.timeout" delay="30s" id="deadline"/>
    </onentry>
    <onexit>
      <cancel sendid="deadline"/>
    </onexit>
    <transition event="charge.ok" target="paid">
      <assign location="charge" expr="_event.data.charge"/>
    </transition>
    <transition event="charge.declined error.communication payment.timedout" cond="attempts &lt; 3" target="paying"/>
    <transition event="charge.declined error.communication payment.timedout" target="cancelled"/>
  </state>
  <state id="paid">
    <transition event="shipped" target="shipped"/>
  </state>
  <final id="shipped">
    <donedata>
      <param name="charge" expr="charge"/>
    </donedata>
  </final>
  <final id="cancelled"/>
</scxml>
