<?xml version="1.0" encoding="UTF-8"?>
<!-- A room. A user actor joins it, and it sends each post to each member.
     It tells the other members when one of them types. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="room" initial="open">
  <datamodel>
    <data id="name"/>
    <data id="members" expr="[]"/>
  </datamodel>
  <state id="open">
    <transition event="join">
      <assign location="members" expr="members.concat([_event.data.user])"/>
      <send targetexpr="_event.origin" event="joined">
        <param name="room" expr="name"/>
      </send>
    </transition>
    <transition event="typing">
      <foreach array="members" item="member">
        <if cond="member !== _event.data.user">
          <send targetexpr="'tinyactors://chat/@user.' + member" event="others.typing">
            <param name="room" expr="name"/>
            <param name="user" expr="_event.data.user"/>
          </send>
        </if>
      </foreach>
    </transition>
    <transition event="post">
      <foreach array="members" item="member">
        <send targetexpr="'tinyactors://chat/@user.' + member" event="message">
          <param name="room" expr="name"/>
          <param name="from" expr="_event.data.user"/>
          <param name="text" expr="_event.data.text"/>
        </send>
      </foreach>
    </transition>
  </state>
</scxml>
