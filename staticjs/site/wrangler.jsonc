// staticjs's documentation site on Cloudflare Workers: the build
// (.vitepress/dist) as static assets, and worker.mjs in front of every
// request for the routing server.mjs does locally. `mise run site:deploy`.
{
  "name": "staticjs-site",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "account_id": "a29df5518d09371e56d0d4e6bf522e48",
  "assets": {
    "directory": ".vitepress/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "staticjs.tinyactors.dev", "custom_domain": true }],
  "workers_dev": false
}
