#!/usr/bin/env ruby
#MISE description="Compile every staticjs source for every release target, wasm32-freestanding included, and check it needs no C library"
# vim:ft=ruby

# staticjs must build wherever core does, the browser included. Each source
# is compiled with the release's zig for wasm32-freestanding, which has no C
# library: a libc header does not exist there, and a libc call would stay
# undefined; and for the other release targets, where the compiler may
# still emit one for an operation. What each object leaves undefined may be staticjs's own
# functions (sjs_*) and the memory builtins the compiler emits, nothing else.

require_relative '../staticjs'
require 'etc'
require 'fileutils'

# The native release targets too: a call the compiler emits for an
# operation (libm's sqrt for errno, a 128-bit division) would stay
# undefined in any of them. Compiled with each release's own flags, a few
# at a time.
jobs = Toolchain::Target.releases.product(StaticJS.sources)
queue = Queue.new
jobs.each { |job| queue << job }
bad = Queue.new
workers = Array.new(Etc.nprocessors.clamp(1, 8)) do
  Thread.new do
    loop do
      target, source = queue.pop(true)
      object = StaticJS::BUILD.join('freestanding', target.name, "#{source.basename('.c')}.o")
      binary = target.compile(source.to_s, into: object.to_s,
                                           includes: [StaticJS::ROOT.join('include'), StaticJS::ROOT.join('src')],
                                           flags: [*StaticJS::WARNINGS, *StaticJS::FREESTANDING])
      foreign = (binary.undefined - binary.format.runtime_undefined).to_a.reject do |symbol|
        symbol.start_with?('sjs_') || StaticJS::MEMORY.include?(symbol)
      end
      bad << "#{target.name} #{source.basename}: #{foreign.join(', ')}" unless foreign.empty?
    rescue ThreadError
      break
    end
  end
end
workers.each(&:join)
problems = Array.new(bad.size) { bad.pop }.sort
abort "check-freestanding: undefined symbols outside staticjs and the memory builtins:\n  #{problems.join("\n  ")}" unless problems.empty?
puts "check-freestanding: #{StaticJS.sources.size} sources build with no C library for " \
     "#{Toolchain::Target.releases.map(&:name).join(', ')}"
