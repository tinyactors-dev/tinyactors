#!/usr/bin/env ruby
#MISE description="Build staticjs: its library (freestanding, without the host's C library) and its test programs"
# vim:ft=ruby

# Each src/*.c is compiled freestanding into build/objects/ and archived
# into build/libstaticjs.a; each test program links against it. Objects
# are reused while their bytes and headers are unchanged (mise/lib/cache.rb).

require_relative '../staticjs'
require 'cache'
require 'fileutils'

target = Toolchain::Target.host
library_command = [*target.compile_command, *StaticJS::WARNINGS, *StaticJS::FREESTANDING, *StaticJS::INCLUDES].freeze
test_command = [*target.compile_command, *StaticJS::WARNINGS, *StaticJS::INCLUDES].freeze

def compile(command, source, object)
  outcome, output = Cache.compile(command, source, object)
  if outcome == :failed
    puts (command + ['-c', source.to_s]).shelljoin
    abort output
  end
  puts output unless output.empty?
  outcome
end

FileUtils.mkdir_p(StaticJS::OBJECTS)
objects = StaticJS.sources.map do |source|
  object = StaticJS::OBJECTS.join("#{source.basename('.c')}.o")
  compile(library_command, source.relative_path_from(StaticJS::ROOT), object)
  object
end
target.archive(objects.map(&:to_s), into: StaticJS.library.to_s)

StaticJS::TESTS.each do |test, spec|
  object = StaticJS::OBJECTS.join("#{test}.o")
  compile(test_command, Pathname.new(spec[:source]), object)
  target.program([object.to_s, StaticJS.library.to_s], into: StaticJS::BUILD.join(test).to_s)
end
puts "build: staticjs (#{objects.size} objects) and #{StaticJS.tests.size} test program(s)"
