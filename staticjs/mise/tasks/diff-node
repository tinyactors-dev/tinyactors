#!/usr/bin/env ruby
#MISE description="Check the spec against JavaScript itself: every expected value is Node's, every syntax error is one Node rejects, every unsupported case is valid JavaScript, every name error throws in Node; and numbers format and read as in Node (number_test --print), JSON reads and writes as in Node (json_test --print), and regular expressions classify as Node reads them (regex_test --print), and Temporal values are the polyfill's (temporal_test --print)"
#MISE depends=["build"]
# vim:ft=ruby

# The rule of staticjs (docs/proposals/staticjs.md): a program it accepts
# gives the same result as JavaScript, or a fault. tests/diff-node.mjs
# evaluates every case of tests/spec in Node, and compares what number_test
# --print and json_test --print compute with what Node computes from the
# same inputs: 100,000 doubles formatted as String(x), 100,000 decimals read
# as Number(s), ..., 100,000 random JSON documents read and written back,
# 100,000 random regular expression literals classified, and Temporal
# values on temporal_test's fixed lists of inputs.

require_relative '../staticjs'
require 'tempfile'

numbers = Tempfile.new(['numbers', '.txt'])
begin
  printed = system(StaticJS::BUILD.join('number_test').to_s, '--print', '100000', out: numbers.path,
                                                                                  chdir: StaticJS::ROOT.to_s)
  abort 'diff-node: number_test --print failed' unless printed
  printed = system(StaticJS::BUILD.join('json_test').to_s, '--print', '100000', out: [numbers.path, 'a'],
                                                                                chdir: StaticJS::ROOT.to_s)
  abort 'diff-node: json_test --print failed' unless printed
  printed = system(StaticJS::BUILD.join('regex_test').to_s, '--print', '100000', out: [numbers.path, 'a'],
                                                                                 chdir: StaticJS::ROOT.to_s)
  abort 'diff-node: regex_test --print failed' unless printed
  printed = system(StaticJS::BUILD.join('temporal_test').to_s, '--print', out: [numbers.path, 'a'],
                                                                     chdir: StaticJS::ROOT.to_s)
  abort 'diff-node: temporal_test --print failed' unless printed
  StaticJS.run('node', '--no-warnings=ExperimentalWarning', '--experimental-vm-modules', 'tests/diff-node.mjs',
               'tests/spec', numbers.path)
ensure
  numbers.close!
end
