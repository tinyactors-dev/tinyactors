# Map: construction, get, has, size, the writer, and what takes a map's
# entries. Every expected value was generated by running the case in Node 22.
# A map is a value: a key is any primitive, compared as SameValueZero; an
# object as a key faults, as JavaScript keys it by its identity.

=== an empty map
new Map()
--- value
new Map([])

=== new Map of undefined and of null
[new Map(undefined).size, new Map(null).size]
--- value
[0,0]

=== entries keep their insertion order
new Map([[1, "a"], ["b", 2], [true, null]])
--- value
new Map([[1,"a"],["b",2],[true,null]])

=== a later duplicate key wins the value and keeps the first place
new Map([[1, "a"], [2, "b"], [1, "c"]])
--- value
new Map([[1,"c"],[2,"b"]])

=== the missing items of an entry are undefined
new Map([[1], []])
--- value
new Map([[1,undefined],[undefined,undefined]])

=== the extra items of an entry are left out
new Map([[1, 2, 3]])
--- value
new Map([[1,2]])

=== a number and a string are different keys
(() => { const m = new Map([[1, "number"], ["1", "string"]]); return [m.size, m.get(1), m.get("1")]; })()
--- value
[2,"number","string"]

=== -0 and 0 are one key, which is 0
new Map([[-0, "a"], [0, "b"]])
--- value
new Map([[0,"b"]])

=== get of -0 finds 0
[new Map([[0, "zero"]]).get(-0), new Map([[-0, "zero"]]).get(0)]
--- value
["zero","zero"]

=== NaN is one key
(() => { const m = new Map([[NaN, 1], [0 / 0, 2]]); return [m.size, m.get(NaN), m.has(NaN)]; })()
--- value
[1,2,true]

=== booleans, null and undefined as keys
(() => { const m = new Map([[true, 1], [false, 2], [null, 3], [undefined, 4]]); return [m.get(true), m.get(false), m.get(null), m.get(undefined), m.get(), m.size]; })()
--- value
[1,2,3,4,4,4]

=== BigInts are keys by their value
(() => { const m = new Map([[10n, "a"], [10n ** 30n, "b"]]); return [m.get(10n), m.get(1000000000000000000000000000000n), m.has(10), m.has(10n)]; })()
--- value
["a","b",false,true]

=== a BigInt and a number are different keys
new Map([[1n, "bigint"], [1, "number"], [-0n, "zero"], [0, "number zero"]])
--- value
new Map([[1n,"bigint"],[1,"number"],[0n,"zero"],[0,"number zero"]])

=== get of a missing key is undefined
new Map([[1, 2]]).get(3)
--- value
undefined

=== has tells a missing key from an undefined value
(() => { const m = new Map([["a", undefined]]); return [m.has("a"), m.has("b"), m.get("a"), m.get("b")]; })()
--- value
[true,false,undefined,undefined]

=== get and has of an object find nothing
(() => { const m = new Map([[1, 2]]); return [m.get({}), m.has([1]), m.get([]), m.has(new Map())]; })()
--- value
[undefined,false,undefined,false]

=== get and has with no argument look for undefined
[new Map([[undefined, 1]]).get(), new Map([[undefined, 1]]).has(), new Map().has()]
--- value
[1,true,false]

=== a value may be anything
new Map([["xs", [1, 2]], ["o", {a: 1}], ["s", new Set([1])], ["m", new Map([[1, 2]])], ["n", 10n], ["u", undefined]])
--- value
new Map([["xs",[1,2]],["o",{"a":1}],["s",new Set([1])],["m",new Map([[1,2]])],["n",10n],["u",undefined]])

=== keys of every primitive kind, written
new Map([[undefined, 1], [null, 2], [true, 3], [1.5, 4], ["s", 5], [7n, 6], [NaN, 7], [-Infinity, 8], [-1n, 9]])
--- value
new Map([[undefined,1],[null,2],[true,3],[1.5,4],["s",5],[7n,6],[NaN,7],[-Infinity,8],[-1n,9]])

=== a value of -0 is kept
new Map([[1, -0]])
--- value
new Map([[1,-0]])

=== string keys with escapes and non-ASCII text
new Map([["a\"b", 1], ["\n", 2], ["é", 3], ["😀", 4]])
--- value
new Map([["a\"b",1],["\n",2],["é",3],["😀",4]])

=== nested maps written
new Map([[1, new Map([["a", [1, new Set([2])]]])]])
--- value
new Map([[1,new Map([["a",[1,new Set([2])]]])]])

=== size
[new Map().size, new Map([[1, 1], [2, 2], [1, 3]]).size]
--- value
[0,2]

=== many keys past the index threshold
(() => { const m = new Map(Array.from({ length: 50 }, (x, i) => [i % 2 === 0 ? i : String(i), i * 2])); return [m.size, m.get(48), m.get("49"), m.get(49), m.get("48"), m.has(50), m.get(0)]; })()
--- value
[50,96,98,undefined,undefined,false,0]

=== many duplicates past the index threshold keep their first places
[...new Map(Array.from({ length: 40 }, (x, i) => [i % 12, i]))]
--- value
[[0,36],[1,37],[2,38],[3,39],[4,28],[5,29],[6,30],[7,31],[8,32],[9,33],[10,34],[11,35]]

=== BigInt and string keys past the index threshold
(() => { const m = new Map(Array.from({ length: 30 }, (x, i) => [i % 3 === 0 ? BigInt(i) : i % 3 === 1 ? i : String(i), i])); return [m.size, m.get(27n), m.get(27), m.get(28), m.get("29"), m.get(29)]; })()
--- value
[30,27,undefined,28,29,undefined]

=== new Map of a map copies it
(() => { const m = new Map([[1, "a"], [2, "b"]]); const n = new Map(m); return [n, n.size, m.get(2)]; })()
--- value
[new Map([[1,"a"],[2,"b"]]),2,"b"]

=== a copy of a map past the index threshold
(() => { const n = new Map(new Map(Array.from({ length: 20 }, (x, i) => [i, i * i]))); return [n.size, n.get(19), n.get(7), n.has(20)]; })()
--- value
[20,361,49,false]

=== new Map of an empty set
new Map(new Set())
--- value
new Map([])

=== new Map of a set of primitives faults, as its members are not entries
new Map(new Set([1]))
--- fault an entry of new Map

=== an entry that is not an array faults
new Map([1])
--- fault an entry of new Map

=== an entry that is an object faults, where JavaScript reads its 0 and 1
new Map([{0: "k", 1: "v"}])
--- fault an entry of new Map

=== a string's characters are not entries
new Map("ab")
--- fault an entry of new Map

=== new Map of a number faults
new Map(5)
--- fault spreads

=== an object as a key faults
new Map([[{}, 1]])
--- fault identity

=== an array as a key faults
new Map([[[1], 1]])
--- fault identity

=== a map as a key faults
new Map([[new Map(), 1]])
--- fault identity

=== a function as a key faults
new Map([[x => x, 1]])
--- fault identity

=== spread of a map gives its entries
[...new Map([[1, "a"], [2, "b"]])]
--- value
[[1,"a"],[2,"b"]]

=== spread of an empty map
[0, ...new Map(), 1]
--- value
[0,1]

=== spread of a map into arguments
((...xs) => xs)(...new Map([[1, 2], [3, 4]]))
--- value
[[1,2],[3,4]]

=== the entries a spread gives are new arrays
(() => { const m = new Map([["k", [1]]]); const [e] = [...m]; return [e, e[1], m.get("k")]; })()
--- value
[["k",[1]],[1],[1]]

=== Array.from of a map
Array.from(new Map([[1, "a"], ["b", 2]]))
--- value
[[1,"a"],["b",2]]

=== Array.from of a map with a mapper
Array.from(new Map([[1, "a"], [2, "b"]]), (e, i) => e[1] + i)
--- value
["a0","b1"]

=== Object.fromEntries of a map
Object.fromEntries(new Map([[1, "a"], ["b", 2], [10n, 3], [null, 4], [true, 5], [undefined, 6], [-0, 7]]))
--- value
{"0":7,"1":"a","10":3,"b":2,"null":4,"true":5,"undefined":6}

=== Object.fromEntries of an empty map
Object.fromEntries(new Map())
--- value
{}

=== Object.fromEntries of a map with __proto__ faults, where JavaScript makes an own property
Object.fromEntries(new Map([["__proto__", 1]]))
--- fault no prototype

=== destructuring a map takes its entries
(() => { const [[k, v], second, third] = new Map([["a", 1], ["b", 2]]); return [k, v, second, third]; })()
--- value
["a",1,["b",2],undefined]

=== a rest element of a map
(() => { const [first, ...rest] = new Map([[1, 1], [2, 2], [3, 3]]); return [first, rest]; })()
--- value
[[1,1],[[2,2],[3,3]]]

=== a parameter's pattern over a map
(([[k]]) => k)(new Map([["only", 1]]))
--- value
"only"

=== an object pattern reads size, and undefined for what a map lacks
(() => { const { size, other } = new Map([[1, 2]]); return [size, other]; })()
--- value
[1,undefined]

=== an object pattern of a method faults
(() => { const { get } = new Map(); return 1; })()
--- fault does not read them

=== spread of a map into an object gives an empty object
({...new Map([[1, 2], ["a", 3]])})
--- value
{}

=== an object rest element of a map gives an empty object
(() => { const {...r} = new Map([["a", 1]]); return r; })()
--- value
{}

=== typeof a map
typeof new Map()
--- value
"object"

=== a map is not an array
Array.isArray(new Map([[1, 2]]))
--- value
false

=== a map is truthy, even empty
[new Map() ? "yes" : "no", !new Map(), Boolean(new Map())]
--- value
["yes",false,true]

=== a property a map lacks is undefined
[new Map().foo, new Map([["foo", 1]]).foo, new Map()[0]]
--- value
[undefined,undefined,undefined]

=== a set's method name is no map's property
new Map().add
--- value
undefined

=== a map's method read as a value faults
new Map().get
--- fault does not read them

=== a name of Object.prototype read on a map faults
new Map().toString
--- fault does not read them

=== a set's method called on a map faults
new Map().add(1)
--- fault changes its receiver

=== an array's method is not a map's
new Map().map(x => x)
--- fault does not have this method

=== a method by a computed name
(() => { const name = "get"; return new Map([[1, 2]])[name](1); })()
--- value
2

=== === on two maps faults
new Map() === new Map()
--- fault identity

=== a map in a template faults
`${new Map()}`
--- fault primitives

=== a map turned into a string faults
String(new Map())
--- fault primitives

=== Object.keys of a map faults, where JavaScript gives []
Object.keys(new Map([[1, 2]]))
--- fault Object.keys

=== in of a map faults
"size" in new Map()
--- fault in needs

=== a map as a set's member faults
new Set([new Map()])
--- fault primitives

=== new Map without parentheses is refused
new Map
--- error unsupported with parentheses

=== Map called without new is refused
Map([[1, 2]])
--- error unsupported used only as

=== a name of Map that staticjs does not have
Map.prototype
--- error unsupported does not have this built-in

=== a map in a closure
(() => { const m = new Map([["a", 1], ["b", 2]]); return ["a", "b", "c"].map(k => m.get(k)); })()
--- value
[1,2,undefined]

=== maps as an array's elements
[new Map([[1, 2]]), new Map()].map(m => m.size)
--- value
[1,0]

# Iteration: keys(), values() and entries() give iterators, which a spread,
# Array.from, new Set, new Map, Object.fromEntries, an array pattern and
# their own toArray, map, filter, reduce, some, every, find, forEach,
# flatMap, take and drop take. An iterator yields its
# values once in JavaScript; staticjs reads one only where nothing else holds
# it, so no program can read one twice, and it holds its map, which cannot
# change while it lives. The writer writes one as `[...].values()`.

=== keys, values and entries spread
(() => { const m = new Map([[1, "a"], ["b", 2]]); return [[...m.keys()], [...m.values()], [...m.entries()]]; })()
--- value
[[1,"b"],["a",2],[[1,"a"],["b",2]]]

=== an empty map's iterators
[[...new Map().keys()], [...new Map().values()], [...new Map().entries()], new Map().keys().toArray()]
--- value
[[],[],[],[]]

=== toArray
(() => { const m = new Map([[1, "a"], [2, "b"]]); return [m.keys().toArray(), m.values().toArray(), m.entries().toArray()]; })()
--- value
[[1,2],["a","b"],[[1,"a"],[2,"b"]]]

=== Array.from of an iterator
Array.from(new Map([[1, "a"], [2, "b"]]).values())
--- value
["a","b"]

=== Array.from of an iterator with a mapper
Array.from(new Map([[1, "a"], [2, "b"]]).keys(), (k, i) => k * 10 + i)
--- value
[10,21]

=== new Set of a map's keys
new Set(new Map([[1, "a"], [2, "a"], [3, "b"]]).values())
--- value
new Set(["a","b"])

=== new Map of a map's entries
new Map(new Map([[1, "a"], [2, "b"]]).entries())
--- value
new Map([[1,"a"],[2,"b"]])

=== new Map of a map's keys faults, as a key is not an entry
new Map(new Map([[1, "a"]]).keys())
--- fault an entry of new Map

=== Object.fromEntries of a map's entries
Object.fromEntries(new Map([["x", 1], ["y", 2]]).entries())
--- value
{"x":1,"y":2}

=== Object.fromEntries of a map's values that are not entries faults
Object.fromEntries(new Map([["x", 1]]).values())
--- fault Object.fromEntries

=== spread of an iterator into arguments
Math.max(...new Map([["a", 3], ["b", 7], ["c", 5]]).values())
--- value
7

=== an array pattern over an iterator
(() => { const [first, ...rest] = new Map([[1, "a"], [2, "b"], [3, "c"]]).values(); return [first, rest]; })()
--- value
["a",["b","c"]]

=== an array pattern over entries
(() => { const [[k, v]] = new Map([["key", "value"]]).entries(); return [k, v]; })()
--- value
["key","value"]

=== an iterator in a const, read once
(() => { const m = new Map([[1, 2], [3, 4]]); const it = m.keys(); return [...it]; })()
--- value
[1,3]

=== an iterator passed to a function that reads it once
((it) => [...it])(new Map([["a", 1]]).entries())
--- value
[["a",1]]

=== an iterator in an object, read once
[...({ it: new Map([[1, 2]]).values() }).it]
--- value
[2]

=== an iterator read twice faults, where JavaScript gives nothing the second time
(() => { const it = new Map([[1, 2]]).keys(); return [[...it], [...it]]; })()
--- fault once

=== an iterator read twice in one array faults
(() => { const it = new Map([[1, 2]]).values(); return [...it, ...it]; })()
--- fault once

=== an iterator a closure holds faults when read
(() => { const it = new Map([[1, 2]]).keys(); return [1].map(() => [...it]); })()
--- fault once

=== an iterator destructured after a read faults
(() => { const it = new Map([[1, 2], [3, 4]]).keys(); const [a] = it; const [b] = it; return [a, b]; })()
--- fault once

=== toArray of an iterator held elsewhere faults
(() => { const it = new Map([[1, 2]]).keys(); const a = it.toArray(); return [a, it.toArray()]; })()
--- fault once

=== an iterator is an object
(() => { const it = new Map().keys(); return [typeof it, Array.isArray(it), it ? 1 : 0]; })()
--- value
["object",false,1]

=== the writer writes an iterator as an array's values
new Map([[1, "a"], [2, "b"]]).keys()
--- value
[1,2].values()

=== the writer writes values and entries
[new Map([[1, "a"]]).values(), new Map([[1, "a"], [2, [3]]]).entries()]
--- value
[["a"].values(),[[1,"a"],[2,[3]]].values()]

=== an iterator nested in a map, written
new Map([["it", new Map([[1, 2]]).entries()]])
--- value
new Map([["it",[[1,2]].values()]])

=== a property an iterator lacks is undefined
new Map().keys().foo
--- value
undefined

=== next is not staticjs's
new Map([[1, 2]]).keys().next()
--- fault does not have this method

=== next read as a value faults
new Map().keys().next
--- fault does not read them

=== a name of Object.prototype read on an iterator faults
new Map().values().toString
--- fault does not read them

=== an iterator's map
@shapes - PLUCK(k)
(() => { const m = new Map([[1, {k: "a"}], [2, {k: "b"}]]); return m.values().map(v => v.k).toArray(); })()
--- value
["a","b"]

=== an iterator's map gives an iterator
new Map([[1, 2], [3, 4]]).keys().map(k => k * 2)
--- value
[2,6].values()

=== an iterator's map is called with the value and a counter only
new Map([["a", 1], ["b", 2]]).keys().map((k, i, rest) => [k, i, rest]).toArray()
--- value
[["a",0,undefined],["b",1,undefined]]

=== an iterator's filter
@shapes ELEMENT_COMPARE(GREATER, 2)
[...new Map([[1, 1], [2, 2], [3, 3], [4, 4]]).values().filter(v => v > 2)]
--- value
[3,4]

=== an iterator's filter by a key
@shapes KEY_COMPARE(n, STRICT_EQUAL, 1)
[...new Map([["a", {n: 1}], ["b", {n: 2}], ["c", {n: 1}]]).values().filter(v => v.n === 1)]
--- value
[{"n":1},{"n":1}]

=== an iterator's filter is called with the value and a counter only
[...new Map([["a", 1], ["b", 2], ["c", 3]]).keys().filter((k, i, rest) => i !== 1 && rest === undefined)]
--- value
["a","c"]

=== an iterator's reduce
@shapes SUM(false)
new Map([["a", 1], ["b", 2], ["c", 3]]).values().reduce((a, x) => a + x, 0)
--- value
6

=== an iterator's reduce by a key
@shapes SUM_KEY(kwh, false)
new Map([["a", {kwh: 1.5}], ["b", {kwh: 2}]]).values().reduce((a, r) => a + r.kwh, 0)
--- value
3.5

=== an iterator's reduce without an initial value
new Map([["a", 1], ["b", 2], ["c", 3]]).values().reduce((a, x, i) => a * 10 + x + i)
--- value
135

=== an iterator's reduce is called with the accumulator, the value and a counter only
new Map([["a", 1], ["b", 2]]).keys().reduce((acc, k, i, rest) => [...acc, k, i, rest], [])
--- value
["a",0,undefined,"b",1,undefined]

=== an iterator's reduce of nothing without an initial value faults
new Map().keys().reduce((a, x) => a + x)
--- fault initial value

=== a chain of helpers
new Map([[1, 10], [2, 20], [3, 30], [4, 40]]).values().filter(v => v !== 20).map(v => v / 10).reduce((a, x) => a + x, 0)
--- value
8

=== a helper's result, written
new Map([[1, 10], [2, 20]]).values().filter(v => v > 10)
--- value
[20].values()

=== a helper's result read twice faults
(() => { const it = new Map([[1, 2]]).keys().map(x => x); return [[...it], [...it]]; })()
--- fault once

=== a helper's callback that is not a function faults
new Map([[1, 2]]).keys().map(5)
--- fault not a function

=== a helper of an iterator held elsewhere faults
(() => { const it = new Map([[1, 2]]).keys(); const doubled = it.map(x => x * 2); return [[...it], [...doubled]]; })()
--- fault once

=== a helper's callback faults at its element
new Map([[1, {k: 2}], [3, null]]).values().map(v => v.k).toArray()
--- fault of null

# An iterator's some, every and find: the array's loops of their names
# over what the iterator yields, with the value and a counter, stopping at
# the first element that decides them.

=== an iterator's some
@shapes ELEMENT_COMPARE(GREATER, 4)
new Map([[1, 1], [2, 5], [3, 2]]).values().some(v => v > 4)
--- value
true

=== an iterator's some that finds nothing
@shapes ELEMENT_COMPARE(GREATER, 9)
new Map([[1, 1], [2, 5]]).values().some(v => v > 9)
--- value
false

=== an empty iterator's some, every and find
[new Map().keys().some(k => true), new Map().keys().every(k => false), new Map().keys().find(k => true) === undefined]
--- value
[false,true,true]

=== an iterator's some is called with the value and a counter only
new Map([["a", 1], ["b", 2]]).keys().some((k, i, rest) => i === 1 && rest === undefined && k === "b")
--- value
true

=== an iterator's some stops at the first true answer
@shapes KEY_COMPARE(k, STRICT_EQUAL, 1)
new Map([[1, {k: 1}], [2, null]]).values().some(v => v.k === 1)
--- value
true

=== an iterator's some stops before an element its callback faults on
new Map([[1, {k: 1}], [2, null]]).values().some((v, i) => v.k === 1)
--- value
true

=== an iterator's some faults at the element its callback faults on
new Map([[1, {k: 2}], [2, null]]).values().some((v, i) => v.k === 1)
--- fault of null

=== an iterator's some takes falsy answers that are not booleans
[new Map([[1, 0], [2, ""], [3, null], [4, NaN], [5, undefined]]).values().some(v => v), new Map([[1, 0], [2, {}]]).values().some(v => v), new Map([[1, 0], [2, "x"]]).values().some(v => v), new Map([[1, 0], [2, []]]).values().some(v => v)]
--- value
[false,true,true,true]

=== an iterator's some over entries
new Map([[1, 1], [2, 3]]).entries().some(([k, v]) => k === v)
--- value
true

=== an iterator's some over a helper's result
@shapes - ELEMENT_COMPARE(STRICT_EQUAL, 4)
new Map([[1, 1], [2, 2], [3, 3]]).keys().map(k => k * 2).some(x => x === 4)
--- value
true

=== an iterator's some whose callback is not a function faults
new Map([[1, 2]]).keys().some(5)
--- fault not a function

=== an iterator's some of an iterator held elsewhere faults
@shapes - ELEMENT_COMPARE(STRICT_EQUAL, 1) ELEMENT_COMPARE(STRICT_EQUAL, 1)
(() => { const it = new Map([[1, 2]]).keys(); const a = it.some(k => k === 1); return [a, it.some(k => k === 1)]; })()
--- fault once

=== an iterator's every
@shapes ELEMENT_COMPARE(GREATER, 0) ELEMENT_COMPARE(GREATER, 0)
[new Map([[1, 1], [2, 5]]).values().every(v => v > 0), new Map([[1, 1], [2, -5]]).values().every(v => v > 0)]
--- value
[true,false]

=== an iterator's every stops at the first false answer
@shapes PLUCK(k)
new Map([[1, {k: 0}], [2, null]]).values().every(v => v.k)
--- value
false

=== an iterator's every by a key stops at the first false answer
@shapes KEY_COMPARE(k, STRICT_EQUAL, 1)
new Map([[1, {k: 0}], [2, null]]).values().every(v => v.k === 1)
--- value
false

=== an iterator's every takes truthy answers that are not booleans
[new Map([[1, 1], [2, "x"], [3, {}], [4, []], [5, -1]]).values().every(v => v), new Map([[1, 1], [2, NaN]]).values().every(v => v), new Map([[1, 1], [2, ""]]).values().every(v => v)]
--- value
[true,false,false]

=== an iterator's every is called with the value and a counter only
new Map([["a", 1], ["b", 2], ["c", 3]]).keys().every((k, i, rest) => rest === undefined && i < 3)
--- value
true

=== an iterator's every whose callback faults
new Map([[1, {k: 1}], [2, null]]).values().every((v, i) => v.k === 1)
--- fault of null

=== an iterator's find
@shapes KEY_COMPARE(n, STRICT_EQUAL, 2)
new Map([["a", {n: 1, id: "a"}], ["b", {n: 2, id: "b"}], ["c", {n: 2, id: "c"}]]).values().find(v => v.n === 2)
--- value
{"n":2,"id":"b"}

=== an iterator's find that finds nothing
@shapes ELEMENT_COMPARE(GREATER, 9)
new Map([[1, 1], [2, 2]]).keys().find(k => k > 9) === undefined
--- value
true

=== an iterator's find gives the value, not the answer
new Map([[1, 0], [2, 7], [3, 8]]).values().find((v, i) => i > 0)
--- value
7

=== an iterator's find stops at the first element it finds
new Map([[1, {k: 1}], [2, null]]).values().find((v, i) => v.k)
--- value
{"k":1}

=== an iterator's find is called with the value and a counter only
new Map([["a", 1], ["b", 2]]).entries().find(([k, v], i, rest) => i === 1 && rest === undefined)
--- value
