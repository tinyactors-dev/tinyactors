# Object.groupBy: edge cases checked against Node 22 (values generated by node).

=== integer-like keys sort first, others keep first-seen order
Object.groupBy([5,"b",10,"a",2,"10",1.5,"01",4294967294,4294967295], x => x)
--- value
{"2":[2],"5":[5],"10":[10,"10"],"4294967294":[4294967294],"b":["b"],"a":["a"],"1.5":[1.5],"01":["01"],"4294967295":[4294967295]}

=== pluck with numeric keys out of order
Object.groupBy([{k:3,v:1},{k:"x",v:2},{k:1,v:3},{k:3,v:4}], r => r.k)
--- value
{"1":[{"k":1,"v":3}],"3":[{"k":3,"v":1},{"k":3,"v":4}],"x":[{"k":"x","v":2}]}

=== pluck where a row lacks the key
Object.groupBy([{k:1},{j:2},{k:1}], r => r.k)
--- value
{"1":[{"k":1},{"k":1}],"undefined":[{"j":2}]}

=== block-bodied pluck
Object.groupBy([{t:"a"},{t:"b"},{t:"a"}], r => { return r.t; })
--- value
{"a":[{"t":"a"},{"t":"a"}],"b":[{"t":"b"}]}

=== index argument
Object.groupBy(["a","b","c","d"], (x, i) => i % 2 === 0 ? "even" : "odd")
--- value
{"even":["a","c"],"odd":["b","d"]}

=== boolean, null and undefined keys
Object.groupBy([1,2,3,null], x => x === null ? null : x > 1)
--- value
{"false":[1],"true":[2,3],"null":[null]}

=== -0 and NaN keys
Object.keys(Object.groupBy([-0, 0, NaN, 0/0], x => x))
--- value
["0","NaN"]

=== result spreads and nests
({...Object.groupBy([1,2,3], x => x % 2), extra: Object.groupBy([], x => x)})
--- value
{"0":[2],"1":[1,3],"extra":{}}

=== groups are fresh arrays of the same items
(() => { const r = {id: 1, t: "x"}; const g = Object.groupBy([r, {id: 2, t: "x"}, r], x => x.t); return [g.x.length, g.x.map(y => y.id)]; })()
--- value
[3,[1,2,1]]

=== many groups past the index threshold
Object.keys(Object.groupBy([..."abcdefghijklmnopqrstuvwxyz"].map((c, i) => ({c, i})), r => r.c)).length
--- value
26

=== groupBy inside a map callback
[[1,2,3],[4,5]].map(xs => Object.keys(Object.groupBy(xs, x => x % 2)))
--- value
[["0","1"],["0","1"]]

=== captured key function
(() => { const k = "t"; return Object.groupBy([{t:1},{t:2},{t:1}], r => r[k]); })()
--- value
{"1":[{"t":1},{"t":1}],"2":[{"t":2}]}

=== object key faults
Object.groupBy([{a:1}], x => x)
--- fault

=== pluck to an object faults
Object.groupBy([{k:{}}], r => r.k)
--- fault

=== __proto__ key
Object.groupBy(["__proto__"], x => x)
--- fault

=== prototype name on the result
Object.groupBy([1], x => "a").hasOwnProperty
--- fault

=== string items
Object.groupBy("abc", x => x)
--- fault

=== callback that is not a function
Object.groupBy([1], 5)
--- fault

=== number keys from a key callback in C, at the edges of their text
@shapes PLUCK(k)
Object.groupBy([{k: 4294967295}, {k: -0}, {k: 1.5}, {k: 4294967296}, {k: NaN}, {k: 0}, {k: -1}, {k: 2**53}, {k: 1e21}, {k: "1"}, {k: 1}, {k: 4294967295}, {k: -4294967296}, {k: 0.1}, {k: Infinity}, {k: -Infinity}], x => x.k)
--- value
{"0":[{"k":-0},{"k":0}],"1":[{"k":"1"},{"k":1}],"4294967295":[{"k":4294967295},{"k":4294967295}],"1.5":[{"k":1.5}],"4294967296":[{"k":4294967296}],"NaN":[{"k":NaN}],"-1":[{"k":-1}],"9007199254740992":[{"k":9007199254740992}],"1e+21":[{"k":1e+21}],"-4294967296":[{"k":-4294967296}],"0.1":[{"k":0.1}],"Infinity":[{"k":Infinity}],"-Infinity":[{"k":-Infinity}]}

=== number and string keys from a key callback in C share a group
@shapes PLUCK(k)
Object.keys(Object.groupBy([{k: 3}, {k: "3"}, {k: "b"}, {k: 3}, {k: 2}, {k: "2"}, {k: true}, {k: "true"}, {k: null}, {k: undefined}], x => x.k))
--- value
["2","3","b","true","null","undefined"]
