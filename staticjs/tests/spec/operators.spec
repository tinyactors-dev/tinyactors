# Operators, and the order they bind in.

=== precedence
1 + 2 * 3 - 4 / 2
--- value
5

=== parentheses
(1 + 2) * 3
--- value
9

=== unary minus binds tighter than *
-2 * 3
--- value
-6

=== remainder is exact and takes the sign of the left
[7 % 3, -7 % 3, 7 % -3, 5.5 % 2, 0.3 % 0.1, -0 % 1, 1 % 0, 1e22 % 7]
--- value
[1,-1,1,1.5,0.09999999999999998,-0,NaN,4]

=== division
[1 / 0, -1 / 0, 0 / 0, 1 / 3]
--- value
[Infinity,-Infinity,NaN,0.3333333333333333]

=== adding strings
"a" + "b" + 1 + 2
--- value
"ab12"

=== a number first, then a string
1 + 2 + "a"
--- value
"3a"

=== adding primitives to a string
["" + null, "" + undefined, "" + true, "x" + 1.5, 2 + "x"]
--- value
["null","undefined","true","x1.5","2x"]

=== comparing numbers
[1 < 2, 2 <= 2, 3 > 4, 4 >= 4, NaN < 1, NaN >= NaN]
--- value
[true,true,false,true,false,false]

=== comparing strings by UTF-16 code unit
["a" < "b", "B" < "a", "abc" < "abd", "ab" < "abc", "￿" < "😀", "é" > "e"]
--- value
[true,true,true,true,false,true]

=== strict equality of primitives
[1 === 1, 1 === "1", NaN === NaN, 0 === -0, null === undefined, "a" === "a", 1 !== 2]
--- value
[true,false,false,true,false,true,true]

=== an object is never === a primitive
[[1] === 1, ({}) !== "x", null === ({})]
--- value
[false,true,false]

=== && and || return an operand
[1 && 2, 0 && 2, 1 || 2, 0 || 2, "" || null, null && undefined.x]
--- value
[2,0,1,2,null,null]

=== ?? replaces only null and undefined
[null ?? 1, undefined ?? 2, 0 ?? 3, "" ?? 4, false ?? 5]
--- value
[1,2,0,"",false]

=== ?? with parentheses around ||
(null || null) ?? "default"
--- value
"default"

=== short-circuit skips the right side
false && undefined.x
--- value
false

=== the conditional operator
[1 ? "yes" : "no", 0 ? "yes" : "no"]
--- value
["yes","no"]

=== nested conditionals associate to the right
(n => n < 0 ? "negative" : n === 0 ? "zero" : "positive")(0)
--- value
"zero"

=== a conditional in a conditional's test
(true ? false : true) ? 1 : 2
--- value
2

=== not
[!0, !1, !"", !"x", !null, !undefined, !NaN, ![], !{}]
--- value
[true,false,true,false,true,true,true,false,false]

=== typeof
[typeof 1, typeof "s", typeof true, typeof undefined, typeof null, typeof [], typeof {}, typeof (x => x), typeof new Set(), typeof Math.max]
--- value
["number","string","boolean","undefined","object","object","object","function","object","function"]

=== unary plus and minus on numbers
[+1, -(-2), -0 === 0]
--- value
[1,2,true]

=== in looks at own properties
["a" in {a: 1}, "b" in {a: 1}, 0 in [5], 1 in [5], "length" in []]
--- value
[true,false,true,false,true]

=== optional chaining on a value
({a: {b: 2}})?.a?.b
--- value
2

=== optional chaining stops at null
((o) => o?.a.b.c)(null)
--- value
undefined

=== optional chaining stops the whole chain
((o) => [o?.a.b, o?.a?.b])({a: null})
--- fault cannot read a property of null

=== optional index and call
((xs, f) => [xs?.[1], f?.(2), (null)?.[0], (undefined)?.(1)])([1, 2], x => x * 10)
--- value
[2,20,undefined,undefined]

=== optional chaining inside an argument
[1, 2].map(x => ({v: x})?.v)
--- value
[1,2]

=== member access on arrays and strings
[[1, 2, 3].length, [1, 2, 3][1], "héllo".length, "abc"[1], [1][5]]
--- value
[3,2,5,"b",undefined]

=== string length counts UTF-16 units
["😀".length, "a😀b".length]
--- value
[2,4]

=== an index that is not an integer
[[1, 2][1.5], [1, 2]["1"], [1, 2][-1]]
--- value
[undefined,2,undefined]

# ?? and && or || in separate expressions of one bracket (values generated by Node 22).

=== ?? after || in the next array element
[0 || 1, 0 ?? 2]
--- value
[1,0]

=== ?? after && in the next argument
Math.max(0 && 1, null ?? 3)
--- value
3

=== ?? after || in the next property
({a: 0 || 1, b: null ?? 2, c: 1 && 0})
--- value
{"a":1,"b":2,"c":0}

=== ?? after || in the next template part
`${0 || 1}${null ?? 2}`
--- value
"12"

=== ?? after || in the next declarator
(() => { const a = 0 || 1, b = null ?? 2; return [a, b]; })()
--- value
[1,2]

=== ?? after || in the next spread
[...[0 || 1], ...[null ?? 2]]
--- value
[1,2]

=== ?? after || in a computed key and its value
({[0 || "k"]: null ?? 1})
--- value
{"k":1}

=== ?? and || in one expression still need parentheses
[0 || 1 ?? 2]
--- error syntax cannot be mixed


=== ?? after || in the next parameter default
((a = 0 || 1, b = null ?? 2) => [a, b])()
--- value
[1,2]

=== ?? after || in the next pattern default
(() => { const {a = 0 || 1, b = null ?? 2} = {}; return [a, b]; })()
--- value
[1,2]

=== ?? after || in the next statement
(() => { const a = 0 || 1; if (a) { const b = null ?? 2; return [a, b]; } return null ?? 3; })()
--- value
[1,2]

=== ?? after || in an index then the next element
[[5, 6][0 || 1], null ?? 2]
--- value
[6,2]

=== ?? after || in a conditional's branches
[true ? 0 || 1 : null ?? 2, false ? 0 || 1 : null ?? 2]
--- value
[1,2]

# **: its binding next to unary operators, its zeros, and **= on every
# kind of target (values from Node 22).

=== ** binds tighter than unary operators on its right, and parentheses lift a unary base
[2 ** -2, 2 ** - - 2, 2 ** +2, 2 ** -(-3), (-2) ** 3, (-2) ** 2, -(2 ** 2), (2 ** -2) ** 2, 2**-1, 2 **3**2]
--- value
[0.25,4,4,8,-8,4,-4,0.0625,0.5,512]

=== ** at zeros and infinities: signs
[(-0) ** -1, (-0) ** -2, 0 ** -1, (-Infinity) ** 3, (-Infinity) ** 0.5, 1 ** NaN, NaN ** 0, (-1) ** Infinity].map(String).concat([1 / (-0) ** 3 === -Infinity, 1 / (-0) ** 2 === Infinity, 1 / (-Infinity) ** -3 === -Infinity, 1 / (-0) ** 0.5 === Infinity])
--- value
["-Infinity","Infinity","Infinity","-Infinity","Infinity","NaN","1","NaN",true,true,true,true]

=== **= of a path, a computed key and a let in a callback
(() => { const k = "n"; const o = {n: 3, p: {q: [2, 5]}}; o[k] **= 2; o.p.q[0] **= 10; o.p.q[1] **= -1; const ys = [2, 3].map(x => { let y = x; y **= y; y **= 2; return y; }); return [o, ys]; })()
--- value
[{"n":9,"p":{"q":[1024,0.2]}},[16,729]]

=== a unary operator before ** on the right of **
2 ** -2 ** 2
--- error syntax cannot follow a unary operator

=== a parenthesized operand of unary minus before **
-(2) ** 2
--- error syntax cannot follow a unary operator

=== two unary minuses before **
- -2 ** 2
--- error syntax cannot follow a unary operator

=== typeof before **
typeof 2 ** 2
--- error syntax cannot follow a unary operator

=== ! before **
!2 ** 2
--- error syntax cannot follow a unary operator

=== a unary minus of a variable before ** in a function
(() => { const x = 3; return 2 ** -x ** 2; })()
--- error syntax cannot follow a unary operator

=== **= of a const
(() => { const a = 2; a **= 2; return a; })()
--- error unsupported declared with let

=== **= of a captured let
(() => { let x = 2; const f = () => { x **= 2; return x; }; return f(); })()
--- error unsupported captures this let

=== **= as a value
(() => { let v = 2; return v **= 3; })()
--- error unsupported no assignment as a value

=== **= chained
(() => { let a = 2, b = 3; a **= b **= 2; return [a, b]; })()
--- error unsupported no assignment as a value

=== **= of a missing key faults, where JavaScript gives NaN
(() => { const o = {}; o.n **= 2; return String(o.n); })()
--- fault arithmetic in staticjs is on numbers

=== **= of a let holding undefined faults, where JavaScript gives NaN
(() => { let a; a **= 2; return String(a); })()
--- fault arithmetic in staticjs is on numbers

=== ** of a boolean faults, where JavaScript converts it
true ** 2
--- fault arithmetic in staticjs is on numbers

=== ** of undefined faults, where JavaScript gives NaN
String(undefined ** 2)
--- fault arithmetic in staticjs is on numbers

=== **= of a frozen object's key faults
(() => { const o = Object.freeze({n: 2}); o.n **= 2; return o.n; })()
--- fault frozen

=== **= of an array's length faults
(() => { const xs = [2, 3]; xs.length **= 2; return xs.length; })()
--- fault does not assign an array's length
