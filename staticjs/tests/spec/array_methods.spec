# Array methods added by the stdlib workflow: edge cases checked against Node 22 (values generated by node).

=== findLastIndex with a key predicate stops at the last match
[{k:1},{k:2},{k:1},{k:3}].findLastIndex(r => r.k === 1)
--- value
2

=== findLastIndex gets the index argument
[5,6,7,8].findLastIndex((x, i) => i < 2)
--- value
1

=== findLastIndex on an empty array
[].findLastIndex(x => x > 0)
--- value
-1

=== findLastIndex mirrored literal
[3,1,4,1,5].findLastIndex(x => 2 > x)
--- value
3

=== lastIndexOf with NaN and -0
[[NaN].lastIndexOf(NaN), [0, -0, 1].lastIndexOf(-0), [0, -0, 1].lastIndexOf(0)]
--- value
[-1,1,1]

=== lastIndexOf with fromIndex in every range
[1,2,1,2,1].map((_, i, xs) => [xs.lastIndexOf(1, i - 2), xs.lastIndexOf(2, -i), xs.lastIndexOf(1, 99)])
--- value
[[2,-1,4],[4,3,4],[0,3,4],[0,1,4],[2,1,4]]

=== lastIndexOf with fractional and infinite fromIndex
[[1,2,1].lastIndexOf(1, 1.9), [1,2,1].lastIndexOf(1, -Infinity), [1,2,1].lastIndexOf(1, Infinity)]
--- value
[0,-1,2]

=== lastIndexOf with strings and non-ASCII
["é", "a", "é"].lastIndexOf("é")
--- value
2

=== toSpliced in every argument form
(() => { const xs = [1,2,3,4,5]; return [xs.toSpliced(), xs.toSpliced(2), xs.toSpliced(-2, 1), xs.toSpliced(1, 2, "a", "b", "c"), xs.toSpliced(10, 1, "z"), xs.toSpliced(1, -5, "y"), xs]; })()
--- value
[[1,2,3,4,5],[1,2],[1,2,3,5],[1,"a","b","c",4,5],[1,2,3,4,5,"z"],[1,"y",2,3,4,5],[1,2,3,4,5]]

=== toSpliced of an array nothing else holds, inside reduce
[1,2,3,4].reduce((acc, x) => acc.toSpliced(0, 0, x), [])
--- value
[4,3,2,1]

=== toSpliced with undefined skipCount
[1,2,3].toSpliced(1, undefined, 9)
--- value
[1,9,2,3]

=== Array.of
[Array.of(), Array.of(7), Array.of(1, "a", null, [2], {b: 3})]
--- value
[[],[7],[1,"a",null,[2],{"b":3}]]

=== Array.from an array, a set and a string
[Array.from([1,2]), Array.from(new Set([3,1,3,2])), Array.from("a😀b")]
--- value
[[1,2],[3,1,2],["a","😀","b"]]

=== Array.from { length: n }
[Array.from({length: 3}, (_, i) => i * i), Array.from({length: 0}).length, Array.from({length: 2}).length]
--- value
[[0,1,4],0,2]

=== Array.from with a pluck mapper over mixed rows
Array.from([{k: 1}, {j: 2}, {k: "x"}], r => r.k).map(v => v === undefined ? "u" : v)
--- value
[1,"u","x"]

=== Array.from a string with a mapper
Array.from("héllo", (c, i) => c + i)
--- value
["h0","é1","l2","l3","o4"]

=== Array.from the result of Object.groupBy's keys
Array.from(Object.keys(Object.groupBy([3,1,2,1], x => x)), k => k + "!")
--- value
["1!","2!","3!"]

=== lastIndexOf of an object
[{}].lastIndexOf({})
--- fault

=== lastIndexOf with a string fromIndex
[1].lastIndexOf(1, "0")
--- fault

=== Array.from an object with other keys
Array.from({length: 2, 0: "a"})
--- fault

=== Array.from a negative length
Array.from({length: -1})
--- fault

=== Array.from a fractional length
Array.from({length: 1.5})
--- fault

=== Array.from a number
Array.from(5)
--- fault

=== Array.from with a mapper that is not a function
Array.from([1], 5)
--- fault

=== findLastIndex with no predicate
[1].findLastIndex()
--- fault

# reduceRight: reduce from the last element to the first, values from Node 22.
# No shape's C path runs it (SUM adds from the first element), but the
# matcher tags the callbacks all the same, so @shapes names their tags.

=== reduceRight with an initial value
@shapes SUM(false)
[1, 2, 3, 4].reduceRight((a, x) => a + x, 0)
--- value
10

=== reduceRight concatenates strings from the end
@shapes SUM(false) SUM(false) SUM(true)
[["a", "b", "c"].reduceRight((a, x) => a + x), ["a", "b", "c"].reduceRight((a, x) => a + x, ""), ["a", "b", "c"].reduceRight((a, x) => x + a, "z")]
--- value
["cba","cba","abcz"]

=== reduceRight passes the index and the array
[[1, 2, 3].reduceRight((a, x, i) => a.concat([[x, i]]), []), [10, 20, 30].reduceRight((a, x, i, xs) => a.concat([[x, i, xs.length, xs[i] === x]]), [])]
--- value
[[[3,2],[2,1],[1,0]],[[30,2,3,true],[20,1,3,true],[10,0,3,true]]]

=== reduceRight without an initial value starts at the last element, index one before it
[5, 6, 7].reduceRight((a, x, i) => String(a) + "," + String(i))
--- value
"7,1,0"

=== reduceRight of an empty array with an initial value gives it uncalled
@shapes SUM(false) SUM(false) SUM(false)
[[].reduceRight((a, x) => a + x, 0), [].reduceRight((a, x) => a + x, "start"), [].reduceRight((a, x) => a + x, undefined) === undefined]
--- value
[0,"start",true]

=== reduceRight of one element without an initial value gives it uncalled
@shapes SUM(false) PLUCK(k) SUM(false)
[[7].reduceRight((a, x) => a + x), [{k: 1}].reduceRight(a => a.k), [7].reduceRight((a, x) => a + x, 1)]
--- value
[7,{"k":1},8]

=== reduceRight adds floating-point numbers in its own order
@shapes SUM(false) SUM(false) SUM(false) SUM(false) SUM(true) SUM_KEY(k, false) SUM_KEY(k, false)
[[0.1, 0.2, 0.3].reduceRight((a, x) => a + x, 0), [0.1, 0.2, 0.3].reduce((a, x) => a + x, 0), [1, 1e16, -1e16].reduceRight((a, x) => a + x, 0), [1, 1e16, -1e16].reduce((a, x) => a + x, 0), [0.1, 0.2, 0.3].reduceRight((a, x) => x + a, 0), [{k: 0.1}, {k: 0.2}, {k: 0.3}].reduceRight((a, x) => a + x.k, 0), [{k: 0.1}, {k: 0.2}, {k: 0.3}].reduce((a, x) => a + x.k, 0)]
--- value
[0.6,0.6000000000000001,1,0,0.6,0.6,0.6000000000000001]

=== reduceRight without an initial value on 1e16, 1, -1e16
@shapes SUM(false)
[1e16, 1, -1e16].reduceRight((a, x) => a + x)
--- value
0

=== reduceRight subtracts and divides from the end
[[3, 1, 2].reduceRight((a, x) => a - x), [2, 3, 4].reduceRight((a, x) => a / x)]
--- value
[-2,0.6666666666666666]

=== reduceRight with an object accumulator
[Object.entries(["x", "y", "x", "z"].reduceRight((acc, k, i) => ({...acc, [k]: i}), {})), ["a", "b", "c"].reduceRight((acc, k, i) => ({...acc, [k]: i}), {}), [1, 2, 3, 4].reduceRight((acc, x) => x % 2 ? {...acc, odd: acc.odd.concat([x])} : {...acc, even: acc.even.concat([x])}, {odd: [], even: []})]
--- value
[[["z",3],["x",0],["y",1]],{"c":2,"b":1,"a":0},{"odd":[3,1],"even":[4,2]}]

=== reduceRight with an array accumulator nothing else holds
[[1, 2, 3].reduceRight((a, x) => a.toSpliced(a.length, 0, x), []), [1, 2, 3].reduceRight((a, x) => [x].concat(a), []), [[1, 2], [3], [4, 5]].reduceRight((a, x) => a.concat(x), []), [1, 2, 3].map(x => x * 2).reduceRight((a, x) => a.concat([x]), [])]
--- value
[[3,2,1],[1,2,3],[4,5,3,1,2],[6,4,2]]

=== reduceRight nested, BigInts and booleans
[[[1, 2], [3, 4]].reduceRight((a, row) => a + row.reduceRight((b, x) => b * 10 + x, 0), 0), [1n, 2n, 3n].reduceRight((a, x) => a * 10n + x, 0n).toString(), [true, false, true].reduceRight((a, x) => a && x), [1, 2].reduceRight((a, x) => a + x, 0, 9)]
--- value
[64,"321",false,3]

=== reduceRight of an empty array without an initial value faults
[].reduceRight((a, x) => a + x)
--- fault reduceRight of an empty array needs an initial value

=== reduceRight with a callback that is not a function faults
[1, 2].reduceRight(5)
--- fault the callback is not a function

=== reduceRight with no callback faults
[1, 2].reduceRight()
--- fault the callback is not a function

=== reduceRight of an empty array with a callback that is not a function faults
[].reduceRight("f", 0)
--- fault the callback is not a function

=== reduceRight with a callback that faults
[1, 2].reduceRight((a, x) => a.k.m, {})
--- fault cannot read a property of undefined

=== reduceRight with a callback that faults on the middle element
[1, 2, 3].reduceRight((a, x) => { if (x === 2) return a.q.r; return a + x; }, 0)
--- fault reads properties of objects

=== a map's iterator has no reduceRight
new Map([[1, 2]]).values().reduceRight((a, x) => a + x)
--- fault does not have this method

=== an iterator helper's iterator has no reduceRight
new Set([1, 2]).values().map(x => x).reduceRight((a, x) => a + x, 0)
--- fault does not have this method

=== a set's iterator has no reduceRight
new Set([1]).values().reduceRight((a, x) => a + x, 0)
--- fault does not have this method

=== a string has no reduceRight
"abc".reduceRight((a, x) => a + x)
--- fault does not have this method

# reduceRight: built-in callbacks, its arguments, and accumulators updated
# in place or refused (from the batch's review).
=== reduceRight with Math.max faults on the array it passes as the fourth argument
[1, 5, 3].reduceRight(Math.max)
--- fault converts only numbers

=== reduceRight passes four arguments, and its initial value as it is
[[1, 2, 3].reduceRight((...args) => args.length, 0), [1].reduceRight((a, x) => a, -0), [1].reduceRight((a, x) => a, NaN), [1].reduceRight((a, x) => a, undefined), [1].reduceRight((a, x) => a, null), [7].reduceRight((a, x) => a), [-0].reduceRight((a, x) => x)]
--- value
[4,-0,NaN,undefined,null,7,-0]

=== reduceRight builds an object in place from the end
["a", "b", "a", "c"].reduceRight((acc, x, i) => { acc[x] = (acc[x] ?? "") + i; return acc; }, {})
--- value
{"c":"3","a":"20","b":"1"}

=== reduceRight with a set and a map accumulator
[[1, 2, 3].reduceRight((acc, x) => acc.add(x * 2), new Set()), [1, 2, 3].reduceRight((acc, x) => acc.set(x, x * x), new Map())]
--- value
[new Set([6,4,2]),new Map([[3,9],[2,4],[1,1]])]

=== reduceRight cannot change an initial value a variable still holds
(() => { const o = {}; const r = [1, 2].reduceRight((acc, x) => { acc[x] = 1; return acc; }, o); return [r, o]; })()
--- fault held elsewhere

=== reduceRight cannot change its array through the fourth argument
[1, 2].reduceRight((acc, x, i, xs) => { xs.push(0); return acc; }, 0)
--- fault held elsewhere

=== reduceRight cannot change an element its array holds
[[1], [2]].reduceRight((acc, x) => { acc.push(x[0]); return acc; })
--- fault held elsewhere

