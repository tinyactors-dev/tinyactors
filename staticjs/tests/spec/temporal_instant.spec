--- fault would convert this object

# --- Getters

=== epochMilliseconds and epochNanoseconds
(i => [i.epochMilliseconds, i.epochNanoseconds])(new Temporal.Instant(1704067200123456789n))
--- value
[1704067200123,1704067200123456789n]

=== epochMilliseconds rounds toward negative infinity
[new Temporal.Instant(-1n).epochMilliseconds, new Temporal.Instant(-1000000n).epochMilliseconds, new Temporal.Instant(-1000001n).epochMilliseconds, new Temporal.Instant(1999999n).epochMilliseconds]
--- value
[-1,-1,-2,1]

=== the getters at the limits
(i => [i.epochMilliseconds, i.epochNanoseconds, i.epochNanoseconds === -8640000000000000000000n])(new Temporal.Instant(-8640000000000000000000n))
--- value
[-8640000000000000,-8640000000000000000000n,true]

=== epochNanoseconds is a BigInt
[typeof new Temporal.Instant(1n).epochNanoseconds, new Temporal.Instant(1n).epochNanoseconds + 1n]
--- value
["bigint",2n]

=== the other types' getters are undefined
(i => [i.year, i.hour, i.days, i.epochSeconds, i.epochMicroseconds, i.calendarId, i.with])(new Temporal.Instant(0n))
--- value
[undefined,undefined,undefined,undefined,undefined,undefined,undefined]

=== a method read as a value, deliberate
new Temporal.Instant(0n).round
--- fault does not read them as values

=== a method an Instant does not have
new Temporal.Instant(0n).toPlainDateTime()
--- fault does not have this method

=== no own properties
[Object.keys({ ...new Temporal.Instant(0n) }).length, Object.hasOwn(new Temporal.Instant(0n), "epochNanoseconds")]
--- value
[0,false]

=== typeof
typeof new Temporal.Instant(0n)
--- value
"object"

# --- compare and equals

=== compare
[Temporal.Instant.compare(new Temporal.Instant(0n), new Temporal.Instant(-1n)), Temporal.Instant.compare("1970-01-01T00:00Z", "1970-01-01T01:00+01:00"), Temporal.Instant.compare("1969-12-31T23:59:59.999999999Z", new Temporal.Instant(0n))]
--- value
[1,0,-1]

=== compare of the limits
Temporal.Instant.compare(new Temporal.Instant(-8640000000000000000000n), new Temporal.Instant(8640000000000000000000n))
--- value
-1

=== compare of a string without an offset
Temporal.Instant.compare("1970-01-01T00:00", new Temporal.Instant(0n))
--- fault not one

=== compare of a BigInt
Temporal.Instant.compare(0n, new Temporal.Instant(0n))
--- fault neither an Instant nor a string

=== equals
[new Temporal.Instant(0n).equals("1970-01-01T00:00Z"), new Temporal.Instant(0n).equals(new Temporal.Instant(1n)), new Temporal.Instant(3600000000000n).equals("1970-01-01T02:00+01:00")]
--- value
[true,false,true]

=== equals of a number
new Temporal.Instant(0n).equals(0)
--- fault neither an Instant nor a string

=== === on two Instants compares identity, deliberate
new Temporal.Instant(0n) === new Temporal.Instant(0n)
--- fault compares identity

=== an Instant in a template, deliberate
`${new Temporal.Instant(0n)}`
--- fault

=== an Instant in a set, deliberate
new Set([new Temporal.Instant(0n)])
--- fault

# --- add and subtract

=== add hours to nanoseconds
new Temporal.Instant(0n).add({ hours: 1, minutes: 2, seconds: 3, milliseconds: 4, microseconds: 5, nanoseconds: 6 })
--- value
Temporal.Instant.from("1970-01-01T01:02:03.004005006Z")

=== add a string, a Duration and 24 hours
[new Temporal.Instant(0n).add("PT1H"), new Temporal.Instant(0n).add(Temporal.Duration.from("-PT1M")), new Temporal.Instant(0n).add({ hours: 24 })]
--- value
[Temporal.Instant.from("1970-01-01T01:00:00Z"),Temporal.Instant.from("1969-12-31T23:59:00Z"),Temporal.Instant.from("1970-01-02T00:00:00Z")]

=== subtract
[new Temporal.Instant(0n).subtract("PT1H"), new Temporal.Instant(0n).subtract({ nanoseconds: -1 })]
--- value
[Temporal.Instant.from("1969-12-31T23:00:00Z"),Temporal.Instant.from("1970-01-01T00:00:00.000000001Z")]

=== add a day
new Temporal.Instant(0n).add({ days: 1 })
--- fault years, months, weeks or days

=== add a year
new Temporal.Instant(0n).add("P1Y")
--- fault years, months, weeks or days

=== subtract a week
new Temporal.Instant(0n).subtract("P1W")
--- fault years, months, weeks or days

=== zero days are not a day
new Temporal.Instant(0n).add({ days: 0, hours: 1 })
--- value
Temporal.Instant.from("1970-01-01T01:00:00Z")

=== add to the limit
[new Temporal.Instant(0n).add({ nanoseconds: 8.64e21 }), new Temporal.Instant(0n).subtract({ nanoseconds: 8.64e21 })]
--- value
[Temporal.Instant.from("+275760-09-13T00:00:00Z"),Temporal.Instant.from("-271821-04-20T00:00:00Z")]

=== add past the limit
new Temporal.Instant(8640000000000000000000n).add({ nanoseconds: 1 })
--- fault 8.64 x 10^21

=== add the largest Duration
new Temporal.Instant(0n).add({ seconds: 9007199254740991, nanoseconds: 999999999 })
--- fault 8.64 x 10^21

=== add takes no options
new Temporal.Instant(0n).add("PT1S", "x")
--- value
Temporal.Instant.from("1970-01-01T00:00:01Z")

=== add of nothing
new Temporal.Instant(0n).add({})
--- fault without years, months

=== add on a variable makes a new value
(() => { const i = new Temporal.Instant(0n); const j = i.add("PT1H"); return [i, j]; })()
--- value
[Temporal.Instant.from("1970-01-01T00:00:00Z"),Temporal.Instant.from("1970-01-01T01:00:00Z")]

# --- until and since

=== until, in seconds by default
new Temporal.Instant(0n).until(new Temporal.Instant(3723004005006n))
--- value
Temporal.Duration.from("PT3723.004005006S")

=== until up to hours
new Temporal.Instant(0n).until("1970-01-01T01:02:03.004005006Z", { largestUnit: "hour" })
--- value
Temporal.Duration.from("PT1H2M3.004005006S")

=== since
new Temporal.Instant(0n).since("1970-01-01T01:02:03.004005006Z", { largestUnit: "hours" })
--- value
Temporal.Duration.from("-PT1H2M3.004005006S")

=== until rounded to minutes, largestUnit auto
new Temporal.Instant(0n).until(new Temporal.Instant(3723004005006n), { smallestUnit: "minute", roundingMode: "halfExpand" })
--- value
Temporal.Duration.from("PT62M")

=== since rounded down, negated
new Temporal.Instant(0n).since(new Temporal.Instant(3600000000001n), { smallestUnit: "minute", roundingMode: "floor" })
--- value
Temporal.Duration.from("-PT61M")

=== until by an increment
new Temporal.Instant(0n).until(new Temporal.Instant(3723004005006n), { smallestUnit: "minute", roundingIncrement: 15, roundingMode: "ceil" })
--- value
Temporal.Duration.from("PT75M")

=== across the whole range
[new Temporal.Instant(-8640000000000000000000n).until(new Temporal.Instant(8640000000000000000000n)), new Temporal.Instant(-8640000000000000000000n).until(new Temporal.Instant(8640000000000000000000n), { largestUnit: "hour" })]
--- value
[Temporal.Duration.from("PT17280000000000S"),Temporal.Duration.from("PT4800000000H")]

=== until in days
new Temporal.Instant(0n).until(new Temporal.Instant(1n), { largestUnit: "day" })
--- fault does not round to

=== until rounded to days
new Temporal.Instant(0n).until(new Temporal.Instant(1n), { smallestUnit: "day" })
--- fault does not round to

=== until by an increment that does not divide the hour
new Temporal.Instant(0n).until(new Temporal.Instant(1n), { smallestUnit: "minute", roundingIncrement: 7 })
--- fault does not divide

=== until by 24 hours
new Temporal.Instant(0n).until(new Temporal.Instant(1n), { smallestUnit: "hour", roundingIncrement: 24 })
--- fault does not divide

=== until with the largest unit below the smallest
new Temporal.Instant(0n).until(new Temporal.Instant(1n), { largestUnit: "second", smallestUnit: "minute" })
--- fault smaller than the smallestUnit

=== until of a string without an offset
new Temporal.Instant(0n).until("1970-01-01T01:00")
--- fault not one

# --- round

=== round to a unit
new Temporal.Instant(1704067200123456789n).round("second")
--- value
Temporal.Instant.from("2024-01-01T00:00:00Z")

=== round with an increment and a mode
new Temporal.Instant(1704067200123456789n).round({ smallestUnit: "minute", roundingIncrement: 15, roundingMode: "floor" })
--- value
Temporal.Instant.from("2024-01-01T00:00:00Z")

=== round by a day's worth of a unit
[new Temporal.Instant(1704067200123456789n).round({ smallestUnit: "hour", roundingIncrement: 24 }), new Temporal.Instant(1704067200123456789n).round({ smallestUnit: "minute", roundingIncrement: 1440 }), new Temporal.Instant(1704067200123456789n).round({ smallestUnit: "second", roundingIncrement: 86400 })]
--- value
[Temporal.Instant.from("2024-01-01T00:00:00Z"),Temporal.Instant.from("2024-01-01T00:00:00Z"),Temporal.Instant.from("2024-01-01T00:00:00Z")]

=== round before the epoch, as if positive
[new Temporal.Instant(-1500n).round("microsecond"), new Temporal.Instant(-1500n).round({ smallestUnit: "microsecond", roundingMode: "floor" }), new Temporal.Instant(-1500n).round({ smallestUnit: "microsecond", roundingMode: "ceil" })]
--- value
[Temporal.Instant.from("1969-12-31T23:59:59.999999Z"),Temporal.Instant.from("1969-12-31T23:59:59.999998Z"),Temporal.Instant.from("1969-12-31T23:59:59.999999Z")]

=== round before the epoch, trunc at an even quotient
new Temporal.Instant(-1500n).round({ smallestUnit: "microsecond", roundingMode: "trunc" })
--- value
Temporal.Instant.from("1969-12-31T23:59:59.999998Z")

=== round before the epoch, trunc at an odd quotient, deliberate: the polyfills differ
new Temporal.Instant(-1n).round({ smallestUnit: "nanosecond", roundingIncrement: 2, roundingMode: "trunc" })
--- fault round differently

=== round before the epoch, halfExpand on a tie at an odd quotient, deliberate: the polyfills differ
new Temporal.Instant(-500n).round({ smallestUnit: "microsecond", roundingMode: "halfExpand" })
--- fault round differently

=== round to the limit
new Temporal.Instant(8639999999999999999999n).round({ smallestUnit: "hour", roundingIncrement: 24, roundingMode: "ceil" })
--- value
Temporal.Instant.from("+275760-09-13T00:00:00Z")

=== round by an increment that does not divide a day
new Temporal.Instant(0n).round({ smallestUnit: "minute", roundingIncrement: 7 })
--- fault does not divide a day

=== round by more than a day
new Temporal.Instant(0n).round({ smallestUnit: "hour", roundingIncrement: 48 })
--- fault does not divide a day

=== round by more than 10^9, deliberate: the polyfills differ
new Temporal.Instant(0n).round({ smallestUnit: "microsecond", roundingIncrement: 86400000000 })
--- fault 10^9

=== round to a day
new Temporal.Instant(0n).round("day")
--- fault does not round to

=== round without options
new Temporal.Instant(0n).round()
--- fault without a smallestUnit

=== round without a smallestUnit
new Temporal.Instant(0n).round({ roundingMode: "ceil" })
--- fault without a smallestUnit

