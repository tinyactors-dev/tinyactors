=== a Date in an object, written and stringified
(() => { const o = { at: new Date(Date.UTC(2024, 1, 29, 12)) }; return [o, JSON.stringify(o)]; })()
--- value
[{"at":new Date("2024-02-29T12:00:00.000Z")},"{\"at\":\"2024-02-29T12:00:00.000Z\"}"]

=== Date.UTC of a Date's fields gives its time back
(() => { const d = new Date(-62198755200001); return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), d.getUTCHours(), d.getUTCMinutes(), d.getUTCSeconds(), d.getUTCMilliseconds()) === d.getTime(); })()
--- value
true
