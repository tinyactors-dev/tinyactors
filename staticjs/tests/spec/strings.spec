# Strings joined with + and templates. A left operand that nothing else
# holds (a value moved out of its variable by its last read, or one just
# made) is extended in place rather than copied (STRING_APPEND, README.md);
# these cases pin that the result is JavaScript's whatever the operands'
# holders. Every expected value was generated by running the case in Node 22.

# reduce with a string accumulator: the callback holds it alone.
=== join the elements with reduce
@shapes SUM(false)
["a", "b", "c"].reduce((acc, x) => acc + x, "")
--- value
"abc"

=== join the elements with reduce, the element first
@shapes SUM(true)
["a", "b", "c"].reduce((acc, x) => x + acc, "")
--- value
"cba"

=== join the elements with reduce from a string that is not empty
@shapes SUM(false)
["b", "c"].reduce((acc, x) => acc + x, "a")
--- value
"abc"

=== join numbers onto a string with reduce
@shapes SUM(false)
[1, 2.5, -0, 1e21, NaN].reduce((acc, x) => acc + x, "n:")
--- value
"n:12.501e+21NaN"

=== add numbers, then join them onto a string, with reduce
@shapes SUM(false)
[1, 2, "x", 3, 4].reduce((acc, x) => acc + x, 0)
--- value
"3x34"

=== join every kind of primitive with reduce
@shapes SUM(false)
[1, true, false, null, undefined, "é"].reduce((acc, x) => acc + x, "")
--- value
"1truefalsenullundefinedé"

=== join a key with reduce
@shapes SUM_KEY(id, false)
[{id: "a"}, {id: "b"}, {id: 3}].reduce((acc, r) => acc + r.id, "")
--- value
"ab3"

=== join a key and a separator with reduce
[{id: "a"}, {id: "b"}].reduce((acc, r) => acc + r.id + ",", "")
--- value
"a,b,"

=== join with a template in reduce
["a", "b", "c"].reduce((acc, x) => `${acc}${x},`, "")
--- value
"a,b,c,"

=== join with a template of every kind of value in reduce
[1, true, null, undefined, "é", -0].reduce((acc, x) => `${acc}${x}|`, "")
--- value
"1|true|null|undefined|é|0|"

=== a template whose head is not empty, in reduce
["a", "b"].reduce((acc, x) => `<${acc}${x}>`, "")
--- value
"<<a>b>"

=== a template of a number accumulator in reduce
[1, 2].reduce((acc, x) => `${acc}${x}`, 0)
--- value
"012"

=== a template of an object in reduce faults
[1, 2].reduce((acc, x) => `${acc}${x}`, {})
--- fault only primitives

=== join an object with reduce faults
@shapes SUM(false)
["a", {}].reduce((acc, x) => acc + x, "")
--- fault adds two numbers

=== join a boolean onto a number with reduce faults
@shapes SUM(false)
[true].reduce((acc, x) => acc + x, 1)
--- fault adds two numbers

=== join non-ASCII text and surrogate pairs with reduce
(() => { const s = ["a", "😀", "é", "\u{10FFFF}", "z"].reduce((acc, x) => acc + x, ""); return [s, s.length, s[0], s[3], s[6], s.slice(1, 3), s.indexOf("é"), s.includes("😀z"), s.endsWith("z")]; })()
--- value
["a😀é􏿿z",7,"a","é","z","😀",3,false,true]

=== the UTF-16 length after each join
["é", "😀", "a"].reduce((acc, x) => [...acc, (acc.length === 0 ? "" : acc[acc.length - 1]) + x], []).map(s => s.length)
--- value
[1,3,4]

=== a joined string is an array index once it reads as one
(() => { const k = ["1", "2"].reduce((acc, x) => acc + x, ""); const xs = [...Array.from({length: 13}, (_, i) => i)]; return [k, xs[k], {[k]: 1}]; })()
--- value
["12",12,{"12":1}]

=== a joined string that reads as an index, then not
(() => { const k = ["1", "2", "a"].reduce((acc, x) => acc + x, ""); return [k, {[k]: 1, 3: 2}]; })()
--- value
["12a",{"3":2,"12a":1}]

=== a joined string is a name of a method once it reads as one
(() => { const k = ["pu", "sh"].reduce((acc, x) => acc + x, ""); return [k, k.length, {[k]: 1}[k]]; })()
--- value
["push",4,1]

=== a joined string compares by its text
(() => { const k = ["a", "b"].reduce((acc, x) => acc + x, ""); return [k === "ab", k < "ac", "ab" === k, k.toUpperCase()]; })()
--- value
[true,true,true,"AB"]

# A string another holder keeps: it does not change.
=== the accumulator kept by an array of every step
["a", "b", "c"].reduce((acc, x) => [...acc, acc[acc.length - 1] + x], [""])
--- value
["","a","ab","abc"]

=== the accumulator kept by a const before it is joined
["a", "b"].reduce((acc, x) => { const kept = acc; const next = acc + x; return next + kept.length; }, "s")
--- value
"sa1b3"

=== the accumulator joined with itself
["a", "b"].reduce((acc, x) => acc + acc + x, "s")
--- value
"ssassab"

=== a joined string kept as an object's key, then joined again
(() => { const k = ["a", "b"].reduce((acc, x) => acc + x, ""); const o = {[k]: 1}; const k2 = k + "c"; return [o, k2, Object.keys(o)]; })()
--- value
[{"ab":1},"abc",["ab"]]

=== a joined string kept as an object's key, joined again on its last read
(() => { const k = ["a", "b"].reduce((acc, x) => acc + x, ""); const o = {[k]: 1}; return [k + "c", o, o.ab]; })()
--- value
["abc",{"ab":1},1]

=== a joined string kept in a set, then joined again
(() => { const k = ["a", "b"].reduce((acc, x) => acc + x, ""); const m = new Set([k]); return [k + "c", m, m.has("ab"), m.has("abc")]; })()
--- value
["abc",new Set(["ab"]),true,false]

=== a joined string kept in an array, then joined again
(() => { const k = ["a", "b"].reduce((acc, x) => acc + x, ""); const xs = [k]; return [k + "c", xs]; })()
--- value
["abc",["ab"]]

=== an object's key read out, then joined
(() => { const o = {["a" + "b"]: 1}; const k = Object.keys(o)[0]; return [k + "c", o]; })()
--- value
["abc",{"ab":1}]

=== a key of a literal read out of a temporary, then joined
[Object.keys({ab: 1})[0] + "c", {ab: 2}.ab, Object.keys({ab: 3})]
--- value
["abc",2,["ab"]]

=== a string constant joined twice
(() => { const f = x => "k" + x; return [f(1), f(2), "k"]; })()
--- value
["k1","k2","k"]

=== a template's string constants stay as they were
(() => { const f = x => `k${x}`; return [f(1), f(2), `k`]; })()
--- value
["k1","k2","k"]

=== a template of one substitution of a joined string
(() => { const s = ["a", "b"].reduce((acc, x) => acc + x, ""); return `${s}`; })()
--- value
"ab"

=== a template that joins one string onto itself
(() => { const s = ["a", "b"].reduce((acc, x) => acc + x, ""); return `${s}${s}`; })()
--- value
"abab"

=== a long string joined in reduce
Array.from({length: 1000}, (_, i) => i % 10).reduce((acc, x) => acc + x, "").length
--- value
1000

=== a long string joined with a template in reduce
(() => { const s = Array.from({length: 300}, (_, i) => ["é", "😀"][i % 2]).reduce((acc, x) => `${acc}${x}`, ""); return [s.length, s.slice(0, 4)]; })()
--- value
[450,"é😀é"]

# padStart, padEnd and repeat. Lengths and counts are in UTF-16 code units;
# a pad string converts with String's rules (an object faults), and padding
# that would end in half of a character outside the BMP faults, as staticjs
# strings cannot hold a lone surrogate. Every expected value was generated
# by running the case in Node 22.

=== padStart and padEnd
["abc".padStart(6), "abc".padEnd(6), "abc".padStart(6, "12"), "abc".padEnd(8, "12"), "abc".padStart(2), "abc".padEnd(3, "x"), "abc".padStart(6, ""), "abc".padEnd(6, "")]
--- value
["   abc","abc   ","121abc","abc12121","abc","abc","abc","abc"]

=== padStart and padEnd of an empty string
["".padStart(3, "ab"), "".padEnd(5, "ab"), "".padStart(0), "".padEnd(2)]
--- value
["aba","ababa","","  "]

=== padStart and padEnd count UTF-16 code units
["é".padStart(3, "日本"), "日本".padEnd(5, "é"), "😀".padStart(4, "x"), "x".padStart(5, "😀"), "x".padEnd(3, "😀"), "😀".padEnd(2, "x"), "é😀".padStart(5, "ab")]
--- value
["日本é","日本ééé","xx😀","😀😀x","x😀","😀","abé😀"]

=== padStart faults where the padding would end in half of a pair
"x".padStart(4, "😀")
--- fault lone surrogate

=== padEnd faults where the padding would end in half of a pair
"x".padEnd(2, "😀")
--- fault lone surrogate

=== padStart and padEnd convert lengths as ToLength does
["a".padStart(3.9, "-"), "a".padEnd(-5, "-"), "a".padStart(NaN, "-"), "a".padEnd(undefined, "-"), "a".padStart(null, "-"), "a".padEnd(true, "-"), "a".padStart(-0, "-"), "a".padEnd(-Infinity, "-"), "a".padStart(Infinity, "")]
--- value
["--a","a","a","a","a","a","a","a","a"]

=== padStart and padEnd convert a primitive pad string as String does
["5".padStart(3, 0), "a".padEnd(4, true), "a".padStart(5, null), "a".padEnd(3, undefined), "a".padStart(4, 1.5), "a".padEnd(4, -0), "a".padStart(3)]
--- value
["005","atru","nulla","a  ","1.5a","a000","  a"]

=== padStart faults on an object as the pad string
"a".padStart(3, {})
--- fault primitives

=== padEnd faults on an array as the pad string
"a".padEnd(3, [1])
--- fault primitives

=== padStart faults on a function as the pad string
"a".padStart(3, x => x)
--- fault primitives

=== padEnd faults on a set as the pad string
"a".padEnd(3, new Set([1]))
--- fault primitives

=== padStart and padEnd convert no pad string when there is nothing to pad
["abc".padStart(2, {}), "abc".padEnd(3, [1]), "".padStart(0, x => x)]
--- value
["abc","abc",""]

=== padStart faults on a length that is a string
"a".padStart("3")
--- fault numbers

=== padEnd faults on a length that is an object
"a".padEnd({}, "x")
--- fault numbers

=== padStart past the limit
"a".padStart(Infinity)
--- fault limit

=== padEnd past the limit
"ab".padEnd(1e9, "x")
--- fault limit

=== repeat
["ab".repeat(3), "ab".repeat(0), "".repeat(5), "é😀".repeat(2), "x".repeat(1), "日本".repeat(3)]
--- value
["ababab","","","é😀é😀","x","日本日本日本"]

=== repeat converts its count as ToIntegerOrInfinity does
["x".repeat(2.9), "x".repeat(NaN), "x".repeat(), "x".repeat(undefined), "x".repeat(null), "x".repeat(true), "x".repeat(false), "x".repeat(-0), "x".repeat(-0.5), "".repeat(1e9)]
--- value
["xx","","","","","x","","","",""]

=== repeat faults on a negative count
"x".repeat(-1)
--- fault count

=== repeat faults on an infinite count
"x".repeat(Infinity)
--- fault count

=== repeat faults on an infinite count of an empty string
"".repeat(Infinity)
--- fault count

=== repeat faults on a negative count of an empty string
"".repeat(-Infinity)
--- fault count

=== repeat faults on a count that is a string
"x".repeat("2")
--- fault numbers

=== repeat faults on a count that is an array
"x".repeat([2])
--- fault numbers

=== repeat past the limit
"abc".repeat(1e9)
--- fault limit

=== a padded and a repeated string join with +
(s => s + s.padEnd(4, "-") + s.repeat(2))("ab")
--- value
"abab--abab"

# at, charAt, charCodeAt and codePointAt index UTF-16 code units. at and
# charAt fault where the unit is half of a character outside the BMP, as
# indexing does: staticjs strings cannot hold a lone surrogate.
# charCodeAt and codePointAt give numbers, so they never fault on one.

=== at
["abc".at(0), "abc".at(2), "abc".at(3), "abc".at(-1), "abc".at(-3), "abc".at(-4), "".at(0), "".at(-1)]
--- value
["a","c",undefined,"c","a",undefined,undefined,undefined]

=== at converts its index as ToIntegerOrInfinity does
["abc".at(1.9), "abc".at(-1.5), "abc".at(NaN), "abc".at(), "abc".at(undefined), "abc".at(null), "abc".at(true), "abc".at(-0), "abc".at(Infinity) === undefined, "abc".at(-Infinity) === undefined]
--- value
["b","c","a","a","a","a","b","a",true,true]

=== at on text outside ASCII
["héllo".at(1), "日本".at(-1), "😀x".at(2), "x😀".at(0), "é😀é".at(-1), "é😀é".at(0)]
--- value
["é","本","x","x","é","é"]

=== at faults on the first half of a pair
"😀".at(0)
--- fault half

=== at faults on the second half of a pair
"x😀".at(-1)
--- fault half

=== at faults on an index that is a string
"abc".at("1")
--- fault numbers

=== charAt
["abc".charAt(0), "abc".charAt(2), "abc".charAt(3), "abc".charAt(-1), "".charAt(0), "abc".charAt(1.7), "abc".charAt(NaN), "abc".charAt(), "abc".charAt(null), "abc".charAt(true), "abc".charAt(Infinity), "abc".charAt(-Infinity)]
--- value
["a","c","","","","b","a","a","a","b","",""]

=== charAt on text outside ASCII
["héllo".charAt(1), "日本".charAt(1), "😀x".charAt(2), "😀".charAt(2), "😀".charAt(-1)]
--- value
["é","本","x","",""]

=== charAt faults on half of a pair
"a😀".charAt(2)
--- fault half

=== charAt faults on an index that is an object
"abc".charAt({})
--- fault numbers

=== charCodeAt
["abc".charCodeAt(0), "abc".charCodeAt(), "abc".charCodeAt(2.5), "abc".charCodeAt(-0), "abc".charCodeAt(true), "abc".charCodeAt(null)]
--- value
[97,97,99,97,98,97]

=== charCodeAt out of range is NaN
["abc".charCodeAt(3), "abc".charCodeAt(-1), "".charCodeAt(0), "abc".charCodeAt(Infinity), "abc".charCodeAt(-Infinity), "abc".charCodeAt(NaN)]
--- value
[NaN,NaN,NaN,NaN,NaN,97]

=== charCodeAt gives each half of a pair
["😀".charCodeAt(0), "😀".charCodeAt(1), "é".charCodeAt(0), "日本".charCodeAt(1), "a😀b".charCodeAt(3), "￿".charCodeAt(0)]
--- value
[55357,56832,233,26412,98,65535]

=== charCodeAt faults on an index that is a string
"abc".charCodeAt("0")
--- fault numbers

=== codePointAt
["abc".codePointAt(0), "abc".codePointAt(), "abc".codePointAt(1.9), "é".codePointAt(0), "日本".codePointAt(1), "abc".codePointAt(null)]
--- value
[97,97,98,233,26412,97]

=== codePointAt out of range is undefined
["abc".codePointAt(3) === undefined, "abc".codePointAt(-1) === undefined, "".codePointAt(0) === undefined, "abc".codePointAt(Infinity) === undefined, "abc".codePointAt(NaN)]
--- value
[true,true,true,true,97]

=== codePointAt joins a pair from its first half only
["😀".codePointAt(0), "😀".codePointAt(1), "a😀".codePointAt(1), "a😀".codePointAt(2), "😀😀".codePointAt(2), "😀😀".codePointAt(3), "\u{10FFFF}".codePointAt(0), "\u{10000}".codePointAt(1)]
--- value
[128512,56832,128512,56832,128512,56832,1114111,56320]

=== codePointAt faults on an index that is a function
"abc".codePointAt(x => 0)
--- fault numbers

=== the string methods read from an array of characters
["a😀é", "日本"].map(s => [s.at(-1), s.charAt(0), s.charCodeAt(0), s.codePointAt(1)])
--- value
[["é","a",97,128512],["本","日",26085,26412]]

# trimStart and trimEnd remove what trim removes, from one end. concat
# converts each argument as String does: primitives join, objects fault.

=== trimStart and trimEnd
["  a b  ".trimStart(), "  a b  ".trimEnd(), "\t\n\v\f\r a".trimStart(), "a \t\n\v\f\r".trimEnd(), "".trimStart(), "".trimEnd(), "   ".trimStart(), "   ".trimEnd(), "x".trimStart(), "x".trimEnd()]
--- value
["a b  ","  a b","a","a","","","","","x","x"]

=== trimStart and trimEnd remove the same white space as trim
["        　﻿é".trimStart(), "é        　﻿".trimEnd(), "​x​".trimStart(), "​x​".trimEnd(), " 😀 ".trimStart(), " 😀 ".trimEnd(), " 日本 ".trim()]
--- value
["é","é","​x​","​x​","😀 "," 😀","日本"]

=== trimStart and trimEnd ignore their arguments
["  a  ".trimStart(1), "  a  ".trimEnd({})]
--- value
["a  ","  a"]

# trimLeft and trimRight are trimStart and trimEnd: the same function
# objects in JavaScript, the same IDs in NAMES. All four remove exactly
# JavaScript's white space and line terminators; U+180E (white space until
# Unicode 6.3), the zero-width characters, NEL and the C0 separators stay.

=== trimLeft and trimRight
["  a b  ".trimLeft(), "  a b  ".trimRight(), "\t\n\v\f\r a".trimLeft(), "a \t\n\v\f\r".trimRight(), "".trimLeft(), "".trimRight(), "   ".trimLeft(), "   ".trimRight(), "x".trimLeft(), "x".trimRight(), " 😀 ".trimLeft(), " 😀 ".trimRight(), " 日本 ".trimLeft()]
--- value
["a b  ","  a b","a","a","","","","","x","x","😀 "," 😀","日本 "]

=== trimLeft and trimRight ignore their arguments
["  a  ".trimLeft(1), "  a  ".trimRight({})]
--- value
["a  ","  a"]

=== trimLeft and trimRight give what trimStart and trimEnd give
[" \u00a0x\u202f ".trimLeft() === " \u00a0x\u202f ".trimStart(), " \u00a0x\u202f ".trimRight() === " \u00a0x\u202f ".trimEnd(), "\u1680x".trimLeft(), "x\u205f".trimRight()]
--- value
[true,true,"x","x"]

=== every white space character, off each end, by all four trims and trim
["\t", "\n", "\v", "\f", "\r", " ", "\u00a0", "\u1680", "\u2000", "\u2001", "\u2002", "\u2003", "\u2004", "\u2005", "\u2006", "\u2007", "\u2008", "\u2009", "\u200a", "\u2028", "\u2029", "\u202f", "\u205f", "\u3000", "\ufeff"].map(w => { const s = w + w + "a" + w; return [s.trimStart().length, s.trimEnd().length, s.trimLeft().length, s.trimRight().length, s.trim().length]; })
--- value
[[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1],[2,3,2,3,1]]

=== characters that are not white space stay, at both ends
["\u180e", "\u200b", "\u200c", "\u200d", "\u2060", "\u0085", "\u001c", "\u001f", "\u0000", "x", "é"].map(w => { const s = w + "a" + w; return [s.trimStart() === s, s.trimEnd() === s, s.trimLeft() === s, s.trimRight() === s, s.trim() === s]; })
--- value
[[true,true,true,true,true],[true,true,true,true,true],[true,true,true,true,true],[true,true,true,true,true],[true,true,true,true,true],[true,true,true,true,true],[true,true,true,true,true],[true,true,true,true,true],[true,true,true,true,true],[true,true,true,true,true],[true,true,true,true,true]]

=== U+180E stops trimLeft and trimRight
["\u180e a \u180e".trimLeft(), "\u180e a \u180e".trimRight(), "\ufeff\u3000a\u2029\u00a0".trimLeft(), "\ufeff\u3000a\u2029\u00a0".trimRight()].map(s => s.length)
