["\u0009\u000a\u000b\u000c\u000d\u0020\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000\ufeffx\u0009\u000a\u000b\u000c\u000d\u0020\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000\ufeff".trimLeft().length, "\u0009\u000a\u000b\u000c\u000d\u0020\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000\ufeffx\u0009\u000a\u000b\u000c\u000d\u0020\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000\ufeff".trimRight().length, "\u0009\u000a\u000b\u000c\u000d\u0020\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000\ufeff".trimLeft(), "\u0009\u000a\u000b\u000c\u000d\u0020\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000\ufeff".trimRight()]
--- value
[26,26,"",""]

# split(separator, limit): each limit ToUint32 gives, each kind of separator (values generated by node).

=== split with a one-character separator and each limit
[0, 1, 2, 3, 4, -1, 4294967296, 4294967299, NaN, Infinity, 1.9].map(n => "a,b,c".split(",", n))
--- value
[[],["a"],["a","b"],["a","b","c"],["a","b","c"],["a","b","c"],[],["a","b","c"],[],[],["a"]]

=== split with a longer separator and each limit
[0, 1, 2, 3, 4, -1, 4294967296, 4294967299, NaN, Infinity, 1.9].map(n => "a--b--c".split("--", n))
--- value
[[],["a"],["a","b"],["a","b","c"],["a","b","c"],["a","b","c"],[],["a","b","c"],[],[],["a"]]

=== split with a separator at both ends and each limit
[0, 1, 2, 3, 4, -1, 4294967296, 4294967299, NaN, Infinity, 1.9].map(n => ",a,,b,".split(",", n))
--- value
[[],[""],["","a"],["","a",""],["","a","","b"],["","a","","b",""],[],["","a",""],[],[],[""]]

=== split with the empty separator and each limit
[0, 1, 2, 3, 4, -1, 4294967296, 4294967299, NaN, Infinity, 1.9].map(n => "abc".split("", n))
--- value
[[],["a"],["a","b"],["a","b","c"],["a","b","c"],["a","b","c"],[],["a","b","c"],[],[],["a"]]

=== split with no separator and each limit
[0, 1, 2, 3, 4, -1, 4294967296, 4294967299, NaN, Infinity, 1.9].map(n => "abc".split(undefined, n))
--- value
[[],["abc"],["abc"],["abc"],["abc"],["abc"],[],["abc"],[],[],["abc"]]

=== split of the empty string and each limit
[0, 1, 2, 3, 4, -1, 4294967296, 4294967299, NaN, Infinity, 1.9].map(n => ["".split(",", n), "".split("", n), "".split(undefined, n)])
--- value
[[[],[],[]],[[""],[],[""]],[[""],[],[""]],[[""],[],[""]],[[""],[],[""]],[[""],[],[""]],[[],[],[]],[[""],[],[""]],[[],[],[]],[[],[],[]],[[""],[],[""]]]

=== split with a separator longer than the string and each limit
[0, 1, 2, 3, 4, -1, 4294967296, 4294967299, NaN, Infinity, 1.9].map(n => "ab".split("abc", n))
--- value
[[],["ab"],["ab"],["ab"],["ab"],["ab"],[],["ab"],[],[],["ab"]]

=== split of non-ASCII text and each limit
[0, 1, 2, 3, 4, -1, 4294967296, 4294967299, NaN, Infinity, 1.9].map(n => "é—ü—ß".split("—", n))
--- value
[[],["é"],["é","ü"],["é","ü","ß"],["é","ü","ß"],["é","ü","ß"],[],["é","ü","ß"],[],[],["é"]]

=== split of astral text by a string and each limit
[0, 1, 2, 3, 4, -1, 4294967296, 4294967299, NaN, Infinity, 1.9].map(n => "😀x😀x".split("x", n))
--- value
[[],["😀"],["😀","😀"],["😀","😀",""],["😀","😀",""],["😀","😀",""],[],["😀","😀",""],[],[],["😀"]]

=== split with an astral separator and each limit
[0, 1, 2, 3, 4, -1, 4294967296, 4294967299, NaN, Infinity, 1.9].map(n => "a😀b😀c".split("😀", n))
--- value
[[],["a"],["a","b"],["a","b","c"],["a","b","c"],["a","b","c"],[],["a","b","c"],[],[],["a"]]

=== split takes undefined, null, true, false and -0 as limits
["a,b,c".split(",", undefined), "a,b,c".split(",", null), "a,b,c".split(",", true), "a,b,c".split(",", false), "a,b,c".split(",", -0)]
--- value
[["a","b","c"],[],["a"],[],[]]

=== split takes a limit as ToUint32 gives it
[-4294967295, -4294967294, 4294967297.5, 1e100, -Infinity, 2.999, -0.5].map(n => "a,b,c".split(",", n))
--- value
[["a"],["a","b"],["a"],[],[],["a","b"],[]]

=== split with the empty separator stops before a pair it would cut
["a😀".split("", 1), "ab😀".split("", 2), "😀".split("", 0), "é😀".split("", 1)]
--- value
[["a"],["a","b"],[],["é"]]

=== split with the empty separator and a limit that reaches a pair faults
"a😀".split("", 2)
--- fault outside the BMP

=== split with the empty separator and no limit faults on a pair
"😀".split("")
--- fault outside the BMP

=== split with a limit that is a string faults, where JavaScript converts it
"a,b".split(",", "1")
--- fault limit

=== split with a limit that is an object faults, where JavaScript converts it
"a,b".split(",", [1])
--- fault limit

=== split with a limit that is a BigInt faults
"a,b".split(",", 1n)
--- fault limit
