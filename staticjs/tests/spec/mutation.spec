=== ??= past an array's length faults
(() => { const xs = [1]; xs[3] ??= 2; return xs; })()
--- fault no holes

=== ??= of a nested default
(() => { const o = {}; o.a ??= {}; o.a.b ??= []; o.a.b[0] ??= "x"; return o; })()
