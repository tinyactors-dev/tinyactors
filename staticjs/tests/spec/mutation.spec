# Faults when it runs: sharing the compiler cannot see.
=== a parameter whose argument the caller still holds
(() => { const xs = [1]; const f = ys => { ys.push(2); return ys; }; const r = f(xs); return [xs, r]; })()
--- fault held elsewhere

=== an element of the array a callback walks
[[1], [2]].map(xs => { xs.push(0); return xs; })
--- fault held elsewhere

=== an initial value of reduce a variable still holds
(() => { const init = []; const r = [1].reduce((a, x) => { a.push(x); return a; }, init); return [init, r]; })()
--- fault held elsewhere

=== a global, through a parameter
@global g = [1, 2]
(a => { a.push(3); return a; })(g)
--- fault held elsewhere

=== a module's export, through a parameter
@module importer
import { xs } from "mutated";
export default (a => { a.push(3); return a; })(xs);
--- fault held elsewhere

=== an array Array.from shares
(rows => { const xs = Array.from(rows); xs.push(1); return [rows, xs]; })([0])
--- fault held elsewhere

=== an array Array.from takes over at the last read
(rows => { const xs = Array.from(rows); xs.push(1); return xs; })([0])
