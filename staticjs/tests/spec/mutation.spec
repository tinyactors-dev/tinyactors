[0,1]

=== a cycle through push
(() => { const xs = []; xs.push(xs); return xs.length; })()
--- fault held elsewhere

=== a cycle through fill
(() => { const xs = [1]; xs.fill(xs); return xs.length; })()
--- fault held elsewhere

=== a cycle through unshift
(() => { const xs = []; xs.unshift([xs]); return xs.length; })()
--- fault held elsewhere


