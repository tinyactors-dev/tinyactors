=== a path call in a block
(() => { const o = {xs: []}; { o.xs.push(1); } return o; })()
--- value
{"xs":[1]}

=== a path call on a parameter
(o => { o.list.push(2); return o; })({list: [1]})
--- value
{"list":[1,2]}

=== a path call on a let given a new value
(() => { let o = {xs: [0]}; o.xs.push(1); o = {xs: [5]}; o.xs.push(6); return o; })()
