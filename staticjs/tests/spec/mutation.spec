=== next of a set's values, keys and entries
(() => { const s = new Set([1, -0, NaN]); const v = s.values(); const k = s.keys(); const e = s.entries(); const a = v.next(); const b = k.next(); const c = e.next(); const d = e.next(); return [a, b, c, d, [...v], [...k], [...e]]; })()
