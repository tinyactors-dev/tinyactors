#!/usr/bin/env ruby
#MISE description="Test tinyactors-cpython: lint (rules, the binding's C, the adapter, the mapping table, the build scripts, acronyms), the build, the interpreters, and the conformance set named by MILESTONE against the adapter on both datamodels"
#MISE sources=["src/**/*", "conform/**/*", "tests/**/*", "tools/**/*", "docs/api-map.md", "sgconfig.yml", "pyproject.toml", "mise/**/*", "mise.toml", "../tinyactors-core/include/**/*", "../tinyactors-core/src/**/*", "../tinyactors-core/third_party/**/*", "../tinyactors-core/mise/**/*", "../tinyactors-core/tools/lint/utils/**/*", "../tinyactors-core/docs/requests.md", "../tinyactors-test/suites/**/*", "../tinyactors-test/lib/**/*", "../tinyactors-test/lint/**/*", "../tinyactors-test/mise/**/*", "../tinyactors-test/mise.toml", "../mise/lib/**/*", "../mise/ast-grep/**/*", "../sgconfig.yml", "../acronyms.txt", "../acronyms-allow.txt", "../mise.toml", "../LICENSE"]
#MISE outputs={auto=true}
# vim:ft=ruby

# The sources are this project's files and those it builds and tests
# against: core's (its amalgamation, the lint utilities, requests.md for
# the mapping table) and the suite's, so a change to either reruns this
# task from the root's `mise run test` (AGENTS.md, "Tests: what to run").
#
# It lints, builds the extension for both interpreters and runs tests/ on
# each with its build on PYTHONPATH (unittest, the standard library's).
# The conformance suite needs the adapter (conform/): with it, the part of
# the set named by CPython::MILESTONE that CPython::GATE holds now must
# pass (`mise run conform -- --milestone <it> --suite <each>`, on the
# gate's datamodels). `mise run conform` on its own runs the whole suite
# on both datamodels.

require_relative '../cpython'

CPython.run('mise', 'run', 'lint')
CPython.run('mise', 'run', 'build')

CPython.builds.each do |build|
  version = IO.popen([build.python, '-c', 'import sys, sysconfig; print(sys.version.split()[0], ' \
                                          '"free-threaded" if sysconfig.get_config_var("Py_GIL_DISABLED") else "with the GIL")'],
                     &:read).strip
  puts "test: python #{version}, the #{build.name} build: tests/"
  CPython.run(build.python, '-m', 'unittest', 'discover', '--start-directory', 'tests',
              env: { 'PYTHONPATH' => build.directory.to_s })
end

gate = CPython::GATE
if !CPython::ADAPTER.exist?
  puts 'test: conform skipped: no adapter yet (conform/)'
elsif gate[:suites].empty? || gate[:datamodels].empty?
  puts 'test: conform skipped: the gate holds no suite yet (GATE, mise/cpython.rb)'
else
  CPython.run('mise', 'run', 'conform', '--', '--milestone', CPython::MILESTONE,
              *gate[:suites].flat_map { |suite| ['--suite', suite] },
              env: { 'TA_PYTHON_DATAMODELS' => gate[:datamodels].join(',') })
end
