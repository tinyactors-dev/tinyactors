#!/usr/bin/env ruby
#MISE description="Build core's amalgamation into build/core (tinyactors-core's amalgamate task with --out), then the extension against it: abi3 for python 3.13 in build/abi3, and the free-threaded tests' build in build/free-threaded"
# vim:ft=ruby

# Core is built from its amalgamation in this project's own build/, never
# by running tinyactors-core's build (AGENTS.md, "Tasks"): the amalgamate
# task writes the headers and sources there and checks that each compiles
# on its own (tinyactors-core/mise/tasks/amalgamate).
# The extension links tinyactors.c, tinyactors_runtime.c with its hosted
# platform file, and tinyactors_datamodel_ecmascript.c (quickjs beside the
# native datamodel, tinyactors-core/docs/bindings.md, section 8), compiled
# with the pinned clang for this machine (Toolchain::Target.host), never a
# compiler from PATH or $CC.

require_relative '../cpython'

CPython.run('mise', 'run', '//tinyactors-core:amalgamate', '--', '--out', CPython::CORE_BUILD.to_s)

target = Toolchain::Target.host
core = CPython.core_objects(target)
CPython.builds.each do |build|
  extension = CPython.build_extension(target, build, core)
  puts "build: #{extension.relative_path_from(CPython::ROOT)}"
end
