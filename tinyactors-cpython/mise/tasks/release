#!/usr/bin/env ruby
#MISE description="Release the Python package tinyactors: check, version, build one abi3 wheel per native target with zig, verify, smoke-test (here and in Linux containers); with --publish, tag, upload to PyPI and create the GitHub release; with --dev, publish HEAD as a development version"
#MISE depends=["amalgamate"]
#USAGE arg "[version]" help="The version to release, MAJOR.MINOR.PATCH (none with --dev)"
#USAGE flag "--publish" help="Commit the version, tag tinyactors-cpython/v<version>, upload to PyPI, push, and create the GitHub release"
#USAGE flag "--dev" help="HEAD as a development version (<next minor>.dev<date><N>): built and checked like a release; with --publish uploaded to PyPI only, as a prerelease, without a commit, tag or GitHub release"
#USAGE flag "--skip-containers" help="Leave out the Linux container smoke tests (no Docker)"
#USAGE flag "--skip-tests" help="Leave this project's test task out of the checks, for a commit whose tests passed already; the wheels' builds, symbol checks and smoke tests still run"
#USAGE flag "--build-only" help="Only build, verify and smoke-test (no checks, no version set, nothing committed): a look at the packaging before a release"
# vim:ft=ruby

# mise run release -- 0.1.0                    check, version, build, verify, smoke-test; publishes nothing
# mise run release -- 0.1.0 --publish          the same, then tag, upload to PyPI, push, GitHub release
# mise run release -- --dev --publish          HEAD to PyPI as a prerelease (pip install --pre tinyactors)
# mise run release -- 0.1.0 --build-only       only the wheels and their checks
#
# docs/adr/0001, decisions 21 to 24, for what is shipped and why; the
# stages are in mise/wheel.rb. The assets (the wheels and SHA256SUMS) land
# in build/release/<version>/. The PyPI token is fnox's PYPI_TOKEN; the
# GitHub release goes through gh.

require_relative '../wheel'

PREFIX = 'tinyactors-cpython/'
TITLE = ->(version) { "tinyactors-cpython #{version}" }
PYPROJECT = CPython::ROOT.join('pyproject.toml')

def fail!(message) = Release.fail!(message)

argv = [ENV['usage_version'], *ARGV].compact.reject(&:empty?)
flag = ->(name) { !argv.delete("--#{name}").nil? | (ENV["usage_#{name.tr('-', '_')}"] == 'true') }
publish = flag.call('publish')
dev = flag.call('dev')
containers = !flag.call('skip-containers')
tests = !flag.call('skip-tests')
build_only = flag.call('build-only')
argv = argv.uniq
fail!('--build-only publishes nothing; leave out --publish') if build_only && publish
fail!('usage: mise run release -- <version> [--publish | --build-only] | --dev [--publish]') unless argv.size == (dev ? 0 : 1)
version = dev ? CPython::Wheel.dev_version(PREFIX) : argv.first
if !dev && Release.parse_version(version)[3]
  fail!("#{version} is a prerelease; a PyPI release is MAJOR.MINOR.PATCH (development builds: --dev)")
end
if containers && !system('sh', '-c', 'docker info', out: File::NULL, err: File::NULL)
  fail!('docker is not running; it runs the Linux smoke tests (or pass --skip-containers)')
end
uv = CPython.pinned('uv')

# 1. Check.
tag = nil
unless build_only
  Release.check_tree!(scope: ['tinyactors-cpython', 'tinyactors-core', 'mise']) # the wheel holds core's code
  tag = Release.check_version!(PREFIX, version) unless dev
  Release.check_changelog!(prefix: PREFIX, version: version) unless dev
  fail!("PyPI has tinyactors #{version} already") if Release.pypi_published?('tinyactors', version)
  fail!('fnox has no PYPI_TOKEN (ADR 0001, decision 24)') if publish && !Release.pypi_token?
  Release.run('mise', 'run', 'test', chdir: CPython::ROOT) if tests
end

out = CPython::BUILD.join('release', version)
FileUtils.rm_rf(out)
FileUtils.mkdir_p(out)
subject = "release(tinyactors-cpython): v#{version}"
committed = false
uploaded = false
pushed = false
begin
  # 2. Version: a release commits pyproject.toml's version and tags it
  # before building, so the wheels are built from the tagged commit.
  if publish && !dev
    notes = out.join('notes.md')
    notes.write(Release.notes(prefix: PREFIX, version: version, title: TITLE.call(version)))
    PYPROJECT.write(PYPROJECT.read.sub(/^version = ".*"$/, "version = \"#{version}\""))
    Release.commit_and_tag!(paths: [PYPROJECT], subject: subject, tag: tag, notes_file: notes)
    committed = true
  end

  # 3. Build, 4. verify, 5. smoke-test.
  wheels = CPython::Wheel.build_all(CPython::Wheel.target_names, version: version, out: out)
  CPython::Wheel.smoke_here!(wheels.fetch(Toolchain::Host.current.target.name))
  if containers
    CPython::Wheel.smoke_in_containers!(wheels)
  else
    puts 'release: --skip-containers: no Linux container smoke test ran'
  end
  sums = Release.write_sha256sums(wheels.values, out.join('SHA256SUMS'))
  assets = [*wheels.values, sums]

  unless publish
    puts <<~DRY
      release: dry run for tinyactors #{version} passed; nothing was committed, tagged or uploaded.
        assets: #{assets.map { |file| file.basename.to_s }.join(', ')}
        in:     #{out.relative_path_from(Release::REPO)}
      Publish with: mise run //tinyactors-cpython:release -- #{dev ? '--dev' : version} --publish
    DRY
    exit
  end

  # 6. Publish: PyPI first, since it never takes a file name back, then
  # the push and the GitHub release.
  fail!('the upload to PyPI failed; run the release again: files PyPI has are skipped') unless Release.pypi_publish!(uv, wheels.values)
  uploaded = true
  if dev
    puts "release: published tinyactors #{version} to PyPI (a prerelease: pip install --pre tinyactors)"
    exit
  end
  Release.push_and_release!(tag: tag, title: TITLE.call(version), notes_file: out.join('notes.md'), assets: assets)
  pushed = true
  puts "release: published tinyactors #{version} to PyPI and GitHub, tagged #{tag}"
rescue Toolchain::Error => e
  fail!(e.message)
ensure
  if committed && !uploaded
    Release.undo_commit_and_tag!(subject: subject, tag: tag)
    warn "release: undid the local commit and tag #{tag}; nothing was uploaded or pushed"
  elsif committed && !pushed
    warn "release: PyPI has #{version}, but the push or the GitHub release failed: " \
         "push main and #{tag}, then `gh release create #{tag}` with the files in #{out}"
  end
end
