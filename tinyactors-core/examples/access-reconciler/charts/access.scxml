<?xml version="1.0" encoding="UTF-8"?>
<!--
  access: one controller per person, reconciling what they SHOULD have (the HR
  record + policy) with what every SaaS app ACTUALLY grants them.

  Kubernetes-style: level-triggered (every trigger re-runs the same pass on the
  full picture), idempotent actions keyed by (person, app, level, generation,
  revision) — a retry after a lost response reuses its key, a repair after
  someone changed the app gets a new one —
  requeue with backoff, status conditions + observedGeneration, a finalizer
  (deprovision everything before the record may be deleted), drift correction
  from watch events and a periodic resync that catches the ones that were lost.

  Host I/O processors (implemented by the host, outside the system):
    saas       target = app ("github", ...) or "*"; event apply {level, key} -> apply.ok /
               apply.failed {reason, retryAfter}; event list -> inventory {apps}
    approvals  event request {app, level} -> approval.granted / approval.denied
    hr         event status {...conditions}, alert {...}, finalized
  Inbound: spec {spec}, changed {app, level} (watch events), plus the replies above.
  Times are seconds (the host drives a simulated clock).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript"
       name="access" initial="alive">
  <datamodel>
    <!-- spec: the HR record; spawn data and `spec` events replace it -->
    <data id="spec" expr="({ id: '', status: 'active', dept: 'eng', role: 'member', legalHold: false, endAt: 0, now: 0 })"/>
    <data id="generation" expr="1"/>
    <data id="observedGeneration" expr="0"/>
    <data id="wanted" expr="({})"/>     <!-- app -> level the policy asks for -->
    <data id="desired" expr="({})"/>    <!-- wanted, minus privileges not approved (least privilege) -->
    <data id="observed" expr="({})"/>   <!-- app -> level the apps report -->
    <data id="inflight" expr="({})"/>   <!-- app -> { level, key, seen } -->
    <data id="failures" expr="({})"/>   <!-- app -> { n, reason } while backing off -->
    <data id="cooling" expr="({})"/>    <!-- app -> true until its retry is due -->
    <data id="rev" expr="({})"/>        <!-- app -> bumped when the app changed behind our back -->
    <data id="approved" expr="({})"/>   <!-- app -> privileged level a manager approved -->
    <data id="asked" expr="({})"/>      <!-- app -> send id of the approval expiry timer -->
    <data id="denied" expr="({})"/>
    <data id="ops" expr="[]"/>          <!-- scratch: this pass's actions -->
    <data id="toAsk" expr="[]"/>
    <data id="inSync" expr="false"/>
    <data id="watchdog" expr="false"/>
    <data id="reported" expr="''"/>     <!-- last status sent (JSON) -->
    <data id="next" expr="null"/>
    <data id="delay" expr="0"/>
    <data id="scheduledEnd" expr="0"/>
  </datamodel>

  <parallel id="alive">

    <!-- ================= the reconcile loop ================= -->
    <state id="reconciler" initial="pass">
      <!-- one pass: desired vs observed -> actions; then wait for a trigger -->
      <state id="pass">
        <onentry>
          <script>
            // policy: what this person should have
            wanted = {};
            if (!In('offboarding')) {
              wanted.google = 'active';
              wanted.slack = 'member';
              if (spec.dept === 'eng') {
                wanted.github = spec.role === 'lead' ? 'admin' : 'member';
                wanted.aws = spec.role === 'lead' ? 'admin' : 'readonly';
              }
              if (spec.dept === 'sales') wanted.salesforce = 'licensed';
              if (spec.dept === 'support') wanted.zendesk = 'agent';
            } else if (spec.legalHold) {
              wanted.google = 'suspended'; // keep the mailbox, block the login
            }
            // privileged levels need a manager's approval; until then, least privilege
            desired = Object.fromEntries(Object.entries(wanted).map(([app, level]) =>
              [app, level === 'admin' &amp;&amp; approved[app] !== 'admin'
                ? ({ github: 'member', aws: 'readonly' })[app] : level]));
            toAsk = Object.keys(wanted).filter((app) => wanted[app] === 'admin' &amp;&amp;
              approved[app] !== 'admin' &amp;&amp; !asked[app] &amp;&amp; !denied[app]);
            // the diff: every app where the two disagree and nothing is pending
            ops = Object.keys(Object.assign({}, desired, observed))
              .filter((app) => (desired[app] || 'none') !== (observed[app] || 'none'))
              .filter((app) => !inflight[app] &amp;&amp; !cooling[app])
              .map((app) => ({ app: app, level: desired[app] || 'none',
                               key: [spec.id, app, desired[app] || 'none', generation, rev[app] || 0].join(':') }));
            inSync = Object.keys(Object.assign({}, desired, observed))
              .every((app) => (desired[app] || 'none') === (observed[app] || 'none'));
            if (inSync) observedGeneration = generation;
          </script>
          <!-- idempotent actions: a retry with the same key is a no-op at the app -->
          <foreach array="ops" item="op">
            <assign location="inflight[op.app]" expr="({ level: op.level, key: op.key, seen: false })"/>
            <send type="saas" targetexpr="op.app" event="apply">
              <param name="level" expr="op.level"/>
              <param name="key" expr="op.key"/>
            </send>
          </foreach>
          <if cond="Object.keys(inflight).length &amp;&amp; !watchdog">
            <assign location="watchdog" expr="true"/>
            <send event="inflight.check" delay="300s"/>
          </if>
          <foreach array="toAsk" item="app">
            <send type="approvals" event="request">
              <param name="app" expr="app"/>
              <param name="level" expr="wanted[app]"/>
            </send>
            <!-- no answer in 72 h counts as a denial -->
            <send event="approval.expired" delay="259200s" idlocation="asked[app]">
              <param name="app" expr="app"/>
            </send>
          </foreach>
          <!-- status: conditions, reported when they change -->
          <assign location="next" expr="JSON.stringify({
              phase: In('employed') ? 'Active' : In('leaving') ? 'Leaving' : 'Offboarding',
              ready: inSync &amp;&amp; !Object.keys(inflight).length &amp;&amp; !Object.keys(asked).length,
              progressing: Object.keys(inflight).length &gt; 0,
              awaitingApproval: Object.keys(asked).length &gt; 0,
              degraded: Object.keys(failures).length &gt; 0,
              blocked: Object.values(failures).some((f) => f.reason === 'no_license'),
              generation: generation, observedGeneration: observedGeneration })"/>
          <if cond="next !== reported">
            <assign location="reported" expr="next"/>
            <send type="hr" event="status"><param name="status" expr="JSON.parse(next)"/></send>
          </if>
        </onentry>
        <transition target="waiting"/>
      </state>

      <state id="waiting">
        <!-- every trigger re-runs the whole pass (level-triggered) -->
        <transition event="reconcile" target="pass"/>
        <transition event="spec" target="pass">
          <if cond="_event.data.spec.role !== spec.role || _event.data.spec.dept !== spec.dept">
            <assign location="approved" expr="({})"/>
            <assign location="denied" expr="({})"/>
          </if>
          <assign location="spec" expr="_event.data.spec"/>
          <assign location="generation" expr="generation + 1"/>
        </transition>

        <transition event="apply.ok" target="pass">
          <if cond="_event.data.level === 'none'">
            <script>delete observed[_event.data.app];</script>
          <else/>
            <assign location="observed[_event.data.app]" expr="_event.data.level"/>
          </if>
          <if cond="inflight[_event.data.app] &amp;&amp; inflight[_event.data.app].level !== _event.data.level">
            <!-- "ok", but not what we asked for: treat as a failure (new key, backoff) -->
            <script>
              rev[_event.data.app] = (rev[_event.data.app] || 0) + 1;
              failures[_event.data.app] = { n: ((failures[_event.data.app] || {}).n || 0) + 1, reason: 'mismatch' };
              cooling[_event.data.app] = true;
            </script>
            <send event="retry" delayexpr="Math.min(3600, 30 * Math.pow(2, failures[_event.data.app].n - 1)) + 's'">
              <param name="app" expr="_event.data.app"/>
            </send>
          <else/>
            <script>delete failures[_event.data.app];</script>
          </if>
          <script>delete inflight[_event.data.app];</script>
        </transition>

        <!-- requeue with exponential backoff (or the app's Retry-After), with jitter:
             without it every controller limited in the same minute retries in the
             same second (a thundering herd). The jitter is a hash, not Math.random,
             so simulations replay exactly. -->
        <transition event="apply.failed" target="pass">
          <script>
            delete inflight[_event.data.app];
            failures[_event.data.app] = { n: ((failures[_event.data.app] || {}).n || 0) + 1,
                                          reason: _event.data.reason };
            cooling[_event.data.app] = true;
            delay = (spec.id + _event.data.app + failures[_event.data.app].n).split('')
              .reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 100003, 7) / 100003; // 0..1
            delay = _event.data.retryAfter ? _event.data.retryAfter + Math.floor(delay * 120)
              : Math.round(Math.min(3600, 30 * Math.pow(2, failures[_event.data.app].n - 1)) * (0.5 + delay));
          </script>
          <send event="retry" delayexpr="delay + 's'">
            <param name="app" expr="_event.data.app"/>
          </send>
        </transition>
        <transition event="retry" target="pass">
          <script>delete cooling[_event.data.app];</script>
        </transition>

        <!-- lost responses: drop actions pending for a whole watchdog period;
             the next pass retries them with the same key -->
        <transition event="inflight.check" target="pass">
          <script>
            Object.keys(inflight).forEach((app) => {
              if (inflight[app].seen) delete inflight[app]; else inflight[app].seen = true;
            });
            watchdog = false;
          </script>
        </transition>

        <!-- watch events (someone changed the app directly) and resync snapshots.
             Event names are prefix-free on purpose: SCXML matches descriptors by
             token prefix, so a transition on "observed" would also take "observed.list" -->
        <transition event="changed" target="pass">
          <script>rev[_event.data.app] = (rev[_event.data.app] || 0) + 1;</script>
          <if cond="_event.data.level === 'none'">
            <script>delete observed[_event.data.app];</script>
          <else/>
            <assign location="observed[_event.data.app]" expr="_event.data.level"/>
          </if>
        </transition>
        <transition event="inventory" target="pass">
          <script>
            Object.keys(Object.assign({}, observed, _event.data.apps))
              .filter((app) => observed[app] !== _event.data.apps[app])
              .forEach((app) => { rev[app] = (rev[app] || 0) + 1; });
          </script>
          <assign location="observed" expr="_event.data.apps"/>
        </transition>

        <transition event="approval.granted" target="pass">
          <cancel sendidexpr="asked[_event.data.app]"/>
          <assign location="approved[_event.data.app]" expr="_event.data.level"/>
          <script>delete asked[_event.data.app];</script>
        </transition>
        <transition event="approval.denied approval.expired" target="pass">
          <cancel sendidexpr="asked[_event.data.app]"/>
          <assign location="denied[_event.data.app]" expr="true"/>
          <script>delete asked[_event.data.app];</script>
        </transition>
      </state>
    </state>

    <!-- ================= periodic resync =================
         (the self-transition lives on an inner state: on a direct child of the
         parallel its domain would be the whole document, resetting every region) -->
    <state id="resync" initial="resync.armed">
      <state id="resync.armed">
        <onentry><send event="resync" delay="86400s"/></onentry>
        <transition event="resync" target="resync.armed">
          <send type="saas" target="*" event="list"/>
        </transition>
      </state>
    </state>

    <!-- ================= lifecycle + finalizer =================
         driven by the spec (eventless transitions see every change), and
         each phase change asks for a new pass: the policy depends on it -->
    <state id="lifecycle" initial="employed">
      <state id="employed">
        <onentry><raise event="reconcile"/></onentry>
        <transition cond="spec.status === 'leaving'" target="leaving"/>
        <transition cond="spec.status === 'left'" target="offboarding"/>
      </state>

      <state id="leaving">
        <onentry>
          <assign location="scheduledEnd" expr="spec.endAt"/>
          <send event="offboard.due" id="offboard"
                delayexpr="Math.max(0, spec.endAt - spec.now) + 's'"/>
        </onentry>
        <onexit><cancel sendid="offboard"/></onexit>
        <transition cond="spec.status === 'active'" target="employed"/>
        <transition cond="spec.status === 'left'" target="offboarding"/>
        <transition cond="spec.endAt !== scheduledEnd" target="leaving"/> <!-- new end date -->
        <transition event="offboard.due" target="offboarding"/>
      </state>

      <!-- the finalizer: everything revoked (bar a legal hold) before the record goes -->
      <state id="offboarding">
        <onentry>
          <assign location="inSync" expr="false"/> <!-- until a pass in this phase says so -->
          <raise event="reconcile"/>
          <send event="offboard.overdue" id="overdue" delay="3600s"/>
        </onentry>
        <onexit><cancel sendid="overdue"/></onexit>
        <transition event="offboard.overdue">
          <send type="hr" event="alert">
            <param name="reason" expr="'deprovisioning overdue'"/>
            <param name="apps" expr="Object.keys(observed).filter((a) =&gt; observed[a] !== desired[a])"/>
          </send>
        </transition>
        <transition cond="spec.status === 'active'" target="employed"/> <!-- rescinded / rehired -->
        <transition cond="inSync &amp;&amp; !Object.keys(inflight).length &amp;&amp; In('waiting')"
                    target="finalized"/>
      </state>

      <state id="finalized">
        <onentry><send type="hr" event="finalized"/></onentry>
        <transition target="deleted"/>
      </state>
    </state>
  </parallel>

  <final id="deleted"/>
</scxml>
