<?xml version="1.0"?>
<!--
  The records of finished games — an actor that lives in PostgreSQL (the
  tinyactors extension), not on the chess server. Durable: every game it is
  told about, and every player's standing, survive restarts of the server
  and of the database; they are rows you can query:

    SELECT datamodel->'standings' FROM tinyactors.actors WHERE name = 'records';

  game.over {code, names: {w, b}, status, moves, players: {w, b}} comes from
  a game actor on the server (through the server's store link). Each player
  then gets RECORD {name, wins, losses, draws, games} — sent from the
  database straight to the player actor in the browser: PostgreSQL -> server
  (store link) -> browser (WebSocket link). The players' references arrive
  as their addresses.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="records" initial="keeping">
  <datamodel>
    <data id="games" expr="[]"/>
    <data id="standings" expr="({})"/>
  </datamodel>
  <state id="keeping">
    <transition event="game.over" cond="_event.data.names &amp;&amp; _event.data.names.w &amp;&amp; _event.data.names.b">
      <script>{
        /* a block: this script runs for every game, and its names are per game */
        const g = _event.data, winner = g.status &amp;&amp; g.status.winner;
        games.push({ code: g.code, names: g.names, status: g.status, moves: g.moves });
        for (const color of ['w', 'b']) {
          const s = standings[g.names[color]] || (standings[g.names[color]] = { wins: 0, losses: 0, draws: 0, games: 0 });
          s.games++;
          if (!winner) s.draws++;
          else if (winner === color) s.wins++;
          else s.losses++;
        }
      }</script>
      <foreach array="['w', 'b']" item="color">
        <if cond="_event.data.players &amp;&amp; _event.data.players[color]">
          <send event="RECORD" targetexpr="_event.data.players[color]">
            <param name="name" expr="_event.data.names[color]"/>
            <param name="wins" expr="standings[_event.data.names[color]].wins"/>
            <param name="losses" expr="standings[_event.data.names[color]].losses"/>
            <param name="draws" expr="standings[_event.data.names[color]].draws"/>
            <param name="games" expr="standings[_event.data.names[color]].games"/>
          </send>
        </if>
      </foreach>
    </transition>
    <!-- a player who went away meanwhile: nothing to do, the standing is kept -->
    <transition event="error.communication"/>
  </state>
</scxml>
