{
  "name": "hibernate",
  "description": "hibernate an idle actor (variables, a pending delayed send); an event wakes it; its timer firing while it sleeps wakes it too — the host stores the blobs, the library asks for them",
  "documents": {
    "sleeper.scxml": [
      "<scxml xmlns='http://www.w3.org/2005/07/scxml' version='1.0' datamodel='ecmascript' name='sleeper' initial='idle'>",
      "  <datamodel><data id='hits' expr='0'/><data id='seen' expr='({ list: [] })'/></datamodel>",
      "  <state id='idle'>",
      "    <onentry><send event='alarm' delay='200ms'/></onentry>",
      "    <transition event='touch'><assign location='hits' expr='hits + 1'/><script>seen.list.push(_event.data.who)</script><log expr=\"'touched ' + hits + ' ' + JSON.stringify(seen)\"/></transition>",
      "    <transition event='alarm'><log expr=\"'alarm after ' + hits + ' touches'\"/></transition>",
      "  </state>",
      "</scxml>"
    ]
  },
  "steps": [
    { "spawn": "sleeper.scxml", "as": "s" },
    { "send": "s", "event": "touch", "data": { "who": "a" } },
    { "expect": { "logs": ["touched 1 {\"list\":[\"a\"]}"] } },
    { "hibernate": "s" },
    { "expect": { "hibernated": ["s"] } },
    { "send": "s", "event": "touch", "data": { "who": "b" } },
    { "expect": { "logs": ["touched 2 {\"list\":[\"a\",\"b\"]}"], "awake": ["s"], "states": { "s": ["idle"] } } },
    { "hibernate": "s" },
    { "advance": 250 },
    { "expect": { "logs": ["alarm after 2 touches"], "awake": ["s"] } }
  ]
}
