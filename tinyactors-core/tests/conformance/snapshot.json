{
  "name": "snapshot",
  "description": "snapshot the whole system, keep going, restore the snapshot (a restart: later changes are gone), then routing between actors, events and a timer armed before the snapshot work in the restored system",
  "documents": {
    "ledger.scxml": [
      "<scxml xmlns='http://www.w3.org/2005/07/scxml' version='1.0' datamodel='ecmascript' name='ledger' initial='open'>",
      "  <datamodel><data id='balance' expr='0'/><data id='history' expr='[]'/></datamodel>",
      "  <state id='open'>",
      "    <onentry><send event='close' delay='300ms'/></onentry>",
      "    <transition event='deposit'><assign location='balance' expr='balance + _event.data.amount'/><script>history.push(_event.data.amount)</script><log expr=\"'balance ' + balance\"/></transition>",
      "    <transition event='ask'><send targetexpr='_event.data.peer' event='ping'><param name='n' expr='balance'/></send></transition>",
      "    <transition event='pong'><log expr=\"'pong ' + _event.data.n\"/></transition>",
      "    <transition event='close' target='closed'><log expr=\"'closed with ' + balance + ' after ' + history.length\"/></transition>",
      "  </state>",
      "  <final id='closed'><donedata><param name='balance' expr='balance'/></donedata></final>",
      "</scxml>"
    ],
    "echo.scxml": [
      "<scxml xmlns='http://www.w3.org/2005/07/scxml' version='1.0' datamodel='ecmascript' name='echo' initial='e'>",
      "  <state id='e'><transition event='ping'><send targetexpr='_event.origin' event='pong'><param name='n' expr='_event.data.n + 1'/></send></transition></state>",
      "</scxml>"
    ]
  },
  "steps": [
    { "spawn": "ledger.scxml", "as": "l" },
    { "spawn": "echo.scxml", "as": "e" },
    { "send": "l", "event": "deposit", "data": { "amount": 5 } },
    { "advance": 100 },
    { "expect": { "logs": ["balance 5"] } },
    { "snapshot": "s1" },
    { "send": "l", "event": "deposit", "data": { "amount": 7 } },
    { "expect": { "logs": ["balance 12"] } },
    { "restore": "s1" },
    { "send": "l", "event": "ask", "data": { "peer": "@e" } },
    { "expect": { "logs": ["pong 6"], "states": { "l": ["open"], "e": ["e"] } } },
    { "send": "l", "event": "deposit", "data": { "amount": 1 } },
    { "advance": 150 },
    { "expect": { "logs": ["balance 6"] } },
    { "advance": 60 },
    { "expect": { "logs": ["closed with 6 after 2"], "done": { "l": { "balance": 6 } } } }
  ]
}
