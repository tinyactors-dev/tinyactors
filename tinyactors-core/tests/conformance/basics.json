{
  "name": "basics",
  "description": "spawn with input, send, sendMany, delayed sends on the system clock, eventless/parallel semantics, In(), foreach, error.execution, done data — the ecmascript datamodel through every host",
  "documents": {
    "counter.scxml": [
      "<scxml xmlns='http://www.w3.org/2005/07/scxml' version='1.0' datamodel='ecmascript' name='counter' initial='idle'>",
      "  <datamodel><data id='count' expr='0'/><data id='items' expr='[]'/></datamodel>",
      "  <state id='idle'>",
      "    <onentry><send event='tick' delay='100ms'/></onentry>",
      "    <transition event='inc'><assign location='count' expr='count + (_event.data &amp;&amp; _event.data.by || 1)'/><log expr=\"'count=' + count\"/></transition>",
      "    <transition event='add'><script>items.push(_event.data.item)</script><log expr=\"'items=' + items.join(',')\"/></transition>",
      "    <transition event='tick' target='ticked'/>",
      "  </state>",
      "  <state id='ticked'>",
      "    <onentry><log expr=\"'ticked at count ' + count\"/></onentry>",
      "    <transition event='stop' target='done'/>",
      "  </state>",
      "  <final id='done'><donedata><param name='total' expr='count'/></donedata></final>",
      "</scxml>"
    ],
    "checks.scxml": [
      "<scxml xmlns='http://www.w3.org/2005/07/scxml' version='1.0' datamodel='ecmascript' name='checks' initial='p'>",
      "  <datamodel><data id='sum' expr='0'/></datamodel>",
      "  <parallel id='p'>",
      "    <state id='l' initial='l1'><state id='l1'><transition event='go' target='l2'/></state><state id='l2'/></state>",
      "    <state id='r' initial='r1'><state id='r1'>",
      "      <transition event='go' cond=\"In('l1')\">",
      "        <foreach array='[1, 2, 3]' item='x' index='i'><assign location='sum' expr='sum + x * 10 + i'/></foreach>",
      "        <log expr=\"'sum=' + sum\"/>",
      "      </transition>",
      "      <transition event='bad'><assign location='undeclared' expr='1'/><log expr=\"'not reached'\"/></transition>",
      "      <transition event='error.execution'><log expr=\"'error.execution'\"/></transition>",
      "    </state></state>",
      "  </parallel>",
      "</scxml>"
    ]
  },
  "steps": [
    { "spawn": "counter.scxml", "as": "a", "input": { "count": 10 } },
    { "expect": { "logs": [], "states": { "a": ["idle"] } } },
    { "send": "a", "event": "inc", "data": { "by": 2 } },
    { "expect": { "logs": ["count=12"] } },
    { "sendMany": [ { "to": "a", "event": "inc" }, { "to": "a", "event": "add", "data": { "item": "x" } }, { "to": "a", "event": "add", "data": { "item": "y" } } ] },
    { "expect": { "logs": ["count=13", "items=x", "items=x,y"] } },
    { "advance": 50 },
    { "expect": { "logs": [], "states": { "a": ["idle"] } } },
    { "advance": 60 },
    { "expect": { "logs": ["ticked at count 13"], "states": { "a": ["ticked"] } } },
    { "send": "a", "event": "stop" },
    { "expect": { "done": { "a": { "total": 13 } } } },
    { "spawn": "checks.scxml", "as": "c" },
    { "send": "c", "event": "go" },
    { "expect": { "logs": ["sum=63"], "states": { "c": ["l2", "r1"] } } },
    { "send": "c", "event": "bad" },
    { "expect": { "logs": ["error.execution"] } }
  ]
}
