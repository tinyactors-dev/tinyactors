{
  "name": "links: an ephemeral peer resumes; past the TTL, error.communication",
  "description": "The peer drops while a reply is pending; the router queues it (resumeMs 1000, on the system's clock) and delivers it when the same system id says hello again on a new connection. The next time the peer stays away past the TTL: the replying session gets error.communication, and a later reconnect starts a fresh peer.",
  "system": "srv",
  "serve": {
    "exports": [
      "echo"
    ],
    "resumeMs": 1000
  },
  "documents": {
    "echo.scxml": [
      "<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" name=\"echo\" initial=\"s\">",
      "  <state id=\"s\">",
      "    <transition event=\"ping\">",
      "      <log expr=\"'ping ' + _event.data.n\"/>",
      "      <send event=\"pong\" targetexpr=\"_event.origin\"><param name=\"n\" expr=\"_event.data.n\"/></send>",
      "    </transition>",
      "    <transition event=\"later\">",
      "      <send event=\"pong\" targetexpr=\"_event.origin\" delay=\"100ms\"><param name=\"n\" expr=\"_event.data.n\"/></send>",
      "    </transition>",
      "    <transition event=\"error.communication\"><log expr=\"'lost ' + _event.sendid\"/></transition>",
      "  </state>",
      "</scxml>"
    ]
  },
  "spawn": [
    {
      "doc": "echo.scxml",
      "as": "echo"
    }
  ],
  "transcript": [
    {
      "in": {
        "t": "hello",
        "v": 1,
        "id": "tab",
        "reach": [],
        "caps": {
          "profile": "neutral"
        }
      }
    },
    {
      "out": {
        "t": "hello",
        "v": 1,
        "id": "srv",
        "reach": []
      }
    },
    {
      "in": {
        "t": "ev",
        "target": "tinyactors://srv/@echo",
        "name": "later",
        "data": {
          "n": 1
        },
        "origin": "tinyactors://tab/#_scxml_7",
        "msgid": "m1",
        "hops": 0
      }
    },
    {
      "close": true
    },
    {
      "advance": 200
    },
    {
      "connect": true
    },
    {
      "in": {
        "t": "hello",
        "v": 1,
        "id": "tab",
        "reach": [],
        "caps": {
          "profile": "neutral"
        }
      }
    },
    {
      "out": {
        "t": "hello",
        "v": 1,
        "id": "srv",
        "reach": []
      }
    },
    {
      "out": {
        "t": "ev",
        "target": "tinyactors://tab/#_scxml_7",
        "name": "pong",
        "data": {
          "n": 1
        }
      }
    },
    {
      "in": {
        "t": "ev",
        "target": "tinyactors://srv/@echo",
        "name": "later",
        "data": {
          "n": 2
        },
        "origin": "tinyactors://tab/#_scxml_7",
        "msgid": "m2",
        "hops": 0
      }
    },
    {
      "close": true
    },
    {
      "advance": 200
    },
    {
      "advance": 1500
    },
    {
      "expect": {
        "logs": [
          "~^lost"
        ]
      }
    },
    {
      "connect": true
    },
    {
      "in": {
        "t": "hello",
        "v": 1,
        "id": "tab",
        "reach": [],
        "caps": {
          "profile": "neutral"
        }
      }
    },
    {
      "out": {
        "t": "hello",
        "v": 1,
        "id": "srv",
        "reach": []
      }
    },
    {
      "in": {
        "t": "ev",
        "target": "tinyactors://srv/@echo",
        "name": "later",
        "data": {
          "n": 3
        },
        "origin": "tinyactors://tab/#_scxml_7",
        "msgid": "m3",
        "hops": 0
      }
    },
    {
      "advance": 200
    },
    {
      "out": {
        "t": "ev",
        "target": "tinyactors://tab/#_scxml_7",
        "name": "pong",
        "data": {
          "n": 3
        }
      }
    }
  ]
}
