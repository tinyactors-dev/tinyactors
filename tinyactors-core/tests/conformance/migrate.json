{
  "name": "migrate",
  "description": "reload a chart (CGI style: new actors run the new version), then migrate running actors — a hibernated one woken for it — to it: error.platform.upgrade carries the old <datamodel> bindings, states match by id, delayed sends survive the move",
  "documents": {
    "worker.scxml": [
      "<scxml xmlns='http://www.w3.org/2005/07/scxml' version='1.0' datamodel='ecmascript' name='worker' initial='busy'>",
      "  <datamodel><data id='done' expr='0'/><data id='label' expr=\"'v1'\"/></datamodel>",
      "  <state id='busy'>",
      "    <onentry><send event='deadline' delay='500ms'/></onentry>",
      "    <transition event='job'><assign location='done' expr='done + 1'/><log expr=\"label + ' did job ' + done\"/></transition>",
      "    <transition event='deadline' target='late'/>",
      "  </state>",
      "  <state id='late'><onentry><log expr=\"label + ' late with ' + done\"/></onentry></state>",
      "</scxml>"
    ],
    "worker-v2.scxml": [
      "<scxml xmlns='http://www.w3.org/2005/07/scxml' version='1.0' datamodel='ecmascript' name='worker' initial='busy'>",
      "  <datamodel><data id='completed' expr='0'/><data id='version' expr=\"'v2'\"/></datamodel>",
      "  <state id='busy'>",
      "    <onentry><send event='deadline' delay='500ms'/></onentry>",
      "    <transition event='error.platform.upgrade'><assign location='completed' expr='_event.data.done'/><log expr=\"'upgraded from ' + _event.data.label + ' with ' + completed\"/></transition>",
      "    <transition event='job'><assign location='completed' expr='completed + 1'/><log expr=\"version + ' did job ' + completed\"/></transition>",
      "    <transition event='deadline' target='late'/>",
      "  </state>",
      "  <state id='late'><onentry><log expr=\"version + ' late with ' + completed\"/></onentry></state>",
      "</scxml>"
    ]
  },
  "steps": [
    { "spawn": "worker.scxml", "as": "w1" },
    { "spawn": "worker.scxml", "as": "w2" },
    { "send": "w1", "event": "job" },
    { "expect": { "logs": ["v1 did job 1"] } },
    { "hibernate": "w2" },
    { "reload": "worker-v2.scxml" },
    { "spawn": "worker.scxml", "as": "w3" },
    { "send": "w3", "event": "job" },
    { "expect": { "logs": ["v2 did job 1"] } },
    { "migrate": { "wake": true } },
    { "expect": { "logsUnordered": ["upgraded from v1 with 1", "upgraded from v1 with 0"], "awake": ["w2"], "states": { "w1": ["busy"], "w2": ["busy"] } } },
    { "send": "w1", "event": "job" },
    { "expect": { "logs": ["v2 did job 2"] } },
    { "advance": 510 },
    { "expect": { "logsUnordered": ["v2 late with 2", "v2 late with 0", "v2 late with 1"] } }
  ]
}
