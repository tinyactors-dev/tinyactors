{
  "description": "Neutral values (docs/protocol.md, Values): event data on the wire between systems. `roundtrip`: from_wire then to_wire gives `wire` back (or `back`; `backEcmascript` for the ECMAScript datamodel, which has no reference type: references become their address). `encode`: a value made by the ECMAScript expression `ecmascript`, written with to_wire, is `wire`. `invalid`: expressions whose values are not neutral values (to_wire fails). Run by tests/unit/test_datamodel_ecmascript.c (C, quickjs-ng datamodel) and tests/conformance/run_js.mjs (Node and web bindings).",
  "roundtrip": [
    {
      "name": "scalars",
      "wire": [
        1,
        -2.5,
        0,
        true,
        false,
        null,
        "",
        "text",
        "ünïcødé ✓"
      ]
    },
    {
      "name": "nested",
      "wire": {
        "a": {
          "b": [
            1,
            {
              "c": []
            }
          ]
        },
        "d": {}
      }
    },
    {
      "name": "big integer by convention",
      "wire": {
        "id": "18446744073709551615"
      }
    },
    {
      "name": "bytes",
      "wire": {
        "$bytes": "AAEC/w=="
      }
    },
    {
      "name": "empty bytes",
      "wire": {
        "$bytes": ""
      }
    },
    {
      "name": "bytes in data",
      "wire": {
        "file": {
          "$bytes": "aGVsbG8="
        },
        "n": 5
      }
    },
    {
      "name": "escaped object",
      "wire": {
        "$": {
          "$type": "order",
          "n": 1
        }
      }
    },
    {
      "name": "escaped object holding special forms",
      "wire": {
        "$": {
          "$ref": {
            "$bytes": "AA=="
          }
        }
      }
    },
    {
      "name": "actor reference",
      "wire": {
        "player": {
          "$ref": "tinyactors://tab-7f3/#_scxml_4"
        }
      },
      "backEcmascript": {
        "player": "tinyactors://tab-7f3/#_scxml_4"
      }
    },
    {
      "name": "object with a $ key next to others is plain",
      "wire": {
        "$ref": "x",
        "other": 1
      },
      "back": {
        "$": {
          "$ref": "x",
          "other": 1
        }
      }
    }
  ],
  "encode": [
    {
      "name": "undefined properties are dropped",
      "ecmascript": "({a: undefined, b: 1})",
      "wire": {
        "b": 1
      }
    },
    {
      "name": "undefined in arrays is null",
      "ecmascript": "[undefined, 1]",
      "wire": [
        null,
        1
      ]
    },
    {
      "name": "non-finite numbers are null",
      "ecmascript": "[NaN, Infinity, -Infinity]",
      "wire": [
        null,
        null,
        null
      ]
    },
    {
      "name": "BigInt as a decimal string",
      "ecmascript": "12345678901234567890n",
      "wire": "12345678901234567890"
    },
    {
      "name": "Uint8Array as bytes",
      "ecmascript": "new Uint8Array([0, 1, 2, 255])",
      "wire": {
        "$bytes": "AAEC/w=="
      }
    },
    {
      "name": "keys starting with $ escape the object",
      "ecmascript": "({$x: 1, y: {$z: 2}})",
      "wire": {
        "$": {
          "$x": 1,
          "y": {
            "$": {
              "$z": 2
            }
          }
        }
      }
    },
    {
      "name": "Date as its JSON form",
      "ecmascript": "new Date(0)",
      "wire": "1970-01-01T00:00:00.000Z"
    },
    {
      "name": "functions are dropped",
      "ecmascript": "({f() {}, g: 1})",
      "wire": {
        "g": 1
      }
    },
    {
      "name": "shared (acyclic) references are copied",
      "ecmascript": "(() => { const s = {k: 1}; return [s, s]; })()",
      "wire": [
        {
          "k": 1
        },
        {
          "k": 1
        }
      ]
    },
    {
      "name": "undefined at the top is null",
      "ecmascript": "undefined",
      "wire": null
    }
  ],
  "invalid": [
    {
      "name": "cycles",
      "ecmascript": "(() => { const o = {}; o.self = o; return o; })()"
    }
  ]
}
