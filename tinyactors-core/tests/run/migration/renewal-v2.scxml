<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="renewal"
       datamodel="ecmascript" initial="charging">
  <datamodel><data id="plan" expr="'annual'"/></datamodel>
  <state id="charging">
    <invoke type="payment" src="psp:renewals" id="payment"/>
    <transition event="done.invoke.payment" target="renewed"/>
  </state>
  <final id="renewed"><donedata><param name="plan" expr="plan"/></donedata></final>
</scxml>
