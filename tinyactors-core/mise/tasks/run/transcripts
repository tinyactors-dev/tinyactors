#!/usr/bin/env ruby
#MISE description="Write the expected lines of tinyactors run's transcripts (tests/run/<case>/transcript.jsonl) from what the server answers now; review the diff"
#MISE depends=["build"]
#USAGE arg "[case]..." help="the cases to write (default: every one)"
# vim:ft=ruby

# A transcript is the client's lines ("> ") and the server's ("< ") in the
# order they come: each client line is followed by what it caused. The test
# (test_tool, test_run_transcripts) feeds the "> " lines and requires the
# "< " lines byte for byte; this task writes them, after a deliberate change
# to the server, from the dev build. A client line's own lines are found by
# running the case with the lines up to it and taking what the run before
# lacked: the server is deterministic, so a prefix answers the same. The end
# of input writes lines too (a held batch's effects, the spans trace.end
# ends), which belong after the last client line only: a prefix is run with
# a request the server refuses at once after it (END_OF_PREFIX, a run.*
# method it does not have), and only the lines before that response count.

require_relative '../../core'
require 'fileutils'
require 'open3'
require 'tmpdir'

CASES = Core::ROOT.join('tests/run')
END_OF_PREFIX = '{"jsonrpc":"2.0","id":"end-of-prefix","method":"run.endOfPrefix"}'
END_OF_PREFIX_ANSWER = '{"jsonrpc":"2.0","id":"end-of-prefix",'
PROGRAM = Core.program_path('dev', 'tinyactors')

# Run in a copy of the case, as the test does, so the files a session
# writes (a snapshot) stay out of the repository.
def answers(directory, arguments, lines)
  output, errors, status = Dir.mktmpdir('run-case') do |scratch|
    copy = File.join(scratch, 'case')
    FileUtils.cp_r(directory.to_s, copy)
    Open3.capture3({ 'TZ' => 'UTC' }, PROGRAM.to_s, 'run', *arguments,
                   stdin_data: lines.map { |line| "#{line}\n" }.join, chdir: copy)
  end
  expected = directory.join('exit').file? ? directory.join('exit').read.to_i : 0
  abort "#{directory.basename}: exit #{status.exitstatus}, not #{expected}: #{errors}" unless status.exitstatus == expected
  output.lines.map(&:chomp)
end

names = ARGV.empty? ? CASES.children.select(&:directory?).map { |path| path.basename.to_s }.sort : ARGV
names.each do |name|
  directory = CASES.join(name)
  transcript = directory.join('transcript.jsonl')
  arguments = directory.join('arguments').file? ? directory.join('arguments').read.split : []
  client = transcript.read.lines.map(&:chomp).select { |line| line.start_with?('> ') }.map { |line| line.delete_prefix('> ') }
  written = []
  seen = []
  client.each_index do |i|
    last = i == client.size - 1
    now = answers(directory, arguments, last ? client : client[0..i] + [END_OF_PREFIX])
    unless last
      ended = now.index { |line| line.start_with?(END_OF_PREFIX_ANSWER) }
      abort "#{name}: the server did not answer the end of a prefix" unless ended
      now = now.first(ended)
    end
    abort "#{name}: the answers to a prefix changed: the server is not deterministic" unless now.first(seen.size) == seen
    written << "> #{client[i]}"
    now.drop(seen.size).each { |line| written << "< #{line}" }
    seen = now
  end
  transcript.write(written.map { |line| "#{line}\n" }.join)
  puts "run:transcripts: #{name}: #{client.size} client lines, #{seen.size} server lines"
end
