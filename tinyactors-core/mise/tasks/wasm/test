#!/usr/bin/env ruby
#MISE description="Build the release's wasm modules (tinyactors, tinyactors_runtime, tinyactors_datamodel_ecmascript) as the release builds them, check that they import nothing, and run tests/wasm/release_test.mjs against each in Node, as a browser would load them"
#MISE depends=["amalgamate"]
# vim:ft=ruby

# The modules are for browsers, and built exactly as the release builds them
# (CRelease.build_wasm) into build/wasm/: tinyactors.wasm for
# wasm32-freestanding with its own page allocator; tinyactors_runtime.wasm
# and tinyactors_datamodel_ecmascript.wasm with tinyactors inside them, their
# C library wasi-libc linked in (root ADR 0001, decisions 19 and 20). Each
# one's interface is checked (no imports: a browser supplies none; the API,
# the wasm functions and memory exported) and the test instantiates it with
# no imports. The release's verify stage runs the same test on the modules
# it packs.

require_relative '../../core'

core = Core.release_project(Core.library('tinyactors'))
runtime = Core.release_project(Core.library('tinyactors_runtime'))
ecmascript = Core.release_project(Core.library('tinyactors_datamodel_ecmascript'))
out = Core::BUILD.join('wasm')
test = Core::ROOT.join('tests/wasm/release_test.mjs')
[[core, [], [core.api]], [runtime, [core], [core.api, runtime.api]],
 [ecmascript, [core], [core.api, ecmascript.api]]].each do |project, uses, apis|
  build = CRelease.build_wasm(project, out, uses: uses)
  CRelease.verify_wasm!(build, test: ->(wasm) { ['node', test, wasm, *apis] })
end
