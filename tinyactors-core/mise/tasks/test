#!/usr/bin/env ruby
#MISE description="Test core: ta_layout used only through its functions, no recursion, the lifetime tests under AddressSanitizer, every test program, and the API description"
#MISE sources=["include/**/*", "src/**/*", "tests/**/*", "protocol/**/*", "mise/**/*", "mise.toml", "../mise/lib/**/*", "../mise.toml", "../mise/ast-grep/rules/layout-*.yml", "../sgconfig.yml"]
#MISE outputs={auto=true}
#USAGE flag "--full" help="Run the exhaustive programs at their large sizes (sets TA_TEST_FULL=1, also for the sanitizer run); needs --force to rerun when nothing changed"
# vim:ft=ruby

# mise skips this task while none of its sources changed since it last
# passed (sources, outputs above); `mise run --force test` runs it anyway.
# It expects core built (`mise run build` at the repo root).
#
# --full sets TA_TEST_FULL=1 for the sanitizer run and every program: those
# marked `exhaustive` (mise/lib/test_programs.rb) then run their large sets.
# Without it they run the small version of the same property.

require 'etc'
require 'pathname'
require_relative '../lib/test_programs'

FULL = ENV['usage_full'] == 'true' || ARGV.include?('--full')
ENV['TA_TEST_FULL'] = FULL ? '1' : nil
ROOT = Pathname.new(__dir__).join('../..').expand_path

def run(*command)
  pid = Process.spawn(*command, chdir: ROOT.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

run('mise', 'run', 'check-layout')
run('mise', 'run', 'check-recursion')
# The generated protocol files (src/ring_proto.*, MESSAGES.md, messages.json) are committed: stale ones fail here.
run('mise', 'run', 'protocol', '--check')
# The lifetime tests under AddressSanitizer: a use-after-free is undefined
# behaviour an ordinary run may survive (ADR 0065).
run('mise', 'run', 'asan')

TESTS = TestPrograms.names
# Tests whose API src/ does not implement yet do not link; the build reports
# them as pending (mise/tasks/build, PENDING_TESTS). Each runs, and must
# pass, as soon as its binary is there. Empty today.
PENDING = %w[].select do |test|
  ROOT.join("build/#{test}").file?.tap do |linked|
    puts "tinyactors-core: #{test} is pending (no implementation to link against)" unless linked
  end
end

# The test programs are independent: they run at once, one per CPU.
queue = Queue.new
(TESTS + PENDING).each { |test| queue << test }
queue.close
failed = Queue.new
Array.new(Etc.nprocessors) do
  Thread.new do
    while (test = queue.pop)
      pid = Process.spawn(ROOT.join("build/#{test}").to_s, chdir: ROOT.join('..').to_s)
      failed << test unless Process.wait2(pid).last.success?
    end
  end
end.each(&:join)
abort "tinyactors-core: failed: #{Array.new(failed.size) { failed.pop }.sort.join(', ')}" unless failed.empty?

run('mise', 'run', 'api-test')

exhaustive = TestPrograms.exhaustive
puts "tinyactors-core: #{exhaustive.size} exhaustive programs (#{exhaustive.join(', ')}) ran at #{FULL ? 'full size' : 'fast size (--full runs them large)'}"
