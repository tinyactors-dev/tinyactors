#!/usr/bin/env ruby
#MISE description="Install the packed @tinyactors/node tarballs in Docker containers, under glibc and musl, on x64 and arm64, with npm and Bun, and run bindings/node/test/smoke/smoke.js in each"
#USAGE flag "--images <names>" help="Comma-separated subset of the images, by their label"
# vim:ft=ruby

# One Linux addon serves glibc and musl (docs/adr/0001, decision 10); this
# is where that is checked on the packed packages. Each container gets the
# tarballs from `mise run node:package` and test/smoke/ read-only, installs
# the main package and its architecture's platform package by path into a
# fresh directory, and runs the smoke script. The architecture that is not
# this machine's runs emulated (qemu or Rosetta), so it is a smoke test
# only: the full suites' timing assertions fail there (decision 14).
# There is no Bun on musl x64: its alpine build needs AVX, which an emulated
# x64 (Rosetta, qemu) lacks, so `bun add` crashes before the addon loads;
# node-alpine-x64 covers the addon on musl x64. Containers run one at a
# time. Needs Docker.

require_relative '../../node_package'

# label => [image, release target, engine]
IMAGES = {
  'node-alpine-x64' => ['node:22-alpine', 'x86_64-linux', :npm],
  'node-bookworm-x64' => ['node:22-bookworm-slim', 'x86_64-linux', :npm],
  'node-alpine-arm64' => ['node:22-alpine', 'aarch64-linux', :npm],
  'node-bookworm-arm64' => ['node:22-bookworm-slim', 'aarch64-linux', :npm],
  'bun-debian-x64' => ['oven/bun:1', 'x86_64-linux', :bun],
  'bun-debian-arm64' => ['oven/bun:1', 'aarch64-linux', :bun],
  'bun-alpine-arm64' => ['oven/bun:1-alpine', 'aarch64-linux', :bun]
}.freeze

requested = NodePackage.flag('images')
labels = requested.empty? ? IMAGES.keys : requested.split(',').map(&:strip)
unknown = labels - IMAGES.keys
abort "node:smoke-containers: unknown images #{unknown.join(', ')}; known: #{IMAGES.keys.join(', ')}" unless unknown.empty?

main = Dir[NodePackage::TARBALLS.join('tinyactors-node-[0-9]*.tgz').to_s].first
abort 'node:smoke-containers: no packed tarballs; run `mise run node:package` first' unless main

results = labels.map do |label|
  image, target, engine = IMAGES.fetch(label)
  platform = Toolchain::Target.release(target).container_platform
  addon = Dir[NodePackage::TARBALLS.join("tinyactors-node-#{NodePackage::PLATFORMS.fetch(target).join('-')}-[0-9]*.tgz").to_s].first
  unless addon
    puts "#{label}: no #{target} tarball; package that target"
    next [label, false]
  end
  install = engine == :npm ? 'npm install --no-audit --no-fund --silent' : 'bun add --silent'
  smoke = engine == :npm ? 'node smoke.js' : 'bun smoke.js'
  script = 'set -e; mkdir /work; cp /smoke/* /work/; cd /work; ' \
           "#{install} /tarballs/#{File.basename(main)} /tarballs/#{File.basename(addon)}; #{smoke}"
  puts "#{label}: #{image} (#{platform})"
  $stdout.flush
  ok = system('docker', 'run', '--rm', '--platform', platform,
              '-v', "#{NodePackage::TARBALLS}:/tarballs:ro", '-v', "#{NodePackage::SMOKE}:/smoke:ro",
              image, 'sh', '-c', script)
  [label, ok]
end

puts
results.each { |label, ok| puts format('  %-4s  %s', ok ? 'pass' : 'FAIL', label) }
failed = results.reject(&:last).map(&:first)
abort "node:smoke-containers: failed: #{failed.join(', ')}" unless failed.empty?
