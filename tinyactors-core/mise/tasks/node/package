#!/usr/bin/env ruby
#MISE description="Build the release addons and pack the npm packages, @tinyactors/node and one platform package per release target, into build/node/npm/tarballs/"
#USAGE flag "--targets <targets>" help="Comma-separated release targets to package (default: all four)"
#USAGE flag "--version <version>" help="Stamp this version into every package instead of bindings/node/package.json's (the release task passes it)"
#USAGE flag "--dev" help="Stamp HEAD's development version (<next minor>-dev.<date>.<n>.g<sha>)"
# vim:ft=ruby

# The npm packages (mise/node_package.rb, docs/adr/0001-packaging-and-releases.md):
#
# - @tinyactors/node, staged into build/node/npm/node/: node/
#   (NodePackage::FILES), README.md and LICENSE, and a package.json made
#   from bindings/node/package.json, without scripts or devDependencies,
#   whose main and types point into node/, and with optionalDependencies on
#   every platform package at exactly its own version. Those live only in
#   the staged copy: the repository's package.json cannot name them, since
#   npm cannot lock packages that are not published.
# - @tinyactors/node-<platform>-<arch>, staged into build/node/npm/<name>/:
#   the target's addon as tinyactors.node, with `os` and `cpu` and no `libc`
#   field, a README.md and LICENSE.
#
# Every addon is built here (node:build --target, cached while its inputs
# are unchanged) and checked (node:symbols) before it is packed, so a
# tarball never holds a stale or unchecked addon. The version is stamped
# into the staged manifests only; bindings/node/package.json is not
# changed (the release commits it).

require 'fileutils'
require 'release'
require_relative '../../node_package'

def run(*command, chdir: Core::ROOT)
  pid = Process.spawn(*command.map(&:to_s), chdir: chdir.to_s)
  _pid, status = Process.wait2(pid)
  abort "node:package: #{command.join(' ')} failed" unless status.success?
end

requested = NodePackage.flag('targets')
targets = requested.empty? ? NodePackage.targets : requested.split(',').map(&:strip)
unknown = targets - NodePackage.targets
abort "node:package: unknown targets #{unknown.join(', ')}; known: #{NodePackage.targets.join(', ')}" unless unknown.empty?

manifest = NodePackage.manifest
version = NodePackage.flag('version')
version = Release.dev_version(NodePackage::TAG_PREFIX) if version.empty? && NodePackage.switch?('dev')
version = manifest.fetch('version') if version.empty?
Release.parse_version(version)

targets.each do |target|
  run('mise', 'run', 'node:build', '--target', target)
  run('mise', 'run', 'node:symbols', '--target', target)
end

abort "node:package: #{NodePackage::LICENSE} is missing" unless NodePackage::LICENSE.file?
FileUtils.rm_rf(NodePackage::NPM)
FileUtils.mkdir_p(NodePackage::TARBALLS)
shared = { 'version' => version, **manifest.slice('license', 'homepage', 'repository', 'bugs') }

# The main package.
main = NodePackage::NPM.join('node')
bindings = Core::ROOT.join('bindings')
NodePackage::FILES.each do |file|
  FileUtils.mkdir_p(main.join(file).dirname)
  FileUtils.cp(bindings.join(file), main.join(file))
end
FileUtils.cp(NodePackage::BINDING.join('README.md'), main.join('README.md'))
FileUtils.cp(NodePackage::LICENSE, main.join('LICENSE'))
staged = manifest.except('scripts', 'devDependencies').merge(
  'version' => version,
  'main' => 'node/index.js',
  'types' => 'node/index.d.ts',
  'files' => [*NodePackage::FILES, 'README.md', 'LICENSE'],
  'optionalDependencies' => NodePackage.targets.to_h { |target| [NodePackage.platform_name(target), version] }
)
main.join('package.json').write("#{JSON.pretty_generate(staged)}\n")

# One package per target.
targets.each do |target|
  os, cpu = NodePackage::PLATFORMS.fetch(target)
  name = NodePackage.platform_name(target)
  dir = NodePackage::NPM.join(name.delete_prefix('@tinyactors/'))
  FileUtils.mkdir_p(dir)
  FileUtils.cp(NodePackage.addon(target), dir.join('tinyactors.node'))
  FileUtils.cp(NodePackage::LICENSE, dir.join('LICENSE'))
  package = {
    'name' => name,
    'description' => "The #{os}-#{cpu} native addon of #{NodePackage::NAME}",
    **shared,
    'os' => [os],
    'cpu' => [cpu],
    'main' => 'tinyactors.node',
    'files' => %w[tinyactors.node LICENSE]
  }
  dir.join('package.json').write("#{JSON.pretty_generate(package)}\n")
  dir.join('README.md').write(<<~README)
    # #{name}

    The #{os}-#{cpu} native addon of
    [#{NodePackage::NAME}](https://www.npmjs.com/package/#{NodePackage::NAME}).
    Install `#{NodePackage::NAME}`, not this package: it depends on the addon
    for each platform, and npm, pnpm and Bun install only the one that
    matches.
  README
end

staged_dirs = [main, *targets.map { |target| NodePackage::NPM.join(NodePackage.platform_name(target).delete_prefix('@tinyactors/')) }]
staged_dirs.each { |dir| run('npm', 'pack', '--silent', '--pack-destination', NodePackage::TARBALLS, chdir: dir) }
puts "node:package: #{version}, #{staged_dirs.size} packages in #{NodePackage::TARBALLS.relative_path_from(Core::ROOT)}:"
Dir[NodePackage::TARBALLS.join('*.tgz').to_s].sort.each do |tarball|
  puts format('  %8.1f KiB  %s', File.size(tarball) / 1024.0, File.basename(tarball))
end
