#!/usr/bin/env ruby
#MISE description="Check the release addons' symbols (build/node/<target>/tinyactors.node): the right architecture, only the Node-API entry points exported, only Node-API and an allowlist of libc functions imported, and no needed library on Linux"
#USAGE flag "--target <target>" help="Check one release target (default: every target built under build/node/)"
# vim:ft=ruby

# What an addon may import (docs/adr/0001-packaging-and-releases.md,
# decision 10):
#
# - Node-API functions; the process that loads the addon provides them.
#   The addon compiles with NAPI_VERSION=8, so node_api.h declares nothing
#   newer, and -Werror fails a call to anything else.
# - On Linux, the libc functions in LINUX_LIBC and QuickJS's
#   (Core::ECMASCRIPT_LIBC, for the quickjs datamodel) and nothing else, and no
#   DT_NEEDED entry at all: the addon links no C library, so it binds to the
#   libc Node itself runs on. Each function here has the same name,
#   arguments and types in glibc and musl; a new one fails the check until
#   that has been checked.
# - On macOS, the same functions from libSystem, plus DARWIN_EXTRA.
#
# It exports only the Node-API registration functions. What the platform's
# runtime adds (libSystem, the lazy-binding helper, ld64's own symbols) is
# Toolchain::ObjectFormat's to allow; symbols are read with the pinned LLVM
# tools, as C names, from any host (mise/lib/toolchain/).

require_relative '../../node_package'

LINUX_LIBC = (%w[bcmp memcmp memcpy memset strncmp malloc_usable_size] + Core::ECMASCRIPT_LIBC + %w[qsort]).uniq.freeze

# libSystem symbols a macOS addon may import beyond LINUX_LIBC, each for a
# reason that holds on every macOS the addon supports.
DARWIN_EXTRA = {
  '__memcpy_chk' => 'the SDK headers turn on _FORTIFY_SOURCE; libSystem has provided it since 10.5',
  'bzero' => "Darwin's clang lowers zeroing to bzero whatever the flags (ADR 0001, decision 16)"
}.freeze

LIBC = {
  'x86_64-linux' => LINUX_LIBC,
  'aarch64-linux' => LINUX_LIBC,
  'x86_64-macos' => LINUX_LIBC - %w[bcmp malloc_usable_size] + %w[malloc_size] + DARWIN_EXTRA.keys,
  'aarch64-macos' => LINUX_LIBC - %w[bcmp malloc_usable_size] + %w[malloc_size] + DARWIN_EXTRA.keys
}.freeze

EXPORTS = %w[napi_register_module_v1 node_api_module_get_api_version_v1].freeze

def node_api?(name) = name.start_with?('napi_', 'node_api_')

def check(target)
  path = NodePackage.addon(target.name)
  return ["#{path.relative_path_from(Core::ROOT)} is not built: mise run node:build --target #{target.name}"] unless path.file?

  addon = Toolchain::Binary.new(path)
  allowed = LIBC.fetch(target.name)
  imported = addon.undefined.to_a
  node_api = imported.select { |name| node_api?(name) }
  problems = []
  {
    -> { addon.must_be_for!(target) } => '',
    -> { addon.must_load_only!([]) } => '',
    -> { addon.must_export_exactly!(EXPORTS) } => '',
    -> { addon.must_leave_undefined_only!(node_api + allowed) } =>
      '. Check that each has the same name, arguments and types in glibc and musl (and exists in libSystem) ' \
      'before adding it to mise/tasks/node/symbols.'
  }.each do |check, advice|
    check.call
  rescue Toolchain::Binary::Mismatch => e
    problems << "#{e.message}#{advice}"
  end
  libc = imported.count { |name| allowed.include?(name) }
  puts "#{target.name}: #{node_api.size} Node-API and #{libc} libc imports, exports #{EXPORTS.join(', ')}" if problems.empty?
  problems
end

given = NodePackage.flag('target')
targets = if given.empty?
            NodePackage.targets.select { |name| NodePackage.addon(name).file? }.map { |name| Toolchain::Target.release(name) }
          else
            [Toolchain::Target.release(given)]
          end
abort 'node:symbols: no release addon is built; run mise run node:build --target <target>' if targets.empty?

failures = targets.to_h { |target| [target.name, check(target)] }.reject { |_, problems| problems.empty? }
failures.each do |name, problems|
  warn "#{name}:"
  problems.each { |problem| warn "  #{problem}" }
end
exit(failures.empty? ? 0 : 1)
