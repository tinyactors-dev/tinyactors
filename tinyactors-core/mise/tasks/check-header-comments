#!/usr/bin/env ruby
#MISE description="Fail on a header in src/ or src/generated/ that does not open with a /** @file */ comment, unless it is on the allow-list of headers older than the check"
# vim:ft=ruby

# The rule and its test are in the root's mise/ast-grep/
# (header-file-comment.yml); `mise run check-portability` runs the test.
# This scans the headers of src/ and src/generated/ with it.
#
# ALLOWED lists the headers written before the check that still lack the
# comment. It only shrinks: a change to one of them adds its comment and
# takes it off the list. The task fails on a listed header that is gone or
# has its comment now, so the list stays exact.
#
#   mise run check-header-comments   exit 1, naming each header without one

require 'json'
require 'pathname'
require 'toolchain'

ROOT = Pathname.new(__dir__).join('../..').expand_path
RULE = ROOT.join('../mise/ast-grep/rules/header-file-comment.yml').expand_path

ALLOWED = %w[
  src/actor.h src/address.h src/arena.h src/builder.h src/clock.h src/codec.h src/configuration.h
  src/continuation.h src/datamodel.h src/definition.h src/event.h src/event_name.h src/export.h src/fault.h
  src/history.h src/internal.h src/interpreter.h src/invoke.h src/io.h src/io_origin.h src/null_datamodel.h
  src/routing.h src/scxml_uri.h src/session.h src/session_image.h src/store.h src/system.h src/timer.h
  src/trace.h src/tree.h
].freeze

out, err, status = Toolchain::Tool[:ast_grep].capture('scan', '--rule', RULE.to_s, '--json=compact',
                                                      '--globs', '*.h', 'src', chdir: ROOT.to_s)
abort "check-header-comments: ast-grep scan failed:\n#{err}" if out.strip.empty? && !status.success?

missing = JSON.parse(out).map { |match| match.fetch('file').delete_prefix('./') }.uniq.sort
headers = Dir[ROOT.join('src/**/*.h').to_s].map { |path| Pathname.new(path).relative_path_from(ROOT).to_s }.sort

errors = []
(missing - ALLOWED).each do |path|
  errors << "#{path}: does not open with a /** @file */ comment; see mise/ast-grep/rules/header-file-comment.yml"
end
(ALLOWED - headers).each { |path| errors << "#{path}: on the allow-list but gone; take it off ALLOWED" }
(ALLOWED & headers - missing).each { |path| errors << "#{path}: has its file comment now; take it off ALLOWED" }

errors.each { |error| puts "check-header-comments: #{error}" }
abort "check-header-comments: #{errors.size} finding(s)" unless errors.empty?
puts "check-header-comments: #{headers.size - ALLOWED.size} of #{headers.size} headers open with a file comment; " \
     "#{ALLOWED.size} older ones are allowed without"
