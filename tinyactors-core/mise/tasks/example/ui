#!/usr/bin/env ruby
#MISE description="Example: UI elements backed by actors (examples/ui-elements), served in the foreground at http://localhost:8000/examples/ui-elements/"
#MISE depends=["web:build"]
#USAGE flag "--port <port>" default="8000" help="The port to listen on; 0 for any free port"
# vim:ft=ruby

# examples/serve.mjs serves examples/ and the web binding's wasm module as
# static files, and prints the URL of the UI elements page.

require_relative '../../core'

port = ENV['usage_port'].to_s
port = '8000' if port.empty?
exec(*Toolchain::Tool[:node].command(Core::ROOT.join('examples/serve.mjs'), '--port', port), chdir: Core::ROOT.to_s)
