#!/usr/bin/env ruby
#MISE description="Example: multiplayer chess (examples/chess), served in the foreground at http://localhost:8080/; game records in PostgreSQL when it runs (mise run pg:start)"
#MISE depends=["node:build", "web:build"]
#USAGE flag "--port <port>" default="8080" help="The port to listen on; 0 for any free port"
#USAGE flag "--no-pg" help="Keep no game records, even when PostgreSQL is running"
# vim:ft=ruby

# The server (examples/chess/server.mjs) runs on the Node.js binding's addon
# and serves the client with the web binding's wasm module; it prints its URL.

require_relative '../../core'

port = ENV['usage_port'].to_s
port = '8080' if port.empty?
arguments = ['--port', port]
arguments << '--no-pg' if ENV['usage_no_pg'] == 'true'
exec(*Toolchain::Tool[:node].command(Core::ROOT.join('examples/chess/server.mjs'), *arguments), chdir: Core::ROOT.to_s)
