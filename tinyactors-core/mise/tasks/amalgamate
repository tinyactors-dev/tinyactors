#!/usr/bin/env ruby
#MISE description="The single-file distribution of each library, as SQLite has one: dist/<library>.h (its public ABI), dist/<library>.c (its portable sources) and dist/<library>_<platform>.c (its platform files), each checked to compile on its own"
#USAGE flag "--out <dir>" help="Write them into this directory instead of dist/ (a binding's build/, relative to where mise was called)"
# vim:ft=ruby

# For each library in Core::LIBRARIES (tinyactors, tinyactors_runtime):
#
#   dist/<name>.h             its public headers in order, inlined once; a
#                             library that uses another includes that one's
#                             header instead of repeating it
#   dist/<name>.c             its portable sources, their project includes
#                             inlined once
#   dist/<name>_<suffix>.c    its platform files for `suffix` (PlatformFiles:
#                             `wasm`, `hosted`), a translation unit of their
#                             own beside the amalgamation
#
# Each .c includes its library's header where its first source includes a
# public header, so a feature macro a source defines first
# (_POSIX_C_SOURCE) still comes before any system header. `cc -c
# tinyactors.c` needs no other file; database extensions, embedded projects
# and language bindings vendor the pair. A binding builds core from them in
# its own build/ (`mise run //tinyactors-core:amalgamate -- --out
# build/core`, from tinyactors-napi or tinyactors-cpython), so two sessions
# never write the same dist/ at once. Each file is compiled on its own:
# the portable and hosted ones for this machine, the wasm ones for wasm
# (tinyactors's for wasm32-freestanding; those of the libraries that call the
# C library against wasi-libc, which their browser modules compile in).

require_relative '../core'

INCLUDE = %r{\A\s*#\s*include\s+(?:"([^"]+)"|<(tinyactors(?:/[^>]+|\.h))>)\s*(?:/\*.*\*/\s*)?\z}
out = ENV.fetch('usage_out', nil)
out ||= ARGV[ARGV.index('--out') + 1] if ARGV.include?('--out')
OUT = out ? Pathname.new(out).expand_path(ENV.fetch('MISE_ORIGINAL_CWD', Dir.pwd)) : Core::DIST
PUBLIC_DIR = Core::ROOT.join('include/tinyactors')

def header(name, directory)
  [directory.join(name), Core::ROOT.join('include', name), Core::ROOT.join('src', name),
   Core::ROOT.join('third_party/quickjs-ng', name)].find(&:file?)&.realpath
end

# Whether `path` opens with an include guard or `#pragma once`, after its
# leading comments.
def guarded?(path)
  path.read.match?(%r{\A(?:\s*(?:/\*.*?\*/|//[^\n]*))*\s*#\s*(?:ifndef\s+\w+\s*\n\s*#\s*define|pragma\s+once)}m)
end

# Inlines `path` and, once each, the project headers it includes, into
# `out`. A public header already in `public` (its library's, or a used
# library's) becomes `#include "<header>"` the first time a source reaches
# one, and is skipped after; `state[:emitted]` remembers that.
def expand(path, seen, out, public: {}, state: {})
  path = path.realpath
  return if seen.include?(path)

  # A header without an include guard is meant to be included again (QuickJS's
  # opcode and atom tables are X-macros), so it is inlined every time.
  seen << path if guarded?(path)
  out << "/* ---- #{path.relative_path_from(Core::ROOT)} ---- */\n"
  path.each_line do |line|
    match = INCLUDE.match(line.chomp)
    found = match && header(match[1] || match[2], path.dirname)
    if found && public.key?(found)
      unless state[:emitted]
        out << "#include \"#{public.fetch(found)}\"\n"
        state[:emitted] = true
      end
    elsif found
      expand(found, seen, out, public: public, state: state)
    else
      out << line
    end
  end
end

version = Core.version
notice = "/* tinyactors #{version}\n\n#{Core::ROOT.join('../LICENSE').read}*/\n"
FileUtils.mkdir_p(OUT)

# The public headers each library's header covers, path => file name.
covered = {}
written = []
Core::LIBRARIES.each do |library|
  file = library.header.basename.to_s
  guard = "#{library.name.upcase}_AMALGAMATION_H"
  head = [notice, "/* #{file} — the public ABI of lib#{library.name}. Generated by mise run amalgamate. */\n",
          "#ifndef #{guard}\n#define #{guard}\n"]
  used = library.uses.to_h { |name| [name, Core.library(name).header.basename.to_s] }
  used.each_value { |name| head << "#include \"#{name}\"\n" }
  seen = covered.keys.select { |path| used.value?(covered[path]) }
  own = []
  library.headers.each do |name|
    before = seen.dup
    expand(PUBLIC_DIR.join(name), seen, head)
    own.concat(seen - before)
  end
  head << "#endif\n"
  own.each { |path| covered[path] = file }
  header = OUT.join(library.header.basename)
  header.write(head.join)
  written << [header, library, nil]

  # The library's public headers, and those of the libraries it uses, map
  # to its header: the header includes theirs.
  public = covered.select { |_, header_file| header_file == file || used.value?(header_file) }.keys.to_h { |path| [path, file] }
  library.sources.group_by { |source| PlatformFiles.platform(source) }.each do |platform, sources|
    out = OUT.join((platform ? library.platform_amalgamation(platform) : library.amalgamation).basename)
    kind = platform ? "its #{platform} platform files" : 'its portable sources'
    body = [notice, "/* #{out.basename} — lib#{library.name}: #{kind}. Generated by mise run amalgamate. */\n"]
    seen = public.keys.dup
    state = {}
    sources.each { |source| expand(Core::ROOT.join(source), seen, body, public: public, state: state) }
    out.write(body.join)
    written << [out, library, platform]
  end
end

# Each .c compiles on its own: the portable and hosted ones here, the wasm
# ones for wasm.
flags = %w[-std=c11 -Wall -Wextra -Werror]
written.select { |path, _, _| path.extname == '.c' }.each do |source, library, platform|
  target = library.target(platform)
  target.compile(source.to_s, into: OUT.join('objects', target.name, "#{source.basename('.c')}.o").to_s,
                              includes: [OUT.to_s], flags: library.cflags ? [*library.cflags, '-Werror'] : flags)
end
shown = OUT == Core::DIST ? 'dist/' : "#{OUT}/"
puts "amalgamate: #{written.map { |path, _, _| "#{shown}#{path.basename}" }.join(', ')}, each compiling on its own"
