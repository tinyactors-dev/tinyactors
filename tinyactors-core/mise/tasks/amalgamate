#!/usr/bin/env ruby
#MISE description="The single-file distribution, as SQLite has one: dist/tinyactors.h (the public ABI) and dist/tinyactors.c (the freestanding layers), checked to compile on its own"
# vim:ft=ruby

# tinyactors.h is the freestanding public headers in dependency order;
# tinyactors.c is every .c of the freestanding layers, its project includes
# inlined once. `cc -c tinyactors.c` needs no other file: database
# extensions, embedded projects and language bindings vendor these two.

require_relative '../core'

PUBLIC = %w[types.h address.h frame.h image.h datamodel.h system.h].freeze
LAYERS = %w[base image core system].freeze
INCLUDE = %r{\A\s*#\s*include\s+(?:"([^"]+)"|<(tinyactors(?:/[^>]+|\.h))>)\s*\z}
OUT = Core::ROOT.join('dist')

def header(name, directory)
  [directory.join(name), Core::ROOT.join('include', name), Core::ROOT.join('src', name)].find(&:file?)&.realpath
end

def expand(path, seen, out)
  path = path.realpath
  return if seen.include?(path)

  seen << path
  out << "/* ---- #{path.relative_path_from(Core::ROOT)} ---- */\n"
  path.each_line do |line|
    match = INCLUDE.match(line.chomp)
    found = match && header(match[1] || match[2], path.dirname)
    found ? expand(found, seen, out) : out << line
  end
end

version = Core::ROOT.join('VERSION').read.strip
notice = "/* tinyactors #{version}\n\n#{Core::ROOT.join('LICENSE').read}*/\n"
seen = []
head = [notice, "/* tinyactors.h — amalgamated public ABI. Generated by mise run amalgamate. */\n",
        "#ifndef TINYACTORS_AMALGAMATION_H\n#define TINYACTORS_AMALGAMATION_H\n"]
PUBLIC.each { |name| expand(Core::ROOT.join('include/tinyactors', name), seen, head) }
head << "#endif\n"
body = [notice, "/* tinyactors.c — amalgamated freestanding runtime. Generated by mise run amalgamate. */\n",
        "#include \"tinyactors.h\"\n"]
LAYERS.each do |layer|
  Core::LAYERS.fetch(layer).sources.sort.each { |source| expand(Core::ROOT.join(source), seen, body) }
end
FileUtils.mkdir_p(OUT)
OUT.join('tinyactors.h').write(head.join)
OUT.join('tinyactors.c').write(body.join)
Toolchain::Target.host.compile(OUT.join('tinyactors.c').to_s, into: OUT.join('tinyactors.o').to_s,
                                flags: %w[-std=c11 -Wall -Wextra -Werror])
puts 'amalgamate: dist/tinyactors.h and dist/tinyactors.c, which compile on their own'
