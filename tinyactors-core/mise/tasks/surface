#!/usr/bin/env ruby
#MISE description="Check the bindings' surface (bindings/surface.json): every public C function is classified, every bound one survives linking each binding, and each binding's index.d.ts declares its runtime surface"
#MISE depends=["node:build", "web:build"]
#MISE sources=["include/**/*", "src/**/*", "bindings/**/*.{c,h,js,mjs,cjs,ts,json}", "mise/core.rb", "mise/tasks/surface", "../mise/lib/toolchain/**/*", "../mise/lib/toolchain.rb", "../mise.toml"]
#MISE outputs={auto=true}
#USAGE flag "-v --verbose" help="List every public function with its classification and where it is reachable"
# vim:ft=ruby

# bindings/surface.json says what every binding must expose:
#
#   "functions"  ta_name => "bind" | {"skip": "reason"} |
#                {"bind": ["node"], "skip": "why not the others"}
#   "typings"    a declaration file => the module it describes
#   "internal"   runtime exports and class members the typings leave out
#
# Three checks:
#
# 1. Classification. Every function the public headers declare is
#    classified, and nothing classified is gone. The functions are read
#    from the API descriptions clang writes (include/<library>.api.json,
#    `mise run api`; `api --check` in `mise run test` keeps them current),
#    one per library of Core::LIBRARIES; a header of include/tinyactors/
#    that no library publishes is an error, since no description reads it.
#
# 2. Reachability, decided by the linker. Each binding is compiled from the
#    sources its real build uses (Core.node_addon_inputs, Core.web_sources),
#    unoptimized with a section per function (Core::UNOPTIMIZED), and
#    linked with dead-code elimination from its entry points. A function is
#    reachable when it survives: some path of calls or function pointers
#    from an entry point reaches it.
#    - node: a relocatable link of the addon for x86_64 Linux ELF (the
#      pinned zig's ld.lld, -r --gc-sections), rooted at
#      napi_register_module_v1; the N-API functions stay undefined, as the
#      process that loads the addon provides them. One fixed target, so the
#      answer is the same on macOS, whose linker garbage-collects only what
#      it links whole, and on Linux.
#    - web: the wasm32-wasi reactor, as web:build links it; wasm-ld always
#      collects garbage, and the exports glue.c names are the roots. Its
#      functions are read from the module's name section.
#
# 3. Typings. Every export of each binding as loaded (bindings/node through
#    index.js, bindings/web/node.mjs) and every public method, getter and
#    static of its System, Actor and SystemImage classes is declared in its
#    index.d.ts: the pinned tsc checks a generated file that refers to each.
#
# Generated files are in build/surface/.

require 'json'
require 'open3'
require_relative '../core'

verbose = ENV['usage_verbose'] == 'true' || ARGV.include?('-v') || ARGV.include?('--verbose')
Dir.chdir(Core::ROOT)
OUT = Core::BUILD.join('surface')
FileUtils.mkdir_p(OUT)
CLASSES = %w[System Actor SystemImage].freeze

manifest = JSON.parse(Core::ROOT.join('bindings/surface.json').read)
problems = []

# --- 1. classification ----------------------------------------------------

functions = {} # name => header of its library
Core::LIBRARIES.each do |library|
  JSON.parse(library.api.read)['functions'].each { |function| functions[function['name']] = library.name }
end
published = Core::LIBRARIES.flat_map(&:headers)
Dir[Core::ROOT.join('include/tinyactors/*.h').to_s].sort.each do |header|
  next if published.include?(File.basename(header))

  problems << "include/tinyactors/#{File.basename(header)} is in no library's headers (Core::LIBRARIES), so no API " \
              'description reads its functions'
end
classes = manifest.fetch('functions')
(functions.keys - classes.keys).sort.each do |name|
  problems << "unclassified: #{name} (#{functions[name]}): add it to bindings/surface.json"
end
(classes.keys - functions.keys).sort.each { |name| problems << "stale: #{name} is classified but no longer public" }

# --- 2. reachability ------------------------------------------------------

def node_functions
  target = Core.target('surface')
  target.combine(Core.node_addon_inputs('surface'), into: OUT.join('node.o').to_s, keep: %w[napi_register_module_v1])
        .defined
end

def web_functions = Core.link_web(into: OUT.join('web.wasm'), flags: Core::UNOPTIMIZED).defined

LINKS = { 'node' => -> { node_functions }, 'web' => -> { web_functions } }.freeze
linked = {}
LINKS.each do |binding, link|
  linked[binding] = link.call
rescue Toolchain::Error => e
  problems << "#{binding}: linking the binding failed:\n#{e.message.lines.last(30).join}"
end

rows = []
reachable = Hash.new(0)
wanted = Hash.new(0)
functions.keys.sort.each do |name|
  classification = classes[name]
  next if classification.nil?

  bound =
    if classification == 'bind'
      LINKS.keys
    elsif classification.is_a?(Hash) && classification['bind'].is_a?(Array)
      unknown = classification['bind'] - LINKS.keys
      problems << "#{name}: bound for #{unknown.join(', ')}, which is no binding (#{LINKS.keys.join(', ')})" unless unknown.empty?
      problems << "#{name}: bound only for #{classification['bind'].join(', ')}: say why not the others (\"skip\")" if
        classification['skip'].to_s.strip.empty?
      classification['bind'] & LINKS.keys
    elsif classification.is_a?(Hash) && classification.key?('skip') && classification.size == 1
      problems << "#{name}: a skip needs a reason" if classification['skip'].to_s.strip.empty?
      rows << [name, 'skip', classification['skip']]
      next
    else
      problems << "#{name}: invalid classification #{classification.to_json}"
      next
    end
  missing = bound.select { |binding| linked[binding] && !linked[binding].include?(name) }
  bound.each do |binding|
    wanted[binding] += 1
    reachable[binding] += 1 if linked[binding] && !missing.include?(binding)
  end
  missing.each do |binding|
    problems << "#{binding}: #{name} is not reachable (classified \"bind\"; linking the binding drops it)"
  end
  rows << [name, 'bind', bound.map { |binding| "#{binding}: #{missing.include?(binding) ? 'unreachable' : 'ok'}" }.join(', ')]
end

# --- 3. typings -------------------------------------------------------------

# Loads `module` and prints its exports and its classes' public members.
RUNTIME_SURFACE = <<~'JS'
  (async () => {
    const file = process.argv[1];
    const m = file.endsWith('.mjs') ? await import(require('url').pathToFileURL(file)) : { default: require(file) };
    const named = Object.keys(m).filter((k) => k !== 'default');
    const api = named.length ? m : m.default;
    const pub = (n) => /^[a-zA-Z]/.test(n);
    const out = { exports: (named.length ? named : Object.keys(api)).sort(), classes: {} };
    for (const c of process.argv.slice(2)) {
      const C = api[c];
      if (typeof C !== 'function') continue;
      out.classes[c] = {
        proto: Object.getOwnPropertyNames(C.prototype).filter((n) => n !== 'constructor' && pub(n)).sort(),
        static: Object.getOwnPropertyNames(C).filter((n) => !['length', 'name', 'prototype'].includes(n) && pub(n)).sort(),
      };
    }
    console.log(JSON.stringify(out));
    setImmediate(() => process.exit(0));
  })()
JS

def runtime_surface(module_path)
  out, err, status = Toolchain::Tool[:node].capture('--input-type=commonjs', '-e', RUNTIME_SURFACE,
                                                     Core::ROOT.join(module_path).to_s, *CLASSES)
  return [nil, err.strip.lines.last.to_s.strip] unless status.success?

  [JSON.parse(out.strip.lines.last), nil]
end

internal = manifest.fetch('internal', [])
tsc = Core.node_packages.join('node_modules/.bin/tsc')
manifest.fetch('typings').each do |declarations, module_path|
  surface, error = runtime_surface(module_path)
  if surface.nil?
    problems << "#{declarations}: cannot load #{module_path} to read its runtime surface: #{error}"
    next
  end
  lines = ["import * as ta from '#{Core::ROOT.join(declarations).to_s.delete_suffix('.d.ts')}';"]
  what = {}
  refer = lambda do |expression, description|
    lines << "type T#{lines.size} = #{expression};"
    what[lines.size] = description
  end
  surface['exports'].each { |name| refer.call("typeof ta.#{name}", "export #{name}") unless internal.include?(name) }
  surface['classes'].each do |name, members|
    members['proto'].each do |member|
      refer.call("InstanceType<typeof ta.#{name}>['#{member}']", "#{name}.#{member}") unless internal.include?("#{name}.#{member}")
    end
    members['static'].each do |member|
      refer.call("(typeof ta.#{name})['#{member}']", "#{name}.#{member} (static)") unless internal.include?("#{name}.#{member}")
    end
  end
  check = OUT.join("#{declarations.tr('/', '_')}.check.ts")
  check.write("#{lines.join("\n")}\n")
  out, _err, status = Open3.capture3(tsc.to_s, '--noEmit', '--strict', '--target', 'ES2022', '--module', 'commonjs',
                                     '--moduleResolution', 'node10', '--lib', 'ES2022,DOM', check.to_s)
  errors = out.scan(/\.check\.ts\((\d+),\d+\): error TS\d+: (.*)/)
  errors.each do |line, message|
    problems << "#{declarations}: #{what.fetch(line.to_i, "line #{line}")} is not declared (#{message})"
  end
  problems << "#{declarations}: tsc failed:\n#{out[-800..] || out}" if !status.success? && errors.empty?
end

# --- report -----------------------------------------------------------------

bound = rows.count { |row| row[1] == 'bind' }
puts "surface: #{functions.size} public functions: #{bound} bound, #{rows.size - bound} skipped with a reason"
LINKS.each_key do |binding|
  state = linked[binding] ? "#{reachable[binding]} of #{wanted[binding]} bound functions reachable" : 'not linked'
  puts "  #{binding}: #{state}"
end
rows.each { |name, kind, note| puts format('  %-42s %-5s %s', name, kind, note) } if verbose
unless problems.empty?
  puts 'surface: INCOMPLETE'
  problems.each { |problem| puts " - #{problem}" }
  exit 1
end
puts 'surface: OK: every public function is classified; every bound function survives the link of every binding; ' \
     'every runtime export and class member is typed'
