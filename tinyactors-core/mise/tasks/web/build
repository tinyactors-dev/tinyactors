#!/usr/bin/env ruby
#MISE description="Build the web binding's WebAssembly module (bindings/web/tinyactors.wasm): the release's three libraries in one module, as the release builds them, exporting the public API and its function table; and bindings/web/api.mjs, their wasm32 layouts"
#MISE depends=["amalgamate"]
# vim:ft=ruby

# No C of the binding's own: the module is tinyactors, tinyactors_runtime and
# tinyactors_datamodel_ecmascript linked as CRelease.build_wasm links a
# release module (one memory, wasi-libc compiled in, importing nothing),
# plus an exported, growable function table: the binding's JavaScript
# datamodel puts its vtable's functions there. api.mjs carries what the
# JavaScript needs to read and write the API's structs: the wasm32 layouts,
# field types, constants and function signatures of the three API
# descriptions.

require 'json'
require_relative '../../core'

core = Core.release_project(Core.library('tinyactors'))
runtime = Core.release_project(Core.library('tinyactors_runtime'))
ecmascript = Core.release_project(Core.library('tinyactors_datamodel_ecmascript'))
web = Core::ROOT.join('bindings/web')
output = web.join('tinyactors.wasm')
api_output = web.join('api.mjs')
apis = [core, runtime, ecmascript].map(&:api)
key = Cache.digest('web:build', Cache.tool_id(Toolchain::Tool[:zig].command),
                   Cache.files('dist/*.c', 'dist/*.h', 'include/*.api.json', 'mise/tasks/web/build'),
                   Digest::SHA256.file(Core::ROOT.join('../mise/lib/c_release/build.rb')).hexdigest)
if output.file? && api_output.file? && Cache.stamped?('web-build', key)
  puts 'web:build: cached (inputs unchanged)'
  exit
end

# The table section with no maximum: what wasm-ld's --growable-table does,
# which zig's linker does not take. Sections are an id byte and a LEB128
# size; the table section (4) is a count of tables, each a reference type
# and limits (flag 1: minimum and maximum, flag 0: minimum only).
def leb(bytes, at)
  value = 0
  shift = 0
  loop do
    byte = bytes[at]
    at += 1
    value |= (byte & 0x7f) << shift
    shift += 7
    return [value, at] if byte < 0x80
  end
end

def leb_bytes(value)
  out = []
  loop do
    byte = value & 0x7f
    value >>= 7
    out << (value.zero? ? byte : byte | 0x80)
    return out if value.zero?
  end
end

def growable_table(binary)
  bytes = binary.bytes
  out = bytes[0, 8]
  at = 8
  while at < bytes.size
    id = bytes[at]
    size, start = leb(bytes, at + 1)
    body = bytes[start, size]
    if id == 4
      count, i = leb(body, 0)
      table = leb_bytes(count)
      count.times do
        table << body[i]
        flag = body[i + 1]
        minimum, i = leb(body, i + 2)
        _maximum, i = leb(body, i) if flag == 1
        table.push(0, *leb_bytes(minimum))
      end
      body = table + body[i..]
    end
    out.push(id, *leb_bytes(body.size), *body)
    at = start + size
  end
  out.pack('C*')
end

build = CRelease.build_wasm(ecmascript, Core::BUILD.join('web'), uses: [core, runtime],
                                                                 link_flags: %w[-Wl,--export-table -s])
output.binwrite(growable_table(build[:wasm].binread))

types = {}
constants = {}
functions = {}
apis.each do |path|
  api = JSON.parse(path.read)
  api.fetch('constants').each { |constant| constants[constant['name']] = constant['value'] }
  api.fetch('types').each do |name, type|
    types[name] = case type['kind']
                  when 'struct'
                    layout = type.fetch('layout').fetch('wasm32')
                    { size: layout['size'], align: layout['align'],
                      fields: type['fields'].to_h { |f| [f['name'], [layout['offsets'][f['name']], f['type']]] } }
                  when 'alias' then { alias: type['type'] }
                  else { opaque: true }
                  end
  end
  api.fetch('functions').each do |function|
    next unless function['public'] && function['implemented'] && !function['static_inline']

    functions[function['name']] = [function['returns'], function['params'].map { |param| param['type'] }]
  end
end
api_output.write(<<~JS)
  // Generated by mise run web:build from #{apis.map { |path| path.relative_path_from(Core::ROOT) }.join(', ')}:
  // the wasm32 layouts ([offset, type] per field), constants and signatures of the API.
  export const TYPES = #{JSON.generate(types)};
  export const CONSTANTS = #{JSON.generate(constants)};
  export const FUNCTIONS = #{JSON.generate(functions)};
JS
Cache.stamp('web-build', key)
puts "web:build: #{output.relative_path_from(Core::ROOT)} (#{output.size} bytes, #{build[:exports].size} functions), " \
     "#{api_output.relative_path_from(Core::ROOT)}"
