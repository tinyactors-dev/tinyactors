#!/usr/bin/env ruby
#MISE description="Test the web binding: the Node.js binding's suites against the wasm module (TA_BINDING=web), and its own tests"
#MISE depends=["web:build", "node:build"]
# vim:ft=ruby

require_relative '../../core'

node = Core.node_packages
Core.run('node', '--test', *Dir[node.join('test/*.test.js').to_s].sort, chdir: node, env: { 'TA_BINDING' => 'web' })
Core.run('node', '--test', *Dir[Core::ROOT.join('bindings/web/test/*.test.mjs').to_s].sort, chdir: Core::ROOT.join('bindings/web'))
