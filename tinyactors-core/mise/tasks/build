#!/usr/bin/env ruby
#MISE description="Build tinyactors-core"
# mise skips this task when every object below is newer than every source.
# Use `mise run --force build` after changing CC/CFLAGS.
#MISE sources=["mise/tasks/build", "mise/tasks/amalgamate", "mise/tasks/api", "mise/lib/**/*", "api/**/*", "src/**/*", "include/tinyactors.h", "tests/*.c"]
#MISE outputs=["tests/smoke.o", "tests/public_smoke.o", "tests/tinyactors.o", "build/inspection_test"]
# vim:ft=ruby

require 'fileutils'
require 'pathname'
require 'shellwords'

ROOT = Pathname.new(__dir__).join('../..').expand_path

def run(*command)
  puts command.join(' ')
  pid = Process.spawn(*command, chdir: ROOT.to_s)
  _pid, status = Process.wait2(pid)

  return if status.success?

  exit(status.exitstatus || 1)
end

compiler = Shellwords.split(ENV.fetch('CC', 'cc'))
flags = Shellwords.split(ENV.fetch('CFLAGS', '-std=c11 -Wall -Wextra -Werror -pedantic'))

run('mise', 'run', 'amalgamate')
run('mise', 'run', 'amalgamate', '--check')
run('mise', 'run', 'api')
run('mise', 'run', 'api', '--check')

run(
  *compiler,
  *flags,
  '-Iinclude',
  '-Isrc',
  '-c',
  'tests/smoke.c',
  '-o',
  'tests/smoke.o'
)

run(
  *compiler,
  *flags,
  '-Iinclude',
  '-Isrc',
  '-c',
  'tests/public_smoke.c',
  '-o',
  'tests/public_smoke.o'
)

run(
  *compiler,
  *flags,
  '-Iinclude',
  '-c',
  'include/tinyactors.c',
  '-o',
  'tests/tinyactors.o'
)

# Runtime unit tests link the amalgamation; `mise run test` runs them.
FileUtils.mkdir_p(ROOT.join('build'))
run(
  *compiler,
  *flags,
  '-Iinclude',
  'tests/inspection_test.c',
  'include/tinyactors.c',
  '-o',
  'build/inspection_test'
)

Dir['src/*.c'].sort.each do |source|
  run(*compiler, *flags, '-Isrc', '-c', source, '-o', "tests/#{File.basename(source, '.c')}.o")
end
