#!/usr/bin/env ruby
#MISE description="Build tinyactors-core"
# mise skips this task when every object below is newer than every source.
# Use `mise run --force build` after changing CC/CFLAGS.
#MISE sources=["mise/tasks/build", "mise/tasks/amalgamate", "mise/tasks/api", "mise/lib/**/*", "src/**/*", "include/tinyactors.h", "tests/*.c"]
#MISE outputs=["tests/smoke.o", "tests/public_smoke.o", "tests/tinyactors.o", "build/inspection_test", "build/export_test", "build/retirement_test", "build/scxml_uri_test", "build/send_id_test", "build/tree_test"]
# vim:ft=ruby

require 'fileutils'
require 'pathname'
require 'shellwords'

ROOT = Pathname.new(__dir__).join('../..').expand_path

def run(*command)
  puts command.join(' ')

  return if try_run(*command)

  exit(1)
end

# Runs a command and reports whether it succeeded, without ending the build.
def try_run(*command)
  pid = Process.spawn(*command, chdir: ROOT.to_s)
  _pid, status = Process.wait2(pid)
  status.success?
end

# Tests written against a public API that src/ does not implement yet: they
# are compiled against the header like every other test, but their link fails
# on the missing symbols. The build reports those as pending instead of
# failing, as tinyxml does for its unwritten modules, and `mise run test`
# runs each one as soon as it links (name => why it does not link yet).
# Empty today: tests/tree_test.c was the last entry, and src/tree.c links it.
PENDING_TESTS = {}.freeze

compiler = Shellwords.split(ENV.fetch('CC', 'cc'))
flags = Shellwords.split(ENV.fetch('CFLAGS', '-std=c11 -Wall -Wextra -Werror -pedantic'))

run('mise', 'run', 'amalgamate')
run('mise', 'run', 'amalgamate', '--check')
run('mise', 'run', 'api')
run('mise', 'run', 'api', '--check')

run(
  *compiler,
  *flags,
  '-Iinclude',
  '-Isrc',
  '-c',
  'tests/smoke.c',
  '-o',
  'tests/smoke.o'
)

run(
  *compiler,
  *flags,
  '-Iinclude',
  '-Isrc',
  '-c',
  'tests/public_smoke.c',
  '-o',
  'tests/public_smoke.o'
)

run(
  *compiler,
  *flags,
  '-Iinclude',
  '-c',
  'include/tinyactors.c',
  '-o',
  'tests/tinyactors.o'
)

# Runtime unit tests link the amalgamation into a host program (with the C
# library); `mise run test` runs them.
FileUtils.mkdir_p(ROOT.join('build'))
run(
  *compiler,
  *flags,
  '-Iinclude',
  'tests/inspection_test.c',
  'include/tinyactors.c',
  '-o',
  'build/inspection_test'
)
run(
  *compiler,
  *flags,
  '-Iinclude',
  'tests/retirement_test.c',
  'include/tinyactors.c',
  '-o',
  'build/retirement_test'
)
run(
  *compiler,
  *flags,
  '-Iinclude',
  'tests/export_test.c',
  '-o',
  'build/export_test'
)
run(
  *compiler,
  *flags,
  '-Iinclude',
  'tests/scxml_uri_test.c',
  'include/tinyactors.c',
  '-o',
  'build/scxml_uri_test'
)
run(
  *compiler,
  *flags,
  '-Iinclude',
  'tests/send_id_test.c',
  'include/tinyactors.c',
  '-o',
  'build/send_id_test'
)
run(
  *compiler,
  *flags,
  '-Iinclude',
  'tests/tree_test.c',
  'include/tinyactors.c',
  '-o',
  'build/tree_test'
)

# A pending test must still compile against the public header, so a renamed
# type or a changed signature fails the build rather than hiding as "pending";
# only its link is allowed to fail.
PENDING_TESTS.each do |test, reason|
  run(*compiler, *flags, '-Iinclude', '-c', "tests/#{test}.c", '-o', "tests/#{test}.o")

  binary = "build/#{test}"
  next if try_run(*compiler, *flags, '-Iinclude', "tests/#{test}.c", 'include/tinyactors.c', '-o', binary)

  FileUtils.rm_f(ROOT.join(binary))
  puts "tinyactors-core: #{test} is pending: #{reason}"
end

Dir['src/*.c'].sort.each do |source|
  run(*compiler, *flags, '-Isrc', '-c', source, '-o', "tests/#{File.basename(source, '.c')}.o")
end
