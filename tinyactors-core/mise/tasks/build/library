#!/usr/bin/env ruby
#MISE description="Regenerate/verify the amalgamation and API description, then compile src/*.c (correctness check) and the amalgamation into build/objects"
# vim:ft=ruby
#
# Half of `mise run build`; the other half, build:tests, compiles the test
# programs. mise runs them in parallel. `amalgamate`/`api` (and their --check
# verification) run here, first, because this task is the one that compiles
# the generated amalgamation (include/tinyactors.c) into an object other tasks
# link against -- it must be current before that compile. Both generators are
# content-gated (mise/lib/cache.rb), so these four calls cost a few hashes, not
# a clang run, when src/*.h, src/*.c and include/tinyactors.h are unchanged.
# `api` does not feed anything compiled below; it is kept here, unconditional,
# because the old single-file build task ran it unconditionally too and this
# task is its direct replacement.
#
# Each src/*.c gets its own object under build/objects/, reused while its
# contents and the headers it includes are unchanged; nothing links these
# objects (src/*.c is compiled for the compile error a stale prototype or
# signature would produce, not for the object file), so a comment-only edit
# that recompiles a module to identical bytes costs this task a hash, not a
# relink of anything downstream. smoke.c and public_smoke.c are compile-only
# checks in the same sense: smoke.c that the private module surface stays
# internally consistent, public_smoke.c that the public header alone (no
# src/ access) is enough to name every public type. The compiler is the
# pinned clang (Toolchain::Target.host) and CFLAGS selects the flags;
# changing either changes the compile command, which is part of every
# object's cache key, so it recompiles everything this task touches.

require 'pathname'
require 'shellwords'
require 'cache'
require 'platform_files'
require 'toolchain'

ROOT = Cache::ROOT
OBJECTS = ROOT.join('build/objects')

def run(*command)
  puts command.join(' ')
  pid = Process.spawn(*command, chdir: ROOT.to_s)
  _pid, status = Process.wait2(pid)
  exit(status.exitstatus || 1) unless status.success?
end

run('mise', 'run', 'amalgamate')
run('mise', 'run', 'amalgamate', '--check')
run('mise', 'run', 'api')
run('mise', 'run', 'api', '--check')

COMPILER = Toolchain::Target.host.compile_command
FLAGS = Shellwords.split(ENV.fetch('CFLAGS', '-std=c11 -Wall -Wextra -Werror -pedantic'))

compiled = 0
reused = 0

def compile(command, source, object)
  outcome, output = Cache.compile(command, source, object)
  if outcome == :failed
    puts (command + ['-c', source.to_s]).shelljoin
    abort output
  end
  puts output unless output.empty?
  outcome
end

# Correctness check only -- see the doc comment above. -Isrc, not -Iinclude:
# each module is compiled the way it is amalgamated, against its private
# headers, not the public one.
src_command = [*COMPILER, *FLAGS, '-Isrc'].freeze
PlatformFiles.sources(ROOT.join('src')).each do |path|
  source = Pathname.new(path).relative_path_from(ROOT)
  outcome = compile(src_command, source, OBJECTS.join("#{source.basename('.c')}.o"))
  outcome == :compiled ? compiled += 1 : reused += 1
end

# smoke.c reaches into src/ (internal.h); public_smoke.c must build from
# include/tinyactors.h alone. Both flags are passed to both, as the old build
# task did, since neither test is sensitive to the extra -I it doesn't need.
smoke_command = [*COMPILER, *FLAGS, '-Iinclude', '-Isrc'].freeze
[['tests/smoke.c', 'smoke.o'], ['tests/public_smoke.c', 'public_smoke.o']].each do |source, object|
  outcome = compile(smoke_command, source, OBJECTS.join(object))
  outcome == :compiled ? compiled += 1 : reused += 1
end

# The amalgamation, compiled once here; build/_default links this same object
# into every test binary that needs the runtime, instead of recompiling
# include/tinyactors.c per test binary as the old build task did.
amalgamation_command = [*COMPILER, *FLAGS, '-Iinclude'].freeze
outcome = compile(amalgamation_command, 'include/tinyactors.c', OBJECTS.join('tinyactors.o'))
outcome == :compiled ? compiled += 1 : reused += 1

puts "build:library: #{compiled} compiled, #{reused} reused"
