#!/usr/bin/env ruby
#MISE description="Write each protocol vector's CBOR (tests/protocol/*.txt) from the diagnostic notation on its diag line; --check only compares"
#USAGE flag "--check" help="Write nothing; run the self-test, then fail and list every case whose hex differs from its diag line"
#USAGE flag "--self-test" help="Check the encoder against known encodings, then exit"
#MISE sources=["tests/protocol/*.txt", "mise/tasks/protocol/encode"]
# vim:ft=ruby

# A vector's hex line (send, reply, cbor, back, error, envelope) is followed
# by a diag line: the same item in CBOR diagnostic notation. This task parses
# the diag line and writes the hex line from it, in the form core writes
# (src/base/cbor.c): shortest integers and lengths, definite lengths, map
# keys in written order (ADR 0009, decision 3), floats in the shortest exact
# width, NaN as f97e00. A diag line that is not an item, such as
# `diag (not CBOR)`, keeps its hex as written.

require_relative '../../core'

module Diagnostic
  HEX_KEYS = %w[send reply cbor back error envelope].freeze

  class Error < StandardError; end

  Map = Struct.new(:pairs) # pairs in written order; a key may repeat
  Tag = Struct.new(:number, :item)
  Simple = Struct.new(:value)
  Bytes = Struct.new(:data)

  # A recursive-descent reader of the notation ta_cbor_diagnostic writes, and
  # what the vector files add: tags, h'..', simple(n), undefined, NaN and the
  # infinities.
  class Parser
    def initialize(text)
      @text = text
      @at = 0
    end

    def parse
      item = value
      space
      raise Error, "unexpected #{@text[@at..]} at #{@at}" unless @at == @text.length

      item
    end

    private

    def space = (@at += 1 while @text[@at]&.match?(/\s/))

    def expect(char)
      space
      raise Error, "expected #{char} at #{@at}" unless @text[@at] == char

      @at += 1
    end

    def value
      space
      case @text[@at]
      when '[' then list
      when '{' then map
      when '"' then text
      when 'h' then bytes
      else word
      end
    end

    def list
      expect('[')
      items = []
      space
      if @text[@at] == ']'
        @at += 1
        return items
      end
      loop do
        items << value
        space
        break @at += 1 if @text[@at] == ']'

        expect(',')
      end
      items
    end

    def map
      expect('{')
      pairs = []
      space
      if @text[@at] == '}'
        @at += 1
        return Map.new(pairs)
      end
      loop do
        key = value
        expect(':')
        pairs << [key, value]
        space
        break @at += 1 if @text[@at] == '}'

        expect(',')
      end
      Map.new(pairs)
    end

    def text
      @at += 1
      out = +''
      loop do
        char = @text[@at] or raise Error, 'unterminated text'
        @at += 1
        break if char == '"'
        next out << char unless char == '\\'

        escape = @text[@at]
        @at += 1
        out << case escape
               when '"', '\\', '/' then escape
               when 'b' then "\b"
               when 'f' then "\f"
               when 'n' then "\n"
               when 'r' then "\r"
               when 't' then "\t"
               when 'u' then unicode
               else raise Error, "bad escape \\#{escape}"
               end
      end
      out.encode('UTF-8')
    end

    def unicode
      code = @text[@at, 4].to_i(16)
      @at += 4
      if code.between?(0xD800, 0xDBFF) && @text[@at, 2] == '\\u'
        low = @text[@at + 2, 4].to_i(16)
        @at += 6
        code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00)
      end
      [code].pack('U')
    end

    def bytes
      raise Error, "expected h' at #{@at}" unless @text[@at, 2] == "h'"

      close = @text.index("'", @at + 2) or raise Error, 'unterminated bytes'
      hex = @text[(@at + 2)...close].delete(' ')
      @at = close + 1
      Bytes.new([hex].pack('H*'))
    end

    def word
      start = @at
      @at += 1 while @text[@at]&.match?(/[A-Za-z0-9+\-.]/)
      token = @text[start...@at]
      space
      if @text[@at] == '('
        @at += 1
        if token == 'simple'
          number = word
          expect(')')
          return Simple.new(number)
        end
        raise Error, "bad tag #{token}" unless token.match?(/\A\d+\z/)

        item = value
        expect(')')
        return Tag.new(Integer(token), item)
      end
      case token
      when 'true' then true
      when 'false' then false
      when 'null' then nil
      when 'undefined' then Simple.new(23)
      when 'NaN' then Float::NAN
      when 'Infinity' then Float::INFINITY
      when '-Infinity' then -Float::INFINITY
      when /\A-?\d+\z/ then Integer(token)
      when /\A-?\d+(\.\d+)?(e[-+]?\d+)?\z/i then Float(token)
      else raise Error, "unknown word #{token.inspect} at #{start}"
      end
    end
  end

  # Half-precision bits for every double a half holds exactly.
  HALVES = (0...0x10000).each_with_object({}) do |bits, table|
    exponent = (bits >> 10) & 0x1f
    fraction = bits & 0x3ff
    next if exponent == 0x1f && fraction != 0 # NaNs: written as f97e00

    magnitude = if exponent.zero? then fraction * 2.0**-24
                elsif exponent == 0x1f then Float::INFINITY
                else (1024 + fraction) * 2.0**(exponent - 25)
                end
    value = bits >> 15 == 1 ? -magnitude : magnitude
    table[[value].pack('G')] = bits
  end.freeze

  module_function

  def head(major, argument)
    if argument < 24 then [(major << 5) | argument].pack('C')
    elsif argument < 0x100 then [(major << 5) | 24, argument].pack('CC')
    elsif argument < 0x10000 then [(major << 5) | 25, argument].pack('Cn')
    elsif argument < 0x100000000 then [(major << 5) | 26, argument].pack('CN')
    elsif argument < 0x10000000000000000 then [(major << 5) | 27, argument].pack('CQ>')
    else raise Error, "#{argument} does not fit in 64 bits"
    end
  end

  def float(value)
    return "\xf9\x7e\x00".b if value.nan?

    half = HALVES[[value].pack('G')]
    return "\xf9".b + [half].pack('n') if half

    single = [value].pack('g')
    return "\xfa".b + single if single.unpack1('g') == value && [single.unpack1('g')].pack('G') == [value].pack('G')

    "\xfb".b + [value].pack('G')
  end

  def encode(item)
    case item
    when Integer then item.negative? ? head(1, -1 - item) : head(0, item)
    when Float then float(item)
    when String then head(3, item.bytesize) + item.b
    when Bytes then head(2, item.data.bytesize) + item.data.b
    when Array then head(4, item.size) + item.map { |each| encode(each) }.join.b
    when Map then head(5, item.pairs.size) + item.pairs.map { |k, v| encode(k) + encode(v) }.join.b
    when Tag then head(6, item.number) + encode(item.item)
    when Simple
      raise Error, "simple(#{item.value}) is reserved" if item.value.between?(24, 31)

      item.value < 24 ? head(7, item.value) : [0xf8, item.value].pack('CC')
    when true then "\xf5".b
    when false then "\xf4".b
    when nil then "\xf6".b
    else raise Error, "cannot encode #{item.inspect}"
    end
  end

  def to_cbor(diag) = encode(Parser.new(diag).parse).unpack1('H*')
end

# The notation that is not an item: the hex stays as written.
def diagnostic?(diag) = !diag.start_with?('(')

# Known encodings: RFC 8949 Appendix A, and what core writes.
def self_test!
  cases = {
    '0' => '00', '23' => '17', '24' => '1818', '1000000' => '1a000f4240',
    '18446744073709551615' => '1bffffffffffffffff', '-1' => '20', '-1000' => '3903e7',
    '0.0' => 'f90000', '-0.0' => 'f98000', '1.5' => 'f93e00', '65504.0' => 'f97bff',
    '100000.0' => 'fa47c35000', '1.1' => 'fb3ff199999999999a', '1.0e+300' => 'fb7e37e43c8800759c',
    'Infinity' => 'f97c00', '-Infinity' => 'f9fc00', 'NaN' => 'f97e00', '5.960464477539063e-8' => 'f90001',
    'false' => 'f4', 'true' => 'f5', 'null' => 'f6', 'undefined' => 'f7', 'simple(16)' => 'f0',
    'simple(255)' => 'f8ff', "h''" => '40', "h'01020304'" => '4401020304', '""' => '60',
    '"\\u00fc"' => '62c3bc', '"\\ud800\\udd51"' => '64f0908591', '"ü"' => '62c3bc', "\"a\\\"\\\\\\n\"" => '6461225c0a',
    '[]' => '80', '[1,[2,3],[4,5]]' => '8301820203820405', '{}' => 'a0',
    '{"b":1,"a":2}' => 'a2616201616102', '{1:2,3:4}' => 'a201020304',
    '32("http://www.example.com")' => 'd82076687474703a2f2f7777772e6578616d706c652e636f6d',
    '24(h\'6449455446\')' => 'd818456449455446', '39999("uint")' => 'd99c3f6475696e74'
  }
  failed = cases.reject { |diag, hex| Diagnostic.to_cbor(diag) == hex }
  failed.each { |diag, hex| warn "protocol:encode: #{diag} gave #{Diagnostic.to_cbor(diag)}, not #{hex}" }
  abort "protocol:encode: #{failed.size} of #{cases.size} self-test cases fail" unless failed.empty?
  cases.size
end

if ARGV.include?('--self-test') || ENV['usage_self_test'] == 'true'
  puts "protocol:encode: #{self_test!} self-test cases pass"
  exit
end

check = ARGV.include?('--check') || ENV['usage_check'] == 'true'
self_test! if check
differ = []
Dir[Core::ROOT.join('tests/protocol/*.txt').to_s].sort.each do |path|
  lines = File.readlines(path, chomp: true)
  changed = false
  lines.each_with_index do |line, index|
    key, hex = line.split(' ', 2)
    next unless Diagnostic::HEX_KEYS.include?(key) && hex

    following = lines[index + 1].to_s
    next unless following.start_with?('diag ')

    diag = following.delete_prefix('diag ')
    next unless diagnostic?(diag)

    written = begin
      Diagnostic.to_cbor(diag)
    rescue Diagnostic::Error => e
      abort "#{File.basename(path)}:#{index + 2}: #{e.message}"
    end
    next if written == hex

    differ << "#{File.basename(path)}:#{index + 1}: #{key} #{hex}\n  diag #{diag}\n  is   #{written}"
    lines[index] = "#{key} #{written}"
    changed = true
  end
  File.write(path, lines.join("\n") + "\n") if changed && !check
end

if check
  abort "protocol:encode: hex differs from diag (run `mise run protocol:encode`):\n#{differ.join("\n")}" unless differ.empty?
  puts 'protocol:encode: every hex line matches its diag line'
else
  puts "protocol:encode: #{differ.size} hex lines written"
end
