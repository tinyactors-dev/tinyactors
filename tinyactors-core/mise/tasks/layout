#!/usr/bin/env ruby
#MISE description="The region's records as the compiler laid them out: each type's size, members and padding, read from the debug information of the debuginfo build, and what an actor, an event, a timer and a request cost"
#USAGE flag "--members" help="Print each type's members and padding too"
# vim:ft=ruby

# It builds the layers with the release flags and debug information
# (`debuginfo` in mise/core.rb), reads the types with the pinned
# llvm-dwarfdump (mise/dwarf.rb), and prints:
#
# - each type the region holds, with its size and padding (and its members
#   with --members);
# - what one more of each capacity costs in a segment's region, following
#   carve() in src/system/system.c, which this task mirrors: a change there
#   changes UNITS below.
#
# Then it checks itself: ta-layout (tools/layout/layout.c) asks
# ta_system_layout what one more actor, event, timer, request and outbox
# entry adds, and each must be what the types give. A difference fails the
# task: carve() changed, and UNITS must follow it.
#
# It writes the same numbers to build/debuginfo/layout.json. The sizes are
# this machine's (x86_64 and aarch64 have the same; wasm32 has 4-byte
# pointers, which no region type holds).
require 'json'
require 'open3'
require_relative '../core'
require_relative '../dwarf'

members = ENV['usage_members'] == 'true' || ARGV.include?('--members')

layers = %w[base trace core system host]
Core.build_layers('debuginfo', (layers + %w[image compile]).uniq)
Core.build_program('debuginfo', Core::TOOLS.find { |tool| tool.name == 'ta-layout' })
dwarf = Dwarf.read(layers.map { |layer| Core.archive_path('debuginfo', layer) })

align = dwarf.macro('TA_ALIGN_MAX')
page = dwarf.macro('TA_SLAB_PAGE')
size = ->(name) { dwarf.struct(name).size }
# ta_pool_stride (src/base/pool.h): the payload, at least 8, rounded up to TA_ALIGN_MAX
stride = ->(name) { ([size.(name), 8].max + align - 1) / align * align }

# What one more of each capacity adds to a segment's region (carve(),
# src/system/system.c). A part is [what, bytes, where]; a range is
# [low, high] for a table whose capacity is a power of two.
UNITS = {
  'actor (maxActors)' => [
    ['ta_actor, a pool slot', stride.('ta_actor'), 'actor_slots'],
    ['its generation', 1, 'actor_generations'],
    ['ta_actor_links', size.('ta_actor_links'), 'actor_links'],
    ['the session index: 4 B a slot, the smallest power of two >= 2 x maxActors', [8, 16], 'sessions'],
    ['the name index: 4 B a slot, the smallest power of two >= 1.25 x maxActors', [5, 10], 'names'],
    ['strings: stringBytes by default (TA_STRING_BYTES_PER_ACTOR)', dwarf.macro('TA_STRING_BYTES_PER_ACTOR'), 'slab_pages'],
    ["its instance: the chart's instance layout, in whole slab pages", nil, 'slab_pages (instanceBytes)']
  ],
  'event (maxEvents)' => [
    ['ta_event, a pool slot', stride.('ta_event'), 'event_slots'],
    ['its generation', 1, 'event_generations'],
    ['with tracing: a trace context (traceContexts = maxEvents)', stride.('ta_trace_entry') + 1, 'context_slots, context_generations']
  ],
  'delayed send (maxTimers)' => [
    ['ta_timer, a pool slot', stride.('ta_timer'), 'timer_slots'],
    ['its generation', 1, 'timer_generations'],
    ['ta_heap_node', size.('ta_heap_node'), 'heap_nodes'],
    ['its heap position', 4, 'heap_positions']
  ],
  'request (maxRequests)' => [
    ['ta_request, a pool slot', stride.('ta_request'), 'request_slots'],
    ['its generation', 1, 'request_generations']
  ],
  'outbox entry (outbox)' => [
    ['ta_effect_record', size.('ta_effect_record'), 'effects'],
    ['ta_effect, its view', size.('ta_effect'), 'effect_views']
  ],
  'trace rule (traceRules)' => [
    ['ta_trace_rule_compiled', size.('ta_trace_rule_compiled'), 'rules']
  ],
  'chart of the image' => [
    ['its datamodel index', 1, 'chart_datamodels'],
    ['its datamodel context', 8, 'chart_contexts'],
    ['ta_chart_stats', size.('ta_chart_stats'), 'chart_stats'],
    ['with trace rules: its point', 1, 'chart_points']
  ],
  'slab page (instanceBytes, stringBytes)' => [
    ['the page', page, 'slab_pages'],
    ['ta_slab_page, its metadata', size.('ta_slab_page'), 'slab_metadata']
  ],
  'segment, once' => [
    ['ta_system, the header', size.('ta_system'), 'header'],
    ['the trace journal (traceBytes, TA_TRACE_BYTES_DEFAULT)', dwarf.macro('TA_TRACE_BYTES_DEFAULT'), 'trace_storage'],
    ['one page per slab class (TA_SLAB_CLASSES)', dwarf.macro('TA_SLAB_CLASSES') * (page + size.('ta_slab_page')), 'slab_pages, slab_metadata']
  ]
}.freeze

TYPES = %w[ta_actor ta_actor_links ta_event ta_trace_entry ta_timer ta_heap_node ta_request
           ta_effect_record ta_effect ta_trace_rule_compiled ta_chart_stats ta_slab_page ta_system].freeze

bytes = ->(value) { value.is_a?(Array) ? "#{value[0]}-#{value[1]}" : value.to_s }

puts "the region's types (#{Core.archive_path('debuginfo', 'system').dirname.relative_path_from(Core::ROOT)}, release flags with -g)"
TYPES.each do |name|
  type = dwarf.struct(name)
  puts format('  %-24<name>s %6<size>d B  %4<padding>d B padding  %<declared>s', name: name, size: type.size,
                                                                              padding: type.padding, declared: type.declared)
  next unless members

  type.members.each do |member|
    width = member.bits ? "#{member.bits} bits" : "#{member.size} B"
    puts format('      %6<offset>d  %-10<width>s %-28<name>s %<type>s', offset: member.offset, width: width,
                                                                       name: member.name, type: member.type)
  end
  type.holes.each { |offset, length| puts format('      %6<offset>d  %-10<width>s (padding)', offset: offset, width: "#{length} B") }
end

puts
puts 'what one more of each costs in a segment\'s region (carve(), src/system/system.c)'
UNITS.each do |unit, parts|
  known = parts.map { |_, value, _| value }.compact
  low = known.sum { |value| value.is_a?(Array) ? value[0] : value }
  high = known.sum { |value| value.is_a?(Array) ? value[1] : value }
  total = low == high ? "#{low} B" : "#{low}-#{high} B"
  total += ' + the chart\'s' if parts.any? { |_, value, _| value.nil? }
  puts "  #{unit}: #{total}"
  parts.each do |what, value, where|
    puts format('      %10<bytes>s  %<what>s  [%<where>s]', bytes: value.nil? ? 'chart' : "#{bytes.(value)} B", what: what, where: where)
  end
end

# The check. At a power of two the session index costs 8 B an actor (2 x 4 B)
# and the name index 8 B (1.25 x rounds up to 2 x); the slabs are fixed, so
# strings and the instance stay out.
expected = {
  'actor' => stride.('ta_actor') + 1 + size.('ta_actor_links') + 8 + 8,
  'event' => UNITS['event (maxEvents)'].sum { |_, value, _| value },
  'timer' => UNITS['delayed send (maxTimers)'].sum { |_, value, _| value },
  'request' => UNITS['request (maxRequests)'].sum { |_, value, _| value },
  'outbox' => UNITS['outbox entry (outbox)'].sum { |_, value, _| value }
}
output, status = Open3.capture2(Core.program_path('debuginfo', 'ta-layout').to_s)
abort 'layout: ta-layout failed' unless status.success?
measured = output.lines.to_h { |line| name, value = line.split; [name, Integer(value)] }
puts
puts 'checked against ta_system_layout (tools/layout/layout.c, from 2^16 to 2^17 of each)'
wrong = expected.reject do |name, bytes|
  puts format('  %-8<name>s %4<bytes>d B  %<verdict>s', name: name, bytes: measured[name] || 0,
                                                       verdict: measured[name] == bytes ? 'as the types give' : "the types give #{bytes} B")
  measured[name] == bytes
end

out = Core.directory('debuginfo').join('layout.json')
File.write(out, JSON.pretty_generate(
  'types' => TYPES.to_h do |name|
    type = dwarf.struct(name)
    [name, { 'size' => type.size, 'padding' => type.padding, 'declared' => type.declared,
             'members' => type.members.map { |m| m.to_h.compact.transform_keys(&:to_s) } }]
  end,
  'units' => UNITS.transform_values do |parts|
    parts.map { |what, value, where| { 'what' => what, 'bytes' => value, 'where' => where } }
  end
))
puts
puts "wrote #{out.relative_path_from(Core::ROOT)}"
abort "layout: #{wrong.keys.join(', ')} differ from ta_system_layout: carve() changed, and UNITS must follow it" if wrong.any?
