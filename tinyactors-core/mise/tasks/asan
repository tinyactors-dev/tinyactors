#!/usr/bin/env ruby
#MISE description="Build core's tests with AddressSanitizer and UndefinedBehaviorSanitizer and run them"
# vim:ft=ruby

# Reading freed memory is not a failed check but undefined behaviour, which
# an ordinary run may survive. ADR 0065's origin tests (tests/address_test.c)
# read an address after its sender is gone; only a sanitized build turns a
# regression there into a failure. The core tests about lifetimes run this
# way.
#
# deep_test is left out: it proves ten thousand levels run on a 64 KiB
# stack, and the sanitizer's own frames do not fit in that stack.
#
#   mise run asan   exit 1 when a test fails or a sanitizer reports

require 'etc'
require 'fileutils'
require 'pathname'
require 'toolchain'

root = Pathname.new(__dir__).join('../..').expand_path
build = root.join('build/asan')
FileUtils.mkdir_p(build)

cc = Toolchain::Target.host.compile_command
flags = %W[-I#{root.join("include")} -std=c11 -Wall -Wextra -Werror -pedantic -g -O1 -fno-omit-frame-pointer
           -fsanitize=address,undefined -fno-sanitize-recover=all]

# Tests that link the amalgamation, and tests that include it themselves.
WITH_RUNTIME = %w[address_test io_origin_test session_image_test delayed_send_test null_datamodel_test pause_test microstep_start_test operator_test trace_test inspection_test
                  retirement_test replay_test params_test copy_test scxml_uri_test send_id_test tree_test].freeze
# Of the tests that include the amalgamation themselves, and so compile it
# again, the ones about lifetimes run: actor lifetimes, and a compile that
# runs out of memory at every allocation (span_test), and lists whose items
# move between calls (list_test), and paged arrays whose directory moves
# and whose pages are freed (paged_array_test), and heaps over items
# that move between calls (heap_test), and queues whose array moves
# when reserved larger (fifo_test), and quota counters checked at
# their bounds (quota_test), and byte rings read at every
# offset and wrap (ring_test). The codec, export, compile
# error and event pattern tests exercise pure functions.
STANDALONE = %w[actor_id_test session_id_test offload_test span_test list_test paged_array_test heap_test fifo_test quota_test ring_test].freeze

# A binary is rebuilt only when one of its inputs is newer: its test, the
# amalgamation or a header. Tests build and run in parallel, one per CPU.
inputs = Dir[root.join('include/*.{h,c}').to_s] + Dir[root.join('tests/*.h').to_s]
stale = lambda do |target, sources|
  !target.file? || (sources + inputs).any? { |source| File.mtime(source) > target.mtime }
end

# The amalgamation is compiled once and linked into every test that needs it.
runtime = build.join('tinyactors.o')
if stale.call(runtime, []) &&
   !system(*cc, *flags, '-c', root.join('include/tinyactors.c').to_s, '-o', runtime.to_s, chdir: root.to_s)
  abort 'asan: the amalgamation does not compile'
end
queue = Queue.new
(WITH_RUNTIME + STANDALONE).each { |test| queue << test }
queue.close
failed = Queue.new
workers = Array.new(Etc.nprocessors) do
  Thread.new do
    while (test = queue.pop)
      sources = [root.join("tests/#{test}.c").to_s]
      sources << runtime.to_s if WITH_RUNTIME.include?(test)
      binary = build.join(test)
      if stale.call(binary, sources) && !system(*cc, *flags, *sources, '-o', binary.to_s, chdir: root.to_s)
        failed << "#{test} (build)"
        next
      end
      failed << test unless system(binary.to_s, chdir: root.to_s, out: File::NULL)
    end
  end
end
workers.each(&:join)
failed = Array.new(failed.size) { failed.pop }.sort
abort "asan: failed: #{failed.join(', ')}" unless failed.empty?
puts "asan: #{WITH_RUNTIME.size + STANDALONE.size} core tests pass under AddressSanitizer and UBSan"
