#!/usr/bin/env ruby
#MISE description="W3C SCXML IRP through the JS bindings (the Node.js addon and the wasm module), with bindings/shared's ECMAScript datamodel: every test not in tests/w3c/skip-js.txt must pass"
#MISE depends=["node:build", "web:build"]
# vim:ft=ruby

require_relative '../../core'

suite = Core.w3c_suite
Core.node_packages
%w[node web].each do |binding|
  Core.run('node', 'tests/w3c/run_js.mjs', suite, '--binding', binding, '--skip', 'tests/w3c/skip-js.txt', '--require-all')
end
