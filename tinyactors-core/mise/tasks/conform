#!/usr/bin/env ruby
#MISE description="The conformance suite (tinyactors-test) against ta-conform, core's reference implementation of its driver protocol: the protocol vectors"
#MISE depends=["build"]
# vim:ft=ruby

# Each run is `mise run //tinyactors-test:run -- <ta-conform> <options>`
# (../tinyactors-test/README.md); every case of it must pass. The runs go
# side by side; a run's report is printed when it fails, else its summary.

require_relative '../core'
require 'open3'

conform = Core.program_path('dev', 'ta-conform').to_s
runs = {
  'protocol' => %w[--suite protocol]
}

failed = []
lock = Mutex.new
Core.in_parallel(runs.to_a) do |name, options|
  output, status = Open3.capture2e('mise', 'run', '//tinyactors-test:run', '--', conform, *options,
                                   chdir: Core::ROOT.to_s)
  lock.synchronize do
    summary = output.lines.grep(/\A(protocol|scenarios|w3c): \d+ pass/).map(&:strip).join('; ')
    next puts("ok   conform #{name}: #{summary}") if status.success?

    failed << name
    puts "FAIL conform #{name} (#{options.join(' ')})", output.lines.reject { |line| line.start_with?('pass ') }.last(60).join
  end
end
abort "tinyactors-core: the suite failed against ta-conform: #{failed.sort.join(', ')}" unless failed.empty?
