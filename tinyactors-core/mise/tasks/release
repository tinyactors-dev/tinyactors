#!/usr/bin/env ruby
#MISE description="Release libtinyactors, libtinyactors_runtime and libtinyactors_datamodel_ecmascript: check, version, build every target with zig cc, verify, pack; with --publish, also tag and create the GitHub release"
#USAGE arg "<version>" help="The version to release, MAJOR.MINOR.PATCH"
#USAGE flag "--publish" help="Commit the version, tag tinyactors-core/v<version>, push, and create the GitHub release"
#USAGE flag "--skip-containers" help="Leave out the Linux container smoke tests (no Docker)"
#USAGE flag "--skip-tests" help="Leave core's test task out of the checks, for a commit whose tests passed already; every build, symbol check, packed test, smoke test and wasm test still runs"
#USAGE flag "--build-only" help="Only build, verify and pack (no checks, no version set, nothing committed): a look at the packaging before a release"
# vim:ft=ruby

# mise run release -- 0.2.0                    check, build, verify, pack; publishes nothing
# mise run release -- 0.2.0 --publish          the same, then tag tinyactors-core/v0.2.0 and release
# mise run release -- 0.2.0 --skip-containers  no Linux container smoke tests (no Docker)
# mise run release -- 0.2.0 --build-only       only build, verify and pack: no checks, nothing versioned
# mise run release -- 0.2.0 --skip-tests       the release without core's test task, which passed already
#
# The libraries of Core::LIBRARIES are released together, under one tag and
# version (root ADR 0001, decisions 19 and 20). Each ships its header, its
# amalgamation (with its platform amalgamations) and API description in a
# source tarball, a static and a shared library for each native release
# target, and a wasm module for browsers that imports nothing. libtinyactors
# is the freestanding core and host; libtinyactors_runtime (the compiler and
# the runtime conveniences) and libtinyactors_datamodel_ecmascript (the
# ECMAScript data model, QuickJS inside) are built against the libtinyactors
# of the same release: their libraries leave its API undefined and their
# shared libraries name its, and their wasm modules hold it. The stages are in mise/lib/c_release/build.rb;
# this file only describes the libraries. The assets land in
# build/release/<version>/assets/.

require_relative '../core'

argv = [ENV['usage_version'], *ARGV].compact.uniq
argv << '--publish' if ENV['usage_publish'] == 'true'
argv << '--skip-containers' if ENV['usage_skip_containers'] == 'true'
argv << '--build-only' if ENV['usage_build_only'] == 'true'
argv = argv.reject(&:empty?).uniq
skip_tests = !argv.delete('--skip-tests').nil? | (ENV['usage_skip_tests'] == 'true')
puts "release: --skip-tests: core's test task does not run" if skip_tests
core = Core.release_project(Core.library('tinyactors'))
runtime = Core.release_project(Core.library('tinyactors_runtime'))
ecmascript = Core.release_project(Core.library('tinyactors_datamodel_ecmascript'))
tests_dir = Core::ROOT.join('tests')

# A smoke program, as a test against the packed libraries of this machine's
# target, beside its run in the Linux containers.
smoke = ->(name, *libraries) { ["#{name}_smoke", ['-I', Core::DIST, tests_dir.join("release/#{name}_smoke.c"), *libraries], []] }

# The test programs that use the public headers alone (and the test data
# model, which does too) run against the packed libraries of this machine's
# target: built by `mise run build --release`, linked with the packed
# libtinyactors_runtime and libtinyactors.
PACKED_TESTS = %w[test_runtime test_e2e].freeze
tests = PACKED_TESTS.map do |name|
  program = Core::PROGRAMS.find { |candidate| candidate.name == name }
  FileUtils.mkdir_p(Core.directory('release').join('scratch', name))
  objects = program.sources.map { |source| Core.directory('release').join('objects', name, "#{File.basename(source, '.c')}.o") }
  [name, [*objects, Core.archive_path('release', 'test_datamodel'), '-lm'], program.arguments || []]
end

# The C library functions a library calls: each has the same name and
# signature in glibc and musl, so a Linux library that links no C library
# binds to either (decision 10), and libSystem has them on macOS, where
# Darwin's clang also calls bzero and the fortified __memcpy_chk.
RUNTIME_LIBC = %w[calloc clock_gettime fclose fopen fread free fseek ftell malloc memmove qsort realloc snprintf strchr
                  strcmp strlen strncmp vsnprintf].freeze
DARWIN = %w[bzero __memcpy_chk].freeze
libc = lambda do |list, linux_only: [], darwin_only: []|
  ->(target) { target.format.links_libc ? list + DARWIN + darwin_only : list + linux_only }
end

CRelease.release(
  libraries: [
    CRelease::Library.new(
      project: core, tests: [smoke.call('tinyactors')], smoke: tests_dir.join('release/tinyactors_smoke.c'),
      sources: [core.header, core.amalgamation, core.platform_amalgamation('wasm'), core.api],
      wasm_test: ->(wasm) { ['node', tests_dir.join('wasm/release_test.mjs'), wasm, core.api] }
    ),
    CRelease::Library.new(
      project: runtime, uses: %w[tinyactors], tests: tests, smoke: tests_dir.join('release/tinyactors_runtime_smoke.c'),
      sources: [runtime.header, runtime.amalgamation, runtime.platform_amalgamation('hosted'),
                runtime.platform_amalgamation('wasm'), runtime.api],
      wasm_test: ->(wasm) { ['node', tests_dir.join('wasm/release_test.mjs'), wasm, core.api, runtime.api] },
      libc_imports: libc.call(RUNTIME_LIBC)
    ),
    CRelease::Library.new(
      project: ecmascript, uses: %w[tinyactors], tests: [smoke.call('tinyactors_datamodel_ecmascript', '-lm')],
      smoke: tests_dir.join('release/tinyactors_datamodel_ecmascript_smoke.c'),
      sources: [ecmascript.header, ecmascript.amalgamation, ecmascript.platform_amalgamation('wasm'), ecmascript.api],
      notices: { 'LICENSE.quickjs' => Core::ROOT.join('third_party/quickjs-ng/LICENSE') },
      wasm_test: ->(wasm) { ['node', tests_dir.join('wasm/release_test.mjs'), wasm, core.api, ecmascript.api] },
      libc_imports: libc.call(Core::ECMASCRIPT_LIBC, linux_only: %w[malloc_usable_size], darwin_only: %w[malloc_size])
    )
  ],
  directory: 'tinyactors-core',
  title: "tinyactors-core #{argv.reject { |arg| arg.start_with?('--') }.first}",
  argv: argv,
  # The whole test task, once (api --check and wasm:test among it), unless
  # --skip-tests, and the release build the packed tests link.
  checks: [*(skip_tests ? [] : [%w[mise run --force test]]), %w[mise run build --release]],
  regenerate: [%w[mise run api]],
  readme: Core::ROOT.join('README.md')
)
