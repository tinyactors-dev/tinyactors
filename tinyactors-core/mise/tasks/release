#!/usr/bin/env ruby
#MISE description="Release tinyactors-core: check, version, build every target with zig cc, verify, pack; with --publish, also tag and create the GitHub release"
# vim:ft=ruby

# mise run release -- 0.1.0                    check, build, verify, pack; publishes nothing
# mise run release -- 0.1.0 --publish          the same, then tag tinyactors-core/v0.1.0 and release
# mise run release -- 0.1.0 --skip-containers  no Linux container smoke tests (no Docker)
#
# The stages and the rules they follow are in mise/lib/c_release/build.rb
# and root ADR 0001 (docs/adr/0001-packaging-and-releases.md); this file
# only describes core. The assets land in build/release/<version>/assets/.

require 'pathname'
require 'c_release'

project = CRelease::Project.new(name: 'tinyactors', prefix: 'ta')
root = project.root
argv = ARGV.dup

# Core's test programs that link the amalgamation object (build/_default's
# TESTS_WITH_RUNTIME) use the public API alone, so they link against the
# packed libraries unchanged; each runs in well under a second.
PACKED_TESTS = %w[version_test delayed_send_test null_datamodel_test session_image_test pause_test operator_test
                  trace_test inspection_test retirement_test replay_test input_log_test send_id_test].freeze

CRelease.release(
  project: project,
  directory: 'tinyactors-core',
  title: "tinyactors-core #{argv.reject { |arg| arg.start_with?('--') }.first}",
  summary: 'The first release of tinyactors-core: an SCXML statechart runtime in C for many long-lived ' \
           'actors, with no C library, no I/O, no threads and no recursion. Each release has the header and ' \
           'the amalgamation to compile yourself, prebuilt static and shared libraries for macOS (arm64) and ' \
           'Linux (x64, arm64; one build for glibc and musl), and a standalone WebAssembly module with its own ' \
           'allocator.',
  argv: argv,
  # The whole test task, once: asan, every test program, the call graph and
  # the API description (it runs against the build, which comes first).
  checks: [%w[mise run amalgamate -- --check], %w[mise run api -- --check], %w[mise run build],
           %w[mise run --force test]],
  regenerate: [%w[mise run amalgamate], %w[mise run api]],
  tests: PACKED_TESTS.map { |name| [name, root.join('build/objects', "#{name}.o"), []] },
  smoke: root.join('tests/release_smoke.c'),
  readme: root.join('README.md'),
  # The source tarball has the platform amalgamation too, so a source
  # embedder can build for wasm (decision 9).
  sources: [project.header, project.amalgamation, root.join('include/tinyactors_wasm.c'), project.api],
  extra_build: ->(targets) { [CRelease.build_wasm(project, targets)] },
  extra_verify: lambda do |builds|
    wasm = builds.find { |build| build[:wasm] }
    CRelease.verify_wasm!(project, wasm,
                          test: ->(module_path) { ['node', root.join('tests/wasm/wasm_test.js'), module_path, project.api] })
  end
)
