<?xml version="1.0"?>
<!-- An order: the shop's catalog is the app's (knows, priced); what has no
operator here is the app's too (placeable, plusLine). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="json" name="order" initial="open">
  <datamodel>
    <data id="items" expr="[]"/>
    <data id="address" expr='{"country": ""}'/>
    <data id="total" expr="0"/>
  </datamodel>
  <state id="open">
    <transition event="add" cond="knows(_event.data)">
      <assign location="items[length(items)]" expr="priced(_event.data)"/>
      <log label="added: items" expr="length(items)"/>
    </transition>
    <transition event="add">
      <log label="refused: no such item" expr="_event.data.sku"/>
    </transition>
    <transition event="address">
      <assign location="address.country" expr="_event.data.country"/>
    </transition>
    <transition event="error.*"><log label="error" expr="_event.data.message"/></transition>
    <transition event="place" cond="placeable(items, address)" target="placed">
      <foreach array="items" item="line">
        <assign location="total" expr="plusLine(total, line)"/>
      </foreach>
    </transition>
  </state>
  <final id="placed">
    <donedata>
      <param name="items" expr="items"/>
      <param name="total" expr="total"/>
      <param name="country" expr="address.country"/>
    </donedata>
  </final>
</scxml>
