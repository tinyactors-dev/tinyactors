<?xml version="1.0"?>
<!-- An order, in Go: every expression is Go, compiled with the app. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="go" name="order" initial="open">
  <datamodel>
    <data id="items" expr="[]Item{}"/>
    <data id="address" expr="Address{}"/>
    <data id="total" expr="0"/>
    <data id="line" expr="Item{}"/>
  </datamodel>
  <state id="open">
    <transition event="add" cond="catalog.knows(_event.Data)">
      <assign location="items" expr="append(items, catalog.item(_event.Data))"/>
      <log label="added" expr='fmt.Sprintf("%d items", len(items))'/>
    </transition>
    <transition event="add">
      <log label="refused" expr='"no such item: " + _event.Data.String()'/>
    </transition>
    <transition event="address">
      <assign location="address.Country" expr='_event.Data.Get("country")'/>
    </transition>
    <transition event="place" cond='len(items) > 0 &amp;&amp; address.Country != ""' target="placed">
      <foreach array="items" item="line">
        <assign location="total" expr="total + line.Cents*line.Quantity"/>
      </foreach>
    </transition>
  </state>
  <final id="placed">
    <donedata>
      <param name="items" expr="items"/>
      <param name="total" expr="total"/>
      <param name="country" expr="address.Country"/>
    </donedata>
  </final>
</scxml>
