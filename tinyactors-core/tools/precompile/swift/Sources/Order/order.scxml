<?xml version="1.0"?>
<!-- An order, in Swift: every expression is Swift, compiled with the app. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="swift" name="order" initial="open">
  <datamodel>
    <data id="items" expr="[Item]()"/>
    <data id="address" expr="Address()"/>
    <data id="total" expr="0"/>
    <data id="line" expr="Item.none"/>
  </datamodel>
  <state id="open">
    <transition event="add" cond="catalog.knows(_event.data)">
      <assign location="items" expr="items + [try catalog.item(_event.data)]"/>
      <log label="added" expr='"\(items.count) items"'/>
    </transition>
    <transition event="add">
      <log label="refused" expr='"no such item: \(_event.data)"'/>
    </transition>
    <transition event="address">
      <assign location="address.country" expr="_event.data.country"/>
    </transition>
    <transition event="place" cond="!items.isEmpty &amp;&amp; !address.country.isEmpty" target="placed">
      <foreach array="items" item="line">
        <assign location="total" expr="total + line.cents * line.quantity"/>
      </foreach>
    </transition>
  </state>
  <final id="placed">
    <donedata>
      <param name="items" expr="items"/>
      <param name="total" expr="total"/>
      <param name="country" expr="address.country"/>
    </donedata>
  </final>
</scxml>
