{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "type": "object",
  "required": ["id", "customer", "items", "placed"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "placed": { "type": "string", "format": "date-time" },
    "channel": { "enum": ["web", "store", "phone", "partner"], "x-weights": [6, 3, 1, 1] },
    "customer": {
      "type": "object",
      "required": ["id", "tier"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "email": { "type": "string", "format": "email" },
        "tier": { "enum": ["free", "plus", "pro"], "x-weights": [7, 2, 1] }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["sku", "qty"],
        "properties": {
          "sku": { "type": "integer", "minimum": 0, "maximum": 19999 },
          "qty": { "type": "integer", "minimum": 1, "maximum": 12 },
          "note": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "shipping": {
      "type": "object",
      "properties": {
        "method": { "enum": ["standard", "express", "pickup"] },
        "address": { "type": "string", "minLength": 20, "maxLength": 80 }
      }
    }
  }
}
