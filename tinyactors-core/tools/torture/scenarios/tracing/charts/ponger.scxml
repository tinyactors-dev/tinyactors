<!-- Answers every ping to whoever sent it. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript"
       name="ponger" initial="ready">
  <state id="ready">
    <transition event="ping">
      <send event="pong" targetexpr="_event.origin"/>
    </transition>
  </state>
</scxml>
