<?xml version="1.0" encoding="UTF-8"?>
<!-- An issue: its lifecycle and its occurrences.

     open (new -> triaged) -> fixed (settled <-> checking) -> closed,
     or wontfix, or a duplicate of another. A commit whose trailer says
     "Fixes-issue: tinyactors:<project>:<n>" fixes it, in any repository; a later report from a commit is checked
     against the fix with GitHub's compare: a commit that contains the fix
     means the issue regressed, an older one is told to update. Fixed
     for 14 days with no new report, it closes itself.

     Every change is written before it is answered: the catalog processor
     appends it to the ledger and applies it to the catalog (every issue
     in full: its title, body, reports, workaround, files) in one
     transaction; the answer waits in answers, keyed by that send's
     sendid. The actor keeps only what its decisions need: its state, its
     title (for its reporters' news), how many reports it has, who
     reported it, its fix, why it was declined, and its files' keys. Readers
     read the catalog, which wakes no actor. A change of state goes to the
     project's index, and the reporters' users hear of a fix, a regression
     or a workaround.

     Spawned with `restored` (a rebuild from the catalog, after a lost
     snapshot), it starts where the catalog says it is, writing nothing.

     A maintainer may delete it (spam, a test report): deleting writes who,
     why and its title to the ledger, then answers, deletes its
     attachments' blobs, cancels the uploads in flight, tells its project
     and ends. Its reporters are not told. A delete the ledger refuses
     answers failed and puts it back where it was (a deep history). -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="issue" initial="issue">
  <script src="issue.js"/>
  <datamodel>
    <data id="repoID"/>  <data id="slug"/>  <data id="n"/>   <!-- given at spawn: answers name the issue by
                                                               its identifier; the gateway adds the repository's current name -->
    <data id="report"/>  <data id="asker"/>  <data id="similar"/> <!-- given at spawn: the first report, dropped once written -->
    <data id="possible"/>                <!-- given at spawn: {n, p}, a duplicate the model was unsure of -->
    <data id="restored" expr="null"/>    <!-- given at spawn by a rebuild: the subset the catalog keeps for it -->
    <data id="title"/>                   <!-- for its reporters' news -->
    <data id="count" expr="0"/>          <!-- for the answers that say how many reports it has -->
    <data id="reporters" expr="[]"/>     <!-- githubIDs: whom to tell, who may read its files -->
    <data id="reason" expr="null"/>      <!-- why it was declined, for the answers -->
    <data id="fix" expr="null"/>         <!-- {sha, url, repoID}: the commit, in the repository it is in -->
    <data id="pending" expr="null"/>     <!-- the report a compare is checking -->
    <data id="answers" expr="({})"/>     <!-- ledger sendid -> {to, event, data} -->
    <data id="lsid"/>
    <data id="item"/>
    <data id="state" expr="'new'"/>      <!-- the index's name for where it is -->
    <data id="files" expr="({})"/>       <!-- upload -> its key in the blob store; the descriptions are the catalog's -->
    <data id="uploading" expr="({})"/>   <!-- uploadID -> true, while its upload actor runs -->
    <data id="uploads" expr="0"/>        <!-- the last upload's number -->
    <data id="purged" expr="false"/>
    <data id="deletion" expr="null"/>    <!-- {sid, to, by, reason}: the delete being written -->
  </datamodel>

  <state id="issue" initial="boot">
    <history id="was" type="deep"><transition target="open"/></history>  <!-- where a refused delete returns -->
    <!-- a maintainer's delete (the project checked who): written first -->
    <transition event="issue.delete" target="deleting">
      <send type="catalog" event="ledger.append" idlocation="lsid">
        <content expr="record('deleted', repoID, slug, n, { by: _event.data.caller.login, reason: _event.data.reason || null, title: title })"/>
      </send>
      <assign location="deletion" expr="({ sid: lsid, to: replyTo(_event), by: _event.data.caller.login })"/>
    </transition>
    <!-- a new issue, or one a rebuild restores where the catalog says it is -->
    <state id="boot">
      <onentry>
        <if cond="restored">
          <assign location="title" expr="restored.title"/>
          <assign location="count" expr="restored.count"/>
          <assign location="reporters" expr="restored.reporters"/>
          <assign location="reason" expr="restored.reason"/>
          <assign location="fix" expr="restored.fix"/>
          <assign location="files" expr="restored.files"/>
          <assign location="purged" expr="restored.purged"/>
        </if>
      </onentry>
      <transition cond="!restored" target="starting"/>
      <transition cond="restored.state === 'triaged'" target="triaged"/>
      <transition cond="restored.state === 'regressed'" target="regressed"/>
      <transition cond="restored.state === 'fixed'" target="fixed"/>
      <transition cond="restored.state === 'closed'" target="closed"/>
      <transition cond="restored.state === 'wontfix'" target="wontfix"/>
      <transition target="new"/>
    </state>
    <!-- the first report, written, then answered -->
    <state id="starting">
      <onentry>
        <assign location="title" expr="report.title"/>
        <assign location="count" expr="1"/>
        <assign location="reporters" expr="report.reporter ? [report.reporter.githubID] : []"/>
        <send type="catalog" event="ledger.append" idlocation="lsid">
          <content expr="record('filed', repoID, slug, n, Object.assign({}, report, { possibleDuplicateOf: possible }))"/>
        </send>
        <assign location="answers" expr="put(answers, lsid, { to: asker, event: 'filed',
                 data: { id: issueID(slug, n), n: n, similar: similar, possibleDuplicateOf: possible } })"/>
        <assign location="report" expr="null"/>
        <assign location="similar" expr="null"/>
      </onentry>
      <transition target="new"/>
    </state>

    <state id="open" initial="new">
      <state id="new">
        <onentry><assign location="state" expr="'new'"/><raise event="changed"/></onentry>
        <transition event="triage" target="triaged">
          <assign location="title" expr="_event.data.title || title"/>
          <send type="catalog" event="ledger.append" idlocation="lsid">
            <content expr="record('triaged', repoID, slug, n, _event.data)"/>
          </send>
          <assign location="answers" expr="put(answers, lsid, answer(_event, 'triaged', { id: issueID(slug, n) }))"/>
        </transition>
      </state>
      <state id="triaged"><onentry><assign location="state" expr="'triaged'"/><raise event="changed"/></onentry></state>
      <state id="regressed"><onentry><assign location="state" expr="'regressed'"/><raise event="changed"/></onentry></state>

      <!-- the answer's workaround is the catalog's: the gateway reads it, after the write -->
      <transition event="report">
        <assign location="count" expr="count + 1"/>
        <assign location="reporters" expr="withReporter(reporters, _event.data)"/>
        <send type="catalog" event="ledger.append" idlocation="lsid">
          <content expr="record('counted', repoID, slug, n, occurrence(_event.data))"/>
        </send>
        <assign location="answers" expr="put(answers, lsid, answer(_event, 'counted',
                 { id: issueID(slug, n), n: n, count: count, workaround: null, matchedBy: _event.data.matchedBy || null }))"/>
      </transition>
      <transition event="fixed" target="fixed">
        <assign location="fix" expr="({ sha: _event.data.sha, url: _event.data.url, repoID: _event.data.repoID })"/>
        <send type="catalog" event="ledger.append"><content expr="record('fixed', repoID, slug, n, fix)"/></send>
        <foreach array="reporters" item="item">
          <send targetexpr="addr('user.' + item)" event="user.update">
            <content expr="({ id: issueID(slug, n), n: n, title: title, state: 'fixed', sha: fix.sha })"/>
          </send>
        </foreach>
      </transition>
      <transition event="wontfix" target="wontfix">
        <assign location="reason" expr="_event.data.reason"/>
        <send type="catalog" event="ledger.append" idlocation="lsid">
          <content expr="record('wontfix', repoID, slug, n, _event.data)"/>
        </send>
        <assign location="answers" expr="put(answers, lsid, answer(_event, 'wontfix', { id: issueID(slug, n) }))"/>
      </transition>
    </state>

    <state id="fixed" initial="settled">
      <state id="settled">
        <onentry>
          <assign location="state" expr="'fixed'"/><raise event="changed"/>
          <send event="autoclose" id="autoclose" delay="1209600s"/>
        </onentry>  <!-- 14 days -->
        <onexit><cancel sendid="autoclose"/></onexit>
        <transition event="report" cond="_event.data.commit" target="checking">
          <assign location="pending" expr="_event.data"/>
          <assign location="pending" expr="Object.assign({}, pending, { replyTo: replyTo(_event) })"/>
          <send type="github" event="compare" id="compare">
            <param name="repoID" expr="fix.repoID"/>
            <param name="base" expr="fix.sha"/>
            <param name="head" expr="_event.data.commit"/>
          </send>
        </transition>
        <transition event="report">
          <send targetexpr="replyTo(_event)" event="fixed">
            <param name="id" expr="issueID(slug, n)"/><param name="n" expr="n"/>
            <param name="sha" expr="fix.sha"/><param name="checked" expr="false"/>
          </send>
        </transition>
        <transition event="autoclose" target="closed">
          <send type="catalog" event="ledger.append"><content expr="record('closed', repoID, slug, n, { by: 'autoclose' })"/></send>
        </transition>
      </state>
      <state id="checking">
        <onentry><send event="compare.timeout" id="compare-timeout" delay="10s"/></onentry>
        <onexit><cancel sendid="compare-timeout"/></onexit>
        <!-- the reporter's commit contains the fix: it came back -->
        <transition event="compared" cond="_event.data.status === 'ahead' || _event.data.status === 'identical'" target="regressed">
          <assign location="count" expr="count + 1"/>
          <assign location="reporters" expr="withReporter(reporters, pending)"/>
          <send type="catalog" event="ledger.append" idlocation="lsid">
            <content expr="record('regressed', repoID, slug, n, occurrence(pending))"/>
          </send>
          <assign location="answers" expr="put(answers, lsid, { to: pending.replyTo, event: 'regressed',
                   data: { id: issueID(slug, n), n: n, fix: fix.sha, commit: pending.commit } })"/>
          <foreach array="reporters" item="item">
            <send targetexpr="addr('user.' + item)" event="user.update">
              <content expr="({ id: issueID(slug, n), n: n, title: title, state: 'regressed', sha: pending.commit })"/>
            </send>
          </foreach>
        </transition>
        <!-- an older commit: the fix is not in it yet -->
        <transition event="compared" target="settled">
          <send targetexpr="pending.replyTo" event="fixed">
            <param name="id" expr="issueID(slug, n)"/><param name="n" expr="n"/>
            <param name="sha" expr="fix.sha"/><param name="checked" expr="true"/>
            <param name="advice" expr="'your commit ' + pending.commit + ' predates the fix: update your checkout'"/>
          </send>
        </transition>
        <transition event="compare.timeout github.unavailable error.communication" target="settled">
          <send targetexpr="pending.replyTo" event="fixed">
            <param name="id" expr="issueID(slug, n)"/><param name="n" expr="n"/>
            <param name="sha" expr="fix.sha"/><param name="checked" expr="false"/>
          </send>
        </transition>
      </state>
      <transition event="fixed">  <!-- a second commit mentioning it: the newest fix counts -->
        <assign location="fix" expr="({ sha: _event.data.sha, url: _event.data.url, repoID: _event.data.repoID })"/>
        <send type="catalog" event="ledger.append"><content expr="record('fixed', repoID, slug, n, fix)"/></send>
      </transition>
      <transition event="close" target="closed">
        <send type="catalog" event="ledger.append" idlocation="lsid">
          <content expr="record('closed', repoID, slug, n, _event.data)"/>
        </send>
        <assign location="answers" expr="put(answers, lsid, answer(_event, 'closed', { id: issueID(slug, n) }))"/>
      </transition>
    </state>

    <state id="closed">
      <onentry>
        <assign location="state" expr="'closed'"/><raise event="changed"/>
        <send event="purge" id="purge" delay="7776000s"/>   <!-- 90 days: the attachments' bytes go -->
      </onentry>
      <onexit><cancel sendid="purge"/></onexit>
      <transition event="report">
        <assign location="count" expr="count + 1"/>
        <send type="catalog" event="ledger.append"><content expr="record('counted', repoID, slug, n, occurrence(_event.data))"/></send>
        <send targetexpr="replyTo(_event)" event="counted">
          <param name="id" expr="issueID(slug, n)"/><param name="n" expr="n"/><param name="count" expr="count"/>
          <param name="state" expr="'closed'"/><param name="fix" expr="fix"/>
        </send>
      </transition>
    </state>
    <state id="wontfix">
      <onentry>
        <assign location="state" expr="'wontfix'"/><raise event="changed"/>
        <send event="purge" id="purge" delay="7776000s"/>
      </onentry>
      <onexit><cancel sendid="purge"/></onexit>
      <transition event="report">
        <assign location="count" expr="count + 1"/>
        <send type="catalog" event="ledger.append"><content expr="record('counted', repoID, slug, n, occurrence(_event.data))"/></send>
        <send targetexpr="replyTo(_event)" event="counted">
          <param name="id" expr="issueID(slug, n)"/><param name="n" expr="n"/><param name="count" expr="count"/>
          <param name="state" expr="'wontfix'"/><param name="reason" expr="reason"/>
        </send>
      </transition>
    </state>

    <!-- in every state -->
    <transition event="workaround">
      <send type="catalog" event="ledger.append" idlocation="lsid">
        <content expr="record('workaround', repoID, slug, n, { text: _event.data.text, by: _event.data.caller.login })"/>
      </send>
      <assign location="answers" expr="put(answers, lsid, answer(_event, 'noted', { id: issueID(slug, n) }))"/>
      <foreach array="reporters" item="item">
        <send targetexpr="addr('user.' + item)" event="user.update">
          <content expr="({ id: issueID(slug, n), n: n, title: title, state: 'workaround', text: _event.data.text })"/>
        </send>
      </foreach>
    </transition>
    <!-- a maintainer's action in a state that does not take it: refused, never left unanswered -->
    <transition event="triage">
      <send targetexpr="replyTo(_event)" event="refused">
        <param name="reason" expr="issueID(slug, n) + ' is ' + state + ': only a new issue is triaged'"/>
      </send>
    </transition>
    <transition event="close">
      <send targetexpr="replyTo(_event)" event="refused">
        <param name="reason" expr="issueID(slug, n) + ' is ' + state + ': only a fixed issue is closed; decline an open one with wontfix'"/>
      </send>
    </transition>
    <transition event="wontfix">
      <send targetexpr="replyTo(_event)" event="refused">
        <param name="reason" expr="issueID(slug, n) + ' is ' + state + ': only an open issue is declined'"/>
      </send>
    </transition>
    <!-- attachments: a slot for a reporter or a maintainer, the bytes by the gateway, the check by the upload -->
    <transition event="attach.open" cond="!mayRead(_event.data.caller, reporters, repoID)">
      <send targetexpr="replyTo(_event)" event="refused">
        <param name="reason" expr="'only the reporters of ' + issueID(slug, n) + ' and its maintainers may attach to it'"/>
      </send>
    </transition>
    <transition event="attach.open" cond="Object.keys(files).length + Object.keys(uploading).length >= 10">
      <send targetexpr="replyTo(_event)" event="refused"><param name="reason" expr="'an issue holds at most 10 attachments'"/></send>
    </transition>
    <transition event="attach.open" cond="_event.data.caller.quota.files &lt;= 0 || _event.data.size > _event.data.caller.quota.bytes">
      <send targetexpr="replyTo(_event)" event="refused"><param name="reason" expr="'over your quota for today'"/></send>
    </transition>
    <transition event="attach.open">
      <assign location="uploads" expr="uploads + 1"/>
      <send type="spawn" event="upload" idlocation="lsid">
        <content expr="({ chart: 'upload', name: 'upload.' + repoID + '.' + n + '.' + uploads,
                          params: { uploadID: repoID + '.' + n + '.' + uploads, issue: addr('issue.' + repoID + '.' + n),
                                    issueKey: slug + '/' + n, issueRef: issueID(slug, n), asker: replyTo(_event),
                                    file: { name: _event.data.name, type: _event.data.type, size: _event.data.size, sha256: _event.data.sha256 },
                                    uploader: { githubID: _event.data.caller.githubID, login: _event.data.caller.login } } })"/>
      </send>
      <assign location="uploading" expr="put(uploading, repoID + '.' + n + '.' + uploads, true)"/>
      <assign location="answers" expr="put(answers, lsid, answer(_event, 'refused', { reason: 'the upload could not start' }))"/>
    </transition>
    <transition event="spawned" cond="has(answers, _event.sendid)">
      <assign location="answers" expr="drop(answers, _event.sendid)"/>  <!-- the upload answers for itself -->
    </transition>
    <transition event="attachment.added">
      <assign location="files" expr="put(files, _event.data.upload, _event.data.key)"/>
      <assign location="uploading" expr="drop(uploading, _event.data.upload)"/>
      <send type="catalog" event="ledger.append"><content expr="record('attached', repoID, slug, n, _event.data)"/></send>
      <foreach array="reporters" item="item">
        <if cond="item !== _event.data.byID">
          <send targetexpr="addr('user.' + item)" event="user.update">
            <content expr="({ id: issueID(slug, n), title: title, state: 'attachment', file: _event.data.name, by: _event.data.by })"/>
          </send>
        </if>
      </foreach>
    </transition>
    <transition event="upload.ended">
      <assign location="uploading" expr="drop(uploading, _event.data.uploadID)"/>
    </transition>
    <!-- a download: a signed link, for whoever may read them -->
    <transition event="attachment.get" cond="!mayRead(_event.data.caller, reporters, repoID)">
      <send targetexpr="replyTo(_event)" event="refused"><param name="reason" expr="'only its reporters and maintainers read its attachments'"/></send>
    </transition>
    <transition event="attachment.get" cond="purged || !has(files, _event.data.upload)">
      <send targetexpr="replyTo(_event)" event="refused"><param name="reason" expr="purged ? 'its attachments were deleted 90 days after it closed' : 'no such attachment'"/></send>
    </transition>
    <!-- the link; the file's description is the catalog's, which the gateway adds -->
    <transition event="attachment.get">
      <send type="blobs" event="blob.sign" idlocation="lsid">
        <param name="key" expr="files[_event.data.upload]"/>
      </send>
      <assign location="answers" expr="put(answers, lsid, answer(_event, 'attachment', { upload: _event.data.upload }))"/>
    </transition>
    <transition event="blob.signed" cond="has(answers, _event.sendid)">
      <send targetexpr="answers[_event.sendid].to" event="attachment">
        <content expr="Object.assign({}, answers[_event.sendid].data, { url: _event.data.url, expiresIn: _event.data.expiresIn })"/>
      </send>
      <assign location="answers" expr="drop(answers, _event.sendid)"/>
    </transition>
    <!-- 90 days after closing: the bytes go, the descriptions stay -->
    <transition event="purge">
      <foreach array="Object.keys(files)" item="item">
        <send type="blobs" event="blob.delete"><param name="key" expr="files[item]"/></send>
      </foreach>
      <assign location="purged" expr="true"/>
      <send type="catalog" event="ledger.append"><content expr="record('purged', repoID, slug, n, { files: Object.keys(files).length })"/></send>
    </transition>

    <!-- the change is written: its answer goes now (when it was filed and last
         changed are the catalog's, from the ledger's times) -->
    <transition event="ledger.written" cond="has(answers, _event.sendid)">
      <send targetexpr="answers[_event.sendid].to" eventexpr="answers[_event.sendid].event">
        <content expr="answers[_event.sendid].data"/>
      </send>
      <assign location="answers" expr="drop(answers, _event.sendid)"/>
    </transition>
    <transition event="error.communication" cond="has(answers, _event.sendid)">
      <send targetexpr="answers[_event.sendid].to" event="failed">
        <param name="reason" expr="'the change could not be written'"/>
      </send>
      <assign location="answers" expr="drop(answers, _event.sendid)"/>
    </transition>
    <!-- after a change of state, the project's index follows -->
    <transition event="changed">
      <send targetexpr="addr('project.' + repoID)" event="issue.changed">
        <param name="n" expr="n"/><param name="state" expr="state"/>
      </send>
    </transition>
  </state>

  <!-- the delete, written: answered, its files and uploads gone, its project told; then it ends -->
  <state id="deleting">
    <transition event="ledger.written" cond="_event.sendid === deletion.sid" target="deleted">
      <send targetexpr="deletion.to" event="deleted"><param name="id" expr="issueID(slug, n)"/></send>
      <foreach array="Object.keys(files)" item="item">
        <send type="blobs" event="blob.delete"><param name="key" expr="files[item]"/></send>
      </foreach>
      <foreach array="Object.keys(uploading)" item="item">
        <send targetexpr="addr('upload.' + item)" event="issue.deleted"/>
      </foreach>
      <send targetexpr="addr('project.' + repoID)" event="issue.deleted"><param name="n" expr="n"/></send>
    </transition>
    <transition event="error.communication" cond="_event.sendid === deletion.sid" target="was">
      <send targetexpr="deletion.to" event="failed"><param name="reason" expr="'the delete could not be written'"/></send>
      <send targetexpr="addr('project.' + repoID)" event="issue.undeleted"><param name="n" expr="n"/></send>
      <assign location="deletion" expr="null"/>
    </transition>
    <!-- what was already on its way to it: refused, never answered by an issue that is going -->
    <transition event="report workaround triage close wontfix attach.open attachment.get issue.delete">
      <send targetexpr="replyTo(_event)" event="refused"><param name="reason" expr="issueID(slug, n) + ' is being deleted'"/></send>
    </transition>
  </state>
  <final id="deleted">
    <donedata><content expr="({ deleted: issueID(slug, n), by: deletion.by })"/></donedata>
  </final>
</scxml>
