#!/usr/bin/env ruby
#MISE description="The restore drill on ta-mcp: the newest backup fetched, verified, decrypted, each database's integrity and row counts checked, into a directory deleted after"
# vim:ft=ruby

require_relative '../../support'

Support.secrets!
puts Support.vm(<<~BASH, timeout: 600)
  set -euo pipefail
  set -a; . #{Support::HOME}/support/env; set +a
  cd #{Support::HOME}/support/current && NODE_NO_WARNINGS=1 /opt/node/bin/node tools/backup.mjs drill
BASH
