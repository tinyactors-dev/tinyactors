#!/usr/bin/env ruby
#MISE description="Write the server's environment on ta-mcp: PUBLIC_URL, and the GitHub App's fields and TypeSafe's key for Jev and the backups' bucket and key from 1Password when they are there (without them the server runs on the stand-ins, and the daily backup does nothing); restarts the service and enables the backup timer when the backups are configured"
#USAGE flag "--standin" help="Leave the GitHub App out: the server runs on the stand-in GitHub and login"
# vim:ft=ruby

require_relative '../support'

Support.secrets!
fields = { 'PUBLIC_URL' => ENV.fetch('SUPPORT_PUBLIC_URL', Support::PUBLIC_URL), 'GITHUB_ORG' => 'tinyactors-dev' }
%w[GITHUB_APP_ID GITHUB_APP_CLIENT_ID GITHUB_APP_CLIENT_SECRET GITHUB_APP_PRIVATE_KEY TYPESAFE_API_KEY
   BACKUP_S3_ENDPOINT BACKUP_S3_BUCKET BACKUP_S3_ACCESS_KEY_ID BACKUP_S3_SECRET_ACCESS_KEY BACKUP_KEY].each do |key|
  fields[key] = ENV[key] if ENV[key].to_s != ''
end
standin = ENV['usage_standin'] == 'true' || fields.keys.count { |k| k.start_with?('GITHUB_APP_') } != 4
fields.delete_if { |key, _| key.start_with?('GITHUB_APP_') } if standin
# the backups go all together or not at all
backups = Support::BACKUP_FIELDS.all? { |k| fields.key?(k) }
fields.delete_if { |key, _| Support::BACKUP_FIELDS.include?(key) } unless backups
puts Support.vm(Support.env_script(fields) + Support.backup_timer_script(backups))
