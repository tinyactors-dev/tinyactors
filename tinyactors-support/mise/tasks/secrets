#!/usr/bin/env ruby
#MISE description="Write the server's environment on ta-mcp: PUBLIC_URL, and the GitHub App's fields and the OpenRouter key from 1Password when they are there (without them the server runs on the stand-ins); restarts the service"
#USAGE flag "--standin" help="Leave the GitHub App out: the server runs on the stand-in GitHub and login"
# vim:ft=ruby

require_relative '../support'

Support.secrets!
fields = { 'PUBLIC_URL' => ENV.fetch('SUPPORT_PUBLIC_URL', Support::PUBLIC_URL), 'GITHUB_ORG' => 'tinyactors-dev' }
%w[GITHUB_APP_ID GITHUB_APP_CLIENT_ID GITHUB_APP_CLIENT_SECRET GITHUB_APP_PRIVATE_KEY OPENROUTER_API_KEY].each do |key|
  fields[key] = ENV[key] if ENV[key].to_s != ''
end
standin = ENV['usage_standin'] == 'true' || fields.keys.count { |k| k.start_with?('GITHUB_APP_') } != 4
fields.delete_if { |key, _| key.start_with?('GITHUB_APP_') } if standin
puts Support.vm(Support.env_script(fields))
