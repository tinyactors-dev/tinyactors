<<<cmd
set -e
bash amalgamate.sh >/dev/null 2>&1
a=dist/amalgamation
cc -shared -fPIC -fvisibility=hidden -I"$a" "$a/pocketparse.c" -o "$a/libpocketparse.so"
nm -D --defined-only "$a/libpocketparse.so" | grep -q ' pocketparse_open'
nm -D --defined-only "$a/libpocketparse.so" | grep -q ' ax_' && exit 1
exit 0
<<<assert
exit 0
