# The library depends on nothing. The dist ships no foreign archive, and the
# static library's only undefined references are the freestanding C memory
# primitives a compiler may emit (memcpy/memset/memmove/memcmp): no allocator,
# no I/O, no actor runtime. Neither the archive nor the CLI defines a symbol of
# the actor runtime tinyparse was born in (an `ax_` prefix).
<<<cmd
set -e
d=dist/x86_64-linux
w="$(mktemp -d)"
trap 'rm -rf "$w"' EXIT
test -f "$d/lib/libtinyparse.a"
test ! -e "$d/lib/libax.a"
test ! -e "$d/.consumes-ax"
"$TP_NM" -u "$d/lib/libtinyparse.a" | awk 'NF == 2 { print $2 }' | sort -u > "$w/undefined"
"$TP_NM" --defined-only -g "$d/lib/libtinyparse.a" | awk 'NF == 3 { print $3 }' | sort -u > "$w/defined"
extra="$(comm -23 "$w/undefined" "$w/defined" | grep -vxE 'memcpy|memset|memmove|memcmp' || true)"
test -z "$extra" || { echo "unexpected undefined symbols: $extra"; exit 1; }
"$TP_NM" "$d/bin/tinyparse" | grep -q ' tinyparse_open$'
"$TP_NM" "$d/lib/libtinyparse.a" "$d/bin/tinyparse" 2>/dev/null | grep -qE ' [A-Za-z] ax_' && exit 1
exit 0
<<<assert
exit 0
