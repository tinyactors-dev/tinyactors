# The x86_64 Linux release tarball (`mise run release`) is a prefix tree.
<<<cmd
set -e
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
tar xzf dist/release/tinyparse-0.1.0-x86_64-linux.tar.gz -C "$d"
r="$d/tinyparse-0.1.0-x86_64-linux"
test -x "$r/bin/tinyparse"
test -f "$r/lib/libtinyparse.a"
test -f "$r/lib/libtinyparse.so"
test -f "$r/include/tinyparse.h"
test -f "$r/share/man/man1/tinyparse.1"
<<<assert
exit 0
