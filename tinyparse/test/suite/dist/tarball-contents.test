<<<cmd
set -e
bash release.sh tarballs >/dev/null 2>&1
d=$(mktemp -d)
tar xzf dist/release/tinyparse-0.1.0-linux-x86_64.tar.gz -C "$d"
r="$d/tinyparse-0.1.0-linux-x86_64"
test -x "$r/bin/tinyparse"
test -f "$r/lib/libtinyparse.a"
test -f "$r/lib/libtinyparse.so"
test -f "$r/include/tinyparse.h"
test -f "$r/share/man/man1/tinyparse.1"
<<<assert
exit 0
