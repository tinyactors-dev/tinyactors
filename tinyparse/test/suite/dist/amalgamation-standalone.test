# The amalgamation is the library alone: no foreign header ships beside it, the
# public header names nothing but tinyparse, and the single translation unit
# carries no `ax_` identifier (the actor runtime tinyparse was born in is not
# folded in any more).
<<<cmd
set -e
bash amalgamate.sh >/dev/null 2>&1
a=dist/amalgamation
test ! -f "$a/ax.h"
grep -qE 'ax\.h|ax_open|ax_sys' "$a/tinyparse.h" && exit 1
grep -qE '(^|[^A-Za-z0-9_])ax_[A-Za-z_]' "$a/tinyparse.c" && exit 1
exit 0
<<<assert
exit 0
