# install.sh installs a release tarball (`mise run release`) into a prefix,
# offline, and the installed CLI runs.
<<<cmd
set -e
pfx=$(mktemp -d)
trap 'rm -rf "$pfx"' EXIT
sh install.sh --from-file dist/release/tinyparse-0.1.0-$(uname -m | sed s/arm64/aarch64/)-$(uname | sed "s/Darwin/macos/;s/Linux/linux/").tar.gz --prefix "$pfx" >/dev/null 2>&1
test -x "$pfx/bin/tinyparse"
test -f "$pfx/include/tinyparse.h"
test -f "$pfx/lib/libtinyparse.a"
test -f "$pfx/share/man/man1/tinyparse.1"
"$pfx/bin/tinyparse" version | grep -q '0\.1\.0'
<<<assert
exit 0
