# A redirect on an if clause (POSIX §2.9.4 redirect_list): `if c; then a; fi >out`
# redirects the whole construct. The Redirect attaches to the CompoundCommand,
# after the IfClause.
<<<cmd
printf 'if c; then a; fi >out\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains CompoundCommand
out-contains IfClause
out-count 1 redirect: Redirect
