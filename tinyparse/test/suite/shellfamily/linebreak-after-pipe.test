# A linebreak is permitted after "|": `a |\n b` is a single pipeline spanning
# two lines, not two separate commands. It parses with no recovery nodes.
<<<cmd
printf 'a |\n b\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 1 Pipeline
out-count 2 command: SimpleCommand
