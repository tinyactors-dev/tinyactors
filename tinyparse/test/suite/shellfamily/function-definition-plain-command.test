# A bare word with no `()` is NOT a function definition: `foo` is a plain
# SimpleCommand. FunctionDefinition backtracks (no `( )` after the name) and the
# Command choice falls through to SimpleCommand.
<<<cmd
printf 'foo\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains SimpleCommand
out-absent FunctionDefinition
