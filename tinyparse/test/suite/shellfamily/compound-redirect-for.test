# A redirect on a for clause: `for i in x; do a; done >out`. The Redirect
# attaches to the CompoundCommand, after the ForClause.
<<<cmd
printf 'for i in x; do a; done >out\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains CompoundCommand
out-contains ForClause
out-count 1 redirect: Redirect
