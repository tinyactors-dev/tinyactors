# Positional and special parameters (POSIX §2.5): $1 (positional) and $@ $# $?
# (special) each parse as a SimpleExpansion whose name is a SpecialParam.
<<<cmd
printf 'echo $1 $@ $# $?\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 4 SimpleExpansion
out-contains name: SpecialParam
