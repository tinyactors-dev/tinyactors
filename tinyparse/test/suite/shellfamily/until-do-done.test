# An until clause: `until list; do list; done`. Same shape as while, but the
# body runs while the condition fails.
<<<cmd
printf 'until c; do x; done\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains UntilClause
out-contains condition: CompoundList
out-contains body: CompoundList
