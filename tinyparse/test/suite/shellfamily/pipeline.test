# A pipeline joins three simple commands with "|". The tree holds one Pipeline
# with three SimpleCommand children joined by two pipe tokens.
<<<cmd
printf 'echo a | grep b | wc -l\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains Pipeline
out-count 3 command: SimpleCommand
out-count 2 |
