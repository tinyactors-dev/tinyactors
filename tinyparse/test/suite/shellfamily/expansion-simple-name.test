# A simple parameter expansion `$name` (POSIX §2.6.2): the `$` and the Name form a
# SimpleExpansion word part with a name field.
<<<cmd
printf 'echo $x\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains SimpleExpansion
out-contains name: Name
