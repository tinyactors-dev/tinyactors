# Corpus: an if/elif/else chain whose condition and clauses are pipelines. One
# IfClause holding one ElifClause and one ElseClause, in that order.
<<<cmd
"$PP" run std.shell --input test/suite/shellfamily/inputs/statements__6.sh --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 1 IfClause [
out-count 1 ElifClause [
out-count 1 ElseClause [
out-order IfClause ~ ElifClause ~ ElseClause
