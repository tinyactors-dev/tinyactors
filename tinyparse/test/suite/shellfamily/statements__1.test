# Corpus: three pipelines, each joining two simple commands with `|`. Six
# SimpleCommand nodes under three Pipeline nodes.
<<<cmd
"$PP" run std.shell --input test/suite/shellfamily/inputs/statements__1.sh --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 3 Pipeline [
out-count 6 SimpleCommand [
