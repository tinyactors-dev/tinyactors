# A for clause with no `in` list iterates the positional parameters:
# `for name; do list; done`. There is no value field, only the variable and body.
<<<cmd
printf 'for i; do echo hi; done\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains ForClause
out-contains variable: Name
out-absent value: Word
out-contains body: CompoundList
