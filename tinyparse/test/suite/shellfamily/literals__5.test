# Corpus: the ten POSIX parameter-substitution operator forms, one per line —
# use-default (-/:-), assign-default (=/:=), alternative (+/:+), indicate-error
# (?/:?), and remove-suffix (%/%%). Ten BracedExpansion nodes.
<<<cmd
"$PP" run std.shell --input test/suite/shellfamily/inputs/literals__5.sh --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 10 BracedExpansion [
