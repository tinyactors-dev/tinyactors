# Inside a double-quoted string a backslash escapes the next byte, so the inner
# escaped quotes do not close the string: "he said \"hi\"" is one DoubleQuoted
# argument with no parse error.
<<<cmd
printf 'echo "he said \\"hi\\""\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 1 arg: Word
out-contains DoubleQuoted
