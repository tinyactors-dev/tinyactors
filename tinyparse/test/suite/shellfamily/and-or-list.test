# An and-or list joins pipelines with "&&" and "||". The AndOrList node holds
# both operators as op fields, left to right.
<<<cmd
printf 'make && echo ok || echo fail\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains AndOrList
out-contains op: &&
out-contains op: ||
out-order op: && ~ op: ||
