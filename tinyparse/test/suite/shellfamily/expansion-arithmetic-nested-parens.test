# Arithmetic expansion with inner parentheses `$((x * (y + 1)))`: the inner parens
# are a balanced ArithGroup, so the terminator is the OUTERMOST `))`.
<<<cmd
printf 'echo $((x * (y + 1)))\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains ArithmeticExpansion
out-contains ArithGroup
