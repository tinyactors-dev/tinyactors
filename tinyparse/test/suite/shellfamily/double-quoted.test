# A double-quoted string is one argument word: the spaces inside the quotes are
# literal, so "a b c" is a single arg holding a DoubleQuoted part.
<<<cmd
printf 'echo "a b c"\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 1 arg: Word
out-contains DoubleQuoted
