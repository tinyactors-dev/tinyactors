# A redirect on a brace group: `{ a; } 2>err`. The fd-2 Redirect attaches to the
# CompoundCommand, after the BraceGroup.
<<<cmd
printf '{ a; } 2>err\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains CompoundCommand
out-contains BraceGroup
out-count 1 redirect: Redirect
out-contains fd: IoNumber
