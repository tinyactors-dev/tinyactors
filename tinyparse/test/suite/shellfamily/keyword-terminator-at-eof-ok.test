# A terminator keyword at end of input is still delimited (EOF is a word
# boundary), so the zero-width boundary assertion succeeds with no byte to consume.
# `if x; then a; fi` with no trailing newline parses as a complete if clause.
<<<cmd
printf 'if x; then a; fi' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains IfClause
out-contains body: CompoundList
