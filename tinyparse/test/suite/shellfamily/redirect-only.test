# A redirection with no command word is a valid simple command: >file is a
# SimpleCommand whose only content is a Redirect, with no command name: Word.
<<<cmd
printf '>file\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 1 redirect: Redirect
out-absent name: Word
out-contains target: Word
