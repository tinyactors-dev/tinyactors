# An expansion concatenated with raw text in one word `a$x.b`: RawWord `a`, then
# SimpleExpansion `$x`, then RawWord `.b`, all parts of a single Word.
<<<cmd
printf 'echo a$x.b\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 1 arg: Word
out-contains SimpleExpansion
out-contains RawWord
