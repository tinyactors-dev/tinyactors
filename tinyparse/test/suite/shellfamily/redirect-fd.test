# A file-descriptor redirection: ls 2>err redirects fd 2. The 2 abuts the > with
# no blank, so it is read as an fd: IoNumber, not an argument.
<<<cmd
printf 'ls 2>err\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 1 redirect: Redirect
out-contains fd: IoNumber
out-contains target: Word
out-absent arg: Word
