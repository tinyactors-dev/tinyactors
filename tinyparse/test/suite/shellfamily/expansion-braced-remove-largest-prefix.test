# Remove-largest-prefix `${name##pattern}` (POSIX §2.6.2): the two-character `##`
# operator wins over `#`, with a BraceBody pattern operand `*/`.
<<<cmd
printf 'echo ${x##*/}\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains BracedExpansion
out-contains op: BracedOperator
out-contains word: BraceBody
