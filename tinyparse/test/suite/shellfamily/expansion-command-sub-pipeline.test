# Command substitution over a pipeline `$(ls | wc -l)`: the body is a full
# CompoundList, so the inner pipeline parses recursively.
<<<cmd
printf 'echo $(ls | wc -l)\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains CommandSubstitution
out-contains Pipeline
