# An if clause: `if list; then list; fi`. The condition and body are
# compound-lists; the keywords if/then/fi bracket them and the body terminates
# at `fi` because `fi` cannot be a command name.
<<<cmd
printf 'if cmd; then a; fi\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains IfClause
out-contains condition: CompoundList
out-contains body: CompoundList
