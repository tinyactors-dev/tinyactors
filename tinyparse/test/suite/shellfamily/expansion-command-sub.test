# Command substitution `$(command)` (POSIX §2.6.3): the body is the recursive
# command grammar, here a single simple command.
<<<cmd
printf 'echo $(date)\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains CommandSubstitution
out-contains body: CompoundList
