# A simple command of two bare words parses cleanly into a SimpleCommand with a
# name and one argument. No ERROR, no MISSING recovery nodes.
<<<cmd
printf 'echo hi\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains SimpleCommand
out-contains name: CommandName
out-contains arg: Word
