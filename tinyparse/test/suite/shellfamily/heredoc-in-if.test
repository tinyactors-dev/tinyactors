# A here-document inside an if clause's compound list: `if true; then cat <<EOF`
# opens a heredoc on a command line WITHIN the if body; the body drains after that
# line's newline, and `fi` still closes the clause. This exercises the per-line
# slot/drain inside CompoundList (not just at the top level).
<<<cmd
printf 'if true; then cat <<EOF\nx\nEOF\n fi\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains IfClause
out-contains body: CompoundList
out-count 1 HeredocBody [
out-contains Fi
