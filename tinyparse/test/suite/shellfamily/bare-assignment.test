# An assignment with no command word is a valid simple command: FOO=bar is one
# Assignment and there is no command name: Word.
<<<cmd
printf 'FOO=bar\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 1 assignment: Assignment
out-absent name: Word
out-contains value: Word
