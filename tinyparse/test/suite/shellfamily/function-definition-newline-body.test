# A function definition with the POSIX `linebreak` between `)` and the body:
# `foo()\n{\n echo hi\n}`. The optional Newline repeat absorbs the blank lines.
<<<cmd
printf 'foo()\n{\n echo hi\n}\n' | "$TP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains FunctionDefinition
out-contains body: CompoundCommand
out-contains BraceGroup
