# A ";" separates commands within one complete command: `a; b; c` is three
# simple commands, each its own and-or list, joined by ";" separators.
<<<cmd
printf 'a; b; c\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 3 SimpleCommand
out-count 2 sep: ;
