# A while clause: `while list; do list; done`. The condition runs the body
# while it succeeds; both are compound-lists.
<<<cmd
printf 'while c; do x; done\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-contains WhileClause
out-contains condition: CompoundList
out-contains body: CompoundList
