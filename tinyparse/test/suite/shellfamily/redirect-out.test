# An output redirection: echo hi >out is a command echo with argument hi and a
# Redirect using the > operator to target out.
<<<cmd
printf 'echo hi >out\n' | "$PP" run std.shell --input - --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 1 redirect: Redirect
out-contains RedirectOp
out-contains target: Word
