# Corpus: commands with arguments, including a backslash-newline line
# continuation. Three command lines, each a SimpleCommand; the last keeps its
# continued word as a single argument across the escaped newline.
<<<cmd
"$TP" run std.shell --input test/suite/shellfamily/inputs/commands__2.sh --dump-tree
<<<assert
exit 0
out-absent ERROR
out-absent MISSING
out-count 3 SimpleCommand [
out-contains SimpleExpansion
