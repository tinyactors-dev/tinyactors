#!/usr/bin/env ruby
#MISE description="Build the test harness for this machine: build/bin/harness"
# vim:ft=ruby

# test/harness.c interprets the data-driven suite (test/suite/**/*.test)
# against the xfail ledger. It is host tooling, so it uses libc freely.

require 'cache'
require_relative '../lib/tinyparse'

command = [*Tinyparse.host.compile_command, *Tinyparse::COMMON_FLAGS]
# harness_<os>.c sets the feature-test macros for the host, then includes harness.c.
PLATFORM_FILES = { macos: 'harness_darwin.c', linux: 'harness_linux.c' }.freeze
source = Tinyparse::ROOT.join('test', PLATFORM_FILES.fetch(Toolchain::Host.current.os))
object = Tinyparse.compile_all(command, [source], Tinyparse::BUILD.join('objects/harness'),
                               'harness').first
harness = Tinyparse.harness
outcome = Tinyparse.link('harness', harness, %w[program], [object]) do
  Tinyparse.host.program([object], into: harness)
end
puts "harness: #{Tinyparse.relative(harness)} #{outcome == :reused ? 'up to date' : 'linked'}"
