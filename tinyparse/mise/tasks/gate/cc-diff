#!/usr/bin/env ruby
#MISE description="Gate: parsers generated by `tinyparse c --parser` build the VM's tree (--full: every input of the JavaScript, TypeScript and shell corpora)"
#MISE depends=["build"]
#USAGE flag "--full" help="Every input of the JavaScript, TypeScript and shell corpora, through their generated parsers"
# vim:ft=ruby

# `tinyparse c --parser GRAMMAR` emits a standalone parser: the grammar
# baked into C over an arena-backed frame stack. It must build the same
# tree as the bytecode VM (`tinyparse run`), so for each grammar this
# generates the parser, compiles it against the library, and holds its
# output (stdout and stderr in one stream, the tree and any diagnostics)
# and exit code to the VM's on:
#
#   - the json family (Tinyparse::Corpus::JSON_FAMILY);
#   - std.fence, which injects std.json and std.javascript into fenced
#     blocks: the generated parser rebuilds the embedded grammars from the
#     packed grammar it carries, with no module resolver at parse time;
#   - examples/heredoc and std.shell's here-documents: deferred slots, the
#     parametrized (parse-deferred) drain, several heredocs on one line;
#   - the family base fixture;
#   - the suite's shell corpus (two inputs in the fast pass) and, with
#     --full, every input of the shell, JavaScript and TypeScript corpora,
#     whose generated parsers take seconds each to compile.
#
# The crash bound of a generated parser is gate:parser-nocrash; its
# diagnostics on their own, gate:diag-diff.

require_relative '../../lib/gate'

ROOT = Tinyparse::ROOT

FENCE = [
  "```json\n{\"a\":1}\n```\n",
  "```js\nlet x = 1;\n```\n",
  "```json\n[1,2,{\"k\":true},null]\n```\n```js\nconst y = [1, 2, 3];\n```\n",
  "```json\n{\"a\":[1,{\"b\":2}],\"c\":null}\n```\n"
].freeze

HEREDOC = [
  "cat <<EOF\nhello\nEOF\n",
  "cat <<A <<B\nfirst\nA\nsecond\nB\n",
  "cat <<EOF\nx\nEOF\ncat <<EOF\ny\nEOF\n",
  "cat <<EOF\necho Hello\necho $(\n  cat <<NESTED\nworld\nNESTED\n)\nEOF\n"
].freeze

SHELL_HEREDOC = [
  "cat <<EOF\nhello\nEOF\n",
  "cat <<EOF >out\nx\nEOF\n",
  "cat <<EOF | grep x\nx\nEOF\n",
  "cat <<A <<B\naaa\nA\nbbb\nB\n",
  "if true; then cat <<EOF\nx\nEOF\n fi\n",
  "cat <<-EOF\n\thello\n\tEOF\n"
].freeze

Tinyparse::Gate.run('cc-diff', 'compiled-parser differential: generated parser vs VM') do |gate|
  cases = Tinyparse::Corpus.json_family(gate)
  { 'std.fence' => FENCE, ROOT.join('examples/heredoc/heredoc.scm') => HEREDOC, 'std.shell' => SHELL_HEREDOC }
    .each do |grammar, inputs|
      inputs.each_with_index do |bytes, index|
        cases << [grammar, gate.write("#{File.basename(grammar.to_s, '.scm')}/#{index + 1}.input", bytes)]
      end
    end
  cases << [ROOT.join('test/suite/family/fixtures/base.scm'), gate.write('family/base.input', 'hello world')]
  families = gate.full? ? Tinyparse::Corpus::FAMILIES.keys : %w[shellfamily]
  families.each { |family| cases.concat(Tinyparse::Corpus.family(family, all: gate.full?)) }

  grammars = cases.map(&:first).uniq
  puts "  #{grammars.size} generated parsers, #{cases.size} inputs"
  parsers = grammars.zip(gate.each_parallel(grammars) { |grammar| gate.parser(grammar) }).to_h
  runs = gate.each_parallel(cases) do |grammar, input|
    next unless parsers[grammar]

    [grammar, input, gate.vm_tree(grammar, input), gate.execute([parsers[grammar]], stdin: input)]
  end
  runs.compact.each do |grammar, input, vm, generated|
    name = grammar.is_a?(Pathname) ? Tinyparse.relative(grammar) : grammar
    gate.compare("#{name} / #{File.basename(input.to_s)}", vm, generated)
  end
  gate.check(grammars.all? { |grammar| parsers[grammar] }, 'a generated parser did not build')
  gate.result
end
