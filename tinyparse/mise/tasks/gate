#!/usr/bin/env ruby
#MISE description="Run gates in ci/ by name (all when none is named): mise run gate cc-diff vm-diff"
#MISE depends=["build", "amalgamate"]
# vim:ft=ruby

# A gate is a shell program in ci/ that checks one property across many
# inputs (Tinyparse::GATES). It runs here with what it needs built and the
# environment that names it (Tinyparse.test_environment): the CLI, the
# library, the examples, the amalgamation and the pinned toolchain. Gates
# named together run at once; each one's output is in build/logs/.

require_relative '../lib/tinyparse'

names = ARGV.empty? ? Tinyparse::GATES : ARGV
unknown = names - Tinyparse::GATES
abort "gate: unknown #{unknown.join(', ')}; known: #{Tinyparse::GATES.join(', ')}" unless unknown.empty?

failed = Tinyparse.run_all(names.map { |name| [name, ['bash', Tinyparse.gate_script(name).to_s]] }, Tinyparse.test_environment)
abort "gate: failed: #{failed.join(' ')}" unless failed.empty?
