#!/usr/bin/env ruby
#MISE description="Gate: generated C parsers (std.json, std.shell) survive a 200,000-byte nested input under a 512 KiB C stack (--full: also JavaScript and TSX)"
#MISE depends=["build"]
#USAGE flag "--full" help="Also the generated std.javascript and std.tsx parsers, whose rule frames are the largest and which take seconds each to compile"
# vim:ft=ruby

# A parser generated with `tinyparse c --parser` recurses natively, one C
# call per rule, so a deep input could overflow the C stack. Each rule body
# is wrapped in a depth guard (src/emitparser.c, TP_PARSER_DEPTH_LIMIT):
# past the limit the rule fails, and the parse ends in a syntax error
# rather than a crash signal. The limit is measured to sit below what fits
# in a 512 KiB stack. This generates the std.json and std.shell parsers,
# runs each on a deeply nested input (200,000 unclosed `[`, or 100,000
# unclosed `$(`, malformed on purpose) under a 512 KiB C stack, and fails
# when one dies by a signal. A clean parse and a syntax error both pass.
#
# std.json's rule frames are small: it survives a limit twice as high,
# which std.shell's do not. --full also runs the JavaScript and TSX
# parsers, whose expression ladders put the most C frames under each
# nesting level (at the limit they need between 256 and 384 KiB) and which
# take seconds each to compile. One input per parser under one bound is the
# whole test (see the profiling skill): it does not sweep depths.

require_relative '../../lib/gate'

STACK = 512 * 1024

Tinyparse::Gate.run('parser-nocrash', 'compiled-parser crash bound') do |gate|
  cases = { 'std.json' => '[' * 200_000, 'std.shell' => '$(' * 100_000 }
  cases.merge!('std.javascript' => '[' * 200_000, 'std.tsx' => '[' * 200_000) if gate.full?
  parsers = cases.keys.zip(gate.each_parallel(cases.keys) { |grammar| gate.parser(grammar) }).to_h
  cases.each do |grammar, bytes|
    next unless parsers[grammar]

    input = gate.write("deep-#{grammar}.input", bytes)
    run = gate.execute([parsers[grammar]], stdin: input, stack: STACK)
    if run.signaled?
      gate.fail("#{grammar}: the generated parser died by signal #{run.status.termsig} under a 512 KiB stack")
    else
      gate.ok("#{grammar}: #{bytes.size} bytes nested: exit #{run.code} under a 512 KiB stack, no crash signal")
    end
  end
end
