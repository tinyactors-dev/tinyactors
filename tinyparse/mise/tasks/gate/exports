#!/usr/bin/env ruby
#MISE description="Gate: a shared object built from generated parsers with examples/embed/embed-lib.sh exports their entries and tinyparse_* alone, and still parses"
#MISE depends=["build", "amalgamate"]
#USAGE flag "--full" help="Build the shared objects at the recipe's -O2 rather than -O0"
# vim:ft=ruby

# A host that drops generated parsers into its program should see their
# entries (PREFIX_load, PREFIX_run) and the public API it calls (the
# functions include/tinyparse.h declares with TINYPARSE_API), and none of
# the library's internals. The recipe that
# builds such an artifact, examples/embed/embed-lib.sh, compiles the
# library amalgamation with the parsers generated by `tinyparse c
# --parser-lib --name PREFIX` and links them behind an export list. This
# gate builds:
#
#   1. one parser (std.json as jp): the shared object exports jp_load,
#      jp_run and the public API, and nothing else;
#   2. the two parsers of examples/embed (host.scm as host_parser, std.json
#      as json_parser): their four entries and the public API, nothing
#      else;
#   3. the embed.c driver linked against that shared object: it needs no
#      more than what is exported, and parses the sample to expected.txt.
#
# The symbols are read with Toolchain::Binary (the dynamic table of an ELF
# shared object, the exports of a Mach-O dylib). gate:nesting checks the
# same for a set of three parsers. (Until the move out of ax this gate was
# hide-ax, and also kept that runtime's symbols out; the runtime is gone,
# and the whole table is held to the API. Holding it to the API rather than
# to the tinyparse_ prefix found tinyparse_apply_manifest, a CLI helper in
# src/package.c that leaked into every embedded artifact; it is
# tp_apply_manifest now.)

require_relative '../../lib/gate'

Tinyparse::Gate.run('exports', 'export-surface gate') do |gate|
  single = gate.embedded_library('libjp.so', 'jp' => 'std.json')
  gate.must_export_only(single, %w[jp_load jp_run])

  example = Tinyparse::ROOT.join('examples/embed')
  pair = gate.embedded_library('libembed.so', 'host_parser' => 'host.scm', 'json_parser' => 'std.json')
  gate.must_export_only(pair, %w[host_parser_load host_parser_run json_parser_load json_parser_run])

  program = gate.program([example.join('embed.c'), pair], gate.scratch.join('embed'))
  gate.compare('embed.c against libembed.so: output vs expected.txt', example.join('expected.txt').binread,
               gate.execute([program, example.join('sample.md')]))
  gate.result
end
