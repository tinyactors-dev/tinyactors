#!/usr/bin/env ruby
#MISE description="Test tinyactors-otlp: no recursion, freestanding for wasm32, the tests under AddressSanitizer and UBSan, and every test program"
#MISE sources=["include/**/*", "src/**/*", "tests/**/*", "mise/**/*", "mise.toml", "../tinyactors-core/include/**/*", "../tinyactors-core/src/**/*", "../mise/lib/**/*", "../mise.toml"]
#MISE outputs={auto=true}
#MISE depends=["build"]
# vim:ft=ruby

require_relative '../../otlp'

OTLPLibrary.run('mise', 'run', 'check-recursion')
OTLPLibrary.run('mise', 'run', 'check-freestanding')
OTLPLibrary.run('mise', 'run', 'asan')

failed = OTLPLibrary.tests.reject do |test|
  system(OTLPLibrary::BUILD.join(test).to_s, chdir: OTLPLibrary::ROOT.to_s)
end
abort "tinyactors-otlp: failed: #{failed.join(', ')}" unless failed.empty?
puts "tinyactors-otlp: #{OTLPLibrary.tests.size} test program(s) pass"
