#!/usr/bin/env ruby
#MISE description="Fail on any cycle in tinyactors-otlp's direct call graph (core's rules: no recursion)"
# vim:ft=ruby

# The library's sources are compiled together, as one translation unit that
# includes each of them, to LLVM IR at -O0 for the check target, and its
# direct call graph is read the way core's is (mise/lib/call_graph.rb).

require_relative '../otlp'
require 'call_graph'
require 'fileutils'
require 'open3'

unit = OTLPLibrary::BUILD.join('check/otlp_all.c')
FileUtils.mkdir_p(unit.dirname)
unit.write(OTLPLibrary.sources.map { |source| "#include \"#{source}\"\n" }.join)
command = Toolchain::Target.check.compile_command('-std=c11', '-O0', '-S', '-emit-llvm', *OTLPLibrary::INCLUDES,
                                                  '-o', '-', unit)
ir, error, status = Open3.capture3(*command)
unless status.success?
  warn error
  abort 'check-recursion: could not compile tinyactors-otlp to LLVM IR'
end
calls = CallGraph.calls(ir)
cycles = CallGraph.cycles(calls)
cycles.each { |cycle| puts "check-recursion: CYCLE: #{cycle.join(' -> ')}" }
abort "check-recursion: #{cycles.size} cycle(s) in tinyactors-otlp's call graph" unless cycles.empty?
puts "check-recursion: #{calls.size} tinyactors-otlp functions, no recursion"
