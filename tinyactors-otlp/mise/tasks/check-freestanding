#!/usr/bin/env ruby
#MISE description="Compile every tinyactors-otlp source for wasm32-freestanding and check it needs no C library: only core's API and the compiler's memory builtins may stay undefined"
# vim:ft=ruby

# Every binding links the library, a browser's too, so it is compiled with
# the release's zig for wasm32-freestanding, which has no C library at all:
# a libc header does not exist there, and a libc call would stay undefined.
# What each object leaves undefined may be core's public API (ta_*), the
# library's own functions (tao_*), and the memory builtins the compiler
# emits (OTLPLibrary::MEMORY), nothing else.

require_relative '../otlp'
require 'fileutils'

target = Toolchain::Target.release('wasm32-freestanding')
out = OTLPLibrary::BUILD.join('wasm32')
FileUtils.mkdir_p(out)
bad = []
OTLPLibrary.sources.each do |source|
  object = out.join("#{source.basename('.c')}.o")
  binary = target.compile(source.to_s, into: object.to_s,
                                       includes: [OTLPLibrary::ROOT.join('include'), OTLPLibrary::CORE_INCLUDE,
                                                  OTLPLibrary::ROOT.join('src')],
                                       flags: OTLPLibrary::WARNINGS)
  foreign = (binary.undefined - binary.format.runtime_undefined).to_a.reject do |symbol|
    symbol.start_with?('ta_', 'tao_') || OTLPLibrary::MEMORY.include?(symbol)
  end
  bad << "#{source.basename}: #{foreign.join(', ')}" unless foreign.empty?
end
abort "check-freestanding: undefined symbols outside core, the library and the memory builtins:\n  #{bad.join("\n  ")}" unless bad.empty?
puts "check-freestanding: #{OTLPLibrary.sources.size} tinyactors-otlp source(s) build for wasm32-freestanding with no C library"
