#!/usr/bin/env ruby
#MISE description="Build tinyactors-otlp: its library (freestanding, without the host's C library) and its test programs"
# vim:ft=ruby

# Each src/*.c is compiled freestanding into build/objects/ and archived
# into build/libtinyactors_otlp.a; each tests/*_test.c links against it and
# core. Objects are reused while their bytes and headers are unchanged
# (mise/lib/cache.rb).

require_relative '../otlp'
require 'cache'
require 'fileutils'

target = Toolchain::Target.host
library_command = [*target.compile_command, *OTLPLibrary::WARNINGS, *OTLPLibrary::FREESTANDING,
                   *OTLPLibrary::INCLUDES].freeze
test_command = [*target.compile_command, *OTLPLibrary::WARNINGS, *OTLPLibrary::INCLUDES].freeze

def compile(command, source, object)
  outcome, output = Cache.compile(command, source, object)
  if outcome == :failed
    puts (command + ['-c', source.to_s]).shelljoin
    abort output
  end
  puts output unless output.empty?
  outcome
end

FileUtils.mkdir_p(OTLPLibrary::OBJECTS)
objects = OTLPLibrary.sources.map do |source|
  object = OTLPLibrary::OBJECTS.join("#{source.basename('.c')}.o")
  compile(library_command, source.relative_path_from(OTLPLibrary::ROOT), object)
  object
end
target.archive(objects.map(&:to_s), into: OTLPLibrary.library.to_s)

core_object = OTLPLibrary::OBJECTS.join('core_tinyactors.o')
compile(test_command, OTLPLibrary::CORE_SOURCE, core_object)

OTLPLibrary.tests.each do |test|
  object = OTLPLibrary::OBJECTS.join("#{test}.o")
  compile(test_command, Pathname.new("tests/#{test}.c"), object)
  target.program([object.to_s, OTLPLibrary.library.to_s, core_object.to_s], into: OTLPLibrary::BUILD.join(test).to_s)
end
puts "build: tinyactors-otlp (#{objects.size} objects) and #{OTLPLibrary.tests.size} test program(s)"
