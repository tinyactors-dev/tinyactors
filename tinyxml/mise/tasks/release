#!/usr/bin/env ruby
#MISE description="Release txml: check, version, build every target with zig cc, verify, pack; with --publish, also tag and create the GitHub release"
# vim:ft=ruby

# mise run release -- 0.1.0                    check, build, verify, pack; publishes nothing
# mise run release -- 0.1.0 --publish          the same, then tag tinyxml/v0.1.0 and release
# mise run release -- 0.1.0 --skip-containers  no Linux container smoke tests (no Docker)
#
# The stages and the rules they follow are in mise/lib/c_release/build.rb
# and docs/adr/0001-packaging-and-releases.md; this file only describes txml.
# The assets land in build/release/<version>/assets/.

require 'pathname'
require 'c_release'
require_relative '../lib/suite'

project = CRelease::Project.new(name: 'txml', prefix: 'txml')
root = project.root
argv = ARGV.dup

CRelease.release(
  libraries: [
    CRelease::Library.new(
      project: project,
      tests: Suite.public_api_tests.map do |name|
        [name, root.join('build/objects', "#{name}.o"), Suite::BINARIES.fetch(name)]
      end,
      smoke: root.join('tests/release_smoke.c'),
      # The source tarball has the platform amalgamation too, so a source
      # embedder can build for wasm (decision 9).
      sources: [project.header, project.amalgamation, root.join('include/txml_wasm.c'), project.api],
      wasm_test: ->(module_path) { ['node', root.join('tests/wasm/wasm_test.js'), module_path, project.api] }
    )
  ],
  directory: 'tinyxml',
  title: "txml #{argv.reject { |arg| arg.start_with?('--') }.first}",
  argv: argv,
  checks: [%w[mise run amalgamate -- --check], %w[mise run test]],
  regenerate: [%w[mise run generate]],
  readme: root.join('README.md')
)
