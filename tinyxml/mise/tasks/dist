#!/usr/bin/env ruby
#MISE description="Publish the txml build artifact: dist/include, dist/lib/<profile>/libtxml.a, dist/txml.json"
#MISE depends=["generated"]
# vim:ft=ruby
#
# Downstream modules link against a prebuilt archive instead of recompiling
# include/txml.c themselves, so a change inside tinyxml no longer costs every
# consumer a rebuild of the amalgamation. This task is the producer side:
#
#   dist/include/txml.h              copy of the authored public header
#   dist/include/txml.c              copy of the generated amalgamation (source embedders)
#   dist/include/txml.api.json       copy of the checked-in API description, for a
#                                     consumer that generates bindings from it (e.g.
#                                     tinyactors-test) instead of compiling C
#   dist/lib/<profile>/libtxml.a     archive of ONE object: include/txml.c compiled
#                                     once, under the named profile's flags
#   dist/txml.json                   manifest a consumer's build keys its own cache on
#
# The archive is built from the amalgamation translation unit, not from
# build/objects/*.o: the amalgamation marks every non-public function
# TXML_PRIVATE (static), so its object exports exactly the public API, whereas
# per-module objects give internal helpers external linkage.
#
# Usage:
#
#   mise run dist          publish the "release" profile (the default)
#   mise run dist debug    publish the "debug" profile
#
# Only the requested profile is (re)built; the others are left untouched.
# `mise run dist` on its own therefore never pays for a profile nobody asked
# for, and never disturbs one a previous invocation published.
#
# PROBLEM THIS FIXES: this task used to read $CFLAGS for its compile flags,
# so the published archive silently carried whatever flags the *invoking
# shell* happened to export, and a consumer's own build (with its own
# $CFLAGS) could silently republish a differently-flagged archive on the next
# `mise run dist` -- the exact cache thrash a published, cacheable artifact
# exists to prevent. A dist artifact must be a function of *this task's own
# definition*, not of who happens to invoke it. So the optimization/warning
# flags are now hard-coded below, per profile, and $CFLAGS is no longer read
# at all. $CC and $AR are still honoured, because *which compiler/archiver
# binary* is a toolchain choice (cross-compiling, pinning a specific clang,
# ...) that reasonably varies by environment without changing what the
# archive means, whereas *which flags* changes the object code itself and is
# exactly what must NOT depend on the caller.
#
# -fPIC is in every profile so a future shared object (e.g. a native binding)
# can link any published profile in.
#
# The manifest is a pure function of content: no timestamps, no git commit, no
# absolute paths, no counters. A consumer keys its own rebuild on `abi` and a
# chosen profile's `digest`, so any non-deterministic field here would churn
# every downstream build on every run of this one, which is the exact problem
# dist removes.
# `ar` is a known trap: default `ar rcs` on this toolchain (Apple/cctools)
# embeds each member's mtime/uid/gid, so two archives built from the same
# object one second apart differ byte-for-byte. ZERO_AR_DATE=1 (a cctools ar
# environment variable) zeroes those fields; verified empirically (see the
# verification notes for this change) that it makes `ar rcs` byte-identical
# across repeated builds of the same object. `ar -D` (GNU ar's deterministic
# flag) does not exist on this ar and is not used.
#
# Every published file is written only when its bytes differ from what is
# already there, so an artifact an upstream change left unchanged (e.g. a
# comment-only edit whose object recompiles to identical bytes, see
# mise/lib/cache.rb's preprocessed-digest fallback) keeps its old mtime. A
# consumer using mise's own mtime-based `sources` therefore does not see a
# reason to rebuild either. Each profile's archive is built to a temporary
# path and only moved over the published one when the bytes differ, instead
# of always `rm`+`ar rcs`-ing the published path directly, which would change
# its mtime on every non-cached run even when unchanged.
#
# Gated on content (mise/lib/cache.rb), one gate per profile: the requested
# profile's published files (header/source/api copies and its own archive)
# are part of that profile's gate outputs, and the profile's flags are part
# of the gate key, so a hand-edited or deleted archive, or a change to a
# profile's flags (which also edits this file, itself a gate input), is
# rebuilt; a different profile's gate is untouched, so switching profiles
# never perturbs the other's cache record.

require 'English'
require 'digest'
require 'fileutils'
require 'json'
require 'pathname'
require 'shellwords'
require 'cache'

ROOT = Cache::ROOT
DIST = ROOT.join('dist')

# Profiles this task can publish. Flags live here, in the task's own
# definition, not in $CFLAGS -- see the doc comment above. -fPIC stays in
# every profile.
PROFILES = {
  'release' => %w[-std=c11 -Wall -Wextra -Werror -pedantic -O2 -fPIC],
  'debug' => %w[-std=c11 -Wall -Wextra -Werror -pedantic -O0 -g -fPIC]
}.freeze
DEFAULT_PROFILE = 'release'

abort "usage: mise run dist [#{PROFILES.keys.join('|')}]" if ARGV.size > 1

profile = ARGV.first || DEFAULT_PROFILE
abort "dist: unknown profile #{profile.inspect} (known: #{PROFILES.keys.join(', ')})" unless PROFILES.key?(profile)

FLAGS = PROFILES.fetch(profile)

# The compiler *binary* is still configurable; the flags that decide what it
# produces are not (see above).
COMPILER = Shellwords.split(ENV.fetch('CC', 'cc'))
COMPILE_COMMAND = [*COMPILER, *FLAGS, '-Iinclude']

AR = Shellwords.split(ENV.fetch('AR', 'ar'))

HEADER = ROOT.join('include/txml.h')
AMALGAMATION = ROOT.join('include/txml.c')
API_DESCRIPTION = ROOT.join('include/txml.api.json')

DIST_HEADER = DIST.join('include/txml.h')
DIST_SOURCE = DIST.join('include/txml.c')
DIST_API = DIST.join('include/txml.api.json')
DIST_MANIFEST = DIST.join('txml.json')

OBJECT = ROOT.join("build/dist/#{profile}/txml.o")
DIST_ARCHIVE = DIST.join("lib/#{profile}/libtxml.a")

Cache.gate("dist-#{profile}",
           inputs: Cache.files('include/txml.h', 'include/txml.c', 'include/txml.api.json', 'mise/tasks/dist'),
           outputs: [DIST_HEADER, DIST_SOURCE, DIST_API, DIST_ARCHIVE],
           extra: [profile, FLAGS.join(' '), COMPILE_COMMAND.join(' '), Cache.tool_id(COMPILER.first(1)), AR.join(' ')])

# Writes `contents` (bytes) to `path` only when they differ, so an unchanged
# published file keeps its mtime instead of being rewritten to the same bytes
# on every non-cached run.
def write_if_changed(path, contents)
  FileUtils.mkdir_p(path.dirname)
  return if path.file? && File.binread(path) == contents

  path.binwrite(contents)
end

outcome, output = Cache.compile(COMPILE_COMMAND, AMALGAMATION, OBJECT)
if outcome == :failed
  warn output
  abort 'dist: include/txml.c does not compile'
end

FileUtils.mkdir_p(DIST_ARCHIVE.dirname)
temp_archive = DIST_ARCHIVE.dirname.join("#{DIST_ARCHIVE.basename}.tmp#{Process.pid}")
FileUtils.rm_f(temp_archive)
# ZERO_AR_DATE makes the archive a pure function of the object's bytes: no
# member mtime/uid/gid, so rebuilding from an unchanged object reproduces the
# same archive byte-for-byte (see the doc comment above). Built to a temporary
# path first: moving it over DIST_ARCHIVE only when the bytes differ is what
# keeps DIST_ARCHIVE's mtime stable across a run that reproduces it exactly.
ar_env = { 'ZERO_AR_DATE' => '1' }
ar_output = IO.popen(ar_env, [*AR, 'rcs', temp_archive.to_s, OBJECT.to_s], err: %i[child out], &:read)
abort "dist: #{AR.join(' ')} failed:\n#{ar_output}" unless $CHILD_STATUS.success?
if DIST_ARCHIVE.file? && File.binread(DIST_ARCHIVE) == File.binread(temp_archive)
  FileUtils.rm_f(temp_archive)
else
  FileUtils.mkdir_p(DIST_ARCHIVE.dirname)
  File.rename(temp_archive, DIST_ARCHIVE)
end

write_if_changed(DIST_HEADER, File.binread(HEADER))
write_if_changed(DIST_SOURCE, File.binread(AMALGAMATION))
write_if_changed(DIST_API, File.binread(API_DESCRIPTION))

# The manifest lists every profile currently published on disk, not just the
# one this run touched: an earlier `mise run dist debug` must stay listed
# after a later plain `mise run dist`. Each profile's flags come from this
# file's own PROFILES table (not from re-deriving them some other way), so
# the listing is correct even for a profile this run did not rebuild.
published_profiles = PROFILES.keys.select { |name| DIST.join("lib/#{name}/libtxml.a").file? }
profiles_manifest = published_profiles.to_h do |name|
  archive = DIST.join("lib/#{name}/libtxml.a")
  [name, {
    'flags' => PROFILES.fetch(name),
    'archive' => "lib/#{name}/libtxml.a",
    'digest' => Cache.digest(archive)
  }]
end

manifest = {
  'name' => 'txml',
  'abi' => Cache.digest(HEADER, API_DESCRIPTION),
  'header' => 'include/txml.h',
  'api' => 'include/txml.api.json',
  'profiles' => profiles_manifest
}
text = "#{JSON.pretty_generate(manifest)}\n"
DIST_MANIFEST.write(text) unless DIST_MANIFEST.file? && DIST_MANIFEST.read == text

puts "dist: published dist/ profile=#{profile} (abi #{manifest['abi'][0, 12]}, archive #{profiles_manifest[profile]['digest'][0, 12]})"
