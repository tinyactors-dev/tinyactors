#!/usr/bin/env ruby
#MISE description="Run the txml test suite"
# vim:ft=ruby

# Checks the source and object-code constraints (freestanding, lint-src), builds,
# runs every test binary that exists, then runs the public-API tests against the
# amalgamation and checks the API description. A test whose modules do not exist
# is reported as pending; any failure fails the task.

require 'pathname'

ROOT = Pathname.new(__dir__).join('../..').expand_path

require_relative '../lib/suite'

BINARIES = Suite::BINARIES

def run(*command)
  puts command.join(' ')
  pid = Process.spawn(*command, chdir: ROOT.to_s)
  _pid, status = Process.wait2(pid)

  return if status.success?

  exit(status.exitstatus || 1)
end

# The constraints that no test binary can see come first: they are properties
# of the source and of the object code (AGENTS.md hard constraints 1, 5, 10).
run('mise', 'run', 'freestanding')
run('mise', 'run', 'lint-src')
run('mise', 'run', 'build')

ran = []
pending = []

BINARIES.each do |name, arguments|
  binary = ROOT.join('build', name)

  unless binary.file?
    pending << name
    next
  end

  run(binary.to_s, *arguments)
  ran << name
end

# The same public-API tests against the single-file library.
run('mise', 'run', 'amalgamate-test')
run('mise', 'run', 'api-test')

puts "txml: #{ran.length} test binaries passed (#{ran.join(' ')})" unless ran.empty?

unless pending.empty?
  puts "txml: #{pending.length} pending, waiting for an implementation in src/: #{pending.join(' ')}"
end
