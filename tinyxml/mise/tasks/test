#!/usr/bin/env ruby
#MISE description="Run the txml test suite"
#MISE sources=["include/**/*", "src/**/*", "tests/**/*", "cli/**/*", "mise/**/*", "mise.toml", "../mise/lib/**/*", "../mise.toml"]
#MISE outputs={auto=true}
#MISE depends=["generated", "freestanding", "lint-src", "build", "amalgamate-test", "api-test"]
# vim:ft=ruby

# The checks are dependencies, which mise runs in parallel (`--jobs`): that the
# checked-in generated files are current (generated), the source and object-code
# constraints (freestanding, quick tier; lint-src), the build, the public-API
# tests against the amalgamation (amalgamate-test) and the API description
# (api-test). Each skips by content, not modification time (mise/lib/cache.rb), so
# touching a file, or editing a comment, costs a few hashes. This task then runs
# the test binaries that exist, all at once, and reports them in a fixed order; a
# binary whose bytes and test data are unchanged since its last pass is not run
# again (mise/lib/suite.rb). A test whose modules do not exist is reported as
# pending; any failure fails the task. `mise run freestanding:full` checks every
# optimisation level of both targets, for before a commit and for CI;
# `TXML_FORCE=1` ignores every cache.

require 'pathname'

ROOT = Pathname.new(__dir__).join('../..').expand_path

require_relative '../lib/suite'

BINARIES = Suite::BINARIES

ran = []
pending = []
entries = []

BINARIES.each do |name, arguments|
  binary = ROOT.join('build', name)

  unless binary.file?
    pending << name
    next
  end

  entries << [name, binary, arguments]
  ran << name
end

failed = Suite.run_all(entries)
abort "txml: failed: #{failed.join(' ')}" unless failed.empty?

puts "txml: #{ran.length} test binaries passed (#{ran.join(' ')})" unless ran.empty?

unless pending.empty?
  puts "txml: #{pending.length} pending, waiting for an implementation in src/: #{pending.join(' ')}"
end
