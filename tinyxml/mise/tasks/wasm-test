#!/usr/bin/env ruby
#MISE description="Build txml.wasm (the release's WebAssembly module) and run it in Node: parse through the module's own allocator, many times, with no imports"
#MISE depends=["amalgamate"]
# vim:ft=ruby

# The module is built exactly as the release builds it
# (mise/lib/c_release/build.rb, CRelease.build_wasm) into build/wasm/, its
# interface checked (no imports; the API, the wasm functions and memory
# exported), and tests/wasm/wasm_test.js run against it. The release's
# verify stage runs the same test on the module it packs.

require 'c_release'

project = CRelease::Project.new(name: 'txml', prefix: 'txml')
build = CRelease.build_wasm(project, project.root.join('build/wasm'))
CRelease.verify_wasm!(project, build,
                      test: ->(wasm) { ['node', project.root.join('tests/wasm/wasm_test.js'), wasm, project.api] })
