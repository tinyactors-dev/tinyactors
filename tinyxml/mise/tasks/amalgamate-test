#!/usr/bin/env ruby
#MISE description="Prove the single-file library: strict build, freestanding, and the public-API tests linked against it"
#MISE depends=["build", "generated"]
# vim:ft=ruby

# include/txml.c is what an embedder copies into a project, so it is held to the
# same rules as src/ and then tested as itself:
#
#   1. it is current (the `generated` task, a dependency, fails otherwise);
#   2. it compiles warning-free under -std=c11 -Wall -Wextra -Werror -pedantic,
#      alone (-Iinclude is all it needs) and as the only library object;
#   3. it passes the freestanding check (no libc, no undefined symbols). That is
#      not repeated here: `mise run freestanding` (quick tier, -O0 -O2 -Os) and
#      `freestanding:full` check the amalgamation, as freestanding:amalgamation:*,
#      alongside src/, and `mise run test` runs them in parallel with this task
#      instead of after it;
#   4. every test that uses only the public API (Suite.public_api_tests) is built
#      against it instead of the modules and run. doc_test includes private
#      headers and stays against src/.
#
# CC and CFLAGS select the compiler and flags as in mise run build. The binaries
# land in build/amalgamated/. The test objects are the ones `build` already
# compiled (a test does not depend on which library it links), so only
# include/txml.c is compiled here, and only when its contents or its headers'
# changed. Each binary is relinked only when its bytes' inputs changed and run
# only when its own bytes or the test data did (mise/lib/cache.rb, suite.rb), so
# a comment edit that regenerates an identical include/txml.c does nothing here.

require 'English'
require 'fileutils'
require 'pathname'
require 'shellwords'
require 'cache'
require_relative '../lib/suite'
require 'toolchain'

ROOT = Cache::ROOT
OUT = ROOT.join('build/amalgamated')
COMPILER = Toolchain::Target.host.compile_command
FLAGS = Shellwords.split(ENV.fetch('CFLAGS', '-std=c11 -Wall -Wextra -Werror -pedantic'))

FileUtils.mkdir_p(OUT)

library = OUT.join('txml.o')
outcome, output = Cache.compile([*COMPILER, *FLAGS, '-Iinclude'], 'include/txml.c', library)
if outcome == :failed
  warn output
  abort 'amalgamate-test: include/txml.c does not compile'
end
puts "amalgamate-test: include/txml.c #{outcome == :compiled ? 'compiled' : 'unchanged, object reused'}"

entries = Suite.public_api_tests.map do |name|
  binary = OUT.join(name)
  inputs = [ROOT.join('build/objects', "#{name}.o"), library]
  command = [*COMPILER, *FLAGS, *inputs.map { |path| path.relative_path_from(ROOT).to_s }, '-o', binary.relative_path_from(ROOT).to_s]
  key = Cache.digest(command.join(' '), Cache.tool_id(COMPILER.first(1)), inputs)
  link = "link-amalgamated-#{name}"
  unless binary.file? && Cache.stamped?(link, key)
    Cache.unstamp(link)
    FileUtils.rm_f(binary)
    puts command.shelljoin
    linked = IO.popen(command, chdir: ROOT.to_s, err: %i[child out], &:read)
    abort linked unless $CHILD_STATUS.success?
    Cache.stamp(link, key)
  end
  ["amalgamated/#{name}", binary, Suite::BINARIES.fetch(name)]
end

failed = Suite.run_all(entries)
abort "amalgamate-test: failed: #{failed.join(' ')}" unless failed.empty?

puts "amalgamate-test: #{entries.length} test binaries passed against include/txml.c (#{Suite.public_api_tests.join(' ')})"
