<?xml version='1.0' encoding='UTF-8'?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:h="http://www.w3.org/1999/xhtml" version="1.0" name="DOMPatch" initial="prepared"><metadata><h:section id="documentation"><h:h2>DOMPatch — actor contract</h:h2><h:p><h:strong>Actor invariant: </h:strong>Text/approved attribute updates only; accepted means approved proposal, not deployed.</h:p><h:p><h:strong>Specification: </h:strong>ACT-PATCH in <h:a href="../system.xml">system.xml</h:a>. These comments use XHTML namespace h: and are not executable SCXML actions.</h:p><h:h3>I/O contracts invoked by this actor</h:h3><h:ul><h:li><h:a href="../io-processors.xml#IO-DOM-PREVIEW">review.dom.preview</h:a> — PatchApplyRequest → PatchApplyResult | Fault; local-write, never, 10000 ms max. <h:a href="../io-messages.xsd">XSD</h:a>; flows: FL-012, FL-013, FL-032; requirements: REQ-037, REQ-038, REQ-039, REQ-042</h:li><h:li><h:a href="../io-processors.xml#IO-DOM-REVERT">review.dom.revert</h:a> — PatchRevertRequest → PatchRevertResult | Fault; local-write, never, 10000 ms max. <h:a href="../io-messages.xsd">XSD</h:a>; flows: FL-014; requirements: REQ-038, REQ-040</h:li><h:li><h:a href="../io-processors.xml#IO-REVISION-SAVE">review.proposal.recordDecision</h:a> — RevisionDecisionRequest → RevisionDecisionResult | Fault; local-write, never, 10000 ms max. <h:a href="../io-messages.xsd">XSD</h:a>; flows: FL-014, FL-045; requirements: REQ-040, REQ-094, REQ-095</h:li></h:ul></h:section></metadata><state id="prepared">
    <metadata><h:section id="state-prepared"><h:h3>State: prepared</h:h3><h:ul><h:li><h:code>patch.preview</h:code> → applying</h:li></h:ul><h:p>I/O result events are delivered only after the corresponding processor returns a schema-valid result. On fault, apply the operation-specific failureHandling contract, never a silent success transition.</h:p></h:section></metadata><transition event="patch.preview" target="applying"/>
  </state>
  <state id="applying">
    <metadata><h:section id="state-applying"><h:h3>State: applying</h:h3><h:ul><h:li><h:code>patch.applied</h:code> → previewed<h:a href="../io-processors.xml#IO-DOM-PREVIEW"> [typed result: IO-DOM-PREVIEW]</h:a></h:li><h:li><h:code>patch.invalidated</h:code> → invalidated<h:a href="../io-processors.xml#IO-DOM-PREVIEW"> [typed result: IO-DOM-PREVIEW]</h:a></h:li></h:ul><h:p>I/O result events are delivered only after the corresponding processor returns a schema-valid result. On fault, apply the operation-specific failureHandling contract, never a silent success transition.</h:p></h:section></metadata><transition event="patch.applied" target="previewed"/>
    <transition event="patch.invalidated" target="invalidated"/>
  </state>
  <state id="previewed">
    <metadata><h:section id="state-previewed"><h:h3>State: previewed</h:h3><h:ul><h:li><h:code>patch.accept</h:code> → accepted</h:li><h:li><h:code>patch.reject</h:code> → rejected</h:li><h:li><h:code>patch.revert</h:code> → reverted</h:li><h:li><h:code>patch.invalidated</h:code> → invalidated<h:a href="../io-processors.xml#IO-DOM-PREVIEW"> [typed result: IO-DOM-PREVIEW]</h:a></h:li></h:ul><h:p>I/O result events are delivered only after the corresponding processor returns a schema-valid result. On fault, apply the operation-specific failureHandling contract, never a silent success transition.</h:p></h:section></metadata><transition event="patch.accept" target="accepted"/>
    <transition event="patch.reject" target="rejected"/>
    <transition event="patch.revert" target="reverted"/>
    <transition event="patch.invalidated" target="invalidated"/>
  </state>
  <state id="accepted"><metadata><h:section id="state-accepted"><h:h3>State: accepted</h:h3><h:p>No outgoing transitions in this version. This state is terminal until the host ends or restores the actor.</h:p></h:section></metadata></state>
  <state id="rejected"><metadata><h:section id="state-rejected"><h:h3>State: rejected</h:h3><h:p>No outgoing transitions in this version. This state is terminal until the host ends or restores the actor.</h:p></h:section></metadata></state>
  <state id="invalidated">
    <metadata><h:section id="state-invalidated"><h:h3>State: invalidated</h:h3><h:ul><h:li><h:code>patch.preview</h:code> → applying</h:li></h:ul><h:p>I/O result events are delivered only after the corresponding processor returns a schema-valid result. On fault, apply the operation-specific failureHandling contract, never a silent success transition.</h:p></h:section></metadata><transition event="patch.preview" target="applying"/>
  </state>
  <state id="reverted"><metadata><h:section id="state-reverted"><h:h3>State: reverted</h:h3><h:p>No outgoing transitions in this version. This state is terminal until the host ends or restores the actor.</h:p></h:section></metadata></state>
</scxml>
