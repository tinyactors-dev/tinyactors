#!/usr/bin/env ruby
#MISE description="Write src/core/charts.mjs: the text of charts/*.scxml and spec/work-packet.xsd, for the bundle and the tests"
#MISE sources=["charts/*.scxml", "spec/work-packet.xsd"]
#MISE outputs=["src/core/charts.mjs"]
# vim:ft=ruby

# The core needs the charts' text in a page, a side panel and Node.js alike,
# with no file system and no bundler loader: a generated module of string
# constants does all three. test/charts.test.mjs fails when it is stale.

require 'json'

root = File.expand_path('../..', __dir__)
charts = Dir[File.join(root, 'charts', '*.scxml')].sort.map do |path|
  "  #{JSON.generate(File.basename(path))}: #{JSON.generate(File.read(path))},"
end
xsd = File.read(File.join(root, 'spec', 'work-packet.xsd'))

File.write(File.join(root, 'src', 'core', 'charts.mjs'), <<~JS)
  // Generated by `mise run charts` from charts/*.scxml and spec/work-packet.xsd:
  // do not edit. test/charts.test.mjs checks it against the files.

  /** Each chart's file name → its SCXML text. */
  export const charts = {
  #{charts.join("\n")}
  };

  /** The work packet's schema, copied into every export. */
  export const workPacketXSD = #{JSON.generate(xsd)};
JS
puts 'charts: wrote src/core/charts.mjs'
