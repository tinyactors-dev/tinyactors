#!/usr/bin/env ruby
#MISE description="A reading eval against the real Gemini: the live home page in Chromium, read as each audience it links (tools/read-eval.mjs)"
#USAGE flag "--model <model>" default="gemini-4-hydrogen" help="The Gemini model to evaluate"
#USAGE flag "--thinking <level>" default="high" help="The thinking level: low, medium, high or xhigh"
#USAGE flag "--url <url>" default="https://www.tinyactors.dev/" help="The page to read"
# vim:ft=ruby

# GEMINI_API_KEY comes from 1Password through fnox (the root fnox.toml).
root = File.expand_path('../..', __dir__)
exec('fnox', 'exec', '--', 'node', File.join(root, 'tools/read-eval.mjs'),
     '--model', ENV.fetch('usage_model', 'gemini-4-hydrogen'), '--thinking', ENV.fetch('usage_thinking', 'high'),
     '--url', ENV.fetch('usage_url', 'https://www.tinyactors.dev/'), chdir: root)
