#!/usr/bin/env ruby
#MISE description="A site eval against the real Gemini: Read the site for the pages named, the grid, and where the readings disagree with the content's answers= (tools/site-eval.mjs)"
#USAGE flag "--model <model>" default="gemini-4-hydrogen" help="The Gemini model to evaluate"
#USAGE flag "--thinking <level>" default="high" help="The reviewer's thinking level (readings think at medium)"
#USAGE flag "--pages <paths>" default="/,/chat/,/guides/testing/,/performance/,/about/,/guides/snapshots/" help="The pages to read, comma-separated"
# vim:ft=ruby

# GEMINI_API_KEY comes from 1Password through fnox (the root fnox.toml).
root = File.expand_path('../..', __dir__)
exec('fnox', 'exec', '--', 'node', File.join(root, 'tools/site-eval.mjs'),
     '--model', ENV.fetch('usage_model', 'gemini-4-hydrogen'), '--thinking', ENV.fetch('usage_thinking', 'high'),
     '--pages', ENV.fetch('usage_pages', '/,/chat/,/guides/testing/,/performance/,/about/,/guides/snapshots/'), chdir: root)
