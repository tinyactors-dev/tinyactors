<?xml version="1.0" encoding="UTF-8"?>
<!--
  One conversation with the model about a page under review. A page has
  any number of them; the core keeps their list and runs the one that is
  open as an actor of this chart (named `conversation <page> <id>`), so a
  new conversation starts from nothing and the model reads only this one.
  When
  the model proposes a rewrite of a piece of the page (`propose_rewrite`
  with `original_text`, and the anchor the model processor found for it),
  this actor spawns an annotation actor for it, and the model's message
  names the annotations it made (`annotations`; `proposed` when the model
  said nothing but the proposals). A spoken message (`chat` with a clip)
  is transcribed first, and the transcript is the user's message. The
  audience calls of a reply (`define_audience`, `use_audiences`) go to the
  `settings` processor, and the model's message names them (`audiences`).

    model    chat         → model.reply {text, proposed?, rewrites, audiences, for, thoughts?, seconds?} | model.error {message}
             transcribe   → model.transcript {text} | model.error {message}   (the clip's id)
    spawn    spawn        → spawned {name, address}    (tinyactors' Spawner)
    settings audience     → audience.saved {ids: {name: id}} | audience.refused {message}
    store    chat         {page, id, messages}, after every change
    ui       chat         {page, id, messages, busy, error}, after every change
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="conversation" initial="live">
  <datamodel>
    <data id="page"/>
    <!-- the conversation's id among the page's -->
    <data id="id"/>
    <data id="lang" expr="'en'"/>
    <data id="messages" expr="[]"/>
    <data id="busy" expr="false"/>
    <!-- the id of the clip being transcribed (the core keeps the audio) -->
    <data id="clip" expr="null"/>
    <data id="spawned" expr="0"/>
    <!-- the last request's failure, until the next message -->
    <data id="error" expr="null"/>
    <!-- the Spawner's requests of the reply being handled -->
    <data id="pending" expr="[]"/>
  </datamodel>

  <script>
    // The Spawner's request for the annotation actor a rewrite becomes.
    // A helper of the chart: it reads nothing but its arguments.
    function annotation(rewrite, page, lang, n) {
      var id = 'm' + Date.now().toString(36) + '-' + n;
      return {
        chart: 'annotation',
        name: id,
        params: {
          id: id, page: page, lang: lang, source: 'model', state: 'new',
          original: rewrite.original_text,
          anchor: rewrite.anchor || { quote: { exact: rewrite.original_text, prefix: '', suffix: '' }, selector: '' },
          suggestions: [{ id: 's1', text: rewrite.replacement, rationale: rewrite.rationale || '', after: 0 }],
          audiences: rewrite.for || [],
        },
      };
    }

    // The model's message of a reply: its words, the annotations its
    // rewrites made, the audience calls and the summary of its thinking.
    function reply(data, pending) {
      var m = { role: 'model', text: data.text || 'No change proposed.', at: new Date().toISOString() };
      if (pending.length) m.annotations = pending.map((p) => p.name);
      if (data.proposed) m.proposed = true;
      var named = (data.audiences || []).flatMap((c) => (c.action === 'use' ? c.names : [c.name]).map((name) => ({ name: name, action: c.action })));
      if (named.length) m.audiences = named;
      if (data.thoughts) m.thoughts = data.thoughts;
      if (data.seconds) m.seconds = data.seconds;
      return m;
    }
  </script>

  <state id="live" initial="idle">
    <!-- Every state raises `changed`: the conversation goes to the panel and to the store. -->
    <transition event="changed">
      <send type="ui" event="chat" namelist="page id messages busy error"/>
      <send type="store" event="chat" namelist="page id messages"/>
    </transition>
    <!-- the settings processor's answers: a saved audience's id on its chip; a refusal is the error -->
    <transition event="audience.saved">
      <assign location="messages" expr="messages.map((m) => m.audiences ? Object.assign({}, m, { audiences: m.audiences.map((a) => (!a.id &amp;&amp; _event.data.ids[a.name] ? Object.assign({}, a, { id: _event.data.ids[a.name] }) : a)) }) : m)"/>
      <raise event="changed"/>
    </transition>
    <transition event="audience.refused">
      <assign location="error" expr="_event.data.message"/>
      <raise event="changed"/>
    </transition>

    <state id="idle">
      <onentry><assign location="busy" expr="false"/><raise event="changed"/></onentry>
      <transition event="chat" cond="_event.data.clip" target="transcribing">
        <assign location="error" expr="null"/>
        <assign location="clip" expr="_event.data.clip"/>
      </transition>
      <transition event="chat" target="asking">
        <assign location="error" expr="null"/>
        <assign location="messages" expr="messages.concat([{ role: 'user', text: _event.data.text, at: new Date().toISOString() }])"/>
      </transition>
    </state>

    <!-- A spoken message: the model writes down what was said, and that is the message. -->
    <state id="transcribing">
      <onentry>
        <assign location="busy" expr="true"/>
        <raise event="changed"/>
        <send type="model" event="transcribe" namelist="page clip"/>
      </onentry>
      <onexit><assign location="clip" expr="null"/></onexit>
      <transition event="model.transcript" cond="String(_event.data.text || '').trim()" target="asking">
        <assign location="messages" expr="messages.concat([{ role: 'user', text: String(_event.data.text).trim(), at: new Date().toISOString(), spoken: true }])"/>
      </transition>
      <transition event="model.transcript" target="idle">
        <assign location="error" expr="'Nothing was heard.'"/>
      </transition>
      <transition event="model.error" target="idle">
        <assign location="error" expr="_event.data.message"/>
      </transition>
      <transition event="error.communication" target="idle">
        <assign location="error" expr="'The model could not be reached.'"/>
      </transition>
    </state>

    <state id="asking">
      <onentry>
        <assign location="busy" expr="true"/>
        <raise event="changed"/>
        <send type="model" event="chat" namelist="page messages"/>
      </onentry>
      <transition event="model.reply" target="idle">
        <assign location="pending" expr="(_event.data.rewrites || []).filter((r) => r.original_text).map((r, i) => annotation(r, page, lang, spawned + i + 1))"/>
        <assign location="spawned" expr="spawned + pending.length"/>
        <assign location="messages" expr="messages.concat([reply(_event.data, pending)])"/>
        <foreach array="pending" item="spawn">
          <send type="spawn" event="spawn"><content expr="spawn"/></send>
        </foreach>
        <foreach array="_event.data.audiences || []" item="call">
          <send type="settings" event="audience"><content expr="call"/></send>
        </foreach>
        <assign location="pending" expr="[]"/>
      </transition>
      <transition event="model.error" target="idle">
        <assign location="error" expr="_event.data.message"/>
      </transition>
      <transition event="error.communication" target="idle">
        <assign location="error" expr="'The model could not be reached.'"/>
      </transition>
    </state>
  </state>
</scxml>
