<?xml version="1.0" encoding="UTF-8"?>
<!--
  The audiences of one page: which of the saved audiences read it. The core
  spawns one actor of this chart for the page it opens, from the page's
  stored record, and ends it when the panel leaves the page. Its set
  (`audienceIDs`) is the page's active audiences; until it has one, the
  page writes for the last set used on any page (the settings'
  `audienceIDs`).

  A page that links its audiences (`<link rel="audience">`, read by the
  core into the store as site audiences) is spawned with them as `linked`,
  in its order: they are its set (`from: 'site'`) unless the reviewer
  changed it (`from: 'user'`), and such a page is never asked. Opened
  again with other links, a set from the site follows them.

  A page with no links and no set is asked about once, when it is first opened with a
  key and saved audiences (`canSuggest`, or `key` later): a cheap request
  over the page and the audiences' names and descriptions ("which of
  these read this page?"). Its answer is a suggestion the reviewer
  accepts, adjusts or dismisses; it is never applied by itself.

    unset ──(canSuggest) or key──▶ suggesting ──model.audiences──▶ suggested
      ▲                               │ none, model.error             │ accept: the suggestion
      └───────────────────────────────┘                               │ dismiss {audienceIDs}: the set in use
                                                                      ▼
    unset, suggesting, suggested ──set {audienceIDs}──────────────▶  set ──set──▶ set
    restore ──linked, and no set of the reviewer's──────────────────▶ set  (from: 'site')

  `suggestion` is null (never asked), {state: 'asking'}, {state: 'ready',
  audienceIDs}, {state: 'none'} (the model named none) or {state:
  'failed', error}; asked once, it is not asked again. Entering `set`
  clears it. `from` says who chose the set: 'site' (the page's links),
  'user' (the reviewer, the model's use_audiences, an accepted or
  dismissed suggestion), null before either. `kind` is the page's kind
  as it declared it when opened, in its record for the export.

    model  suggest  {url}          → model.audiences {audienceIDs} | model.error {message}
                                     (sent to this actor by name when the answer comes,
                                     so opening the page does not wait for it)
    store  page     its record, after every change
    ui     page     its record, after every change

  `state` names where it was for the store; an actor spawned with a stored
  record starts from it (one stored while asking was cut off asks again).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="audiences" initial="live">
  <datamodel>
    <data id="url"/>
    <!-- the page's set, in order; null: none yet -->
    <data id="audienceIDs" expr="null"/>
    <data id="suggestion" expr="null"/>
    <data id="state" expr="'new'"/>
    <!-- spawn only: a key and saved audiences, so a suggestion can be asked for now -->
    <data id="canSuggest" expr="false"/>
    <!-- spawn only: the ids of the site audiences the page links, in order; null: it links none -->
    <data id="linked" expr="null"/>
    <!-- spawn only: the page's kind (its meta page-kind), kept for the export; null: it declares none -->
    <data id="kind" expr="null"/>
    <!-- who chose the set: 'site' | 'user' | null -->
    <data id="from" expr="null"/>
  </datamodel>

  <state id="live" initial="restore">
    <transition event="changed">
      <send type="ui" event="page" namelist="url audienceIDs suggestion state from kind"/>
      <send type="store" event="page" namelist="url audienceIDs suggestion state from kind"/>
    </transition>
    <!-- the reviewer (or the model's use_audiences) chose the page's set -->
    <transition event="set" target="set">
      <assign location="audienceIDs" expr="_event.data.audienceIDs"/>
      <assign location="from" expr="'user'"/>
    </transition>

    <state id="restore">
      <!-- the page's links are its set, unless the reviewer chose one -->
      <transition cond="linked &amp;&amp; linked.length &amp;&amp; (audienceIDs === null || from === 'site')" target="set">
        <assign location="audienceIDs" expr="linked"/>
        <assign location="from" expr="'site'"/>
      </transition>
      <transition cond="audienceIDs !== null" target="set"/>
      <transition cond="suggestion &amp;&amp; suggestion.state === 'ready'" target="suggested"/>
      <transition cond="canSuggest &amp;&amp; (!suggestion || suggestion.state === 'asking')" target="suggesting"/>
      <transition target="unset">
        <if cond="suggestion &amp;&amp; suggestion.state === 'asking'"><assign location="suggestion" expr="null"/></if>
      </transition>
    </state>

    <!-- No set: the page writes for the last set used. -->
    <state id="unset">
      <onentry>
        <if cond="state !== 'unset'"><assign location="state" expr="'unset'"/><raise event="changed"/></if>
      </onentry>
      <transition event="key" cond="!suggestion" target="suggesting"/>
    </state>

    <!-- The model is asked which audiences read the page. -->
    <state id="suggesting">
      <onentry>
        <assign location="state" expr="'suggesting'"/>
        <assign location="suggestion" expr="({ state: 'asking' })"/>
        <raise event="changed"/>
        <send type="model" event="suggest" namelist="url"/>
      </onentry>
      <transition event="model.audiences" cond="(_event.data.audienceIDs || []).length" target="suggested">
        <assign location="suggestion" expr="({ state: 'ready', audienceIDs: _event.data.audienceIDs })"/>
      </transition>
      <transition event="model.audiences" target="unset">
        <assign location="suggestion" expr="({ state: 'none' })"/>
      </transition>
      <transition event="model.error" target="unset">
        <assign location="suggestion" expr="({ state: 'failed', error: _event.data.message })"/>
      </transition>
      <transition event="error.communication" target="unset">
        <assign location="suggestion" expr="({ state: 'failed', error: 'The model could not be reached.' })"/>
      </transition>
    </state>

    <!-- A suggestion waits for the reviewer. -->
    <state id="suggested">
      <onentry><assign location="state" expr="'suggested'"/><raise event="changed"/></onentry>
      <transition event="accept" target="set">
        <assign location="audienceIDs" expr="suggestion.audienceIDs"/>
        <assign location="from" expr="'user'"/>
      </transition>
      <!-- not these: the page keeps the set in use -->
      <transition event="dismiss" target="set">
        <assign location="audienceIDs" expr="_event.data.audienceIDs"/>
        <assign location="from" expr="'user'"/>
      </transition>
    </state>

    <!-- The page has its own set. -->
    <state id="set">
      <onentry>
        <assign location="state" expr="'set'"/>
        <assign location="suggestion" expr="null"/>
        <raise event="changed"/>
      </onentry>
      <!-- an answer that comes after the reviewer chose: dropped -->
      <transition event="model.audiences model.error error.communication key"/>
    </state>
  </state>
</scxml>
