<?xml version="1.0" encoding="UTF-8"?>
<!--
  One page under review: the page-level conversation with the model. When
  the model proposes a rewrite of a piece of the page (`propose_rewrite`
  with `original_text`, and the anchor the model processor found for it),
  this actor spawns an annotation actor for it, and the model's message
  names the annotations it made (`annotations`; `proposed` when the model
  said nothing but the proposals).

    model  chat           → model.reply {text, proposed?, rewrites} | model.error {message}
    spawn  spawn          → spawned {name, address}    (tinyactors' Spawner)
    store  chat           {page, messages}, after every change
    ui     chat           {page, messages, busy, error}, after every change
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="ecmascript" name="session" initial="live">
  <datamodel>
    <data id="page"/>
    <data id="lang" expr="'en'"/>
    <data id="messages" expr="[]"/>
    <data id="busy" expr="false"/>
    <!-- what the next model request carries besides the messages: {clip} -->
    <data id="request" expr="null"/>
    <data id="spawned" expr="0"/>
    <!-- the last request's failure, until the next message -->
    <data id="error" expr="null"/>
    <!-- the Spawner's requests of the reply being handled -->
    <data id="pending" expr="[]"/>
  </datamodel>

  <script>
    // The Spawner's request for the annotation actor a rewrite becomes.
    // A helper of the chart: it reads nothing but its arguments.
    function annotation(rewrite, page, lang, n) {
      var id = 'm' + Date.now().toString(36) + '-' + n;
      return {
        chart: 'annotation',
        name: id,
        params: {
          id: id, page: page, lang: lang, source: 'model', state: 'new',
          original: rewrite.original_text,
          anchor: rewrite.anchor || { quote: { exact: rewrite.original_text, prefix: '', suffix: '' }, selector: '' },
          suggestions: [{ id: 's1', text: rewrite.replacement, rationale: rewrite.rationale || '', after: 0 }],
        },
      };
    }
  </script>

  <state id="live" initial="idle">
    <!-- Every state raises `changed`: the conversation goes to the panel and to the store. -->
    <transition event="changed">
      <send type="ui" event="chat" namelist="page messages busy error"/>
      <send type="store" event="chat" namelist="page messages"/>
    </transition>

    <state id="idle">
      <onentry><assign location="busy" expr="false"/><raise event="changed"/></onentry>
      <transition event="chat" target="asking">
        <assign location="error" expr="null"/>
        <assign location="messages" expr="messages.concat([{ role: 'user', text: _event.data.text || '(voice message)', at: new Date().toISOString() }])"/>
        <assign location="request" expr="({ clip: _event.data.clip || null })"/>
      </transition>
    </state>

    <state id="asking">
      <onentry>
        <assign location="busy" expr="true"/>
        <raise event="changed"/>
        <send type="model" event="chat" namelist="page messages request"/>
      </onentry>
      <transition event="model.reply" target="idle">
        <assign location="pending" expr="(_event.data.rewrites || []).filter((r) => r.original_text).map((r, i) => annotation(r, page, lang, spawned + i + 1))"/>
        <assign location="spawned" expr="spawned + pending.length"/>
        <assign location="messages" expr="messages.concat([Object.assign({ role: 'model', text: _event.data.text || 'No change proposed.', at: new Date().toISOString() },
          pending.length ? { annotations: pending.map((p) => p.name) } : {}, _event.data.proposed ? { proposed: true } : {})])"/>
        <foreach array="pending" item="spawn">
          <send type="spawn" event="spawn"><content expr="spawn"/></send>
        </foreach>
        <assign location="pending" expr="[]"/>
        <assign location="request" expr="null"/>
      </transition>
      <transition event="model.error" target="idle">
        <assign location="error" expr="_event.data.message"/>
        <assign location="request" expr="null"/>
      </transition>
      <transition event="error.communication" target="idle">
        <assign location="error" expr="'The model could not be reached.'"/>
        <assign location="request" expr="null"/>
      </transition>
    </state>
  </state>
</scxml>
