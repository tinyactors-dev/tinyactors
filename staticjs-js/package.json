    "webassembly",
    "wasm",
    "expressions",
    "plugins"
  ],
  "homepage": "https://staticjs.tinyactors.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhamidi/tinyactors.git",
    "directory": "staticjs-js"
  },
  "bugs": {
    "url": "https://github.com/dhamidi/tinyactors/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
