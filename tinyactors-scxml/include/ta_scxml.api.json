  "functions": [
    {
      "name": "ta_scxml_codec_init",
      "doc": "Resolves `params` (null for all defaults) into `codec`. TA_ERR_INVALID when a bound exceeds what txml can represent: max_depth above 65535, or max_parse_bytes above UINT32_MAX.",
      "public": true,
      "static_inline": false,
      "implemented": true,
      "returns": {
        "type": {
          "type": "ta_result"
        },
        "success": "TA_OK"
      },
      "params": [
        {
          "name": "codec",
          "type": {
