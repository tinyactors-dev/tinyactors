              "type": "ta_scxml_codec"
            }
          },
          "shape": "single",
          "direction": "out",
          "valid_on": "success"
        },
        {
          "name": "params",
          "type": {
            "pointer": {
              "type": "ta_scxml_codec_params",
              "const": true
            }
          },
          "shape": "single",
          "direction": "in",
          "optional": true
        }
      ]
    },
    {
      "name": "ta_scxml_codec_adapter",
      "doc": "The ta_chart_codec for `codec`, which must outlive it.",
      "public": true,
      "static_inline": false,
      "implemented": true,
      "returns": {
        "type": {
          "type": "ta_chart_codec"
        }
      },
