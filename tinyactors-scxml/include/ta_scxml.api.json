  "types": {
    "ta_scxml_codec": {
      "kind": "struct",
      "doc": "A codec. Initialize it once and keep it while its adapter is used.",
      "fields": [
        {
          "name": "limits",
          "type": {
            "type": "ta_scxml_codec_params"
          },
          "doc": "The bounds in force: the params given, with every zero replaced by its default."
        }
      ],
      "layout": {
        "x86_64-unknown-linux-gnu": {
          "size": 48,
          "align": 8,
          "offsets": {
            "limits": 0
          }
        },
        "wasm32-unknown-unknown": {
          "size": 48,
          "align": 8,
          "offsets": {
            "limits": 0
          }
        }
      }
    },
    "ta_scxml_codec_params": {
      "kind": "struct",
      "doc": "The bounds a decode enforces. Zero selects the default beside each field. The defaults are safe for untrusted input: a document within them costs at most a few tens of MiB and a bounded stack. The largest W3C IRP test document is under 8 KiB and 12 elements deep.\n\nReaching a bound is TA_CHART_ERROR_LIMIT. Its `construct` is the field's name (\"max_depth\", ...) and its `at` is where the input reached it.\n\nBounds that txml also has are passed to txml and enforced there only: max_depth, max_attributes, max_name_length, max_names, max_entity_expansion and max_parse_bytes.",
      "fields": [
        {
          "name": "max_document_bytes",
          "type": {
            "builtin": "uint64_t"
          },
          "doc": "Bytes of input. Checked before parsing."
        },
        {
          "name": "max_parse_bytes",
          "type": {
            "builtin": "uint64_t"
          },
          "doc": "Bytes the parsed document may occupy: txml's max_document_bytes, its node and value storage. Markup-dense input needs several times its own size. At most UINT32_MAX."
        },
        {
          "name": "max_depth",
          "type": {
            "builtin": "uint32_t"
          },
          "doc": "Element nesting, inline machines inside <content > included. It also bounds the codec's own recursion. At most 65535."
        },
        {
          "name": "max_attributes",
          "type": {
            "builtin": "uint32_t"
          },
          "doc": "Attributes on one element, namespace declarations included."
        },
        {
          "name": "max_text_bytes",
          "type": {
            "builtin": "uint32_t"
          },
          "doc": "Bytes of one text value the codec produces: an attribute value, a <script > body, the bytes of a literal <content >, <data > body or fetched `src`."
        },
        {
          "name": "max_entity_expansion",
          "type": {
            "builtin": "uint64_t"
          },
          "doc": "Bytes produced by expanding entities the document's internal subset declares (txml's entity_expansion_budget); predefined and character references are not charged."
        },
        {
          "name": "max_name_length",
          "type": {
            "builtin": "uint32_t"
          },
          "doc": "Bytes of one qualified name."
        },
        {
          "name": "max_names",
          "type": {
            "builtin": "uint32_t"
          },
          "doc": "Distinct expanded names (element and attribute) in one document."
        }
      ],
      "layout": {
        "x86_64-unknown-linux-gnu": {
          "size": 48,
          "align": 8,
          "offsets": {
            "max_document_bytes": 0,
            "max_parse_bytes": 8,
            "max_depth": 16,
            "max_attributes": 20,
            "max_text_bytes": 24,
            "max_entity_expansion": 32,
            "max_name_length": 40,
            "max_names": 44
          }
        },
