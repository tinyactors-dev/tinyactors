#!/usr/bin/env ruby
#MISE description="Describe the codec's public API as include/ta_scxml.api.json, or verify the checked-in description"
#MISE depends=["amalgamate"]
# vim:ft=ruby

# The codec builds on core, so it is described by core's extractor
# (tinyactors-core/mise/lib/api.rb, docs/internal/api-ir.md there), with
# core's annotations and schema: its macro prefix is TA_SCXML, its header
# includes tinyactors.h, and core's own description is an import, whose
# types the codec's functions name without describing them again. The
# release checks each binary's exports against this description (root ADR
# 0001). `--check` fails when the checked-in description is out of date.

require 'json'
require 'pathname'
require 'toolchain'
require 'cache'
require_relative '../../../tinyactors-core/mise/lib/api'

CORE = Pathname.new(__dir__).join('../../../tinyactors-core').expand_path
Cache.gate('api',
           inputs: Cache.files('include/ta_scxml.h', 'include/ta_scxml.c', 'mise/tasks/api',
                               '../tinyactors-core/include/tinyactors.h', '../tinyactors-core/include/tinyactors.api.json',
                               '../tinyactors-core/include/tinyactors.api.schema.json',
                               '../tinyactors-core/mise/lib/api.rb', '../tinyactors-core/mise/lib/api/*.rb'),
           outputs: [Cache::ROOT.join('include/ta_scxml.api.json')],
           extra: [Toolchain::Tool[:clang].identity])

ROOT = Pathname.new(__dir__).join('../..').expand_path
HEADER = ROOT.join('include/ta_scxml.h')
LIBRARY = ROOT.join('include/ta_scxml.c')
OUTPUT = ROOT.join('include/ta_scxml.api.json')

check = ARGV == ['--check']
abort 'usage: mise run api [--check]' unless ARGV.empty? || check

begin
  description = API.describe(HEADER, library: LIBRARY, schema: CORE.join('include/tinyactors.api.schema.json'),
                                     prefix: 'TA_SCXML',
                                     includes: [CORE.join('include'), ROOT.join('../tinyxml/include').expand_path],
                                     imports: [JSON.parse(CORE.join('include/tinyactors.api.json').read)])
rescue API::Error, API::Clang::Error => e
  abort "api: #{HEADER.relative_path_from(ROOT)} cannot be described:\n#{e.message}"
end
text = API.render(description)
current = OUTPUT.file? && OUTPUT.read == text

if check
  abort "#{OUTPUT.relative_path_from(ROOT)} is out of date; run mise run api" unless current
  puts 'The codec API description is current.'
elsif current
  puts "#{OUTPUT.relative_path_from(ROOT)} unchanged"
else
  OUTPUT.write(text)
  puts "generated #{OUTPUT.relative_path_from(ROOT)} (#{description['types'].size} types, " \
       "#{description['functions'].size} functions, #{description['constants'].size} constants)"
end
