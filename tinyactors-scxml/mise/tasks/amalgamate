#!/usr/bin/env ruby
#MISE description="Generate or verify the codec's single-file amalgamation, include/ta_scxml.c"
# vim:ft=ruby

# include/ta_scxml.h is the authored public API. The amalgamation is every
# portable src/*.c (mise/lib/platform_files.rb, root ADR 0001 decision 9), in
# name order, behind a banner: one translation unit a C embedder compiles
# beside core and txml, and the one the release builds from. The codec has
# no private headers and gives every non-public function internal linkage
# itself, so nothing is rewritten; the proof step checks that the result
# compiles and exports exactly the functions the public header declares
# with TA_API.
#
#   mise run amalgamate           write include/ta_scxml.c
#   mise run amalgamate --check   fail if the checked-in file is out of date

require 'pathname'
require 'tmpdir'
require 'c_header'
require 'cache'
require 'platform_files'
require 'toolchain'

Cache.gate('amalgamate',
           inputs: Cache.files('src/*.c', 'include/ta_scxml.h', 'mise/tasks/amalgamate', '../mise/lib/platform_files.rb'),
           outputs: [Cache::ROOT.join('include/ta_scxml.c')])

ROOT = Pathname.new(__dir__).join('../..').expand_path
OUTPUT = ROOT.join('include/ta_scxml.c')
check = ARGV == ['--check']
abort 'usage: mise run amalgamate [--check]' unless ARGV.empty? || check

sources = PlatformFiles.sources(ROOT.join('src')).map { |path| Pathname.new(path) }.sort_by(&:basename)
abort 'amalgamate: src/ has no portable .c files' if sources.empty?

text = +<<~BANNER
  /*
   * ta_scxml.c: the SCXML codec for tinyactors as one translation unit.
   * GENERATED by `mise run amalgamate` in tinyactors-scxml from the .c files in src/; do not
   * edit. Compile it with tinyactors.h and txml.h on the include path, and
   * link core and txml beside it.
   */
BANNER
sources.each do |source|
  text << "\n/* ---- src/#{source.basename} ---- */\n\n" << source.read
end

current = OUTPUT.file? && OUTPUT.read == text
if check
  abort "#{OUTPUT.relative_path_from(ROOT)} is out of date; run mise run amalgamate" unless current
  puts 'The codec amalgamation is current.'
  exit 0
end

# The proof: the unit compiles, and its global functions are exactly the
# header's TA_API functions. It is compiled for the check target
# (Toolchain::Target.check), so the answer is the same on every host.
declared = CHeader.new(ROOT.join('include/ta_scxml.h')).functions_declared_with('TA_API')
includes = [ROOT.join('include'), ROOT.join('../tinyactors-core/include'), ROOT.join('../tinyxml/include')]
Dir.mktmpdir('ta_scxml-amalgamate') do |dir|
  unit = File.join(dir, 'ta_scxml.c')
  File.write(unit, text)
  Toolchain::Target.check.compile(unit, into: File.join(dir, 'ta_scxml.o'), includes: includes,
                                        flags: %w[-std=c11 -Wall -Wextra -Werror -pedantic])
                   .must_export_exactly!(declared)
rescue Toolchain::Error => e
  abort "amalgamate: #{e.message}"
end

if current
  puts "#{OUTPUT.relative_path_from(ROOT)} unchanged"
else
  OUTPUT.write(text)
  puts "generated #{OUTPUT.relative_path_from(ROOT)} from #{sources.size} source file(s)"
end
